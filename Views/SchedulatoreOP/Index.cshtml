                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Data Fine OP</div>
                        <div class="info-value">${ordine.DataFineOP ? formatDateTime(ordine.DataFineOP) : '-'}</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Data Fine Prevista</div>
                        <div class="info-value">${ordine.DataFinePrevista ? formatDateTime(ordine.DataFinePrevista) : '-'}</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">ID Operatore</div>
                        <div class="info-value">${ordine.IdOperatore || '-'}</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Costo Orario</div>
                        <div class="info-value">${ordine.CostoOrario ? '€ ' + ordine.CostoOrario.toFixed(2) : '-'}</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Tempo Effettivo</div>
                        <div class="info-value">${ordine.TempoEffettivo ? ordine.TempoEffettivo + ' secondi' : '-'}</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Modificato</div>
                        <div class="info-value">${getModificatoLabel(ordine.Modificato)}</div>
                    </div>
                    
                    ${ordine.Note ? `
                    <div class="info-item full-width">
                        <div class="info-label">Note</div>

                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Tempo Ciclo</div>
                        <div class="info-value">${ordine.TempoCiclo} secondi</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Tempo Setup</div>

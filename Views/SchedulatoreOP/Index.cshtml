        // Carica fermi centri di lavoro (Block Events nativi Syncfusion)
        async function loadFermi() {
            try {
                const response = await fetch('@Url.Action("GetFermiCentriLavoro", "SchedulatoreOP")');
                const fermiJson = await response.json();
                
                // Mappa fermi come Block Events nativi di Syncfusion (con parsing ora locale)
                const blockEvents = fermiJson.map(f => ({
                    Id: 'FERMO_' + f.codiceCentro + '_' + f.id, // ID univoco
                    Subject: f.descrizione || 'Fermo',
                    StartTime: parseLocalDate(f.dataInizio),
                    EndTime: parseLocalDate(f.dataFine),
                    IsBlock: true, // Proprietà nativa Syncfusion per Block Events
                    ResourceID: f.codiceCentro // Associa al centro di lavoro
                }));
                
                return blockEvents;
            } catch (error) {
                console.error('❌ Errore caricamento fermi:', error);
                return [];
            }
        }

        // Carica ordini di produzione
        async function loadOrdini() {
            try {
                const response = await fetch('@Url.Action("GetOrdiniProduzione", "SchedulatoreOP")');
                const ordiniJson = await response.json();
                
                // IMPORTANTE: ASP.NET Core serializza in camelCase, mappiamo a PascalCase per Syncfusion
                const ordini = ordiniJson.map(o => ({
                    // Campi Syncfusion (PascalCase) - Date parsate come ora locale
                    Id: o.id,
                    Subject: o.subject,
                    StartTime: parseLocalDate(o.startTime),
                    EndTime: parseLocalDate(o.endTime),
                    RoomId: o.roomId,
                    CategoryColor: o.categoryColor,
                    IsAllDay: o.isAllDay,
                    
                    // TUTTI i campi extra per il popup (mantieni camelCase originale)
                    TipoOrdine: o.tipoOrdine,
                    AnnoOrdine: o.annoOrdine,
                    SerieOrdine: o.serieOrdine,
                    NumeroOrdine: o.numeroOrdine,
                    RigaOrdine: o.rigaOrdine,
                    DescrOrdine: o.descrOrdine,
                    CodiceArticolo: o.codiceArticolo,
                    DescrizioneArticolo: o.descrizioneArticolo,
                    UnitaMisura: o.unitaMisura,
                    Quantita: o.quantita,
                    QuantitaProdotta: o.quantitaProdotta,
                    DataInizioOP: parseLocalDate(o.dataInizioOP),
                    TempoCiclo: o.tempoCiclo,
                    DataInizioSetup: parseLocalDate(o.dataInizioSetup),
                    TempoSetup: o.tempoSetup,
                    IdStato: o.idStato,
                    StatoDescrizione: o.statoDescrizione,
                    CodiceCentro: o.codiceCentro,
                    CentroLavoroDescrizione: o.centroLavoroDescrizione,
                    CodiceLavorazione: o.codiceLavorazione,
                    DescrizioneLavorazione: o.descrizioneLavorazione,
                    CodiceOperatore: o.codiceOperatore,
                    NomeOperatore: o.nomeOperatore,
                    Note: o.note,
                    DataFineOP: parseLocalDate(o.dataFineOP),
                    DataFinePrevista: parseLocalDate(o.dataFinePrevista),
                    Priorita: o.priorita,
                    IdOperatore: o.idOperatore,
                    CostoOrario: o.costoOrario,
                    TempoEffettivo: o.tempoEffettivo,
                    Modificato: o.modificato,
                    PercentualeCompletamento: o.percentualeCompletamento
                }));
                
                if (scheduleObj) {
                    // Aggiorna data source dello scheduler
                    scheduleObj.eventSettings.dataSource = ordini;
                    scheduleObj.refreshEvents();
                } else {
                    console.error('❌ scheduleObj non disponibile!');
                }
                
            } catch (error) {
                console.error('Errore caricamento ordini:', error);
                showAlert('Errore durante il caricamento degli ordini', 'danger');
            }
        }

        // Personalizza rendering eventi (applica colori da CategoryColor)
        function onEventRendered(args) {
            const eventData = args.data;
            const colore = eventData.CategoryColor || '#808080';
            
            args.element.style.setProperty('background-color', colore, 'important');
            args.element.style.setProperty('border-color', colore, 'important');
            args.element.style.setProperty('color', 'white', 'important');
            
            // Applica 75% trasparenza a TUTTI gli eventi (opacity 0.75)
            args.element.style.setProperty('opacity', '0.75', 'important');
        }

        // Renderizzazione celle - colora celle in fermo E personalizza header date in italiano
        function onRenderCell(args) {
            // Personalizza gli header delle date in italiano
            if (args.elementType === 'dateHeader') {
                const giorni = ['dom', 'lun', 'mar', 'mer', 'gio', 'ven', 'sab'];
                const mesi = ['gen', 'feb', 'mar', 'apr', 'mag', 'giu', 'lug', 'ago', 'set', 'ott', 'nov', 'dic'];
                const data = new Date(args.date);
                const giorno = giorni[data.getDay()];
                const mese = mesi[data.getMonth()];
                const giornoNum = data.getDate();
                
                // Modifica il contenuto della cella
                args.element.innerHTML = `<span>${giorno} ${giornoNum} ${mese}</span>`;
            }
            
            // Solo per celle di tipo work cells (non header) - colora fermi
            if (args.elementType === 'workCells') {
                const groupIndex = args.groupIndex;
                
                // Ottieni il centro di lavoro per questa riga (risorsa)
                if (scheduleObj && scheduleObj.resourceCollection && scheduleObj.resourceCollection.length > 0) {
                    const resource = scheduleObj.resourceCollection[0].dataSource[groupIndex];
                    if (resource) {
                        const codiceCentro = resource.Id;
                        
                        // Controlla se la data cade in un periodo di fermo per questo centro
                        let matchedFermo = null;
                        const isFermo = fermiCentriLavoro.some(fermo => {
                            if (fermo.codiceCentro !== codiceCentro) return false;
                            
                            // Confronto semplice con timestamp
                            // IMPORTANTE: uso < invece di <= perché ogni cella rappresenta un INTERVALLO
                            // La cella "06:00" rappresenta l'ora 06:00-07:00, quindi se il fermo finisce alle 06:00
                            // quella cella NON deve essere grigia (il fermo è terminato PRIMA dell'intervallo)
                            const cellTimestamp = args.date.getTime();
                            const fermoInizioTimestamp = fermo.dataInizio.getTime();
                            const fermoFineTimestamp = fermo.dataFine.getTime();
                            
                            const match = cellTimestamp >= fermoInizioTimestamp && cellTimestamp < fermoFineTimestamp;
                            if (match) {
                                matchedFermo = fermo;
                            }
                            return match;
                        });
                        
                        if (isFermo) {
                            // Colora la cella con grigio più scuro per indicare fermo
                            args.element.style.backgroundColor = 'rgba(52, 58, 64, 0.35)';
                        }
                    }
                }
            }
        }

        // Click su evento -> mostra popup
        function onEventClick(args) {
            args.cancel = true; // Previeni popup default Syncfusion
            showOrderPopup(args.event);
        }

        // Blocca TUTTI i popup nativi di Syncfusion
        function onPopupOpen(args) {
            // Tipi di popup nativi da bloccare:
            // - 'QuickInfo' = popup rapido info
            // - 'Editor' = editor eventi
            // - 'DeleteAlert' = conferma eliminazione
            // - 'ViewEventInfo' = visualizzazione evento
            // - 'EventContainer' = contenitore evento
            
            args.cancel = true; // Blocca qualsiasi popup nativo
        }

        // Variabili globali per tracciare il resize e drag
        let originalStartTime = null;
        let originalEndTime = null;
        let originalRoomId = null;

        // Resize evento iniziato - salva valori originali
        function onResizeStart(args) {
            const evento = args.data;
            originalStartTime = new Date(evento.StartTime);
            originalEndTime = new Date(evento.EndTime);
        }

        // Resize evento terminato
        async function onResizeStop(args) {
            const evento = args.data;
            
            // ===== VALIDAZIONI CLIENT-SIDE =====
            
            // 1. Modificato = 7 (bloccato)
            if (evento.Modificato === 7) {
                showAlert('❌ Impossibile modificare: ordine BLOCCATO (Modificato=7)', 'danger');
                args.cancel = true;
                loadOrdini(); // Ricarica per ripristinare
                return;
            }
            
            // 2. IdStato = 3 o 4 (non modificabili)
            if (evento.IdStato === 3 || evento.IdStato === 4) {
                showAlert(`❌ Impossibile modificare: ordine in Stato ${evento.IdStato}`, 'danger');
                args.cancel = true;
                loadOrdini(); // Ricarica per ripristinare
                return;
            }
            
            // 3. IdStato = 2 e tentativo di modificare DataInizio
            if (evento.IdStato === 2 && originalStartTime !== null) {
                // Verifica se StartTime è cambiato rispetto all'originale salvato in resizeStart
                const nuovaDataInizio = new Date(evento.StartTime);
                
                // Confronto con tolleranza di 1 secondo per evitare problemi con millisecondi
                const differenzaSecondi = Math.abs((nuovaDataInizio.getTime() - originalStartTime.getTime()) / 1000);
                
                console.log('🔍 Controllo DataInizio per IdStato=2:', {
                    originale: originalStartTime.toLocaleString('it-IT'),
                    nuova: nuovaDataInizio.toLocaleString('it-IT'),
                    differenzaSecondi: differenzaSecondi
                });
                
                if (differenzaSecondi > 1) {
                    showAlert('❌ Ordine OP in Produzione, non posso alterare Data Inizio OP', 'danger');
                    args.cancel = true;
                    originalStartTime = null;
                    originalEndTime = null;
                    loadOrdini(); // Ricarica per ripristinare
                    return;
                }
            }
            
            // 4. DataInizioOP NON può cadere in un periodo di fermo
            const dataInizioOP = new Date(evento.StartTime);
            const codiceCentro = evento.RoomId;
            
            // Trova fermi per questo centro
            const fermiCentro = fermiCentriLavoro.filter(f => f.codiceCentro === codiceCentro);
            
            // Verifica se DataInizioOP cade dentro un fermo
            const fermoInConflitto = fermiCentro.find(fermo => {
                return dataInizioOP >= fermo.dataInizio && dataInizioOP < fermo.dataFine;
            });
            
            if (fermoInConflitto) {
                showAlert(
                    `❌ Impossibile iniziare ordine durante un fermo del centro lavoro<br>` +
                    `Fermo: ${fermoInConflitto.dataInizio.toLocaleString('it-IT')} - ${fermoInConflitto.dataFine.toLocaleString('it-IT')}<br>` +
                    `${fermoInConflitto.descrizione || ''}`,
                    'danger'
                );
                args.cancel = true;
                originalStartTime = null;
                originalEndTime = null;
                loadOrdini(); // Ricarica per ripristinare
                return;
            }
            
            // ===== CHIAMATA API PER SALVARE =====
            
            try {
                const response = await fetch('@Url.Action("UpdateOrdineResize", "SchedulatoreOP")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: evento.Id,
                        startTime: toLocalISOString(evento.StartTime),
                        endTime: toLocalISOString(evento.EndTime)
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Aggiorna i campi dell'evento con i valori dal server
                    evento.Quantita = result.nuovaQuantita;
                    evento.DataInizioOP = parseLocalDate(result.dataInizioOP);
                    evento.DataFinePrevista = result.dataFinePrevista ? parseLocalDate(result.dataFinePrevista) : null;
                    evento.Modificato = 1;
                    
                    // IMPORTANTE: Aggiorna StartTime e EndTime con i valori calcolati dal backend (con fermi)
                    evento.StartTime = parseLocalDate(result.dataInizioOP);
                    evento.EndTime = parseLocalDate(result.endTimeVisivo);
                    
                    // Aggiorna il subject con la nuova quantità e percentuale
                    const annoOrdine = evento.AnnoOrdine;
                    const numeroOrdine = evento.NumeroOrdine;
                    const quantitaProdotta = evento.QuantitaProdotta || 0;
                    const percentuale = result.nuovaQuantita > 0 ? ((quantitaProdotta / result.nuovaQuantita) * 100).toFixed(1) : 0;
                    evento.Subject = `Ord. ${annoOrdine}-${numeroOrdine} Qta: ${Math.floor(result.nuovaQuantita)} (${percentuale}%)`;
                    
                    // Aggiorna l'evento nello scheduler (senza ricaricare tutto)
                    scheduleObj.saveEvent(evento);
                } else {
                    // Errore dal server
                    showAlert(result.message, 'danger');
                    args.cancel = true;
                    loadOrdini(); // Ricarica per ripristinare
                }
            } catch (error) {
                console.error('❌ Errore salvataggio resize:', error);
                showAlert('❌ Errore durante il salvataggio: ' + error.message, 'danger');
                args.cancel = true;
                loadOrdini(); // Ricarica per ripristinare
            } finally {
                // Reset valori originali
                originalStartTime = null;
                originalEndTime = null;
            }
        }

        // Drag evento iniziato - salva valori originali
        function onDragStart(args) {
            const evento = args.data;
            originalStartTime = new Date(evento.StartTime);
            originalEndTime = new Date(evento.EndTime);
            originalRoomId = evento.RoomId;
        }

        // Drag evento terminato
        async function onDragStop(args) {
            const evento = args.data;
            
            // ===== VALIDAZIONI CLIENT-SIDE =====
            
            // 1. Solo IdStato = 1 può fare drag&drop
            if (evento.IdStato !== 1) {
                showAlert(`❌ Impossibile spostare: solo ordini con Stato 1 (Emesso) possono essere spostati. Stato corrente: ${evento.IdStato}`, 'danger');
                args.cancel = true;
                loadOrdini(); // Ricarica per ripristinare
                return;
            }
            
            // 2. Non si può cambiare centro di lavoro
            if (originalRoomId !== null && evento.RoomId !== originalRoomId) {
                showAlert('❌ Impossibile cambiare Centro di Lavoro. Puoi solo spostare nel tempo.', 'danger');
                args.cancel = true;
                loadOrdini(); // Ricarica per ripristinare
                return;
            }
            
            // 3. Verifica che la nuova data di inizio NON cada dentro un fermo
            const nuovaDataInizio = new Date(evento.StartTime);
            const codiceCentro = evento.CodiceCentro;
            const fermiDelCentro = fermiCentriLavoro.filter(f => f.codiceCentro === codiceCentro);
            
            for (const fermo of fermiDelCentro) {
                if (nuovaDataInizio >= fermo.dataInizio && nuovaDataInizio < fermo.dataFine) {
                    showAlert('❌ Impossibile spostare: la data di inizio cade in un periodo di fermo del centro lavoro.', 'danger');
                    args.cancel = true;
                    loadOrdini(); // Ricarica per ripristinare
                    return;
                }
            }
            
            // ===== CHIAMATA API PER SALVARE =====
            
            try {
                const response = await fetch('@Url.Action("UpdateOrdineDragDrop", "SchedulatoreOP")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: evento.Id,
                        startTime: toLocalISOString(evento.StartTime)
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Aggiorna i campi dell'evento con i valori dal server
                    evento.DataInizioOP = parseLocalDate(result.dataInizioOP);
                    evento.DataFinePrevista = result.dataFinePrevista ? parseLocalDate(result.dataFinePrevista) : null;
                    evento.Modificato = 1;
                    
                    // IMPORTANTE: Aggiorna StartTime e EndTime con i valori calcolati dal backend (con fermi)
                    evento.StartTime = parseLocalDate(result.dataInizioOP);
                    evento.EndTime = parseLocalDate(result.endTimeVisivo);
                    
                    // Aggiorna il subject (quantità invariata, ma ricalcola percentuale)
                    const annoOrdine = evento.AnnoOrdine;
                    const numeroOrdine = evento.NumeroOrdine;
                    const quantita = evento.Quantita;
                    const quantitaProdotta = evento.QuantitaProdotta || 0;
                    const percentuale = quantita > 0 ? ((quantitaProdotta / quantita) * 100).toFixed(1) : 0;
                    evento.Subject = `Ord. ${annoOrdine}-${numeroOrdine} Qta: ${Math.floor(quantita)} (${percentuale}%)`;
                    
                    // Aggiorna l'evento nello scheduler (senza ricaricare tutto)
                    scheduleObj.saveEvent(evento);
                } else {
                    // Errore dal server
                    showAlert(result.message, 'danger');
                    args.cancel = true;
                    loadOrdini(); // Ricarica per ripristinare
                }
            } catch (error) {
                console.error('❌ Errore salvataggio drag&drop:', error);
                showAlert('❌ Errore durante il salvataggio: ' + error.message, 'danger');
                args.cancel = true;
                loadOrdini(); // Ricarica per ripristinare
            } finally {
                // Reset valori originali
                originalStartTime = null;
                originalEndTime = null;
                originalRoomId = null;
            }
        }

        // Variabile globale per mantenere i dati dell'ordine corrente
        let currentOrdine = null;

        // Mostra popup con dettagli ordine
        function showOrderPopup(ordine) {
            const popup = document.getElementById('ordinePopup');
            const body = document.getElementById('popupBody');
            const footer = document.getElementById('popupFooter');
            
            // Salva l'ordine corrente
            currentOrdine = ordine;
            
            // Determina se i campi sono modificabili
            const isModificabile = (ordine.IdStato === 1 || ordine.IdStato === 2) && ordine.Modificato !== 7;
            const canEditDataInizio = ordine.IdStato === 1 && ordine.Modificato !== 7;
            const canEditQuantita = (ordine.IdStato === 1 || ordine.IdStato === 2) && ordine.Modificato !== 7;
            
            // Formatta data per input datetime-local
            const formatDateForInput = (dateInput) => {
                // Se è già un Date object, usalo direttamente; altrimenti parsa come locale
                const date = dateInput instanceof Date ? dateInput : parseLocalDate(dateInput);
                
                if (!date || isNaN(date.getTime())) return '';
                
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                return `${year}-${month}-${day}T${hours}:${minutes}`;
            };
            
            // Genera HTML con layout riorganizzato in 4 righe
            body.innerHTML = `
                <div class="info-grid">
                    <!-- PRIMA RIGA: Ordine (3 col) + Stato (2 col) -->
                    <div class="info-item span-3">
                        <div class="info-label">Ordine</div>
                        <div class="info-value highlight">
                            ${ordine.TipoOrdine}-${ordine.AnnoOrdine}/${ordine.SerieOrdine}/${ordine.NumeroOrdine} - Riga ${ordine.RigaOrdine}
                        </div>
                    </div>
                    
                    <div class="info-item span-2">
                        <div class="info-label">Stato</div>
                        <div class="info-value">
                            <span class="stato-badge" style="background-color: ${ordine.CategoryColor}">
                                ${ordine.StatoDescrizione}
                            </span>
                        </div>
                    </div>
                    
                    <!-- SECONDA RIGA: Codice Articolo + Descrizione Articolo + Quantità + Quantità Prodotta -->
                    <div class="info-item">
                        <div class="info-label">Codice Articolo</div>
                        <div class="info-value">${ordine.CodiceArticolo}</div>
                    </div>
                    
                    <div class="info-item span-2">
                        <div class="info-label">Descrizione Articolo</div>
                        <div class="info-value">${ordine.DescrizioneArticolo}</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Quantità ${canEditQuantita ? '✏️' : ''}</div>
                        ${canEditQuantita ? `
                            <input type="number" 
                                   id="inputQuantita" 
                                   class="info-input" 
                                   value="${ordine.Quantita}" 
                                   step="1" 
                                   min="1"
                                   onchange="ricalcolaDataFinePrevista()">
                        ` : `
                            <div class="info-value highlight">${Math.floor(ordine.Quantita)} ${ordine.UnitaMisura}</div>
                        `}
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Quantità Prodotta</div>
                        <div class="info-value">${Math.floor(ordine.QuantitaProdotta)} ${ordine.UnitaMisura} (${ordine.PercentualeCompletamento.toFixed(1)}%)</div>
                    </div>
                    
                    <!-- TERZA RIGA: Data Inizio OP + Data Fine Prevista + Tempo Ciclo + Tempo Setup + Centro di Lavoro -->
                    <div class="info-item">
                        <div class="info-label">Data Inizio OP ${canEditDataInizio ? '✏️' : ''}</div>
                        ${canEditDataInizio ? `
                            <input type="datetime-local" 
                                   id="inputDataInizioOP" 
                                   class="info-input" 
                                   value="${formatDateForInput(ordine.DataInizioOP)}"
                                   onchange="ricalcolaDataFinePrevista()">
                        ` : `
                            <div class="info-value">${formatDateTime(ordine.DataInizioOP)}</div>
                        `}
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Data Fine Prevista ${isModificabile ? '🔄' : ''}</div>
                        <div class="info-value ${isModificabile ? 'calculated' : ''}" id="displayDataFinePrevista">
                            ${ordine.DataFinePrevista ? formatDateTime(ordine.DataFinePrevista) : '-'}
                        </div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Tempo Ciclo</div>
                        <div class="info-value">${ordine.TempoCiclo} sec</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Tempo Setup</div>
                        <div class="info-value">${ordine.TempoSetup || 0} min</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Centro di Lavoro</div>
                        <div class="info-value">${ordine.CodiceCentro} - ${ordine.CentroLavoroDescrizione}</div>
                    </div>
                    
                    <!-- QUARTA RIGA: Lavorazione + Operatore + Costo Orario -->
                    <div class="info-item span-2">
                        <div class="info-label">Lavorazione</div>
                        <div class="info-value">${ordine.DescrizioneLavorazione || ordine.CodiceLavorazione || '-'}</div>
                    </div>
                    
                    <div class="info-item span-2">
                        <div class="info-label">Operatore</div>
                        <div class="info-value">${ordine.CodiceOperatore && ordine.NomeOperatore ? ordine.CodiceOperatore + ' - ' + ordine.NomeOperatore : (ordine.IdOperatore || '-')}</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Costo Orario</div>
                        <div class="info-value">${ordine.CostoOrario ? '€ ' + ordine.CostoOrario.toFixed(2) : '-'}</div>
                    </div>
                    
                    <!-- NOTE (se presenti, full-width) -->
                    ${ordine.Note ? `
                    <div class="info-item full-width">
                        <div class="info-label">Note</div>
                        <div class="info-value">${ordine.Note}</div>
                    </div>
                    ` : ''}
                </div>
                
                <!-- Alert Fermo Centro Lavoro -->
                <div class="alert-fermo-centro" id="alertFermoCentro">
                    ⚠️ ATTENZIONE: Fermo Centro Lavoro Rilevato
                </div>
            `;
            
            // Mostra/nascondi footer con pulsante Salva
            if (isModificabile) {
                footer.style.display = 'flex';
            } else {
                footer.style.display = 'none';
            }
            
            // Mostra popup (posizione resettata a quella del CSS)
            popup.style.display = 'block';
            popup.style.left = '50%';
            popup.style.top = '10%';
            popup.style.transform = 'translateX(-50%)';
            
            // Controlla se c'è sovrapposizione con fermi (controllo iniziale)
            if (isModificabile) {
                controllaFermiCentroLavoro();
            }
        }

        // Ricalcola Data Fine Prevista in tempo reale
        function ricalcolaDataFinePrevista() {
            if (!currentOrdine) return;
            
            // Ottieni valori dai campi input (se esistono)
            const inputDataInizio = document.getElementById('inputDataInizioOP');
            const inputQuantita = document.getElementById('inputQuantita');
            
            // Usa i valori dai campi se esistono, altrimenti usa valori originali
            const dataInizioOP = inputDataInizio ? new Date(inputDataInizio.value) : new Date(currentOrdine.DataInizioOP);
            const quantita = inputQuantita ? parseFloat(inputQuantita.value) : currentOrdine.Quantita;
            
            // Parametri fissi dall'ordine
            const tempoCiclo = currentOrdine.TempoCiclo; // secondi
            const tempoSetup = currentOrdine.TempoSetup || 0; // minuti
            
            // Calcola durata totale
            const durataLavorazioneSecondi = quantita * tempoCiclo;
            const tempoSetupSecondi = tempoSetup * 60; // Converti minuti in secondi
            const durataTotaleSecondi = durataLavorazioneSecondi + tempoSetupSecondi;
            
            // Filtra i fermi per questo centro lavoro
            const codiceCentro = currentOrdine.CodiceCentro;
            const fermiDelCentro = fermiCentriLavoro.filter(f => f.codiceCentro === codiceCentro);
            
            // Calcola DataFinePrevista con logica che salta i fermi
            const dataFinePrevista = calcolaEndTimeConFermiJS(dataInizioOP, durataTotaleSecondi, fermiDelCentro);
            
            // Aggiorna il display
            const displayDataFinePrevista = document.getElementById('displayDataFinePrevista');
            if (displayDataFinePrevista) {
                displayDataFinePrevista.textContent = formatDateTime(dataFinePrevista);
            }
            
            // Controlla sovrapposizione con fermi centro lavoro
            controllaFermiCentroLavoro();
        }

        // Controlla se il range ordine si sovrappone con fermi del centro lavoro
        function controllaFermiCentroLavoro() {
            if (!currentOrdine) return;
            
            // Ottieni range dell'ordine
            const inputDataInizio = document.getElementById('inputDataInizioOP');
            const inputQuantita = document.getElementById('inputQuantita');
            
            const dataInizioOP = inputDataInizio ? new Date(inputDataInizio.value) : new Date(currentOrdine.DataInizioOP);
            const quantita = inputQuantita ? parseFloat(inputQuantita.value) : currentOrdine.Quantita;
            
            // Calcola DataFinePrevista
            const tempoCiclo = currentOrdine.TempoCiclo;
            const tempoSetup = currentOrdine.TempoSetup || 0;
            const durataLavorazioneSecondi = quantita * tempoCiclo;
            const tempoSetupSecondi = tempoSetup * 60;
            const durataTotaleSecondi = durataLavorazioneSecondi + tempoSetupSecondi;
            
            // Filtra fermi per il centro di lavoro corrente
            const fermiCentro = fermiCentriLavoro.filter(f => f.codiceCentro === currentOrdine.CodiceCentro);
            
            // Usa la funzione con fermi per calcolare la DataFinePrevista corretta
            const dataFinePrevista = calcolaEndTimeConFermiJS(dataInizioOP, durataTotaleSecondi, fermiCentro);
            
            // Raccogli tutti i fermi sovrapposti
            const fermiSovrapposti = [];
            for (const fermo of fermiCentro) {
                // Due range si sovrappongono se: startA < endB AND endA > startB
                if (dataInizioOP < fermo.dataFine && dataFinePrevista > fermo.dataInizio) {
                    fermiSovrapposti.push(fermo);
                }
            }
            
            // Mostra/nascondi alert con lista fermi
            const alertFermo = document.getElementById('alertFermoCentro');
            if (alertFermo) {
                if (fermiSovrapposti.length > 0) {
                    // Plurale corretto
                    const numeroFermi = fermiSovrapposti.length;
                    const testoFermi = numeroFermi === 1 ? 'fermo' : 'fermi';
                    
                    // Genera HTML lista fermi
                    let listaFermiHTML = '<ul style="margin: 3px 0; padding-left: 20px; line-height: 1.4;">';
                    fermiSovrapposti.forEach(fermo => {
                        const inizioStr = fermo.dataInizio.toLocaleString('it-IT', { 
                            day: '2-digit', 
                            month: '2-digit', 
                            year: 'numeric', 
                            hour: '2-digit', 
                            minute: '2-digit' 
                        });
                        const fineStr = fermo.dataFine.toLocaleString('it-IT', { 
                            day: '2-digit', 
                            month: '2-digit', 
                            year: 'numeric', 
                            hour: '2-digit', 
                            minute: '2-digit' 
                        });
                        listaFermiHTML += `<li style="margin: 1px 0;"><strong>${inizioStr} - ${fineStr}</strong> - <span style="font-size: 0.9em;">${fermo.descrizione || 'Fermo centro lavoro'}</span></li>`;
                    });
                    listaFermiHTML += '</ul>';
                    
                    alertFermo.innerHTML = `
                        <strong>⚠️ Attenzione:</strong> L'ordine attraversa ${numeroFermi} ${testoFermi} del centro lavoro.<br><br>
                        ${listaFermiHTML}
                        <br>
                        <small style="font-style: italic;">La data di fine sarà estesa automaticamente per compensare i fermi.</small>
                    `;
                    alertFermo.classList.add('visible');
                } else {
                    alertFermo.classList.remove('visible');
                }
            }
        }

        // Salva modifiche ordine
        async function saveOrdineModifiche() {
            if (!currentOrdine) {
                showAlert('❌ Nessun ordine selezionato', 'danger');
                return;
            }
            
            // Ottieni valori dai campi input
            const inputDataInizio = document.getElementById('inputDataInizioOP');
            const inputQuantita = document.getElementById('inputQuantita');
            
            // Valida che almeno un campo sia modificabile e presente
            if (!inputQuantita) {
                showAlert('❌ Nessun campo modificabile trovato', 'danger');
                return;
            }
            
            // Prepara i dati da inviare
            const dataInizioOP = inputDataInizio ? new Date(inputDataInizio.value) : new Date(currentOrdine.DataInizioOP);
            const quantita = parseFloat(inputQuantita.value);
            
            // Validazione quantità
            if (quantita <= 0 || isNaN(quantita)) {
                showAlert('❌ La quantità deve essere maggiore di zero', 'danger');
                return;
            }
            
            // Disabilita il pulsante durante il salvataggio
            const btnSave = document.querySelector('.btn-save-changes');
            const originalText = btnSave.innerHTML;
            btnSave.disabled = true;
            btnSave.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Salvataggio...';
            
            try {
                const response = await fetch('@Url.Action("UpdateOrdineManuale", "SchedulatoreOP")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: currentOrdine.Id,
                        dataInizioOP: toLocalISOString(dataInizioOP),
                        quantita: quantita
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    // Aggiorna i dati dell'ordine corrente
                    currentOrdine.DataInizioOP = result.dataInizioOP;
                    currentOrdine.Quantita = result.quantita;
                    currentOrdine.DataFinePrevista = result.dataFinePrevista;
                    currentOrdine.Modificato = 1;
                    
                    // Chiudi popup
                    closePopup();
                    
                    // Ricarica ordini per aggiornare il calendario
                    await loadOrdini();
                    
                } else {
                    // Errore dal server
                    showAlert(result.message, 'danger');
                }
            } catch (error) {
                console.error('❌ Errore salvataggio:', error);
                showAlert('❌ Errore durante il salvataggio: ' + error.message, 'danger');
            } finally {
                // Riabilita il pulsante
                btnSave.disabled = false;
                btnSave.innerHTML = originalText;
            }
        }

        // Chiudi popup
        function closePopup() {
            document.getElementById('ordinePopup').style.display = 'none';
            currentOrdine = null;
        }

        // Rendi popup trascinabile
        function makeDraggable(element, header) {
            let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
            
            header.onmousedown = dragMouseDown;

            function dragMouseDown(e) {
                e = e || window.event;
                e.preventDefault();
                pos3 = e.clientX;
                pos4 = e.clientY;
                document.onmouseup = closeDragElement;
                document.onmousemove = elementDrag;
                element.classList.add('dragging');
            }

            function elementDrag(e) {
                e = e || window.event;
                e.preventDefault();
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;
                element.style.top = (element.offsetTop - pos2) + 'px';
                element.style.left = (element.offsetLeft - pos1) + 'px';
                element.style.transform = 'none';
            }

            function closeDragElement() {
                document.onmouseup = null;
                document.onmousemove = null;
                element.classList.remove('dragging');
            }
        }

        // Helper: formatta data e ora
        function formatDateTime(dateInput) {
            if (!dateInput) return '-';
            
            // Se è già un Date object, usalo direttamente
            const date = dateInput instanceof Date ? dateInput : parseLocalDate(dateInput);
            
            if (!date || isNaN(date.getTime())) return '-';
            
            return date.toLocaleString('it-IT', {
                day: '2-digit',
                month: '2-digit',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        // Helper: label per campo Modificato
        function getModificatoLabel(modificato) {
            switch(modificato) {
                case 0: return '❌ Non modificato';
                case 1: return '✏️ Modificato';
                case 7: return '🔒 Bloccato';
                default: return '-';
            }
        }

        // Mostra alert
        function showAlert(message, type = 'info') {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            document.getElementById('alertContainer').innerHTML = alertHtml;
            
            setTimeout(() => {
                const alert = document.querySelector('#alertContainer .alert');
                if (alert) {
                    bootstrap.Alert.getOrCreateInstance(alert).close();
                }
            }, 5000);
        }
    </script>
}


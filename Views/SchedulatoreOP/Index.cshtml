                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Quantità Prodotta</div>
                        <div class="info-value">${ordine.QuantitaProdotta.toFixed(3)} ${ordine.UnitaMisura} (${ordine.PercentualeCompletamento.toFixed(1)}%)</div>

@{
    ViewData["Title"] = "Interrogazioni AI";
    ViewBag.UseFluidContainer = true;
}

@section Styles {
    <style>
        .ai-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .chat-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 2rem;
            border-radius: 12px 12px 0 0;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }

        .chat-icon {
            font-size: 3rem;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        .input-section {
            background: white;
            padding: 2rem;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
        }

        .question-input {
            border: 2px solid #667eea;
            border-radius: 8px;
            padding: 1rem;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .question-input:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .btn-ask {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 1rem 2.5rem;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-ask:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-ask:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        .suggested-questions {
            margin-top: 1rem;
        }

        .suggested-question-btn {
            font-size: 0.85rem;
            margin: 0.25rem;
            padding: 0.4rem 0.8rem;
            border-radius: 20px;
            border: 1px solid #667eea;
            background: white;
            color: #667eea;
            transition: all 0.3s ease;
        }

        .suggested-question-btn:hover {
            background: #667eea;
            color: white;
        }

        .result-card {
            background: white;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            animation: slideIn 0.5s ease;
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .question-display {
            background: #f8f9fa;
            padding: 1rem;
            border-left: 4px solid #667eea;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .sql-query-box {
            background: #282c34;
            color: #abb2bf;
            padding: 1rem;
            border-radius: 8px;
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            overflow-x: auto;
            margin-bottom: 1rem;
        }

        .sql-keyword {
            color: #c678dd;
            font-weight: bold;
        }

        .results-table {
            font-size: 0.9rem;
        }

        .results-table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .results-table th {
            padding: 0.75rem;
            font-weight: 600;
        }

        .results-table td {
            padding: 0.6rem;
        }

        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        .loading-overlay.active {
            display: flex;
        }

        .loading-spinner {
            width: 80px;
            height: 80px;
            border: 8px solid #f3f3f3;
            border-top: 8px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .error-box {
            background: #ffe6e6;
            border-left: 4px solid #dc3545;
            padding: 1rem;
            border-radius: 8px;
            color: #721c24;
        }

        .stats-badge {
            background: #667eea;
            color: white;
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: bold;
        }

        /* Stili per i pulsanti */
        .btn {
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

        .gap-2 {
            gap: 0.5rem !important;
        }

        /* Stili responsivi per i pulsanti */
        @@media (max-width: 768px) {
            .d-flex.gap-2 {
                flex-wrap: wrap;
            }
            
            .d-flex.gap-2 .btn {
                margin-bottom: 0.5rem;
            }
        }

        /* Stili per il popup trascinabile */
        .floating-window {
            position: fixed;
            width: 92%;
            max-width: 1800px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
            z-index: 10000;
            display: flex;
            flex-direction: column;
            max-height: 90vh;
            transition: all 0.3s ease;
        }

        .floating-window.minimized {
            height: 60px;
            overflow: hidden;
        }

        .floating-window.maximized {
            width: 98% !important;
            height: 98vh !important;
            top: 1vh !important;
            left: 1% !important;
            transform: none !important;
            max-width: none !important;
        }

        .window-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1rem 1.5rem;
            border-radius: 12px 12px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: move;
            user-select: none;
        }

        .window-title {
            margin: 0;
            font-size: 1.1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            max-width: 70%;
        }

        .window-title i {
            flex-shrink: 0;
        }

        .window-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .window-controls .btn {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }

        .window-body {
            padding: 1.5rem;
            overflow-y: auto;
            flex-grow: 1;
            background: #f8f9fa;
        }

        .window-footer {
            padding: 1rem 1.5rem;
            border-top: 2px solid #e9ecef;
            background: white;
            border-radius: 0 0 12px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .popup-results-table {
            font-size: 0.95rem;
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .popup-results-table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .popup-results-table th {
            padding: 1rem 0.75rem;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .popup-results-table td {
            padding: 0.75rem;
            border-bottom: 1px solid #e9ecef;
        }

        .popup-results-table tbody tr:hover {
            background-color: #f1f3ff;
        }

        .popup-results-table tbody tr:last-child td {
            border-bottom: none;
        }

        .sql-accordion {
            margin-bottom: 1.5rem;
        }

        .window-body .table-responsive {
            margin-top: 0;
        }

        .window-body > .table-responsive:first-child {
            margin-top: 0;
        }

        .sql-accordion .accordion-button {
            background: white;
            color: #667eea;
            font-weight: 600;
        }

        .sql-accordion .accordion-button:not(.collapsed) {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        /* Stile per il pulsante SQL admin */
        .show-sql-btn {
            font-weight: 600;
            border: 2px solid rgba(255,255,255,0.3);
            transition: all 0.3s ease;
        }

        .show-sql-btn:hover {
            border-color: rgba(255,255,255,0.6);
            transform: scale(1.05);
        }

        .show-sql-btn.btn-success {
            background: #28a745;
            border-color: rgba(255,255,255,0.5);
        }

        /* Stile per le celle con informazioni quantità */
        .popup-results-table td {
            font-size: 0.9rem;
            line-height: 1.6;
        }
    </style>
}

<div class="ai-container">
    <!-- Header -->
    <div class="chat-header">
        <div class="d-flex align-items-center justify-content-between">
                <div>
                <h2 class="mb-0">
                    <i class="bi bi-robot chat-icon me-3"></i>
                    Interrogazioni AI - Mistral
                </h2>
                <p class="mb-0 mt-2 opacity-75">
                    Fai domande in linguaggio naturale sulle consegne e sugli ordini. L'AI genererà la query SQL e mostrerà i risultati.
                </p>
            </div>
            <a asp-controller="InterrogazioniDB" asp-action="Index" class="btn btn-light">
                <i class="bi bi-arrow-left"></i> Torna al Menu
            </a>
        </div>
    </div>

    <!-- Input Section -->
    <div class="input-section">
        <div class="row align-items-end">
            <div class="col-md-12">
                <label for="questionInput" class="form-label fw-bold">
                    <i class="bi bi-question-circle me-2"></i>La tua domanda
                </label>
                <textarea 
                    class="form-control question-input" 
                    id="questionInput" 
                    rows="3" 
                    placeholder="Es: Quante consegne sono in ritardo? oppure Top 5 agenti per fatturato..."></textarea>
            </div>
        </div>
        
        <!-- Barra dei pulsanti -->
        <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap">
            <div class="d-flex gap-2 mb-2 mb-md-0">
                <button class="btn btn-primary" id="startRecording">
                    <i class="bi bi-mic-fill"></i> Richiesta Vocale
                </button>
                <button class="btn btn-danger" id="stopRecording" style="display: none;">
                    <i class="bi bi-stop-fill"></i> Fine Richiesta
                </button>
                <button class="btn btn-success" id="askBtn" onclick="askQuestion()">
                    <i class="bi bi-send-fill"></i> Chiedi all'AI
                </button>
            </div>
            <div>
                <button class="btn btn-warning" id="clearQuery" onclick="clearQuestion()">
                    <i class="bi bi-trash-fill"></i> Cancella
                </button>
            </div>
        </div>

        <!-- Domande Suggerite -->
        <div class="suggested-questions">
            <small class="text-muted"><i class="bi bi-lightbulb me-1"></i>Domande suggerite:</small><br>
            <button class="btn btn-sm suggested-question-btn" onclick="fillQuestion(this)">Quante consegne sono in ritardo?</button>
            <button class="btn btn-sm suggested-question-btn" onclick="fillQuestion(this)">Top 10 agenti per fatturato</button>
            <button class="btn btn-sm suggested-question-btn" onclick="fillQuestion(this)">Ordini del cliente 1000 nel mese di novembre</button>
            <button class="btn btn-sm suggested-question-btn" onclick="fillQuestion(this)">Consegne in Lombardia questo mese</button>
            <button class="btn btn-sm suggested-question-btn" onclick="fillQuestion(this)">Valore totale ordini in ritardo</button>
            <button class="btn btn-sm suggested-question-btn" onclick="fillQuestion(this)">Top 5 province per numero ordini</button>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="text-center text-white">
            <div class="loading-spinner"></div>
            <h4 class="mt-3">L'AI sta elaborando la tua domanda...</h4>
            <p>Generazione query SQL in corso</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ========== VARIABILI GLOBALI ==========
        let isAdmin = @(User.IsInRole("Admin") ? "true" : "false");
        let questionInput, startButton, stopButton, askBtn;
        let recognition = null;

        // ========== FUNZIONI GLOBALI (chiamate da onclick) ==========
        function askQuestion() {
            const question = questionInput.value.trim();
            if (!question) {
                alert('Inserisci una domanda.');
                return;
            }
            executeQuery(question);
        }

        function clearQuestion() {
            questionInput.value = '';
            questionInput.focus();
            const popups = document.querySelectorAll('.floating-window');
            popups.forEach(popup => popup.remove());
        }

        function fillQuestion(button) {
            questionInput.value = button.textContent.trim();
            questionInput.focus();
        }

        // ========== FUNZIONE PRINCIPALE PER ESEGUIRE LA QUERY ==========
        async function executeQuery(question) {
            if (!question) {
                alert('Per favore, inserisci una domanda');
                return;
            }

            // Disabilita pulsante e mostra loading
            askBtn.disabled = true;
            document.getElementById('loadingOverlay').classList.add('active');

            try {
                const response = await fetch('@Url.Action("AskQuestion", "InterrogazioniAI")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ question: question })
                });

                const result = await response.json();

                if (result.success) {
                    displayResults(result);
                } else {
                    displayError(result.error || 'Errore sconosciuto');
                }
            } catch (error) {
                displayError('Errore di connessione: ' + error.message);
            } finally {
                askBtn.disabled = false;
                document.getElementById('loadingOverlay').classList.remove('active');
            }
        }

        // Aspetta che il DOM sia completamente caricato
        document.addEventListener('DOMContentLoaded', function() {
            // Riferimenti agli elementi dell'interfaccia
            questionInput = document.getElementById('questionInput');
            startButton = document.getElementById('startRecording');
            stopButton = document.getElementById('stopRecording');
            askBtn = document.getElementById('askBtn');

            // Verifica che tutti gli elementi esistano
            if (!questionInput || !startButton || !stopButton || !askBtn) {
                console.error('Alcuni elementi della pagina non sono stati trovati!');
                return;
            }

            // Inizializzazione del riconoscimento vocale
            // Controlla se il browser supporta il riconoscimento vocale
            if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
            recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
            recognition.lang = 'it-IT';
            recognition.continuous = true;
            recognition.interimResults = true;
            recognition.maxAlternatives = 1;

            recognition.onstart = function() {
                console.log('Riconoscimento vocale avviato');
                startButton.innerHTML = '<i class="bi bi-mic-fill"></i> Registrazione in corso...';
                startButton.disabled = true;
            };

            recognition.onresult = function(event) {
                console.log('Risultato riconoscimento vocale ricevuto');
                let interimTranscript = '';
                let finalTranscript = '';

                for (let i = event.resultIndex; i < event.results.length; i++) {
                    const transcript = event.results[i][0].transcript;
                    if (event.results[i].isFinal) {
                        finalTranscript += transcript;
                    } else {
                        interimTranscript += transcript;
                    }
                }

                // Aggiorna il campo di testo con il transcript finale e interim
                questionInput.value = finalTranscript + interimTranscript;
                console.log('Testo riconosciuto:', finalTranscript + interimTranscript);
            };

            recognition.onerror = function(event) {
                console.error('Errore di riconoscimento vocale:', event.error);
                let errorMessage = 'Errore del riconoscimento vocale: ';
                switch(event.error) {
                    case 'no-speech':
                        errorMessage += 'Nessun parlato rilevato. Riprova.';
                        break;
                    case 'audio-capture':
                        errorMessage += 'Impossibile accedere al microfono.';
                        break;
                    case 'not-allowed':
                        errorMessage += 'Permesso microfono negato.';
                        break;
                    case 'network':
                        errorMessage += 'Errore di rete.';
                        break;
                    default:
                        errorMessage += event.error;
                }
                alert(errorMessage);
                stopRecording();
            };

            recognition.onend = function() {
                console.log('Riconoscimento vocale terminato');
                stopRecording();
            };
        } else {
            console.error('Il browser non supporta il riconoscimento vocale');
            startButton.disabled = true;
            startButton.innerHTML = '<i class="bi bi-mic-mute-fill"></i> Non supportato';
            startButton.title = 'Il tuo browser non supporta il riconoscimento vocale';
        }

        function startRecording() {
            if (!recognition) {
                alert('Il riconoscimento vocale non è supportato dal tuo browser. Prova con Chrome, Firefox o Edge.');
                return;
            }
            
            try {
                console.log('Avvio registrazione...');
                questionInput.value = ''; // Pulisce il campo prima di iniziare
                recognition.start();
                startButton.style.display = 'none';
                stopButton.style.display = 'inline-block';
            } catch (error) {
                console.error('Errore nell\'avvio della registrazione:', error);
                alert('Impossibile avviare la registrazione. Assicurati di aver dato i permessi per il microfono.');
                resetRecordingButtons();
            }
        }

        function stopRecording() {
            if (!recognition) {
                return;
            }
            
            try {
                console.log('Arresto registrazione...');
                recognition.stop();
            } catch (error) {
                console.error('Errore nell\'arresto della registrazione:', error);
            }
            resetRecordingButtons();
        }

        function resetRecordingButtons() {
            startButton.style.display = 'inline-block';
            stopButton.style.display = 'none';
            startButton.innerHTML = '<i class="bi bi-mic-fill"></i> Richiesta Vocale';
            startButton.disabled = false;
        }

        // Event Listeners per i pulsanti vocali
        startButton.addEventListener('click', startRecording);
        stopButton.addEventListener('click', stopRecording);

        // Enter per inviare
        questionInput.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.key === 'Enter') {
                askQuestion();
            }
        });

        }); // Fine DOMContentLoaded

        // ========== COSTANTI E MAPPE (possono essere fuori da DOMContentLoaded) ==========
        
        // Mappa per tradurre i nomi delle colonne in modo conciso e comprensibile
        const columnNameMap = {
            // Ordini - brevi e diretti
            'AnnoOrdine': 'Anno',
            'NumeroOrdine': 'Ordine',
            'RigaOrdine': 'Riga',
            'TipoOrdine': 'Tipo',
            'StatoOrdine': 'Stato',
            

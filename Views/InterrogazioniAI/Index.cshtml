            'Importo', 'ImportoTotale', 'ImportoNetto', 'ImportoLordo',
            'Fatturato', 'Valore', 'ValoreTotale', 'TotaleOrdine',
            'Costo', 'CostoTotale', 'Margine', 'Ricavo', 'Sconto'
        ];

        // Campi che rappresentano quantità
        const quantityFields = [
            'Quantita', 'QuantitaOrdinata', 'QuantitaEvasa', 'QuantitaRimanente',
            'QuantitaDaEvadere', 'QuantitaProdotta', 'QuantitaScaricata',
            'QtaOrdinata', 'QtaEvasa', 'Qtà'
        ];

        function translateColumnName(columnName) {
            return columnNameMap[columnName] || columnName;
        }

        function isCurrencyField(columnName) {
            return currencyFields.includes(columnName);
        }

        function isQuantityField(columnName) {
            return quantityFields.includes(columnName);
        }

        // Regole di combinazione delle colonne
        const columnCombinationRules = [
            {
                // CONSEGNE: Quantita + QuantitaEvasa + Calcolo automatico Da Evadere
                match: (columns) => {
                    return columns.includes('Quantita') && columns.includes('QuantitaEvasa');
                },
                combine: (columns) => {
                    return {
                        displayName: 'CONSEGNE',
                        sourceColumns: ['Quantita', 'QuantitaEvasa'],
                        combined: true,
                        special: 'consegne',  // Flag speciale per gestione custom
                        separator: ' | '
                    };
                }
            },
            {
                // Ordine: AnnoOrdine + SerieOrdine + NumeroOrdine
                match: (columns) => {
                    const hasAnno = columns.includes('AnnoOrdine');
                    const hasSerie = columns.includes('SerieOrdine');
                    const hasNumero = columns.includes('NumeroOrdine');
                    return hasAnno && hasNumero; // Serie è opzionale
                },
                combine: (columns) => {
                    const cols = [];
                    if (columns.includes('AnnoOrdine')) cols.push('AnnoOrdine');
                    if (columns.includes('SerieOrdine')) cols.push('SerieOrdine');
                    if (columns.includes('NumeroOrdine')) cols.push('NumeroOrdine');
                    return {
                        displayName: 'Ordine',
                        sourceColumns: cols,
                        combined: true,
                        separator: '/'
                    };
                }
            },
            {
                // Cliente: CodiceCliente + RagioneSociale
                match: (columns) => {
                    return columns.includes('CodiceCliente') && columns.includes('RagioneSociale');
                },
                combine: (columns) => {
                    return {
                        displayName: 'Cliente',
                        sourceColumns: ['CodiceCliente', 'RagioneSociale'],
                        combined: true,
                        separator: ' - '
                    };
                }
            },
            {
                // Articolo: CodiceArticolo + DescrizioneArticolo
                match: (columns) => {
                    return columns.includes('CodiceArticolo') && 
                           (columns.includes('DescrizioneArticolo') || columns.includes('Descrizione'));
                },
                combine: (columns) => {
                    const descCol = columns.includes('DescrizioneArticolo') ? 'DescrizioneArticolo' : 'Descrizione';
                    return {
                        displayName: 'Articolo',
                        sourceColumns: ['CodiceArticolo', descCol],
                        combined: true,
                        separator: ' . '
                    };
                }
            },
            {
                // Fornitore: CodiceFornitore + RagioneSociale
                match: (columns) => {
                    return columns.includes('CodiceFornitore') && columns.includes('RagioneSociale');
                },
                combine: (columns) => {
                    return {
                        displayName: 'Fornitore',
                        sourceColumns: ['CodiceFornitore', 'RagioneSociale'],
                        combined: true,
                        separator: ' - '
                    };
                }
            },
            {
                // Agente: CodiceAgente + NomeAgente
                match: (columns) => {
                    return columns.includes('CodiceAgente') && columns.includes('NomeAgente');
                },
                combine: (columns) => {
                    return {
                        displayName: 'Agente',
                        sourceColumns: ['CodiceAgente', 'NomeAgente'],
                        combined: true,
                        separator: ' - '
                    };
                }
            },
            {
                // Indirizzo completo: Indirizzo + CAP + Citta + Provincia
                match: (columns) => {
                    return columns.includes('Indirizzo') && columns.includes('Citta');
                },
                combine: (columns) => {
                    const cols = ['Indirizzo'];
                    if (columns.includes('CAP')) cols.push('CAP');
                    if (columns.includes('Citta')) cols.push('Citta');
                    if (columns.includes('Provincia')) cols.push('Provincia');
                    return {
                        displayName: 'Indirizzo',
                        sourceColumns: cols,
                        combined: true,
                        separator: ', '
                    };
                }
            },
            {
                // Riga ordine: RigaOrdine da sola (per evitare che venga combinata con NumeroOrdine)
                // Questa regola viene controllata DOPO la regola dell'ordine completo
                match: (columns) => {
                    return columns.includes('RigaOrdine') && 
                           !columns.includes('NumeroOrdine') && 
                           !columns.includes('AnnoOrdine');
                },
                combine: (columns) => {
                    return {
                        displayName: 'Riga',
                        sourceColumns: ['RigaOrdine'],
                        combined: false
                    };
                }
            }
        ];

        function getColumnPriority(col) {
            // Definisce la priorità di ordinamento delle colonne
            const displayName = col.displayName.toLowerCase();
            const sourceCol = col.sourceColumns[0]?.toLowerCase() || '';
            
            // Priorità massima: Ordine
            if (displayName === 'ordine' || 
                sourceCol.includes('numeroordine') || 
                sourceCol.includes('annoordine')) {
                return 1;
            }
            
            // Seconda priorità: Cliente
            if (displayName === 'cliente' || 
                sourceCol.includes('codicecliente') || 
                sourceCol.includes('ragionesociale')) {
                return 2;
            }
            
            // Terza priorità: Articolo
            if (displayName === 'articolo' || 
                sourceCol.includes('codicearticolo') || 
                sourceCol.includes('descrizionearticolo')) {
                return 3;
            }
            
            // Priorità CONSEGNE
            if (col.special === 'consegne') {
                return 4;
            }
            
            // Resto delle colonne
            return 100;
        }

        function processColumns(firstRow) {
            const columns = Object.keys(firstRow);
            const processedColumns = [];
            const usedColumns = new Set();

            // Prima passa: applica le regole di combinazione
            columnCombinationRules.forEach(rule => {
                if (rule.match(columns)) {
                    const combinedCol = rule.combine(columns);
                    processedColumns.push(combinedCol);
                    // Marca le colonne come usate
                    combinedCol.sourceColumns.forEach(col => usedColumns.add(col));
                }
            });

            // Seconda passa: aggiungi le colonne non combinate
            columns.forEach(col => {
                if (!usedColumns.has(col)) {
                    processedColumns.push({
                        displayName: translateColumnName(col),
                        sourceColumns: [col],
                        combined: false
                    });
                }
            });

            // Terza passa: ORDINA le colonne con priorità Ordine → Cliente → Articolo → Resto
            processedColumns.sort((a, b) => {
                const priorityA = getColumnPriority(a);
                const priorityB = getColumnPriority(b);
                return priorityA - priorityB;
            });

            return processedColumns;
        }

        function formatValue(value, columnName, row, forceUM = false) {
            // Formattazione valori
            if (value === null || value === undefined || value === '') {
                return '';  // Ritorna stringa vuota invece di '-' per le combinazioni
            } 
            
            // SEMPRE aggiungi € per gli importi (con 2 decimali)
            if (isCurrencyField(columnName) && typeof value === 'number') {
                return `€ ${value.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            } 
            
            // SEMPRE aggiungi unità di misura per le quantità
            if ((isQuantityField(columnName) || forceUM) && typeof value === 'number') {
                const um = row['UnitaMisura'] || row['U.M.'] || 'pz';
                return `${value.toLocaleString('it-IT')} ${um}`;
            } 
            
            // Controlla se il campo contiene "Importo", "Prezzo", "Costo", "Valore", "Fatturato" nel nome (con 2 decimali)
            if (typeof value === 'number' && 
                (columnName.toLowerCase().includes('importo') ||
                 columnName.toLowerCase().includes('prezzo') ||
                 columnName.toLowerCase().includes('costo') ||
                 columnName.toLowerCase().includes('valore') ||
                 columnName.toLowerCase().includes('fatturato') ||
                 columnName.toLowerCase().includes('ricavo') ||
                 columnName.toLowerCase().includes('margine'))) {
                return `€ ${value.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            }
            
            // Controlla se il campo contiene "Quantita" o "Qtà" nel nome
            if (typeof value === 'number' && 
                (columnName.toLowerCase().includes('quantita') ||
                 columnName.toLowerCase().includes('qta') ||
                 columnName.toLowerCase().includes('qt'))) {
                const um = row['UnitaMisura'] || row['U.M.'] || 'pz';
                return `${value.toLocaleString('it-IT')} ${um}`;
            }
            
            if (typeof value === 'number') {
                // Formatta altri numeri con separatore migliaia
                return value.toLocaleString('it-IT');
            } else if (typeof value === 'string' && value.match(/^\d{4}-\d{2}-\d{2}T/)) {
                // Formatta le date con ora
                const date = new Date(value);
                return date.toLocaleDateString('it-IT');
            } else if (typeof value === 'string' && value.match(/^\d{4}-\d{2}-\d{2}$/)) {
                // Formatta le date senza ora
                const parts = value.split('-');
                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            
            return String(value);
        }

        function displayResults(result) {
            // Crea il popup trascinabile
            const popup = document.createElement('div');
            popup.className = 'floating-window';
            
            const timestamp = Date.now();
            const accordionId = `sqlAccordion${timestamp}`;
            const collapseId = `sqlCollapse${timestamp}`;
            
            let bodyHtml = '';
            
            // Accordion SQL - nascosto di default, visibile solo se admin clicca il pulsante
            // Senza card sopra, direttamente l'accordion
            bodyHtml += `<div class="accordion sql-accordion" id="${accordionId}" style="display: none;">`;
            bodyHtml += '<div class="accordion-item">';
            bodyHtml += '<h2 class="accordion-header">';
            bodyHtml += `<button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#${collapseId}">`;
            bodyHtml += '<i class="bi bi-code-square me-2"></i>Query SQL Generata';
            bodyHtml += '</button></h2>';
            bodyHtml += `<div id="${collapseId}" class="accordion-collapse collapse show">`;
            bodyHtml += '<div class="accordion-body p-0">';
            bodyHtml += `<div class="sql-query-box">${highlightSQL(result.sqlQuery)}</div>`;
            bodyHtml += '</div></div></div></div>';

            // Tabella risultati
            if (result.data && result.data.length > 0) {
                // Prepara le colonne con logica di combinazione
                const processedColumns = processColumns(result.data[0]);
                
                bodyHtml += '<div class="table-responsive">';
                bodyHtml += '<table class="table table-hover popup-results-table">';
                
                // Header con nomi tradotti e colonne combinate
                bodyHtml += '<thead><tr>';
                processedColumns.forEach(col => {
                    bodyHtml += `<th>${escapeHtml(col.displayName)}</th>`;
                });
                bodyHtml += '</tr></thead>';
                
                // Body
                bodyHtml += '<tbody>';
                result.data.forEach(row => {
                    bodyHtml += '<tr>';
                    processedColumns.forEach(col => {
                        let value = '';
                        
                        if (col.combined) {
                            // Gestione speciale per le CONSEGNE
                            if (col.special === 'consegne') {
                                const qtaOrdine = row['Quantita'] || 0;
                                const qtaEvasa = row['QuantitaEvasa'] || 0;
                                const qtaDaEvadere = qtaOrdine - qtaEvasa;
                                const um = row['UnitaMisura'] || row['U.M.'] || 'pz';
                                
                                // Formatta le tre quantità con unità di misura
                                const qtaOrdineStr = qtaOrdine !== null ? `Ord: ${qtaOrdine.toLocaleString('it-IT')} ${um}` : '';
                                const qtaEvataStr = qtaEvasa !== null ? `Evasa: ${qtaEvasa.toLocaleString('it-IT')} ${um}` : '';
                                const qtaDaEvadereStr = qtaDaEvadere !== null ? `Da Evadere: ${qtaDaEvadere.toLocaleString('it-IT')} ${um}` : '';
                                
                                const parts = [qtaOrdineStr, qtaEvataStr, qtaDaEvadereStr].filter(p => p !== '');
                                value = parts.join(' | ') || '-';
                            } else {
                                // Colonna combinata normale - concatena i valori
                                const parts = [];
                                col.sourceColumns.forEach(srcCol => {
                                    const val = row[srcCol];
                                    const formattedVal = formatValue(val, srcCol, row);
                                    // Aggiungi solo se non è vuoto
                                    if (formattedVal && formattedVal !== '') {
                                        parts.push(formattedVal);
                                    }
                                });
                                
                                if (parts.length > 0) {
                                    // Usa il separatore definito nella regola
                                    const separator = col.separator || ' - ';
                                    value = parts.join(separator);
                                } else {
                                    // Se tutti i valori sono vuoti, mostra '-'
                                    value = '-';
                                }
                            }
                        } else {
                            // Colonna singola
                            const rawValue = row[col.sourceColumns[0]];
                            const formattedVal = formatValue(rawValue, col.sourceColumns[0], row);
                            value = formattedVal || '-';
                        }
                        
                        bodyHtml += `<td>${escapeHtml(String(value))}</td>`;
                    });
                    bodyHtml += '</tr>';
                });
                bodyHtml += '</tbody></table></div>';
            } else {
                bodyHtml += '<div class="alert alert-info mt-3"><i class="bi bi-info-circle me-2"></i>Nessun risultato trovato</div>';
            }
            
            // Pulsante per mostrare SQL (solo per admin)
            const sqlButtonHtml = isAdmin ? `
                <button type="button" class="btn btn-warning btn-sm me-2 show-sql-btn" title="Mostra Query SQL">
                    <i class="bi bi-code-square"></i> SQL
                </button>
            ` : '';
            
            popup.innerHTML = `
                <div class="window-header">
                    <h5 class="window-title">
                        <i class="bi bi-chat-left-text me-2"></i>
                        ${escapeHtml(result.question)}
                    </h5>
                    <div class="window-controls">
                        ${sqlButtonHtml}
                        <button type="button" class="btn btn-light btn-sm minimize-window">
                            <i class="bi bi-dash-lg"></i>
                        </button>
                        <button type="button" class="btn btn-light btn-sm maximize-window">
                            <i class="bi bi-arrows-fullscreen"></i>
                        </button>
                        <button type="button" class="btn btn-light btn-sm close-popup-btn">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="window-body">${bodyHtml}</div>
                <div class="window-footer">
                    <span class="stats-badge">
                        <i class="bi bi-list-check me-1"></i>${result.rowCount} righe trovate
                    </span>
                    <button type="button" class="btn btn-secondary close-window">Chiudi</button>
                </div>
            `;
            
            // Posiziona il popup al centro
            document.body.appendChild(popup);
            const rect = popup.getBoundingClientRect();
            popup.style.left = `${(window.innerWidth - rect.width) / 2}px`;
            popup.style.top = `${(window.innerHeight - rect.height) / 2}px`;
            
            // Aggiungi event listeners
            setupPopupControls(popup);
        }

        function setupPopupControls(popup) {
            // Gestione chiusura (sia pulsante X nell'header che pulsante Chiudi nel footer)
            const closeButtons = popup.querySelectorAll('.close-popup-btn, .close-window');
            closeButtons.forEach(btn => {
                btn.addEventListener('click', () => popup.remove());
            });

            // Gestione minimizza (solo se il pulsante esiste)
            const minimizeBtn = popup.querySelector('.minimize-window');
            if (minimizeBtn) {
                minimizeBtn.addEventListener('click', () => {
                    popup.classList.toggle('minimized');
                    const icon = minimizeBtn.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('bi-dash-lg');
                        icon.classList.toggle('bi-arrows-angle-expand');
                    }
                });
            }

            // Gestione massimizza (solo se il pulsante esiste)
            const maximizeBtn = popup.querySelector('.maximize-window');
            if (maximizeBtn) {
                maximizeBtn.addEventListener('click', () => {
                    popup.classList.toggle('maximized');
                    const icon = maximizeBtn.querySelector('i');
                    if (icon) {
                        icon.classList.toggle('bi-arrows-fullscreen');
                        icon.classList.toggle('bi-arrows-angle-contract');
                    }
                });
            }
            
            // Gestione pulsante SQL (solo per admin)
            const sqlBtn = popup.querySelector('.show-sql-btn');
            if (sqlBtn) {
                const sqlAccordion = popup.querySelector('.sql-accordion');
                let isSqlVisible = false;
                
                sqlBtn.addEventListener('click', () => {
                    isSqlVisible = !isSqlVisible;
                    sqlAccordion.style.display = isSqlVisible ? 'block' : 'none';
                    
                    // Cambia l'aspetto del pulsante
                    if (isSqlVisible) {
                        sqlBtn.classList.remove('btn-warning');
                        sqlBtn.classList.add('btn-success');
                        sqlBtn.innerHTML = '<i class="bi bi-code-square-fill"></i> SQL';
                        sqlBtn.title = 'Nascondi Query SQL';
                    } else {
                        sqlBtn.classList.remove('btn-success');
                        sqlBtn.classList.add('btn-warning');
                        sqlBtn.innerHTML = '<i class="bi bi-code-square"></i> SQL';
                        sqlBtn.title = 'Mostra Query SQL';
                    }
                });
            }
            
            // Rendi trascinabile
            makeWindowDraggable(popup);
        }

        function makeWindowDraggable(windowElement) {
            const header = windowElement.querySelector('.window-header');
            let isDragging = false;
            let currentX;
            let currentY;
            let initialX;
            let initialY;
            let xOffset = 0;
            let yOffset = 0;

            const dragStart = (e) => {
                if (e.target.closest('.btn')) return;
                
                const rect = windowElement.getBoundingClientRect();
                initialX = e.clientX - rect.left;
                initialY = e.clientY - rect.top;

                if (e.target === header || header.contains(e.target)) {
                    isDragging = true;
                    windowElement.style.zIndex = '10001';
                }
            };

            const drag = (e) => {
                if (isDragging && !windowElement.classList.contains('maximized')) {
                    e.preventDefault();
                    
                    currentX = e.clientX - initialX;
                    currentY = e.clientY - initialY;

                    windowElement.style.left = `${currentX}px`;
                    windowElement.style.top = `${currentY}px`;
                    windowElement.style.transform = 'none';
                }
            };

            const dragEnd = () => {
                isDragging = false;
                if (!windowElement.classList.contains('maximized')) {
                    windowElement.style.zIndex = '10000';
                }
            };

            header.addEventListener('mousedown', dragStart);
            document.addEventListener('mousemove', drag);
            document.addEventListener('mouseup', dragEnd);
        }

        function displayError(errorMessage) {
            // Mostra l'errore in un popup
            const popup = document.createElement('div');
            popup.className = 'floating-window';
            
            popup.innerHTML = `
                <div class="window-header">
                    <h5 class="window-title">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        Errore
                    </h5>
                    <div class="window-controls">
                        <button type="button" class="btn btn-light btn-sm close-popup-btn">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>
                <div class="window-body">
                    <div class="error-box">
                        <h5><i class="bi bi-exclamation-triangle me-2"></i>Errore</h5>
                        <p class="mb-0">${escapeHtml(errorMessage)}</p>
                    </div>
                </div>
                <div class="window-footer">
                    <span></span>
                    <button type="button" class="btn btn-danger close-window">Chiudi</button>
                </div>
            `;
            
            document.body.appendChild(popup);
            const rect = popup.getBoundingClientRect();
            popup.style.left = `${(window.innerWidth - rect.width) / 2}px`;
            popup.style.top = `${(window.innerHeight - rect.height) / 2}px`;
            
            setupPopupControls(popup);
        }

        function highlightSQL(sql) {
            const keywords = ['SELECT', 'FROM', 'WHERE', 'JOIN', 'LEFT', 'RIGHT', 'INNER', 'OUTER', 
                             'ON', 'GROUP', 'BY', 'ORDER', 'TOP', 'AS', 'AND', 'OR', 'IN', 'LIKE', 
                             'COUNT', 'SUM', 'AVG', 'MIN', 'MAX', 'DISTINCT', 'GETDATE'];
            
            let highlighted = escapeHtml(sql);
            keywords.forEach(keyword => {
                const regex = new RegExp(`\\b${keyword}\\b`, 'gi');
                highlighted = highlighted.replace(regex, `<span class="sql-keyword">${keyword.toUpperCase()}</span>`);
            });
            
            return highlighted;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

    </script>
} 

@model AiDbMaster.Models.PstreeListaSedi

@{
    ViewData["Title"] = "Elimina Sede";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-trash text-danger"></i> Elimina Sede</h2>
        <a asp-action="Index" asp-controller="PstreeListaSedi" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            @if (ViewBag.IsUsed)
            {
                <div class="alert alert-danger" role="alert">
                    <h5 class="alert-heading">
                        <i class="bi bi-slash-circle"></i> Eliminazione non consentita
                    </h5>
                    <p class="mb-0">
                        Questa sede è utilizzata in <strong>@ViewBag.CountSaldi saldi</strong> 
                        e <strong>@ViewBag.CountRettifiche rettifiche</strong>.
                        Non può essere eliminata.
                    </p>
                </div>
            }
            else
            {
                <div class="alert alert-warning" role="alert">
                    <h5 class="alert-heading">
                        <i class="bi bi-exclamation-triangle"></i> Conferma Eliminazione
                    </h5>
                    <p class="mb-0">
                        Sei sicuro di voler eliminare questa sede? L'operazione non può essere annullata.
                    </p>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-building"></i> Sede da eliminare</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary">@Model.Id</span></dd>

                        <dt class="col-sm-4">Nome</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Sede</dd>

                        <dt class="col-sm-4">Descrizione</dt>
                        <dd class="col-sm-8">@(Model.DescrizioneSede ?? "-")</dd>
                    </dl>

                    <hr />

                    @if (ViewBag.IsUsed)
                    {
                        <a asp-action="Index" asp-controller="PstreeListaSedi" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Torna all'elenco
                        </a>
                    }
                    else
                    {
                        <form asp-action="Delete" asp-controller="PstreeListaSedi">
                            <input type="hidden" asp-for="Id" />
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Conferma Eliminazione
                                </button>
                                <a asp-action="Index" asp-controller="PstreeListaSedi" class="btn btn-secondary">
                                    <i class="bi bi-x"></i> Annulla
                                </a>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

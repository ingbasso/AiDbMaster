@model AiDbMaster.Models.PstreeListaSedi

@{
    ViewData["Title"] = "Nuova Sede";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-plus-circle text-primary"></i> Nuova Sede</h2>
        <a asp-action="Index" asp-controller="PstreeListaSedi" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-building"></i> Inserisci Sede</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" asp-controller="PstreeListaSedi">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Id" class="form-label">
                                <i class="bi bi-hash"></i> ID <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Id" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Id" class="text-danger"></span>
                            <small class="form-text text-muted">Codice identificativo univoco della sede.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sede" class="form-label">
                                <i class="bi bi-building"></i> Nome Sede <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Sede" class="form-control" placeholder="Es: Sede Centrale" />
                            <span asp-validation-for="Sede" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DescrizioneSede" class="form-label">
                                <i class="bi bi-file-text"></i> Descrizione
                            </label>
                            <textarea asp-for="DescrizioneSede" class="form-control" rows="3" 
                                      placeholder="Indirizzo o descrizione opzionale della sede..."></textarea>
                            <span asp-validation-for="DescrizioneSede" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-floppy"></i> Salva
                            </button>
                            <a asp-action="Index" asp-controller="PstreeListaSedi" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

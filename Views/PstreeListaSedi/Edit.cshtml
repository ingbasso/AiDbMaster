@model AiDbMaster.Models.PstreeListaSedi

@{
    ViewData["Title"] = "Modifica Sede";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-pencil text-warning"></i> Modifica Sede</h2>
        <a asp-action="Index" asp-controller="PstreeListaSedi" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-building"></i> Modifica Sede #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-controller="PstreeListaSedi">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="bi bi-hash"></i> ID
                            </label>
                            <input value="@Model.Id" class="form-control" readonly disabled />
                            <small class="form-text text-muted">L'ID non può essere modificato.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sede" class="form-label">
                                <i class="bi bi-building"></i> Nome Sede <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Sede" class="form-control" />
                            <span asp-validation-for="Sede" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DescrizioneSede" class="form-label">
                                <i class="bi bi-file-text"></i> Descrizione
                            </label>
                            <textarea asp-for="DescrizioneSede" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="DescrizioneSede" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-floppy"></i> Salva Modifiche
                            </button>
                            <a asp-action="Index" asp-controller="PstreeListaSedi" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

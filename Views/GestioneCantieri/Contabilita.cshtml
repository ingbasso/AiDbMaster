        }
        .riga-totale-padre .tot-vendita-manca {
            background: #fff6cc;
            font-size: .68rem;
            font-weight: 500;
            color: #6c757d;
        }
        .riga-totale-padre .tot-vendita-manca.delta-negativo {
            color: #c0392b;
            font-weight: 700;
        }
        .delta-riga:empty { display: none; }
        .delta-riga {
            display: block;
            margin-top: 2px;
            font-size: .68rem;
            font-weight: 500;
            line-height: 1.2;
            color: #6c757d;
            white-space: nowrap;
        }
        .delta-positivo { color: #157347; font-weight: 700; }
        .delta-negativo { color: #c0392b; font-weight: 700; }
        .contab-table td:has(.delta-riga) { vertical-align: top; }
        .flag-proforma {
            display: inline-flex;

                                    {
                                        <span class="badge-confronto">solo finale</span>
                                    }
                                </td>
                                <td class="col-um">@Html.Raw(HtmlUm($"Righe[{i}].UnitaMisura", padre.UnitaMisura))</td>
                                <td class="col-num">
                                    <input name="Righe[@i].QuantitaPosata" class="form-control form-control-sm text-end num num-edit qty" inputmode="decimal" value="@Num(padre.QuantitaPosata)" />
                                    @if (padre.HaConfronto)
                                    {
                                        <div class="delta-riga delta-qty"></div>
                                    }
                                </td>
                                <td class="col-num">
                                    <input name="Righe[@i].CostoMaterialeServizio" class="form-control form-control-sm text-end costo costo-padre" readonly tabindex="-1" title="Il costo si scrive sulla riga del materiale, sotto il padre." />
                                </td>
                                <td class="tot-cell text-end align-middle tot-costo"><span class="tot-val"></span></td>
                                <td class="col-num"></td>
                                <td class="col-num">
                                    <input name="Righe[@i].PrezzoVenditaCliente" class="form-control form-control-sm text-end num num-edit prz" inputmode="decimal" value="@Num(padre.PrezzoVenditaCliente)" />
                                    @if (padre.HaConfronto)
                                    {
                                        <div class="delta-riga delta-vendita"></div>
                                    }
                                </td>
                                <td class="tot-cell text-end align-middle tot-vendita"><span class="tot-val"></span></td>
                                <td><input name="Righe[@i].Note" class="form-control form-control-sm" maxlength="200" value="@padre.Note" /></td>
                                <td class="text-nowrap">
                                    @Html.Raw(FlagProforma($"Righe[{i}].MostraInProforma", padre.MostraInProforma))

            <input type="hidden" name="Righe[__P__].Figli[__F__].Id" value="0" />
            <div class="cerca-wrap">
                <input name="Righe[__P__].Figli[__F__].CodiceArticolo" class="form-control form-control-sm codice-art" maxlength="40" autocomplete="off" placeholder="Codice" />
                <div class="cerca-risultati d-none"></div>
            </div>
        </td>
        <td><input name="Righe[__P__].Figli[__F__].Descrizione" class="form-control form-control-sm col-desc desc" maxlength="255" /></td>
        <td class="col-um">@Html.Raw(HtmlUm("Righe[__P__].Figli[__F__].UnitaMisura", null))</td>
        <td class="col-num"><input name="Righe[__P__].Figli[__F__].QuantitaPosata" class="form-control form-control-sm text-end num qty" inputmode="decimal" /></td>
        <td class="col-num"><input name="Righe[__P__].Figli[__F__].CostoMaterialeServizio" class="form-control form-control-sm text-end num costo" inputmode="decimal" /></td>
        <td class="tot-cell text-end align-middle tot-costo"></td>
        <td class="col-num"><input name="Righe[__P__].Figli[__F__].PrezzoVenditaCliente" class="form-control form-control-sm text-end num prz" inputmode="decimal" /></td>
        <td class="tot-cell text-end align-middle tot-vendita"></td>
        <td><input name="Righe[__P__].Figli[__F__].Note" class="form-control form-control-sm" maxlength="200" /></td>
        <td>
            <button type="button" class="btn btn-sm btn-outline-danger btn-elimina-figlio" title="Elimina figlio"><i class="bi bi-x-lg"></i></button>

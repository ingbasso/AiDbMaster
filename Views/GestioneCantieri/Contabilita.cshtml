            </div>
        </td>
        <td><input name="Righe[__P__].Figli[__F__].Descrizione" class="form-control form-control-sm col-desc desc" maxlength="255" /></td>
        <td class="col-um">@Html.Raw(HtmlUm("Righe[__P__].Figli[__F__].UnitaMisura", null))</td>
        <td class="col-num"><input name="Righe[__P__].Figli[__F__].QuantitaPosata" class="form-control form-control-sm text-end num num-edit qty" inputmode="decimal" /></td>
        <td class="col-num"><input name="Righe[__P__].Figli[__F__].CostoMaterialeServizio" class="form-control form-control-sm text-end num num-edit costo" inputmode="decimal" /><div class="delta-riga pm-costo" title="Costo presente in tabella per questo articolo"></div></td>
        <td class="tot-cell text-end align-middle tot-costo"><span class="tot-val"></span></td>
        <td class="col-num"><input name="Righe[__P__].Figli[__F__].RicaricoPercentuale" class="form-control form-control-sm text-end num num-edit ricarico" inputmode="decimal" value="30" /></td>
        <td class="col-num"><div class="prezzo-um-wrap"><input class="form-control form-control-sm text-end num num-edit prz-um" inputmode="decimal" autocomplete="off" title="Prezzo di vendita nell'unità di questa riga. Sotto c'è il prezzo rapportato all'unità del padre. Il totale vendita usa quello." /></div><div class="delta-riga prz-mq" title="Prezzo rapportato all'unità di misura del padre"></div><input name="Righe[__P__].Figli[__F__].PrezzoVenditaCliente" class="form-control form-control-sm text-end num num-edit prz" inputmode="decimal" title="Scrivi il prezzo e si aggiorna il ricarico. Scrivi il ricarico e si aggiorna il prezzo." /><div class="delta-riga pm-prezzo" title="Prezzo medio di vendita"></div></td>
        <td class="tot-cell text-end align-middle tot-vendita"><span class="tot-val"></span></td>
        <td><input name="Righe[__P__].Figli[__F__].Note" class="form-control form-control-sm" maxlength="200" /></td>
        <td>
            <button type="button" class="btn btn-sm btn-danger btn-elimina-figlio" title="Elimina figlio"><i class="bi bi-x-lg"></i></button>
        </td>
    </tr>
</script>

@section Scripts {
    <script type="application/json" id="costiArticoliJson">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CostiArticoli))</script>
    <script>
        (function () {
            var urlArticoli = '@Url.Action("CercaArticoliContabilita", "GestioneCantieri")';
            var urlDatiArticolo = '@Url.Action("DatiArticoloContabilita", "GestioneCantieri")';
            var costiPerCodice = {};
            try {
                JSON.parse(document.getElementById('costiArticoliJson').textContent || '[]').forEach(function (r) {
                    var codice = String(r.Codice || r.codice || '').trim().toUpperCase();
                    if (codice) costiPerCodice[codice] = r;
                });
            } catch (e) { }
            var corpo = document.getElementById('corpoContabilita');
            var form = document.getElementById('formContabilita');
            var prossimoPadre = document.querySelectorAll('tr.riga-padre').length;
            var prossimoAcconto = document.querySelectorAll('.riga-acconto').length;
            var confrontaIniziale = @(Model.ConfrontaIniziale ? "true" : "false");
            var timerCerca = null;
            var richiestaCerca = 0;
            var indiceAttivo = -1;

            function parseNum(valore) {
                if (valore === null || valore === undefined) return 0;
                var s = String(valore).trim().replace(/\s/g, '');
                if (!s) return 0;
                if (s.indexOf(',') >= 0 && s.indexOf('.') >= 0) {
                    if (s.lastIndexOf(',') > s.lastIndexOf('.'))
                        s = s.replace(/\./g, '').replace(',', '.');
                    else
                        s = s.replace(/,/g, '');
                } else {
                    s = s.replace(',', '.');
                }
                var n = parseFloat(s);
                return isNaN(n) ? 0 : n;
            }

            function formatIta(n, dec) {
                return n.toLocaleString('it-IT', { minimumFractionDigits: dec, maximumFractionDigits: dec });
            }

            function formatDelta(d, dec) {
                var fattore = Math.pow(10, dec);
                var arrotondato = Math.round(d * fattore) / fattore;
                if (arrotondato === 0)
                    return formatIta(0, dec);
                var testo = formatIta(arrotondato, dec);
                return arrotondato > 0 ? '+' + testo : testo;
            }

            function scriviConfronto(el, attr, attuale, dec) {
                if (!el) return;
                dec = dec || 2;
                var fattore = Math.pow(10, dec);
                var iniziale = (attr === null || attr === '') ? 0 : parseNum(attr);
                var delta = attuale - iniziale;
                if (Math.round(delta * fattore) / fattore === 0) {
                    el.textContent = '';
                    return;
                }
                var ini = (attr === null || attr === '') ? '—' : formatIta(iniziale, dec);
                var segno = document.createElement('span');
                segno.className = delta > 0 ? 'delta-positivo' : 'delta-negativo';
                segno.textContent = 'Δ ' + formatDelta(delta, dec);
                el.textContent = 'iniz. ' + ini + ' · ';
                el.appendChild(segno);
            }

            function scriviTotale(cella, valore) {
                if (!cella) return;
                var testo = valore ? formatIta(valore, 2) : '';
                var slot = cella.querySelector('.tot-val');
                if (slot) slot.textContent = testo;
                else cella.textContent = testo;
            }

            function aggiornaDeltaRiga(tr) {
                if (!tr.hasAttribute('data-iniz-qty')) return;
                var prz = parseNum(tr.querySelector('.prz')?.value);
                if (tr.classList.contains('riga-sconto'))
                    prz = Math.abs(prz);
                scriviConfronto(tr.querySelector('.delta-qty'), tr.getAttribute('data-iniz-qty'), parseNum(tr.querySelector('.qty')?.value), 2);
                scriviConfronto(tr.querySelector('.delta-costo'), tr.getAttribute('data-iniz-costo'), parseNum(tr.querySelector('.costo')?.value), 2);
                var decimaliVendita = (tr.classList.contains('riga-figlio') || tr.classList.contains('riga-sconto')) ? 2 : 4;
                scriviConfronto(tr.querySelector('.delta-vendita'), tr.getAttribute('data-iniz-vendita'), prz, decimaliVendita);
            }

            function marcaSoloFinale(tr) {
                if (!confrontaIniziale || !tr) return;
                var td = tr.querySelector('input.desc')?.parentElement;
                if (!td || td.querySelector('.badge-confronto')) return;
                var badge = document.createElement('span');
                badge.className = 'badge-confronto';
                badge.textContent = 'solo finale';
                td.appendChild(badge);
            }

            function applicaConfrontoPosa(padre, posa) {
                if (!confrontaIniziale || !padre || !posa || posa.hasAttribute('data-iniz-qty')) return;
                if (!padre.hasAttribute('data-iniz-posa-qty')) {
                    marcaSoloFinale(posa);
                    return;
                }
                posa.setAttribute('data-iniz-qty', padre.getAttribute('data-iniz-posa-qty'));
                posa.setAttribute('data-iniz-costo', padre.getAttribute('data-iniz-posa-costo') || '0');
                posa.setAttribute('data-iniz-vendita', padre.getAttribute('data-iniz-posa-vendita') || '0');
                var qtyTd = posa.querySelector('.qty')?.closest('td');
                if (qtyTd && !qtyTd.querySelector('.delta-qty')) {
                    var dq = document.createElement('div');
                    dq.className = 'delta-riga delta-qty';
                    qtyTd.appendChild(dq);
                }
                [['.costo', 'delta-costo'], ['.prz', 'delta-vendita']].forEach(function (pair) {
                    var cella = posa.querySelector(pair[0])?.closest('td');
                    if (!cella || cella.querySelector('.' + pair[1])) return;
                    var d = document.createElement('div');
                    d.className = 'delta-riga ' + pair[1];
                    cella.appendChild(d);
                });
            }

            function scriviScostamento(id, attuale) {
                var el = document.getElementById(id);
                if (!el) return;
                var delta = attuale - parseNum(el.getAttribute('data-iniziale'));
                var nascosto = Math.round(delta * 100) / 100 === 0;
                el.classList.toggle('d-none', nascosto);
                el.classList.remove('delta-positivo', 'delta-negativo');
                if (!nascosto)
                    el.classList.add(delta > 0 ? 'delta-positivo' : 'delta-negativo');
                if (el.previousElementSibling)
                    el.previousElementSibling.classList.toggle('d-none', nascosto);
                el.textContent = nascosto ? '' : formatDelta(delta, 2);
            }

            function campo(data, nomeMinuscolo, nomeMaiuscolo) {
                if (!data) return '';
                return data[nomeMinuscolo] || data[nomeMaiuscolo] || '';
            }

            function normalizzaUm(um) {
                var v = String(um || '').trim().toUpperCase();
                if (!v) return '';
                if (v === 'ML' || v === 'METRI') return 'M';
                if (v === 'M2' || v === 'MQ.') return 'MQ';
                if (v === 'M3' || v === 'MC.') return 'MC';
                if (v === 'SAC' || v === 'SACCHETTI' || v === 'SACCHETTO') return 'SA';
                if (v === 'ROT' || v === 'ROTOLO' || v === 'ROTOLI') return 'RT';
                return v;
            }

            function impostaUm(select, um) {
                if (!select) return;
                var valore = normalizzaUm(um);
                if (!valore) return;
                var esiste = Array.prototype.some.call(select.options, function (o) {
                    return o.value.toUpperCase() === valore;
                });
                if (!esiste)
                    select.appendChild(new Option(valore, valore));
                select.value = esiste
                    ? Array.prototype.find.call(select.options, function (o) { return o.value.toUpperCase() === valore; }).value
                    : valore;
            }

            function applicaArticolo(tr, data, forza) {
                if (!tr || !data) return;
                var desc = campo(data, 'descrizione', 'Descrizione');
                var um = campo(data, 'unitaMisura', 'UnitaMisura');
                var codice = campo(data, 'id', 'Id') || campo(data, 'codice', 'Codice');
                var inputCodice = tr.querySelector('input.codice-art');
                var inputDesc = tr.querySelector('input.desc');
                var selectUm = tr.querySelector('select.um');
                if (inputCodice && codice) inputCodice.value = codice;
                if (inputDesc && desc && (forza || !inputDesc.value.trim())) inputDesc.value = desc;
                if (selectUm && um && (forza || !selectUm.value)) impostaUm(selectUm, um);
                if (tr.classList.contains('riga-articolo')) {
                    ricalcola();
                }
                else if (tr.classList.contains('riga-padre') && !tr.classList.contains('riga-sconto')) {
                    bloccaCodicePadre(tr);
                    ricalcola();
                }
            }

            function chiudiRisultati(wrap) {
                if (!wrap) {
                    document.querySelectorAll('.cerca-risultati').forEach(function (el) {
                        el.classList.add('d-none');
                        el.innerHTML = '';
                    });
                    indiceAttivo = -1;
                    return;
                }
                var box = wrap.querySelector('.cerca-risultati');
                if (box) {
                    box.classList.add('d-none');
                    box.innerHTML = '';
                }
                indiceAttivo = -1;
            }

            function vociRisultati(box) {
                return box ? Array.prototype.slice.call(box.querySelectorAll('.cerca-item')) : [];
            }

            function evidenziaVoce(box, indice) {
                var voci = vociRisultati(box);
                voci.forEach(function (v, i) { v.classList.toggle('active', i === indice); });
                if (voci[indice]) voci[indice].scrollIntoView({ block: 'nearest' });
                indiceAttivo = indice;
            }

            function scegliArticolo(input, voce) {
                var tr = input.closest('tr');
                applicaArticolo(tr, {
                    id: voce.getAttribute('data-id'),
                    descrizione: voce.getAttribute('data-desc'),
                    unitaMisura: voce.getAttribute('data-um')
                }, true);
                chiudiRisultati(input.closest('.cerca-wrap'));
            }

            function escapeHtml(s) {
                return String(s || '').replace(/[&<>"']/g, function (c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
                });
            }

            function mostraRisultati(input, articoli) {
                var wrap = input.closest('.cerca-wrap');
                var box = wrap.querySelector('.cerca-risultati');
                if (!articoli || !articoli.length) {
                    box.innerHTML = '<div class="cerca-vuoto">Nessun articolo trovato. Puoi lasciare il codice libero.</div>';
                    box.classList.remove('d-none');
                    indiceAttivo = -1;
                    return;
                }
                box.innerHTML = articoli.map(function (a) {
                    var id = campo(a, 'id', 'Id');
                    var desc = campo(a, 'descrizione', 'Descrizione');
                    var um = campo(a, 'unitaMisura', 'UnitaMisura');
                    return '<button type="button" class="cerca-item" data-id="' + escapeHtml(id) + '" data-desc="' +
                        escapeHtml(desc) + '" data-um="' + escapeHtml(um) +
                        '"><div class="cod">' + escapeHtml(id) + '</div><div class="dsc">' +
                        escapeHtml(desc) + (um ? ' · ' + escapeHtml(um) : '') + '</div></button>';
                }).join('');
                box.classList.remove('d-none');
                evidenziaVoce(box, 0);
            }

            function cercaArticoli(input) {
                var term = input.value.trim();
                if (term.length < 2) {
                    chiudiRisultati(input.closest('.cerca-wrap'));
                    return;
                }
                var token = ++richiestaCerca;
                fetch(urlArticoli + '?term=' + encodeURIComponent(term))
                    .then(function (r) { return r.json(); })
                    .then(function (dati) {
                        if (token !== richiestaCerca) return;
                        if (document.activeElement !== input) return;
                        mostraRisultati(input, dati || []);
                    })
                    .catch(function () { });
            }

            function caricaDatiArticolo(tr, codice) {
                if (!codice) return;
                fetch(urlDatiArticolo + '?codice=' + encodeURIComponent(codice))
                    .then(function (r) { return r.json(); })
                    .then(function (dati) { applicaArticolo(tr, dati); })
                    .catch(function () { });
            }

            function formatDec(n) {
                if (n === null || isNaN(n)) return '';
                return n.toFixed(2).replace('.', ',');
            }

            function voceCosto(tr) {
                var codice = (tr?.querySelector('input.codice-art')?.value || '').trim().toUpperCase();
                return codice ? costiPerCodice[codice] : null;
            }

            function proponiCosto(tr) {
                if (!tr || tr.classList.contains('riga-posa')) return;
                if (tr.classList.contains('riga-padre') && !tr.classList.contains('riga-articolo')) return;
                var costo = tr.querySelector('input.costo');
                if (!costo) return;
                var codice = (tr.querySelector('input.codice-art')?.value || '').trim().toUpperCase();
                if (!codice || tr.getAttribute('data-costo-da') === codice) return;
                tr.setAttribute('data-costo-da', codice);
                if (costo.value.trim()) return;
                var info = costiPerCodice[codice];
                var valore = info ? (info.Costo != null ? info.Costo : info.costo) : null;
                if (valore === null || valore === undefined || isNaN(valore)) return;
                costo.value = formatDec(valore);
            }

            function aggiornaPm(padre) {
                var materiale = corpo.querySelector('tr.riga-materiale[data-padre-ix="' + padre.getAttribute('data-ix') + '"]');
                if (!materiale) return;
                var info = voceCosto(materiale);
                var prezzoMedio = info ? (info.PrezzoMedio != null ? info.PrezzoMedio : info.prezzoMedio) : null;
                var costoTabella = info ? (info.Costo != null ? info.Costo : info.costo) : null;
                var slotPrezzo = materiale.querySelector('.pm-prezzo');
                var slotCosto = materiale.querySelector('.pm-costo');
                if (slotPrezzo)
                    slotPrezzo.textContent = (prezzoMedio === null || prezzoMedio === undefined || isNaN(prezzoMedio)) ? '' : ('PM ' + formatDec(prezzoMedio));
                if (slotCosto)
                    slotCosto.textContent = (costoTabella === null || costoTabella === undefined || isNaN(costoTabella)) ? '' : ('CT ' + formatDec(costoTabella));
            }

            function bloccaCodicePadre(padre) {
                var input = padre.querySelector('input.codice-art');
                if (!input || !input.value.trim()) return;
                input.readOnly = true;
                input.title = 'Il codice non si può più modificare.';
            }

            function marcaPosa(tr) {
                if (!tr) return;
                tr.classList.add('riga-posa');
                var flag = tr.querySelector('input.is-posa');
                if (flag) flag.value = 'true';
                var desc = tr.querySelector('input.desc');
                if (desc && !desc.value.trim()) desc.value = 'Posa';
                var qtyPosa = tr.querySelector('.qty');
                if (qtyPosa) {
                    qtyPosa.readOnly = false;
                    qtyPosa.removeAttribute('tabindex');
                    qtyPosa.classList.remove('num-calc');
                    qtyPosa.classList.add('num-edit');
                    qtyPosa.title = 'Segue la quantità del padre. Se la cambi, resta il tuo numero. Se la svuoti, torna quella del padre.';
                }
                var ricarico = tr.querySelector('.ricarico');
                if (ricarico && !ricarico.value.trim()) ricarico.value = '30';
                tr.querySelector('.btn-elimina-figlio')?.remove();
            }

            function marcaMateriale(tr) {
                if (!tr) return;
                tr.classList.add('riga-materiale');
                var flagPosa = tr.querySelector('input.is-posa');
                if (flagPosa && !tr.querySelector('input.is-materiale')) {
                    var hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.className = 'is-materiale';
                    hidden.name = flagPosa.name.replace(/IsPosa$/, 'IsArticoloMateriale');
                    hidden.value = 'true';
                    flagPosa.insertAdjacentElement('afterend', hidden);
                }
                var codice = tr.querySelector('input.codice-art');
                if (codice) {
                    codice.readOnly = true;
                    codice.title = 'Stesso articolo del padre.';
                }
                var desc = tr.querySelector('input.desc');
                if (desc) desc.readOnly = true;
                var um = tr.querySelector('select.um');
                if (um) um.disabled = true;
                var qty = tr.querySelector('.qty');
                if (qty) {
                    qty.readOnly = false;
                    qty.removeAttribute('tabindex');
                    qty.classList.remove('num-calc');
                    qty.classList.add('num-edit');
                    qty.title = 'Segue la quantità del padre. Se la cambi, resta il tuo numero. Se la svuoti, torna quella del padre.';
                }
                tr.querySelector('.btn-elimina-figlio')?.remove();
            }

            function assicuraMateriale(padre) {
                var ix = padre.getAttribute('data-ix');
                var materiale = corpo.querySelector('tr.riga-materiale[data-padre-ix="' + ix + '"]');
                if (!materiale) {
                    var codicePadre = (padre.querySelector('input.codice-art')?.value || '').trim().toUpperCase();
                    if (codicePadre) {
                        corpo.querySelectorAll('tr.riga-figlio[data-padre-ix="' + ix + '"]:not(.riga-posa)').forEach(function (figlio) {
                            if (materiale) return;
                            var codice = (figlio.querySelector('input.codice-art')?.value || '').trim().toUpperCase();
                            if (codice === codicePadre) materiale = figlio;
                        });
                    }
                }
                if (!materiale) {
                    var figli = corpo.querySelectorAll('tr.riga-figlio[data-padre-ix="' + ix + '"]');
                    var ancora = figli.length
                        ? figli[0]
                        : corpo.querySelector('tr.riga-totale-padre[data-ix="' + ix + '"]');
                    if (!ancora) return;
                    var f = figli.length;
                    var html = document.getElementById('tplFiglio').innerHTML
                        .replace(/__P__/g, String(ix))
                        .replace(/__F__/g, String(f));
                    ancora.insertAdjacentHTML('beforebegin', html);
                    materiale = ancora.previousElementSibling;
                }
                marcaMateriale(materiale);
            }

            function allineaMateriale(padre) {
                var ix = padre.getAttribute('data-ix');
                var materiale = corpo.querySelector('tr.riga-materiale[data-padre-ix="' + ix + '"]');
                if (!materiale) return;
                var codice = materiale.querySelector('input.codice-art');
                var desc = materiale.querySelector('input.desc');
                var um = materiale.querySelector('select.um');
                var qty = materiale.querySelector('.qty');
                var ricarico = materiale.querySelector('.ricarico');
                if (codice) codice.value = padre.querySelector('input.codice-art')?.value || '';
                if (desc) desc.value = padre.querySelector('input.desc')?.value || '';
                if (um) {
                    um.disabled = false;
                    var umPadre = padre.querySelector('select.um')?.value || '';
                    if (umPadre) impostaUm(um, umPadre);
                    else um.value = '';
                    um.disabled = true;
                }
                var valoreQtyPadre = padre.querySelector('.qty')?.value || '';
                if (qty) {
                    preparaOrigineQty(qty, valoreQtyPadre);
                    if (qtySegueIlPadre(qty) && document.activeElement !== qty)
                        qty.value = valoreQtyPadre;
                }
                if (ricarico && !ricarico.value.trim()) ricarico.value = '30';
            }

            function preparaOrigineQty(input, valorePadre) {
                if (!input || input.hasAttribute('data-qty-origine')) return;
                var testo = (input.value || '').trim();
                var padreTesto = (valorePadre || '').trim();
                var uguali = padreTesto && Math.abs(parseNum(testo) - parseNum(padreTesto)) < 0.0000001;
                input.setAttribute('data-qty-origine', (!testo || uguali) ? 'padre' : 'manuale');
            }

            function qtySegueIlPadre(input) {
                return !!input && input.getAttribute('data-qty-origine') !== 'manuale';
            }

            function segnaOriginePrezzo(figlio, daPrezzo) {
                if (!figlio) return;
                figlio.setAttribute('data-origine', daPrezzo ? 'prezzo' : 'ricarico');
                var hidden = figlio.querySelector('input.origine-prezzo');
                if (hidden) hidden.value = daPrezzo ? 'true' : 'false';
            }

            function segnaOriginePrezzoUm(figlio) {
                if (!figlio) return;
                figlio.setAttribute('data-origine', 'prezzo-um');
                var hidden = figlio.querySelector('input.origine-prezzo');
                if (hidden) hidden.value = 'false';
            }

            function prezzoScrittoAMano(figlio) {
                return figlio.getAttribute('data-origine') === 'prezzo';
            }

            function prezzoUmScritto(figlio) {
                return figlio.getAttribute('data-origine') === 'prezzo-um';
            }

            function umCodice(tr) {
                return (tr?.querySelector('select.um')?.value || '').trim().toUpperCase();
            }

            function umDiversaDalPadre(figlio, padre) {
                if (!figlio || figlio.classList.contains('riga-posa') || figlio.classList.contains('riga-materiale'))
                    return false;
                var umFiglio = umCodice(figlio);
                var umPadre = umCodice(padre);
                return !!umFiglio && !!umPadre && umFiglio !== umPadre;
            }

            function scriviIndicazioneMq(figlio, padre, prezzoMq) {
                var hint = figlio.querySelector('.prz-mq');
                if (!hint) return;
                var um = umCodice(figlio);
                var umPadre = umCodice(padre);
                if (!um) {
                    hint.textContent = '';
                    return;
                }
                hint.textContent = prezzoMq ? ('€/' + um + '\n' + prezzoMq + ' €/' + umPadre) : ('€/' + um);
            }

            function formatRicarico(n) {
                var arrotondato = Math.round(n * 10000) / 10000;
                var negativo = arrotondato < 0;
                var testo = Math.abs(arrotondato).toFixed(4).replace(/0+$/, '').replace(/\.$/, '');
                return (negativo ? '-' : '') + testo.replace('.', ',');
            }

            function allineaVenditaFigli(padre) {
                var ix = padre.getAttribute('data-ix');
                var qtyPadreInput = padre.querySelector('.qty');
                var qtyPadre = parseNum(qtyPadreInput?.value);
                var haQtyPadre = !!(qtyPadreInput && qtyPadreInput.value.trim() && qtyPadre !== 0);
                corpo.querySelectorAll('tr.riga-figlio[data-padre-ix="' + ix + '"]').forEach(function (figlio) {
                    var qty = figlio.querySelector('.qty');
                    var costo = figlio.querySelector('.costo');
                    var ricarico = figlio.querySelector('.ricarico');
                    var prz = figlio.querySelector('.prz');
                    var przUm = figlio.querySelector('.prz-um');
                    if (!prz || !ricarico) return;
                    var diversa = umDiversaDalPadre(figlio, padre);
                    figlio.classList.toggle('riga-um-diversa', diversa);
                    if (!diversa) {
                        var hintStessa = figlio.querySelector('.prz-mq');
                        if (hintStessa) hintStessa.textContent = '';
                        if (prezzoUmScritto(figlio))
                            segnaOriginePrezzo(figlio, false);
                    }
                    var base = parseNum(qty?.value) * parseNum(costo?.value);
                    if (diversa) {
                        var costoNum = parseNum(costo?.value);
                        var qtyNum = parseNum(qty?.value);
                        var staScrivendoUm = prezzoUmScritto(figlio) && document.activeElement === przUm;
                        if (prezzoUmScritto(figlio) && przUm && przUm.value.trim() && costoNum) {
                            var prezzoUm = parseNum(przUm.value);
                            ricarico.value = formatRicarico((prezzoUm / costoNum - 1) * 100);
                            prz.value = (haQtyPadre && qty && qty.value.trim())
                                ? formatDec(qtyNum * prezzoUm / qtyPadre)
                                : '';
                            scriviIndicazioneMq(figlio, padre, prz.value);
                            return;
                        }
                        if (staScrivendoUm) return;
                        if (prezzoUmScritto(figlio))
                            segnaOriginePrezzo(figlio, false);
                        if (!ricarico.value.trim()) ricarico.value = '30';
                        if (!haQtyPadre || !qty || !qty.value.trim() || !costo || !costo.value.trim()) {
                            if (przUm && document.activeElement !== przUm) przUm.value = '';
                            prz.value = '';
                            scriviIndicazioneMq(figlio, padre, '');
                            return;
                        }
                        var prezzoUmCalcolato = costoNum * (1 + parseNum(ricarico.value) / 100);
                        if (przUm) przUm.value = formatDec(prezzoUmCalcolato);
                        var prezzoUmVisibile = przUm ? parseNum(przUm.value) : prezzoUmCalcolato;
                        prz.value = formatDec(qtyNum * prezzoUmVisibile / qtyPadre);
                        scriviIndicazioneMq(figlio, padre, prz.value);
                        return;
                    }
                    if (prezzoScrittoAMano(figlio) && prz.value.trim() && haQtyPadre && base) {
                        var ric = (parseNum(prz.value) * qtyPadre / base - 1) * 100;
                        ricarico.value = formatRicarico(ric);
                        return;
                    }
                    if (prezzoScrittoAMano(figlio) && document.activeElement === prz)
                        return;
                    if (prezzoScrittoAMano(figlio))
                        segnaOriginePrezzo(figlio, false);
                    if (!ricarico.value.trim()) ricarico.value = '30';
                    if (!haQtyPadre || !qty || !qty.value.trim() || !costo || !costo.value.trim()) {
                        prz.value = '';
                        return;
                    }
                    var importo = parseNum(qty.value) * parseNum(costo.value) * (1 + parseNum(ricarico.value) / 100);
                    prz.value = formatDec(importo / qtyPadre);
                });
            }

            function allineaPosa(padre) {
                var ix = padre.getAttribute('data-ix');
                var posa = corpo.querySelector('tr.riga-posa[data-padre-ix="' + ix + '"]');
                if (!posa) return;
                var qtyPadre = padre.querySelector('.qty');
                var umPadre = padre.querySelector('select.um');
                var qtyPosa = posa.querySelector('.qty');
                var umPosa = posa.querySelector('select.um');
                if (qtyPosa && qtyPadre) {
                    preparaOrigineQty(qtyPosa, qtyPadre.value);
                    if (qtySegueIlPadre(qtyPosa) && document.activeElement !== qtyPosa)
                        qtyPosa.value = qtyPadre.value;
                }
                if (umPosa && umPadre) impostaUm(umPosa, umPadre.value);
                var ricarico = posa.querySelector('.ricarico');
                if (ricarico && !ricarico.value.trim()) ricarico.value = '30';
            }

            function assicuraPosa(ixPadre) {
                if (corpo.querySelector('tr.riga-posa[data-padre-ix="' + ixPadre + '"]'))
                    return;
                var azioni = corpo.querySelector('tr.riga-totale-padre[data-ix="' + ixPadre + '"]');
                if (!azioni) return;
                var f = corpo.querySelectorAll('tr.riga-figlio[data-padre-ix="' + ixPadre + '"]').length;
                var html = document.getElementById('tplFiglio').innerHTML
                    .replace(/__P__/g, String(ixPadre))
                    .replace(/__F__/g, String(f));
                azioni.insertAdjacentHTML('beforebegin', html);
                var nuova = azioni.previousElementSibling;
                marcaPosa(nuova);
            }

            function ricalcola() {
                document.querySelectorAll('tr.riga-padre').forEach(function (padre) {
                    if (padre.classList.contains('riga-sconto')) return;
                    if (padre.classList.contains('riga-articolo')) {
                        proponiCosto(padre);
                        return;
                    }
                    var ix = padre.getAttribute('data-ix');
                    assicuraMateriale(padre);
                    assicuraPosa(ix);
                    applicaConfrontoPosa(padre, corpo.querySelector('tr.riga-posa[data-padre-ix="' + ix + '"]'));
                    allineaMateriale(padre);
                    allineaPosa(padre);
                    proponiCosto(corpo.querySelector('tr.riga-materiale[data-padre-ix="' + ix + '"]'));
                    corpo.querySelectorAll('tr.riga-figlio[data-padre-ix="' + ix + '"]:not(.riga-posa):not(.riga-materiale)').forEach(proponiCosto);
                    allineaVenditaFigli(padre);
                    aggiornaPm(padre);
                });
                var totV = 0, totSconto = 0, totCosti = 0, totVenditaPosa = 0, totAcquistoPosa = 0;
                var costiPerPadre = {};
                var venditaPadre = {};
                var venditaFigli = {};
                document.querySelectorAll('tr.riga-contab').forEach(function (tr) {
                    if (tr.classList.contains('riga-sconto')) {
                        var importo = Math.abs(parseNum(tr.querySelector('.prz')?.value));
                        totSconto += importo;
                        totV += -importo;
                        var slotSconto = tr.querySelector('.tot-vendita .tot-val');
                        if (slotSconto) slotSconto.textContent = importo ? formatIta(-importo, 2) : '';
                        aggiornaDeltaRiga(tr);
                        return;
                    }
                    var qty = parseNum(tr.querySelector('.qty')?.value);
                    var costoInput = tr.querySelector('.costo');
                    var costoBloccato = tr.classList.contains('riga-padre') && !tr.classList.contains('riga-articolo');
                    if (costoBloccato && costoInput) costoInput.value = '';
                    var costo = costoBloccato ? 0 : parseNum(costoInput?.value);
                    var prz = parseNum(tr.querySelector('.prz')?.value);
                    var rC = qty * costo;
                    var rV = qty * prz;
                    if (tr.classList.contains('riga-figlio') && !tr.classList.contains('riga-posa')) {
                        var padreRiga = corpo.querySelector('tr.riga-padre[data-ix="' + tr.getAttribute('data-padre-ix') + '"]');
                        rV = parseNum(padreRiga?.querySelector('.qty')?.value) * prz;
                    }
                    totCosti += rC;
                    var ixGruppo = tr.classList.contains('riga-padre')
                        ? tr.getAttribute('data-ix')
                        : tr.getAttribute('data-padre-ix');
                    if (ixGruppo !== null) {
                        costiPerPadre[ixGruppo] = (costiPerPadre[ixGruppo] || 0) + rC;
                        if (tr.classList.contains('riga-padre') && !tr.classList.contains('riga-articolo'))
                            venditaPadre[ixGruppo] = rV;
                        else
                            venditaFigli[ixGruppo] = (venditaFigli[ixGruppo] || 0) + rV;
                    }
                    if (tr.classList.contains('riga-padre'))
                        totV += rV;
                    if (tr.classList.contains('riga-posa')) {
                        totVenditaPosa += rV;
                        totAcquistoPosa += rC;
                    }
                    scriviTotale(tr.querySelector('.tot-costo'), rC);
                    scriviTotale(tr.querySelector('.tot-vendita'), rV);
                    aggiornaDeltaRiga(tr);
                });
                document.querySelectorAll('tr.riga-totale-padre').forEach(function (riga) {
                    var ix = riga.getAttribute('data-ix');
                    var somma = costiPerPadre[ix] || 0;
                    var cella = riga.querySelector('.tot-costo-gruppo');
                    if (cella) cella.textContent = somma ? formatIta(somma, 2) : '';
                    var mancaCella = riga.querySelector('.tot-vendita-manca');
                    if (mancaCella) {
                        var manca = (venditaPadre[ix] || 0) - (venditaFigli[ix] || 0);
                        if (Math.round(manca * 100) / 100 === 0) {
                            mancaCella.textContent = '';
                            mancaCella.classList.remove('delta-negativo');
                        } else {
                            mancaCella.textContent = formatIta(manca, 2);
                            mancaCella.classList.toggle('delta-negativo', manca < 0);
                        }
                    }
                });
                var acconto = 0;
                document.querySelectorAll('.acconto-importo').forEach(function (el) { acconto += parseNum(el.value); });
                var iva = parseNum(document.getElementById('aliquotaIva')?.value);
                var saldo = totV - acconto;
                var conIva = saldo * (1 + iva / 100);
                var margine = document.getElementById('totMargine');
                document.getElementById('totVendita').textContent = formatIta(totV, 2);
                var compVendita = document.getElementById('compVendita');
                if (compVendita)
                    compVendita.textContent = Math.round(totSconto * 100) / 100 === 0
                        ? ''
                        : formatIta(totV + totSconto, 2) + ' − ' + formatIta(totSconto, 2);
                var deltaVendita = document.getElementById('deltaVendita');
                if (deltaVendita) {
                    var deltaV = totV - parseNum(deltaVendita.getAttribute('data-iniziale'));
                    if (Math.round(deltaV * 100) / 100 === 0) {
                        deltaVendita.textContent = '';
                        deltaVendita.className = 'delta-sotto';
                    } else {
                        deltaVendita.className = 'delta-sotto ' + (deltaV > 0 ? 'delta-positivo' : 'delta-negativo');
                        deltaVendita.textContent = 'Δ ' + formatDelta(deltaV, 2);
                    }
                }
                var elCosti = document.getElementById('totCosti');
                if (elCosti) elCosti.textContent = formatIta(totCosti, 2);
                var deltaCosti = document.getElementById('deltaCosti');
                if (deltaCosti) {
                    var deltaC = totCosti - parseNum(deltaCosti.getAttribute('data-iniziale'));
                    if (Math.round(deltaC * 100) / 100 === 0) {
                        deltaCosti.textContent = '';
                        deltaCosti.className = 'delta-sotto';
                    } else {
                        deltaCosti.className = 'delta-sotto ' + (deltaC > 0 ? 'delta-positivo' : 'delta-negativo');
                        deltaCosti.textContent = 'Δ ' + formatDelta(deltaC, 2);
                    }
                }
                document.getElementById('totVenditaPosa').textContent = formatIta(totVenditaPosa, 2);
                document.getElementById('totAcquistoPosa').textContent = formatIta(totAcquistoPosa, 2);
                var guadagnoPosa = totVenditaPosa - totAcquistoPosa;
                var elGuadagnoPosa = document.getElementById('totGuadagnoPosa');
                if (elGuadagnoPosa) {
                    elGuadagnoPosa.textContent = formatIta(guadagnoPosa, 2);
                    elGuadagnoPosa.classList.toggle('text-danger', guadagnoPosa < 0);
                }
                var marginePosa = document.getElementById('marginePosa');
                if (marginePosa) {
                    if (totVenditaPosa) {
                        var percPosa = guadagnoPosa / totVenditaPosa * 100;
                        marginePosa.className = 'margine-piccolo' + (percPosa < 0 ? ' delta-negativo' : '');
                        marginePosa.textContent = 'margine ' + formatIta(percPosa, 2) + ' %';
                    } else {
                        marginePosa.textContent = '';
                        marginePosa.className = 'margine-piccolo';
                    }
                }
                if (margine) {
                    if (totV) {
                        var perc = (totV - totCosti) / totV * 100;
                        margine.textContent = formatIta(perc, 2) + ' %';
                        margine.classList.toggle('text-danger', perc < 0);
                    } else {
                        margine.textContent = '—';
                        margine.classList.remove('text-danger');
                    }
                }
                document.getElementById('totAcconto').textContent = formatIta(acconto, 2);
                document.getElementById('totSaldo').textContent = formatIta(saldo, 2);
                document.getElementById('totIva').textContent = formatIta(conIva, 2);
            }

            function aggiungiFiglio(ixPadre) {
                var azioni = corpo.querySelector('tr.riga-posa[data-padre-ix="' + ixPadre + '"]')
                    || corpo.querySelector('tr.riga-totale-padre[data-ix="' + ixPadre + '"]');
                if (!azioni) return;
                var f = corpo.querySelectorAll('tr.riga-figlio[data-padre-ix="' + ixPadre + '"]').length;
                var html = document.getElementById('tplFiglio').innerHTML
                    .replace(/__P__/g, String(ixPadre))
                    .replace(/__F__/g, String(f));
                var posa = corpo.querySelector('tr.riga-posa[data-padre-ix="' + ixPadre + '"]');
                var ancora = posa || azioni;
                ancora.insertAdjacentHTML('beforebegin', html);
                marcaSoloFinale(ancora.previousElementSibling);
                ricalcola();
            }

            function inserisciPrimaDi(html, selettore) {
                var ancora = corpo.querySelector(selettore);
                if (ancora)
                    ancora.insertAdjacentHTML('beforebegin', html);
                else
                    corpo.insertAdjacentHTML('beforeend', html);
            }

            document.getElementById('btnAggiungiArticolo')?.addEventListener('click', function () {
                var p = prossimoPadre++;
                var html = document.getElementById('tplArticolo').innerHTML.replace(/__P__/g, String(p));
                inserisciPrimaDi(html, 'tr.riga-sconto, tr.blocco-mancante');
                marcaSoloFinale(corpo.querySelector('tr.riga-articolo[data-ix="' + p + '"]'));
                ricalcola();
                var nuovo = corpo.querySelector('tr.riga-articolo[data-ix="' + p + '"] input.codice-art');
                if (nuovo) nuovo.focus();
            });

            document.getElementById('btnAggiungiPadre')?.addEventListener('click', function () {
                var p = prossimoPadre++;
                var html = document.getElementById('tplPadre').innerHTML.replace(/__P__/g, String(p));
                inserisciPrimaDi(html, 'tr.riga-sconto, tr.blocco-mancante');
                marcaSoloFinale(corpo.querySelector('tr.riga-padre[data-ix="' + p + '"]'));
                assicuraPosa(String(p));
                ricalcola();
                var nuovo = corpo.querySelector('tr.riga-padre[data-ix="' + p + '"] input.codice-art');
                if (nuovo) nuovo.focus();
            });

            document.getElementById('btnAggiungiSconto')?.addEventListener('click', function () {
                var p = prossimoPadre++;
                var html = document.getElementById('tplSconto').innerHTML.replace(/__P__/g, String(p));
                inserisciPrimaDi(html, 'tr.blocco-mancante');
                marcaSoloFinale(corpo.querySelector('tr.riga-sconto[data-ix="' + p + '"]'));
                ricalcola();
                var importo = corpo.querySelector('tr.riga-sconto[data-ix="' + p + '"] input.prz');
                if (importo) importo.focus();
            });

            form.addEventListener('click', function (e) {
                var voce = e.target.closest('.cerca-item');
                if (voce) {
                    e.preventDefault();
                    var wrap = voce.closest('.cerca-wrap');
                    scegliArticolo(wrap.querySelector('input.codice-art'), voce);
                    return;
                }
                var btnFiglio = e.target.closest('.btn-aggiungi-figlio');
                if (btnFiglio) {
                    e.preventDefault();
                    var padreRiga = btnFiglio.closest('tr.riga-padre');
                    if (!padreRiga) return;
                    aggiungiFiglio(padreRiga.getAttribute('data-ix'));
                    return;
                }
                if (e.target.closest('.btn-elimina-padre')) {
                    var padre = e.target.closest('tr.riga-padre');
                    if (!padre) return;
                    var ix = padre.getAttribute('data-ix');
                    corpo.querySelectorAll('tr.riga-figlio[data-padre-ix="' + ix + '"]').forEach(function (r) { r.remove(); });
                    corpo.querySelectorAll('tr.riga-mancante[data-padre-ix="' + ix + '"]').forEach(function (r) { r.remove(); });
                    corpo.querySelector('tr.riga-sforamento[data-padre-ix="' + ix + '"]')?.remove();
                    corpo.querySelector('tr.riga-totale-padre[data-ix="' + ix + '"]')?.remove();
                    padre.remove();
                    ricalcola();
                    return;
                }
                if (e.target.closest('.btn-elimina-figlio')) {
                    e.target.closest('tr')?.remove();
                    ricalcola();
                    return;
                }
                if (e.target.closest('.btn-elimina-acconto')) {
                    e.target.closest('.riga-acconto')?.remove();
                    ricalcola();
                }
            });

            form.addEventListener('input', function (e) {
                if (e.target.classList.contains('qty') && e.target.closest('tr.riga-materiale, tr.riga-posa'))
                    e.target.setAttribute('data-qty-origine', 'manuale');
                var rigaFiglio = e.target.closest('tr.riga-figlio');
                if (rigaFiglio && e.target.classList.contains('prz-um'))
                    segnaOriginePrezzoUm(rigaFiglio);
                else if (rigaFiglio && e.target.classList.contains('prz'))
                    segnaOriginePrezzo(rigaFiglio, true);
                else if (rigaFiglio && (e.target.classList.contains('ricarico') || e.target.classList.contains('costo') || e.target.classList.contains('qty')))
                    segnaOriginePrezzo(rigaFiglio, false);
                else if (e.target.classList.contains('qty')) {
                    var padreQty = e.target.closest('tr.riga-padre');
                    if (padreQty && !padreQty.classList.contains('riga-articolo') && !padreQty.classList.contains('riga-sconto')) {
                        corpo.querySelectorAll('tr.riga-figlio[data-padre-ix="' + padreQty.getAttribute('data-ix') + '"]').forEach(function (figlio) {
                            segnaOriginePrezzo(figlio, false);
                        });
                    }
                }
                if (e.target.classList.contains('num') || e.target.classList.contains('desc'))
                    ricalcola();
                if (e.target.classList.contains('codice-art') && !e.target.readOnly) {
                    clearTimeout(timerCerca);
                    var input = e.target;
                    timerCerca = setTimeout(function () { cercaArticoli(input); }, 220);
                }
            });

            form.addEventListener('change', function (e) {
                if (e.target.classList.contains('um'))
                    ricalcola();
            });

            form.addEventListener('keydown', function (e) {
                if (!e.target.classList.contains('codice-art')) return;
                var box = e.target.closest('.cerca-wrap').querySelector('.cerca-risultati');
                if (box.classList.contains('d-none')) {
                    if (e.key === 'Enter') e.preventDefault();
                    return;
                }
                var voci = vociRisultati(box);
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    evidenziaVoce(box, Math.min(indiceAttivo + 1, voci.length - 1));
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    evidenziaVoce(box, Math.max(indiceAttivo - 1, 0));
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (voci[indiceAttivo]) scegliArticolo(e.target, voci[indiceAttivo]);
                } else if (e.key === 'Escape') {
                    chiudiRisultati(e.target.closest('.cerca-wrap'));
                }
            });

            form.addEventListener('focusout', function (e) {
                if (e.target.classList.contains('prz-um') && !e.target.value.trim()) {
                    var rigaPrezzo = e.target.closest('tr.riga-figlio');
                    if (rigaPrezzo) {
                        segnaOriginePrezzo(rigaPrezzo, false);
                        ricalcola();
                    }
                }
                if (e.target.classList.contains('qty')) {
                    var rigaQty = e.target.closest('tr.riga-materiale, tr.riga-posa');
                    if (rigaQty && !e.target.value.trim()) {
                        var padreQty = corpo.querySelector('tr.riga-padre[data-ix="' + rigaQty.getAttribute('data-padre-ix') + '"]');
                        var valorePadre = padreQty?.querySelector('.qty')?.value || '';
                        e.target.setAttribute('data-qty-origine', 'padre');
                        if (valorePadre) {
                            e.target.value = valorePadre;
                            ricalcola();
                        }
                    }
                }
                if (!e.target.classList.contains('codice-art') || e.target.readOnly) return;
                var input = e.target;
                setTimeout(function () {
                    if (input.closest('.cerca-wrap')?.contains(document.activeElement)) return;
                    chiudiRisultati(input.closest('.cerca-wrap'));
                    var padre = input.closest('tr.riga-padre');
                    if (padre && !padre.classList.contains('riga-sconto') && !padre.classList.contains('riga-articolo')) {
                        bloccaCodicePadre(padre);
                        ricalcola();
                    }
                    if (input.value.trim())
                        caricaDatiArticolo(input.closest('tr'), input.value.trim());
                }, 180);
            });

            document.addEventListener('click', function (e) {
                if (!e.target.closest('.cerca-wrap'))
                    chiudiRisultati();
            });

            form.addEventListener('submit', function () {
                document.querySelectorAll('tr.riga-padre:not(.riga-sconto):not(.riga-articolo)').forEach(function (padre) {
                    allineaMateriale(padre);
                    allineaPosa(padre);
                    allineaVenditaFigli(padre);
                    var materiale = corpo.querySelector('tr.riga-materiale[data-padre-ix="' + padre.getAttribute('data-ix') + '"] select.um');
                    if (materiale) materiale.disabled = false;
                });
                document.querySelectorAll('#formContabilita input.num').forEach(function (input) {
                    if (!input.value) return;
                    var numero = parseNum(input.value);
                    if (input.closest('tr.riga-sconto'))
                        numero = Math.abs(numero);
                    input.value = String(numero).replace('.', ',');
                });
            });

            document.getElementById('btnAggiungiAcconto')?.addEventListener('click', function () {
                var i = prossimoAcconto++;
                var html = document.getElementById('tplAcconto').innerHTML.replace(/__I__/g, String(i));
                document.getElementById('listaAcconti').insertAdjacentHTML('beforeend', html);
                var nuovo = document.querySelector('.riga-acconto:last-child input[name$=".Descrizione"]');
                if (nuovo) nuovo.focus();
            });

            document.querySelectorAll('tr.riga-posa').forEach(marcaPosa);
            document.querySelectorAll('tr.riga-padre:not(.riga-sconto):not(.riga-articolo)').forEach(bloccaCodicePadre);
            ricalcola();
        })();
    </script>
}

                                        <input type="hidden" name="Righe[@i].Figli.Index" value="@f" />
                                        <input type="hidden" name="Righe[@i].Figli[@f].Id" value="@figlio.Id" />
                                        <input type="hidden" name="Righe[@i].Figli[@f].IsPosa" value="@(figlio.IsPosa ? "true" : "false")" class="is-posa" />
                                        <input type="hidden" name="Righe[@i].Figli[@f].PrezzoDaPrezzo" value="false" class="origine-prezzo" />
                                        <div class="cerca-wrap">
                                            <input name="Righe[@i].Figli[@f].CodiceArticolo" class="form-control form-control-sm codice-art" maxlength="40" autocomplete="off" placeholder="Codice" value="@figlio.CodiceArticolo" />
                                            <div class="cerca-risultati d-none"></div>
                                        </div>
                                    </td>
                                    <td>
                                        <input name="Righe[@i].Figli[@f].Descrizione" class="form-control form-control-sm col-desc desc" maxlength="255" value="@figlio.Descrizione" />
                                        @if (figlio.SoloFinale)
                                        {
                                            <span class="badge-confronto">solo finale</span>
                                        }
                                    </td>
                                    <td class="col-um">@Html.Raw(HtmlUm($"Righe[{i}].Figli[{f}].UnitaMisura", figlio.UnitaMisura))</td>
                                    <td class="col-num">
                                        <input name="Righe[@i].Figli[@f].QuantitaPosata" class="form-control form-control-sm text-end num num-edit qty" inputmode="decimal" value="@Num(figlio.QuantitaPosata)" title="@(figlio.IsPosa ? "Se la lasci vuota, prende la quantità del padre." : null)" />
                                        @if (figlio.HaConfronto)
                                        {
                                            <div class="delta-riga delta-qty"></div>
                                        }
                                    </td>
                                    <td class="col-num">
                                        <input name="Righe[@i].Figli[@f].CostoMaterialeServizio" class="form-control form-control-sm text-end num num-edit costo" inputmode="decimal" value="@Num(figlio.CostoMaterialeServizio)" />
                                        <div class="delta-riga pm-costo" title="Costo presente in tabella per questo articolo"></div>
                                        @if (figlio.HaConfronto)
                                        {
                                            <div class="delta-riga delta-costo"></div>
                                        }
                                    </td>
                                    <td class="tot-cell text-end align-middle tot-costo"><span class="tot-val"></span></td>
                                    <td class="col-num">
                                        <input name="Righe[@i].Figli[@f].RicaricoPercentuale" class="form-control form-control-sm text-end num num-edit ricarico" inputmode="decimal" value="@Num(figlio.RicaricoEffettivo)" />
                                    </td>
                                    <td class="col-num">
                                        <div class="prezzo-um-wrap">
                                            <input class="form-control form-control-sm text-end num num-edit prz-um" inputmode="decimal" autocomplete="off" title="Prezzo di vendita nell'unità di questa riga. Sotto c'è il prezzo rapportato all'unità del padre. Il totale vendita usa quello." />
                                        </div>
                                        <div class="delta-riga prz-mq" title="Prezzo rapportato all'unità di misura del padre"></div>
                                        <input name="Righe[@i].Figli[@f].PrezzoVenditaCliente" class="form-control form-control-sm text-end num num-edit prz" inputmode="decimal" value="@Num(figlio.PrezzoVenditaCliente)" title="Scrivi il prezzo e si aggiorna il ricarico. Scrivi il ricarico e si aggiorna il prezzo." />
                                        <div class="delta-riga pm-prezzo" title="Prezzo medio di vendita"></div>
                                        @if (figlio.HaConfronto)
                                        {
                                            <div class="delta-riga delta-vendita"></div>
                                        }
                                    </td>
                                    <td class="tot-cell text-end align-middle tot-vendita"><span class="tot-val"></span></td>
                                    <td><input name="Righe[@i].Figli[@f].Note" class="form-control form-control-sm" maxlength="200" value="@figlio.Note" /></td>
                                    <td>
                                        @if (!figlio.IsPosa)
                                        {
                                            <button type="button" class="btn btn-sm btn-danger btn-elimina-figlio" title="Elimina figlio">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            @foreach (var assente in padre.Mancanti)
                            {
                                <tr class="riga-mancante" data-padre-ix="@i">
                                    <td>@assente.CodiceArticolo</td>
                                    <td>@assente.Descrizione <span class="badge-confronto">mancante in finale</span></td>
                                    <td>@assente.UnitaMisura</td>
                                    <td class="text-end"><div class="delta-riga">@TestoMancante(assente.InizialeQuantita)</div></td>
                                    <td class="text-end"><div class="delta-riga">@TestoMancante(assente.InizialeCostoUnitario)</div></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-end"><div class="delta-riga">@TestoMancante(assente.InizialePrezzoUnitario, 4)</div></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            }
                            <tr class="riga-totale-padre" data-ix="@i">
                                <td colspan="5" class="text-end">Totale costi</td>
                                <td class="text-end tot-costo-gruppo"></td>
                                <td colspan="2"></td>
                                <td class="text-end tot-vendita-manca" title="Quanto manca, sommando le vendite dei figli, per arrivare al totale vendita del padre"></td>
                                <td colspan="2"></td>
                            </tr>
                        }
                        @for (var m = 0; m < Model.RigheSoloIniziale.Count; m++)
                        {
                            var assentePadre = Model.RigheSoloIniziale[m];
                            <tr class="riga-mancante @(m == 0 ? "blocco-mancante" : null)">
                                <td>@assentePadre.CodiceArticolo</td>
                                <td>@assentePadre.Descrizione <span class="badge-confronto">mancante in finale</span></td>
                                <td>@assentePadre.UnitaMisura</td>
                                <td class="text-end"><div class="delta-riga">@TestoMancante(assentePadre.InizialeQuantita)</div></td>
                                <td class="text-end"><div class="delta-riga">@TestoMancante(assentePadre.InizialeCostoUnitario)</div></td>
                                <td></td>
                                <td></td>
                                <td class="text-end"><div class="delta-riga">@TestoMancante(assentePadre.InizialePrezzoUnitario, 4)</div></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            @foreach (var assente in assentePadre.Figli)
                            {
                                <tr class="riga-mancante">
                                    <td>@assente.CodiceArticolo</td>
                                    <td>@assente.Descrizione <span class="badge-confronto">mancante in finale</span></td>
                                    <td>@assente.UnitaMisura</td>
                                    <td class="text-end"><div class="delta-riga">@TestoMancante(assente.InizialeQuantita)</div></td>
                                    <td class="text-end"><div class="delta-riga">@TestoMancante(assente.InizialeCostoUnitario)</div></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-end"><div class="delta-riga">@TestoMancante(assente.InizialePrezzoUnitario, 4)</div></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row g-2">
            <div class="col-lg-7">
                <div class="card h-100 chiusura-box">
                    <div class="card-header py-2">Gestione Acconti</div>
                    <div class="card-body py-2">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Riferimento ordine</label>
                                <input asp-for="RiferimentoOrdine" class="form-control form-control-sm" maxlength="150" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Aliquota IVA %</label>
                                <input asp-for="AliquotaIva" class="form-control form-control-sm num" id="aliquotaIva" inputmode="decimal" />
                            </div>
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label mb-0">Acconti (imponibile)</label>
                                    <button type="button" class="btn btn-sm btn-primary" id="btnAggiungiAcconto" permission-required="GestioneCantieri:Edit">
                                        <i class="bi bi-plus-lg me-1"></i>Aggiungi acconto
                                    </button>
                                </div>
                                <div class="row g-1 mb-1 small text-muted">
                                    <div class="col">Descrizione</div>
                                    <div class="col-4 text-end pe-2">Imponibile €</div>
                                    <div class="col-auto" style="width:2.4rem"></div>
                                </div>
                                <div id="listaAcconti">
                                    @for (var a = 0; a < Model.Acconti.Count; a++)
                                    {
                                        <div class="row g-1 align-items-center mb-1 riga-acconto">
                                            <div class="col">
                                                <input type="hidden" name="Acconti.Index" value="@a" />
                                                <input type="hidden" name="Acconti[@a].Id" value="@Model.Acconti[a].Id" />
                                                <input name="Acconti[@a].Descrizione" class="form-control form-control-sm" maxlength="100" value="@Model.Acconti[a].Descrizione" />
                                            </div>
                                            <div class="col-4">
                                                <input name="Acconti[@a].Imponibile" class="form-control form-control-sm text-end num num-edit acconto-importo" inputmode="decimal" value="@Num(Model.Acconti[a].Imponibile)" />
                                            </div>
                                            <div class="col-auto">
                                                <button type="button" class="btn btn-sm btn-danger btn-elimina-acconto" title="Elimina acconto" permission-required="GestioneCantieri:Edit">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Note</label>
                                <textarea asp-for="Note" class="form-control form-control-sm" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-header">Riepilogo Economico</div>
                    <div class="card-body riepilogo-box">
                        <dl class="row mb-0">
                            <dt class="col-7">
                                Totale vendita <span class="comp-vendita" id="compVendita"></span>@if (Model.ConfrontaIniziale)
                                {
                                    <span class="delta-sotto" id="deltaVendita" title="Totale vendita della finale meno il totale vendita dell'iniziale" data-iniziale="@Inv(Model.TotaleVenditaIniziale)"></span>
                                }
                            </dt>
                            <dd class="col-5 text-end" id="totVendita">0,00</dd>
                            <dt class="col-7">
                                Totale costi
                                @if (Model.ConfrontaIniziale)
                                {
                                    <span class="delta-sotto" id="deltaCosti" title="Totale costi della finale meno il totale costi dell'iniziale" data-iniziale="@Inv(Model.TotaleCostiIniziale)"></span>
                                }
                            </dt>
                            <dd class="col-5 text-end" id="totCosti">0,00</dd>
                            <dt class="col-7" title="(totale vendita − totale costi) / totale vendita">Margine</dt>
                            <dd class="col-5 text-end fw-semibold" id="totMargine" title="(totale vendita − totale costi) / totale vendita">—</dd>
                            <div class="col-12"><hr class="riepilogo-sep" /></div>
                            <dt class="col-7">Totale vendita posa</dt>
                            <dd class="col-5 text-end" id="totVenditaPosa">0,00</dd>
                            <dt class="col-7">Totale acquisto posa</dt>
                            <dd class="col-5 text-end" id="totAcquistoPosa">0,00</dd>
                            <dt class="col-7" title="Totale vendita posa meno totale acquisto posa">
                                Guadagno posa
                                <div class="margine-piccolo" id="marginePosa" title="(totale vendita posa − totale acquisto posa) / totale vendita posa"></div>
                            </dt>
                            <dd class="col-5 text-end fw-semibold" id="totGuadagnoPosa" title="Totale vendita posa meno totale acquisto posa">0,00</dd>
                            <div class="col-12"><hr class="riepilogo-sep" /></div>
                            <dt class="col-7">Imponibile acconto</dt>
                            <dd class="col-5 text-end" id="totAcconto">0,00</dd>
                            <dt class="col-7">Imponibile a saldo</dt>
                            <dd class="col-5 text-end fw-semibold" id="totSaldo">0,00</dd>
                            <dt class="col-7">Totale con IVA</dt>
                            <dd class="col-5 text-end fw-semibold" id="totIva">0,00</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

    </form>
</div>


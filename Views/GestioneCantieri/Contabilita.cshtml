                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </td>
                            </tr>
                            @for (var f = 0; f < padre.Figli.Count; f++)
                            {
                                var figlio = padre.Figli[f];
                                <tr class="riga-contab riga-figlio@(figlio.IsPosa ? " riga-posa" : "")" data-padre-ix="@i"@Html.Raw(AttrConfronto(figlio))>

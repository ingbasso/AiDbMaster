            pointer-events: none;
        }
        .contab-table input.costo-padre {
            background: #f1f3f5;
            pointer-events: none;
        }
        .contab-table tr.posa-sotto-zero input.prz,
        .contab-table tr.posa-sotto-zero .tot-vendita {
            background-color: #fde8e8;
            color: #9b1c1c;
            font-weight: 600;
        }
        .riga-sforamento td {

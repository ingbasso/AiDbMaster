@model AiDbMaster.ViewModels.ContabilitaCantiereViewModel
@using System.Globalization
@using AiDbMaster.Models
@using AiDbMaster.ViewModels

@{
    var etichettaTipo = Model.Tipo == TipoContabilitaCantiere.Finale ? "Finale" : "Iniziale";
    ViewData["Title"] = $"Contabilità {etichettaTipo} - {Model.Titolo}";
    ViewBag.UseFluidContainer = true;
    var it = new CultureInfo("it-IT");

    string Num(decimal? valore)
    {
        if (!valore.HasValue)
            return string.Empty;
        return valore.Value.ToString("0.####", it);
    }

    string FlagProforma(string nome, bool acceso)
    {
        var spunta = acceso ? " checked" : "";
        return "<label class=\"flag-proforma\" title=\"Se è spuntato, la riga compare nella proforma.\">"
            + $"<input type=\"checkbox\" name=\"{nome}\" value=\"true\"{spunta} />"
            + $"<input type=\"hidden\" name=\"{nome}\" value=\"false\" />"
            + "<span>Proforma</span></label>";
    }

    string HtmlUm(string name, string? selezionata)
    {
        var opzioni = new (string Valore, string Testo)[]
        {
            ("M", "M"),
            ("MQ", "MQ"),
            ("MC", "MC"),
            ("SA", "SA (sacchetti)"),
            ("RT", "RT (rotoli)")
        };
        var sb = new System.Text.StringBuilder();
        sb.Append($"<select name=\"{name}\" class=\"form-select form-select-sm um\">");
        sb.Append("<option value=\"\"></option>");
        var trovato = false;
        foreach (var o in opzioni)
        {
            var sel = string.Equals(selezionata, o.Valore, StringComparison.OrdinalIgnoreCase);
            if (sel) trovato = true;
            sb.Append($"<option value=\"{o.Valore}\"{(sel ? " selected" : "")}>{o.Testo}</option>");
        }
        if (!string.IsNullOrWhiteSpace(selezionata) && !trovato)
            sb.Append($"<option value=\"{selezionata}\" selected>{selezionata}</option>");
        sb.Append("</select>");
        return sb.ToString();
    }

    string Inv(decimal? valore) => valore.HasValue
        ? valore.Value.ToString(CultureInfo.InvariantCulture)
        : string.Empty;

    string AttrConfronto(ContabilitaCantiereRigaViewModel riga)
    {
        var parti = new List<string>();
        if (riga.HaConfronto)
        {
            parti.Add($"data-iniz-qty=\"{Inv(riga.InizialeQuantita)}\"");
            parti.Add($"data-iniz-costo=\"{Inv(riga.InizialeCostoUnitario)}\"");
            parti.Add($"data-iniz-vendita=\"{Inv(riga.InizialePrezzoUnitario)}\"");
        }
        if (riga.HaConfrontoPosa)
        {
            parti.Add($"data-iniz-posa-qty=\"{Inv(riga.InizialePosaQuantita)}\"");
            parti.Add($"data-iniz-posa-costo=\"{Inv(riga.InizialePosaCostoUnitario)}\"");
            parti.Add($"data-iniz-posa-vendita=\"{Inv(riga.InizialePosaPrezzoUnitario)}\"");
        }
        return parti.Count == 0 ? string.Empty : " " + string.Join(" ", parti);
    }

    Microsoft.AspNetCore.Html.IHtmlContent TestoMancante(decimal? iniziale, int decimali = 2)
    {
        var baseVal = Math.Round(iniziale ?? 0m, decimali);
        if (baseVal == 0)
            return new Microsoft.AspNetCore.Html.HtmlString(string.Empty);

        var formato = "N" + decimali;
        var delta = -baseVal;
        var classe = delta > 0 ? "delta-positivo" : "delta-negativo";
        var dif = delta.ToString(formato, it);
        if (delta > 0)
            dif = "+" + dif;
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"iniz. {baseVal.ToString(formato, it)} · <span class=\"{classe}\">Δ {dif}</span>");
    }
}


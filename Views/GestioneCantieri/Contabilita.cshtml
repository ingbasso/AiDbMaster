            gap: .25rem;
            margin-right: .35rem;
            font-size: .68rem;
            font-weight: 600;
            color: #495057;
            vertical-align: middle;
            cursor: pointer;
            user-select: none;
        }
        .flag-proforma input { margin: 0; }
        .badge-confronto {
            display: inline-block;
            margin-left: .35rem;
            padding: 0 .4rem;
            border-radius: 999px;
            background: #e9ecef;
            color: #495057;
            font-size: .68rem;
            font-weight: 600;
            vertical-align: middle;
        }
        .riga-mancante td {
            background: #f8f9fa;
            color: #6c757d;
            font-size: .78rem;
        }
        .riepilogo-box dt { font-weight: 500; color: #6c757d; }
        .riepilogo-box dd { font-variant-numeric: tabular-nums; margin-bottom: 0.25rem; }
        .comp-vendita, .delta-sotto, .margine-piccolo { font-size: .72rem; font-weight: 400; line-height: 1.2; font-variant-numeric: tabular-nums; }
        .comp-vendita, .delta-sotto { margin-left: .35rem; }
        .comp-vendita { color: #6c757d; }
        .comp-vendita:empty, .delta-sotto:empty, .margine-piccolo:empty { display: none; }
        .margine-piccolo { display: block; color: #6c757d; }
        .margine-piccolo.delta-negativo { color: #c0392b; font-weight: 700; }
        .riepilogo-sep { margin: .45rem 0 .35rem; border: 0; border-top: 1px solid #dee2e6; opacity: 1; }
        .contab-info { font-size: .85rem; }
        .chiusura-box .form-label { font-size: .78rem; margin-bottom: .15rem; }
        .pagina-contabilita .btn,
        .pagina-contabilita .btn:hover,
        .pagina-contabilita .btn:focus,
        .pagina-contabilita .btn:active {
            color: #fff !important;
        }
        .btn-excel,
        .btn-excel:hover,
        .btn-excel:focus {
            background: #1d6f42;
            border-color: #1d6f42;
        }
    </style>
}

<div class="container-fluid pagina-contabilita">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <h2 class="mb-0 fs-4">
            <i class="bi bi-calculator me-2 text-primary"></i>Contabilità @etichettaTipo
            <span class="fw-normal text-muted fs-5">— @Model.Titolo</span>
        </h2>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Edit" asp-route-id="@Model.CantiereId" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Torna alla scheda
            </a>
            <a asp-action="Edit" asp-route-id="@Model.CantiereId" class="btn btn-success btn-sm" permission-required="GestioneCantieri:Edit">Annulla</a>
            <button type="submit" form="formContabilita" class="btn btn-primary btn-sm" permission-required="GestioneCantieri:Edit">
                <i class="bi bi-check-lg me-1"></i>Salva contabilità @etichettaTipo.ToLower()
            </button>
            <a asp-action="EsportaExcel" asp-route-id="@Model.CantiereId" asp-route-tipo="@Model.Tipo"
               class="btn btn-excel btn-sm"
               title="Scarica la griglia in Excel con i dati già salvati. Le modifiche non ancora salvate non entrano nel file.">
                <i class="bi bi-file-earmark-excel me-1"></i>Esporta Excel
            </a>
            <a asp-action="Proforma" asp-route-id="@Model.CantiereId" asp-route-tipo="@Model.Tipo"
               class="btn btn-dark btn-sm" target="_blank"
               title="Crea il PDF della proforma con i dati già salvati. Le modifiche non ancora salvate non entrano nel documento.">
                <i class="bi bi-file-earmark-pdf me-1"></i>Proforma
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(Model.Tipo == TipoContabilitaCantiere.Iniziale ? "active" : null)"
               asp-action="Contabilita" asp-route-id="@Model.CantiereId" asp-route-tipo="Iniziale">
                Iniziale
                @if (Model.HaContabilitaIniziale) { <span class="badge bg-success-subtle text-success ms-1">ok</span> }
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Tipo == TipoContabilitaCantiere.Finale ? "active" : null)"
               asp-action="Contabilita" asp-route-id="@Model.CantiereId" asp-route-tipo="Finale">
                Finale
                @if (Model.HaContabilitaFinale) { <span class="badge bg-success-subtle text-success ms-1">ok</span> }
            </a>
        </li>
    </ul>

    <form asp-action="SalvaContabilita" method="post" id="formContabilita">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CantiereId" />
        <input type="hidden" asp-for="Tipo" />

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span><i class="bi bi-diagram-3 me-1"></i>Lista Materiali e Lavorazioni</span>
                <div class="d-flex flex-wrap gap-2" permission-required="GestioneCantieri:Edit">
                    <button type="button" class="btn btn-secondary btn-sm" id="btnAggiungiPadre">
                        <i class="bi bi-plus-lg me-1"></i>Articolo con Posa
                    </button>
                    <button type="button" class="btn btn-info btn-sm" id="btnAggiungiArticolo">
                        <i class="bi bi-plus-lg me-1"></i>Aggiungi Articolo
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" id="btnAggiungiSconto">
                        <i class="bi bi-dash-lg me-1"></i>Aggiungi sconto
                    </button>
                    <button type="submit" formaction="@Url.Action("ImportaDaOrdini", new { id = Model.CantiereId, tipo = Model.Tipo })"
                            class="btn btn-primary btn-sm"
                            @(Model.NumeroOrdiniCollegati == 0 ? "disabled" : null)
                            onclick="return confirm('Importo gli articoli degli ordini collegati come padri. Le righe già presenti restano.');">
                        <i class="bi bi-box-arrow-in-down me-1"></i>Importa da ordini (@Model.NumeroOrdiniCollegati)
                    </button>
                    @if (Model.Tipo == TipoContabilitaCantiere.Finale)
                    {
                        <button type="submit" formaction="@Url.Action("CopiaInizialeSuFinale", new { id = Model.CantiereId })"
                                class="btn btn-warning btn-sm"
                                @(Model.HaContabilitaIniziale ? null : "disabled")
                                onclick="return confirm('Copio la contabilità iniziale (padri e figli) sulla finale. Le righe finali già presenti verranno sostituite.');">
                            <i class="bi bi-copy me-1"></i>Copia da iniziale
                        </button>
                    }
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0 contab-table">
                        <thead class="table-light">
                            <tr>
                                <th class="col-art">Art.</th>
                                <th>Descrizione</th>
                                <th class="col-um">UM</th>
                                <th class="col-num text-end">Q.tà</th>
                                <th class="col-num text-end">Ct Un.€</th>
                                <th class="col-tot text-end">Tot.Ct.€</th>
                                <th class="col-num text-end">Ric.%</th>
                                <th class="col-num text-end" title="Sul padre è il prezzo al metro quadro. Sul figlio è lo stesso prezzo riportato sui metri quadri del padre.">Ven. €/MQ</th>
                                <th class="col-tot text-end">Tot.Ven.€</th>
                                <th>Note</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="corpoContabilita">
                        @for (var i = 0; i < Model.Righe.Count; i++)
                        {
                            var padre = Model.Righe[i];
                            if (padre.IsSconto)
                            {
                                <tr class="riga-contab riga-padre riga-sconto" data-ix="@i"@Html.Raw(AttrConfronto(padre))>
                                    <td>
                                        <input type="hidden" name="Righe.Index" value="@i" />
                                        <input type="hidden" name="Righe[@i].Id" value="@padre.Id" />
                                        <input type="hidden" name="Righe[@i].IsSconto" value="true" />
                                    </td>
                                    <td>
                                        <input name="Righe[@i].Descrizione" class="form-control form-control-sm col-desc desc" maxlength="255" value="@(string.IsNullOrWhiteSpace(padre.Descrizione) ? "Sconto" : padre.Descrizione)" />
                                        @if (padre.SoloFinale)
                                        {
                                            <span class="badge-confronto">solo finale</span>
                                        }
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td class="col-num">
                                        <input name="Righe[@i].PrezzoVenditaCliente" class="form-control form-control-sm text-end num num-edit prz" inputmode="decimal" title="Importo dello sconto in euro. Viene sottratto dal totale vendita." value="@Num(padre.PrezzoVenditaCliente.HasValue ? Math.Abs(padre.PrezzoVenditaCliente.Value) : null)" />
                                        @if (padre.HaConfronto)
                                        {
                                            <div class="delta-riga delta-vendita"></div>
                                        }
                                    </td>
                                    <td class="tot-cell text-end align-middle tot-vendita"><span class="tot-val"></span></td>
                                    <td><input name="Righe[@i].Note" class="form-control form-control-sm" maxlength="200" value="@padre.Note" /></td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-danger btn-elimina-padre" title="Elimina sconto">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                                continue;
                            }
                            if (padre.IsArticoloSingolo)
                            {
                                <tr class="riga-contab riga-padre riga-articolo" data-ix="@i"@Html.Raw(AttrConfronto(padre))>
                                    <td class="col-art">
                                        <input type="hidden" name="Righe.Index" value="@i" />
                                        <input type="hidden" name="Righe[@i].Id" value="@padre.Id" />
                                        <input type="hidden" name="Righe[@i].IsArticoloSingolo" value="true" />
                                        <div class="cerca-wrap">
                                            <input name="Righe[@i].CodiceArticolo" class="form-control form-control-sm codice-art" maxlength="40" autocomplete="off" placeholder="Codice" value="@padre.CodiceArticolo" />
                                            <div class="cerca-risultati d-none"></div>
                                        </div>
                                    </td>
                                    <td>
                                        <input name="Righe[@i].Descrizione" class="form-control form-control-sm col-desc desc" maxlength="255" value="@padre.Descrizione" />
                                        @if (padre.SoloFinale)
                                        {
                                            <span class="badge-confronto">solo finale</span>
                                        }
                                    </td>
                                    <td class="col-um">@Html.Raw(HtmlUm($"Righe[{i}].UnitaMisura", padre.UnitaMisura))</td>
                                    <td class="col-num">
                                        <input name="Righe[@i].QuantitaPosata" class="form-control form-control-sm text-end num num-edit qty" inputmode="decimal" value="@Num(padre.QuantitaPosata)" />
                                        @if (padre.HaConfronto)
                                        {
                                            <div class="delta-riga delta-qty"></div>
                                        }
                                    </td>
                                    <td class="col-num">
                                        <input name="Righe[@i].CostoMaterialeServizio" class="form-control form-control-sm text-end num num-edit costo" inputmode="decimal" value="@Num(padre.CostoMaterialeServizio)" />
                                        @if (padre.HaConfronto)
                                        {
                                            <div class="delta-riga delta-costo"></div>
                                        }
                                    </td>
                                    <td class="tot-cell text-end align-middle tot-costo"><span class="tot-val"></span></td>
                                    <td class="col-num">
                                        <input name="Righe[@i].RicaricoPercentuale" class="form-control form-control-sm text-end num num-edit ricarico" inputmode="decimal" value="@Num(padre.RicaricoPercentuale)" />
                                    </td>
                                    <td class="col-num">
                                        <input name="Righe[@i].PrezzoVenditaCliente" class="form-control form-control-sm text-end num num-edit prz" inputmode="decimal" value="@Num(padre.PrezzoVenditaCliente)" />
                                        @if (padre.HaConfronto)
                                        {
                                            <div class="delta-riga delta-vendita"></div>
                                        }
                                    </td>
                                    <td class="tot-cell text-end align-middle tot-vendita"><span class="tot-val"></span></td>
                                    <td><input name="Righe[@i].Note" class="form-control form-control-sm" maxlength="200" value="@padre.Note" /></td>
                                    <td class="text-nowrap">
                                        @Html.Raw(FlagProforma($"Righe[{i}].MostraInProforma", padre.MostraInProforma))
                                        <button type="button" class="btn btn-sm btn-danger btn-elimina-padre" title="Elimina articolo">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                                continue;
                            }
                            <tr class="riga-contab riga-padre" data-ix="@i"@Html.Raw(AttrConfronto(padre))>
                                <td class="col-art">
                                    <input type="hidden" name="Righe.Index" value="@i" />
                                    <input type="hidden" name="Righe[@i].Id" value="@padre.Id" />
                                    <div class="codice-con-figlio">
                                        <div class="cerca-wrap">
                                            <input name="Righe[@i].CodiceArticolo" class="form-control form-control-sm codice-art" maxlength="40" autocomplete="off" placeholder="Codice" value="@padre.CodiceArticolo" @(string.IsNullOrWhiteSpace(padre.CodiceArticolo) ? null : "readonly") title="@(string.IsNullOrWhiteSpace(padre.CodiceArticolo) ? "Codice articolo. Dopo la scelta non si può più modificare." : "Il codice non si può più modificare.")" />
                                            <div class="cerca-risultati d-none"></div>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-primary btn-aggiungi-figlio" title="Aggiungi figlio">
                                            <i class="bi bi-plus-lg"></i>

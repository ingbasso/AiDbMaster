@model IList<AiDbMaster.ViewModels.CantiereElencoItemViewModel>
@using AiDbMaster.Models

@{
    ViewData["Title"] = "Elenco Cantieri";
    ViewBag.UseFluidContainer = true;
    var filtroTesto = ViewBag.FiltroTesto as string;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">
            <i class="bi bi-building me-2 text-primary"></i>Elenco Cantieri
        </h2>
        <a asp-action="Create" class="btn btn-primary btn-sm" permission-required="GestioneCantieri:Create">
            <i class="bi bi-plus-circle me-1"></i>Nuovo cantiere
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Cerca</label>
                    <input type="text" name="q" value="@filtroTesto" class="form-control" placeholder="Nome, codice, cliente, località, impresa di posa" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Stato</label>
                    <select name="stato" class="form-select" asp-items="@(ViewBag.Stati as IEnumerable<SelectListItem>)">
                        <option value="">Tutti gli stati</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search me-1"></i>Filtra
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Azzera</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <i class="bi bi-list-ul me-1"></i>Cantieri (@Model.Count)
        </div>
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Non ci sono cantieri con questi filtri.
                    <div class="mt-2">
                        <a asp-action="Create" permission-required="GestioneCantieri:Create">Crea la prima scheda</a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Codice</th>
                                <th>Cantiere</th>
                                <th>Cliente</th>
                                <th>Località</th>
                                <th>Impresa di posa</th>
                                <th>Date previste</th>
                                <th class="text-center">Stato</th>
                                <th class="text-center">Ordini</th>
                                <th class="text-center" style="width:150px;">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>@item.Codice</strong></td>
                                <td>@item.Nome</td>
                                <td>@item.CodiceCliente - @item.ClienteNome</td>
                                <td>
                                    @item.Localita
                                    @if (!string.IsNullOrWhiteSpace(item.Provincia))
                                    {
                                        <span class="text-muted">(@item.Provincia)</span>
                                    }
                                </td>
                                <td>@(item.ImpresaPosa ?? "—")</td>
                                <td>
                                    @if (item.DataInizioPrevista.HasValue || item.DataFinePrevista.HasValue)
                                    {
                                        @(item.DataInizioPrevista?.ToString("dd/MM/yyyy") ?? "…")
                                        <span class="text-muted">→</span>
                                        @(item.DataFinePrevista?.ToString("dd/MM/yyyy") ?? "…")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="@item.Stato.GetBadgeCss()">@item.Stato.GetDisplayName()</span>
                                </td>
                                <td class="text-center">@item.NumeroOrdini</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"
                                       title="Apri scheda">
                                        <i class="bi bi-journal-text"></i>
                                    </a>
                                    <a asp-action="Contabilita" asp-route-id="@item.Id" asp-route-tipo="Iniziale"
                                       class="btn btn-sm btn-outline-secondary me-1" title="Contabilità">
                                        <i class="bi bi-calculator"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"
                                            permission-required="GestioneCantieri:Delete" title="Elimina">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@foreach (var item in Model)
{
    <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" data-bs-backdrop="false" data-bs-keyboard="true">
        <div class="modal-dialog" style="margin-top: 120px; box-shadow: 0 8px 32px rgba(0,0,0,0.3);">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Conferma eliminazione</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Eliminare la scheda del cantiere? Gli ordini collegati <strong>non</strong> vengono cancellati, solo staccati da questa scheda.</p>
                    <ul class="list-unstyled mb-0">
                        <li><strong>Codice:</strong> @item.Codice</li>
                        <li><strong>Nome:</strong> @item.Nome</li>
                        <li><strong>Cliente:</strong> @item.ClienteNome</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Elimina</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function makeModalDraggable(modalEl) {
            var dialog = modalEl.querySelector('.modal-dialog');
            var header = modalEl.querySelector('.modal-header');
            var dragging = false;
            var startX = 0, startY = 0;
            var currentX = 0, currentY = 0;

            header.style.cursor = 'move';
            header.addEventListener('mousedown', function(e) {
                if (e.target.closest('.btn-close') || e.target.closest('input') || e.target.closest('select') || e.target.closest('button')) return;
                startX = e.clientX - currentX;
                startY = e.clientY - currentY;
                dragging = true;
                e.preventDefault();
            });

            document.addEventListener('mousemove', function(e) {
                if (!dragging) return;
                currentX = e.clientX - startX;
                currentY = e.clientY - startY;
                dialog.style.transform = 'translate(' + currentX + 'px, ' + currentY + 'px)';
            });

            document.addEventListener('mouseup', function() { dragging = false; });
            modalEl.addEventListener('show.bs.modal', function() {
                currentX = 0;
                currentY = 0;
                dialog.style.transform = '';
            });
        }

        document.querySelectorAll('.modal').forEach(makeModalDraggable);
    </script>
}

@model AiDbMaster.Models.PstreeAssociazioniImportSaldiCE

@{
    ViewData["Title"] = "Modifica Ripartizione Import Saldi";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-pencil text-warning"></i> Modifica Ripartizione</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Modifica Ripartizione #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="CodicePdC" class="form-label">
                                <i class="bi bi-book"></i> Codice Piano dei Conti <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CodicePdC" class="form-select">
                                <option value="">-- Seleziona un conto --</option>
                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.CodiciPdC)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="CodicePdC" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdCodiceConto" class="form-label">
                                <i class="bi bi-diagram-3"></i> Voce Conto Economico <span class="text-danger">*</span>
                            </label>
                            <select asp-for="IdCodiceConto" class="form-select">
                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.VociCE)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="IdCodiceConto" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdSede" class="form-label">
                                    <i class="bi bi-building"></i> Sede <span class="text-danger">*</span>
                                </label>
                                <select asp-for="IdSede" class="form-select">
                                    <option value="">-- Seleziona una sede --</option>
                                    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Sedi)
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="IdSede" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Percentuale" class="form-label">
                                    <i class="bi bi-percent"></i> Percentuale <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="Percentuale" class="form-control" type="number" step="0.01" min="0" max="100" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="Percentuale" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Anno" class="form-label">
                                    <i class="bi bi-calendar"></i> Anno <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Anno" class="form-select">
                                    @foreach (var a in (IEnumerable<int>)ViewBag.AnniDisponibili)
                                    {
                                        <option value="@a" selected="@(a == Model.Anno)">@a</option>
                                    }
                                </select>
                                <span asp-validation-for="Anno" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Mese" class="form-label">
                                    <i class="bi bi-calendar-month"></i> Mese <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Mese" class="form-select">
                                    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Mesi)
                                    {
                                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Mese" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Salva Modifiche
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

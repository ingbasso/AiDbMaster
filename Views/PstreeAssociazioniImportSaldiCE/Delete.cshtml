@model AiDbMaster.Models.PstreeAssociazioniImportSaldiCE

@{
    ViewData["Title"] = "Elimina Ripartizione";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-trash text-danger"></i> Elimina Ripartizione</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Conferma Eliminazione</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-circle"></i>
                        Sei sicuro di voler eliminare questa ripartizione?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Codice PdC</dt>
                        <dd class="col-sm-8">
                            <code>@Model.CodicePdC</code>
                            @if (Model.PianoDeiConti != null)
                            {
                                <span class="ms-2">- @Model.PianoDeiConti.DescrizionePdC</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Voce Conto Economico</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.IdCodiceConto</span>
                            @if (Model.ContoEconomico != null)
                            {
                                <span class="ms-1">@Model.ContoEconomico.DescrizioneConto</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Sede</dt>
                        <dd class="col-sm-8">@(Model.Sede != null ? Model.Sede.Sede : Model.IdSede.ToString())</dd>

                        <dt class="col-sm-4">Periodo</dt>
                        <dd class="col-sm-8">@Model.Periodo</dd>

                        <dt class="col-sm-4">Percentuale</dt>
                        <dd class="col-sm-8">@Model.PercentualeFormattata</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Conferma Eliminazione
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

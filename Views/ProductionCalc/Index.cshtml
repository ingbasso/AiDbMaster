@model AiDbMaster.ViewModels.ProductionCalcViewModel

@{
    ViewData["Title"] = "Production Calc";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    .calc-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }
    .calc-table td {
        padding: 4px 10px;
        border: 1px solid #dee2e6;
        vertical-align: middle;
    }
    .calc-table .label-cell {
        background-color: #f0f0f0;
        font-weight: 600;
        white-space: nowrap;
        width: 1%;
        color: #333;
    }
    .calc-table .value-cell {
        background-color: #fff;
        min-width: 80px;
    }
    .calc-table .value-highlight {
        background-color: #fffde7;
        font-weight: 700;
        font-size: 1.1rem;
    }
    .calc-table .header-row td {
        background-color: #1565c0;
        color: #fff;
        font-weight: 700;
        font-size: 0.95rem;
        text-align: center;
        padding: 8px 10px;
    }
    .calc-table .section-title {
        background-color: #e3f2fd;
        font-weight: 700;
        color: #1565c0;
    }
    .file-updated-box {
        text-align: right;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1565c0;
    }
    .calc-input {
        font-weight: 700;
        border: 2px solid #90caf9;
        transition: border-color 0.2s;
    }
    .calc-input:focus {
        border-color: #1565c0;
        box-shadow: 0 0 0 0.2rem rgba(21,101,192,0.25);
    }
</style>

<div class="container-fluid">
    <!-- Sezione Filtro -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="bi bi-calculator me-2 fs-5"></i>
            <h5 class="mb-0">Production Calc</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div class="row align-items-end">
                    <div class="col mb-3">
                        <label class="form-label fw-bold">
                            <i class="bi bi-box-seam me-1"></i>Seleziona Articolo
                        </label>
                        <div class="d-flex gap-2">
                            <div class="flex-grow-1">
                                <select name="codiceArticolo" class="form-select" id="codiceArticolo">
                                    <option value="">-- Cerca per codice o descrizione --</option>
                                    @if (!string.IsNullOrEmpty(Model.CodiceArticolo))
                                    {
                                        <option value="@Model.CodiceArticolo" selected>@Model.CodiceArticolo @(!string.IsNullOrEmpty(Model.Descrizione) ? " - " + Model.Descrizione : "")</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-1"></i>Calcola
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="resetForm()">
                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
                            </button>
                        </div>
                        <small class="text-muted">Digita almeno 2 caratteri per cercare</small>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Errore))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Errore
        </div>
    }

    @if (Model.ArticoloTrovato)
    {
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <table class="calc-table">
                    <!-- Riga intestazione -->
                    <tr class="header-row">
                        <td colspan="6" style="text-align:left;">PRODUCTION CALC</td>
                        <td colspan="4" class="file-updated-box" style="background-color:#1565c0; color:#fff;">
                            File updated: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                        </td>
                    </tr>

                    <!-- Code Article + UMP -->
                    <tr>
                        <td class="label-cell">Code Article</td>
                        <td class="value-cell value-highlight" style="font-size:1.3rem;">@Model.CodiceArticolo</td>
                        <td class="label-cell">UMP</td>
                        <td class="value-cell value-highlight">@Model.UnitaMisura</td>
                        <td colspan="6"></td>
                    </tr>

                    <!-- Descrizione -->
                    <tr>
                        <td class="label-cell">Article description</td>
                        <td colspan="9" class="value-cell">@Model.Descrizione</td>
                    </tr>

                    <!-- Color/Note -->
                    <tr>
                        <td class="label-cell">Color/Note</td>
                        <td colspan="9" class="value-cell">@(Model.DescrizioneUlteriore ?? "–")</td>
                    </tr>

                    <!-- Politica di Riordino + Quantità per Tavole -->
                    <tr>
                        <td class="label-cell">Politica di Riordino</td>
                        <td class="value-cell">@(Model.PoliticaDiRiordino ?? "–")</td>
                        <td colspan="5"></td>
                        <td class="label-cell">Quantità per Tavole</td>
                        <td class="value-cell" colspan="2">@Model.QtaUMPPerTavola.ToString("N1")</td>
                    </tr>

                    <!-- Lot + Sublot + Quantità Per Pallet -->
                    <tr>
                        <td class="label-cell">Lot (@Model.UnitaMisura)</td>
                        <td class="value-cell">@(Model.LottoStandardProduzione != 0 ? Model.LottoStandardProduzione.ToString("N0") : "–")</td>
                        <td class="label-cell">Sublot</td>
                        <td class="value-cell">@(Model.Sottolotto != 0 ? Model.Sottolotto.ToString("N0") : "–")</td>
                        <td colspan="3"></td>
                        <td class="label-cell">Quantità Per Pallet</td>
                        <td class="value-cell" colspan="2">@Model.QtaUMPPerPallet.ToString("N1")</td>
                    </tr>

                    <!-- Stock min/max + Tavole Per Pallet -->
                    <tr>
                        <td class="label-cell">Stock (@Model.UnitaMisura)</td>
                        <td class="value-cell">min @(Model.ScortaMinima != 0 ? Model.ScortaMinima.ToString("N0") : "–")</td>
                        <td colspan="1"></td>
                        <td class="value-cell">max @(Model.ScortaMassima != 0 ? Model.ScortaMassima.ToString("N0") : "–")</td>
                        <td colspan="3"></td>
                        <td class="label-cell">Tavole Per Pallet</td>
                        <td class="value-cell" colspan="2">@Model.TavolePerPallet.ToString("N1")</td>
                    </tr>

                    <!-- Tavole Ora Teoriche -->
                    <tr>
                        <td class="label-cell">Tavole prodotte per Ora Teoriche</td>
                        <td class="value-cell value-highlight" colspan="9">@Model.TavoleOraTeoriche.ToString("N1")</td>
                    </tr>

                    <!-- Efficienza -->
                    <tr>
                        <td class="label-cell">Efficienza sul ciclo produttivo</td>
                        <td class="value-cell" colspan="9">@(Model.Efficienza.ToString("N0"))%</td>
                    </tr>

                    <!-- Tavole Ora Reali -->
                    <tr>
                        <td class="label-cell">Tavole prodotte per Ora Reali</td>
                        <td class="value-cell value-highlight" colspan="9">@Model.TavoleOraReali.ToString("N1")</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- Sezione Calcolo Produzione -->
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-success text-white d-flex align-items-center">
                <i class="bi bi-calculator me-2 fs-5"></i>
                <h5 class="mb-0">Calcolo Produzione</h5>
            </div>
            <div class="card-body p-3">
                <table class="calc-table">
                    <tr class="header-row">
                        <td style="width:180px;"></td>
                        <td>Ore Previste</td>
                        <td>Tavole Previste</td>
                        <td>Pallet Previsti</td>
                        <td>Qtà Prevista (@Model.UnitaMisura)</td>
                        <td>Efficienza Ciclo</td>
                    </tr>
                    <!-- Riga 1: Teorica (100%) - Editabile -->
                    <tr>
                        <td class="label-cell" style="background-color:#e3f2fd;">
                            <i class="bi bi-pencil-square me-1"></i>Teorica (100%)
                        </td>
                        <td class="value-cell">
                            <input type="number" id="calcOre" class="form-control form-control-sm text-end calc-input"
                                   step="0.1" min="0" placeholder="0" data-field="ore" />
                        </td>
                        <td class="value-cell">
                            <input type="number" id="calcTavole" class="form-control form-control-sm text-end calc-input"
                                   step="1" min="0" placeholder="0" data-field="tavole" />
                        </td>
                        <td class="value-cell">
                            <input type="number" id="calcPallet" class="form-control form-control-sm text-end calc-input"
                                   step="0.1" min="0" placeholder="0" data-field="pallet" />
                        </td>
                        <td class="value-cell">
                            <input type="number" id="calcQta" class="form-control form-control-sm text-end calc-input"
                                   step="0.1" min="0" placeholder="0" data-field="qta" />
                        </td>
                        <td class="value-cell text-center" style="font-weight:700; font-size:1.1rem;">
                            100%
                        </td>
                    </tr>
                    <!-- Riga 2: Reale (con Efficienza) - Solo lettura -->
                    <tr style="background-color:#fff8e1;">
                        <td class="label-cell" style="background-color:#fff3e0;">
                            <i class="bi bi-graph-down-arrow me-1"></i>Reale (@(Model.Efficienza.ToString("N0"))%)
                        </td>
                        <td class="value-cell" style="background-color:#fff8e1;">
                            <span id="realeOre" class="d-block text-end fw-bold">0</span>
                        </td>
                        <td class="value-cell" style="background-color:#fff8e1;">
                            <span id="realeTavole" class="d-block text-end fw-bold">0</span>
                        </td>
                        <td class="value-cell" style="background-color:#fff8e1;">
                            <span id="realePallet" class="d-block text-end fw-bold">0</span>
                        </td>
                        <td class="value-cell" style="background-color:#fff8e1;">
                            <span id="realeQta" class="d-block text-end fw-bold">0</span>
                        </td>
                        <td class="value-cell text-center" style="background-color:#fff8e1; font-weight:700; font-size:1.1rem; color:#e65100;">
                            @(Model.Efficienza.ToString("N0"))%
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    }
    <div style="height:120px;"></div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            $('#codiceArticolo').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Cerca per codice o descrizione --',
                allowClear: true,
                minimumInputLength: 2,
                width: '100%',
                ajax: {
                    url: '@Url.Action("SearchArticoli", "ProductionCalc")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return { term: params.term };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return { id: item.id, text: item.text };
                            })
                        };
                    },
                    cache: true
                }
            });

            const sidebar = document.querySelector('.sidebar, #sidebar-wrapper, .offcanvas');
            if (sidebar) {
                sidebar.addEventListener('transitionend', function() {
                    setTimeout(function() {
                        var val = $('#codiceArticolo').val();
                        var text = $('#codiceArticolo option:selected').text();
                        $('#codiceArticolo').select2('destroy').select2({
                            theme: 'bootstrap-5',
                            placeholder: '-- Cerca per codice o descrizione --',
                            allowClear: true,
                            minimumInputLength: 2,
                            width: '100%',
                            ajax: {
                                url: '@Url.Action("SearchArticoli", "ProductionCalc")',
                                dataType: 'json',
                                delay: 250,
                                data: function (params) {
                                    return { term: params.term };
                                },
                                processResults: function (data) {
                                    return {
                                        results: $.map(data, function (item) {
                                            return { id: item.id, text: item.text };
                                        })
                                    };
                                },
                                cache: true
                            }
                        });
                        if (val) {
                            var option = new Option(text, val, true, true);
                            $('#codiceArticolo').append(option).trigger('change');
                        }
                    }, 100);
                });
            }
        });

        function resetForm() {
            $('#codiceArticolo').val(null).trigger('change');
            window.location.href = '@Url.Action("Index", "ProductionCalc")';
        }

        @if (Model.ArticoloTrovato)
        {
            <text>
            var tavoleOraTeoriche = @(Model.TavoleOraTeoriche.ToString(System.Globalization.CultureInfo.InvariantCulture));
            var tavolePerPallet = @(Model.TavolePerPallet.ToString(System.Globalization.CultureInfo.InvariantCulture));
            var qtaUMPPerTavola = @(Model.QtaUMPPerTavola.ToString(System.Globalization.CultureInfo.InvariantCulture));
            var efficienzaReale = @(Model.Efficienza.ToString(System.Globalization.CultureInfo.InvariantCulture)) / 100;
            var isCalculating = false;

            function roundVal(val, dec) {
                return Math.round(val * Math.pow(10, dec)) / Math.pow(10, dec);
            }

            function fmtNum(val) {
                return roundVal(val, 1).toLocaleString('it-IT', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
            }

            function updateReale(ore, tavole, pallet, qta) {
                document.getElementById('realeOre').textContent = fmtNum(ore);
                document.getElementById('realeTavole').textContent = fmtNum(tavole * efficienzaReale);
                document.getElementById('realePallet').textContent = fmtNum(pallet * efficienzaReale);
                document.getElementById('realeQta').textContent = fmtNum(qta * efficienzaReale);
            }

            function calcFromOre(ore) {
                var tavole = tavoleOraTeoriche * ore;
                var pallet = tavolePerPallet > 0 ? tavole / tavolePerPallet : 0;
                var qta = tavole * qtaUMPPerTavola;
                document.getElementById('calcTavole').value = roundVal(tavole, 1);
                document.getElementById('calcPallet').value = roundVal(pallet, 1);
                document.getElementById('calcQta').value = roundVal(qta, 1);
                updateReale(ore, tavole, pallet, qta);
            }

            function calcFromTavole(tavole) {
                var ore = tavoleOraTeoriche > 0 ? tavole / tavoleOraTeoriche : 0;
                var pallet = tavolePerPallet > 0 ? tavole / tavolePerPallet : 0;
                var qta = tavole * qtaUMPPerTavola;
                document.getElementById('calcOre').value = roundVal(ore, 1);
                document.getElementById('calcPallet').value = roundVal(pallet, 1);
                document.getElementById('calcQta').value = roundVal(qta, 1);
                updateReale(ore, tavole, pallet, qta);
            }

            function calcFromPallet(pallet) {
                var tavole = pallet * tavolePerPallet;
                var ore = tavoleOraTeoriche > 0 ? tavole / tavoleOraTeoriche : 0;
                var qta = tavole * qtaUMPPerTavola;
                document.getElementById('calcOre').value = roundVal(ore, 1);
                document.getElementById('calcTavole').value = roundVal(tavole, 1);
                document.getElementById('calcQta').value = roundVal(qta, 1);
                updateReale(ore, tavole, pallet, qta);
            }

            function calcFromQta(qta) {
                var tavole = qtaUMPPerTavola > 0 ? qta / qtaUMPPerTavola : 0;
                var ore = tavoleOraTeoriche > 0 ? tavole / tavoleOraTeoriche : 0;
                var pallet = tavolePerPallet > 0 ? tavole / tavolePerPallet : 0;
                document.getElementById('calcOre').value = roundVal(ore, 1);
                document.getElementById('calcTavole').value = roundVal(tavole, 1);
                document.getElementById('calcPallet').value = roundVal(pallet, 1);
                updateReale(ore, tavole, pallet, qta);
            }

            document.getElementById('calcOre').addEventListener('input', function() {
                if (isCalculating) return; isCalculating = true;
                calcFromOre(parseFloat(this.value) || 0);
                isCalculating = false;
            });
            document.getElementById('calcTavole').addEventListener('input', function() {
                if (isCalculating) return; isCalculating = true;
                calcFromTavole(parseFloat(this.value) || 0);
                isCalculating = false;
            });
            document.getElementById('calcPallet').addEventListener('input', function() {
                if (isCalculating) return; isCalculating = true;
                calcFromPallet(parseFloat(this.value) || 0);
                isCalculating = false;
            });
            document.getElementById('calcQta').addEventListener('input', function() {
                if (isCalculating) return; isCalculating = true;
                calcFromQta(parseFloat(this.value) || 0);
                isCalculating = false;
            });
            </text>
        }
    </script>
}

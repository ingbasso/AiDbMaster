@{
    ViewData["Title"] = "Interrogazioni DB";
}

<div class="container">
    <div class="content-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-search me-2 text-primary"></i>Interrogazioni Database</h2>
        </div>

        <div class="row">
            <!-- Card Disponibilità -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-boxes me-2"></i>Disponibilità Articolo
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            Interroga il database per visualizzare la disponibilità di un articolo specifico 
                            in tutti i magazzini, con informazioni su esistenza, impegnato e ordinato da fornitori.
                        </p>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-circle text-success me-2"></i>Esistenza per magazzino</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Quantità impegnata</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Ordinato da fornitori</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Disponibile calcolato</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-light">
                        <a asp-action="Disponibilita" class="btn btn-info text-white">
                            <i class="bi bi-arrow-right-circle me-2"></i>Vai alla Disponibilità
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card Consegne Programmate -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar-event me-2"></i>Consegne Programmate
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            Visualizza e gestisci tutte le consegne programmate per i clienti, con filtri avanzati 
                            per cliente, agente, provincia e regione.
                        </p>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-circle text-success me-2"></i>Filtro per periodo e cliente</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Ricerca geografica (regione/provincia)</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Evidenziazione consegne in ritardo</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Dettaglio ordini e righe</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-light">
                        <a asp-action="ConsegneProgrammate" class="btn btn-success text-white">
                            <i class="bi bi-arrow-right-circle me-2"></i>Vai alle Consegne
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Card Dashboard Consegne -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-graph-up me-2"></i>Dashboard Consegne
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            Dashboard completa con KPI, grafici e analisi sulle consegne. 
                            Visualizza trend, classifiche agenti e province, consegne in ritardo.
                        </p>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-graph-up text-primary me-2"></i>KPI e statistiche in tempo reale</li>
                            <li><i class="bi bi-graph-up text-primary me-2"></i>Grafici consegnato vs da consegnare</li>
                            <li><i class="bi bi-graph-up text-primary me-2"></i>Top 10 Agenti e Province</li>
                            <li><i class="bi bi-graph-up text-primary me-2"></i>Monitoraggio ritardi</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-light">
                        <a asp-controller="DashboardConsegne" asp-action="Index" class="btn btn-primary text-white">
                            <i class="bi bi-arrow-right-circle me-2"></i>Vai alla Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Informazioni Aggiuntive -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>Informazioni
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">
                            <strong>Interrogazioni DB</strong> è una sezione dedicata alle query avanzate sul database 
                            per ottenere informazioni dettagliate e report specifici sull'inventario, ordini e disponibilità.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


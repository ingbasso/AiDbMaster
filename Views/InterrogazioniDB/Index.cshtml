@{
    ViewData["Title"] = "Interrogazioni DB";
}

<div class="container">
    <div class="content-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-search me-2 text-primary"></i>Interrogazioni Database</h2>
        </div>

        <div class="row">
            <!-- Card Disponibilità -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-boxes me-2"></i>Disponibilità Articolo
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            Interroga il database per visualizzare la disponibilità di un articolo specifico 
                            in tutti i magazzini, con informazioni su esistenza, impegnato e ordinato da fornitori.
                        </p>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-circle text-success me-2"></i>Esistenza per magazzino</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Quantità impegnata</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Ordinato da fornitori</li>
                            <li><i class="bi bi-check-circle text-success me-2"></i>Disponibile calcolato</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-light">
                        <a asp-action="Disponibilita" class="btn btn-info text-white">
                            <i class="bi bi-arrow-right-circle me-2"></i>Vai alla Disponibilità
                        </a>
                    </div>
                </div>
            </div>

            <!-- Card Consegne Programmate -->
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar-event me-2"></i>Consegne Programmate
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">
                            Visualizza le consegne programmate per gli articoli ordinati, con date previste 
                            e dettagli sui fornitori.
                        </p>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-clock text-warning me-2"></i>Date di consegna previste</li>
                            <li><i class="bi bi-clock text-warning me-2"></i>Quantità ordinate</li>
                            <li><i class="bi bi-clock text-warning me-2"></i>Fornitori</li>
                            <li><i class="bi bi-clock text-warning me-2"></i>Note e dettagli</li>
                        </ul>
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <small>Funzionalità in fase di implementazione</small>
                        </div>
                    </div>
                    <div class="card-footer bg-light">
                        <a asp-action="ConsegneProgrammate" class="btn btn-info text-white disabled">
                            <i class="bi bi-arrow-right-circle me-2"></i>Vai alle Consegne (Prossimamente)
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Informazioni Aggiuntive -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>Informazioni
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="mb-0">
                            <strong>Interrogazioni DB</strong> è una sezione dedicata alle query avanzate sul database 
                            per ottenere informazioni dettagliate e report specifici sull'inventario, ordini e disponibilità.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


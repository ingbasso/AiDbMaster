@model AiDbMaster.ViewModels.ConsegneProgrammateViewModel

@{
    ViewData["Title"] = "Lista Ordini Clienti";
    ViewBag.UseFluidContainer = true;
}

@section Styles {
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <style>
        .accordion-header-custom {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 1rem;
            border-radius: 0.375rem 0.375rem 0 0;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .accordion-header-custom:hover {
            background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

        .accordion-header-custom.collapsed {
            border-radius: 0.375rem;
        }

        .header-info-inline {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            font-size: 0.85rem;
            margin-top: 0.5rem;
        }

        .header-info-inline > span {
            white-space: nowrap;
        }

        .header-info-inline strong {
            font-weight: 600;
        }

        .badge-custom {
            font-size: 0.85rem;
            padding: 0.35rem 0.65rem;
        }

        .table-righe {
            font-size: 0.8rem;
        }

        .table-righe thead {
            background-color: #f8f9fa;
            font-weight: 600;
        }

        .table-righe td, .table-righe th {
            padding: 0.4rem 0.5rem;
        }

        .select2-container {
            width: 100% !important;
        }

        .filter-section {
            background-color: #f8f9fa;
            border-radius: 0.5rem;
            padding: 0.75rem;
            margin-bottom: 1rem;
        }

        .filter-section label {
            font-size: 0.75rem;
            margin-bottom: 0.15rem;
        }

        .filter-section .form-control,
        .filter-section .form-select {
            padding: 0.3rem 0.5rem;
            font-size: 0.8rem;
            height: calc(1.8rem + 2px);
        }

        .filter-section small {
            font-size: 0.7rem;
        }

        .result-card {
            margin-bottom: 1.5rem;
            border: none;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
        }

        .result-card:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

        .info-grid-ordine {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 0.5rem;
            margin-bottom: 0.75rem;
        }

        .info-item-ordine {
            padding: 0.4rem 0.6rem;
            background-color: #f8f9fa;
            border-radius: 0.25rem;
            border-left: 3px solid #667eea;
        }

        .info-label-ordine {
            font-size: 0.65rem;
            text-transform: uppercase;
            color: #6c757d;
            font-weight: 600;
            margin-bottom: 0.15rem;
        }

        .info-value-ordine {
            font-size: 0.85rem;
            color: #212529;
            font-weight: 500;
        }

        /* Evidenziazione consegne in ritardo */
        .ordine-in-ritardo {
            border-left: 5px solid #dc3545;
            box-shadow: 0 2px 8px rgba(220, 53, 69, 0.3);
        }

        .ordine-in-ritardo .accordion-header-custom {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        }

        .riga-in-ritardo {
            background-color: #ffe6e6 !important;
            border-left: 3px solid #dc3545;
        }

        .badge-ritardo {
            background-color: #dc3545;
            color: white;
            font-weight: bold;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        /* Evidenziazione destinazione diversa */
        .destinazione-diversa {
            color: #ff8c00 !important;
            font-weight: 600;
        }

        .badge-destinazione-diversa {
            background-color: #ff8c00;
            color: white;
            font-size: 0.7rem;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            margin-left: 0.5rem;
        }
    </style>
}

<div class="container-fluid">
    <div class="mb-3">
        <h2 class="mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>Lista Ordini Clienti</h2>
    </div>

    <!-- FORM FILTRI -->
    <div class="filter-section">
        <form asp-action="ConsegneProgrammate" method="post" id="formFiltri">
            @Html.AntiForgeryToken()

            <!-- RIGA 1: Date, Cliente, Regione, Provincia -->
            <div class="row g-2">
                <!-- Data Consegna Da -->
                <div class="col-md-2">
                    <label asp-for="DataConsegnaDa" class="form-label fw-bold">
                        <i class="bi bi-calendar3 me-1"></i>@Html.DisplayNameFor(model => model.DataConsegnaDa)
                    </label>
                    <input asp-for="DataConsegnaDa" type="date" class="form-control" />
                </div>

                <!-- Data Consegna A -->
                <div class="col-md-2">
                    <label asp-for="DataConsegnaA" class="form-label fw-bold">
                        <i class="bi bi-calendar3 me-1"></i>@Html.DisplayNameFor(model => model.DataConsegnaA)
                    </label>
                    <input asp-for="DataConsegnaA" type="date" class="form-control" />
                </div>

                <!-- Cliente (Select2) -->
                <div class="col-md-4">
                    <label asp-for="CodiceCliente" class="form-label fw-bold">
                        <i class="bi bi-person-circle me-1"></i>@Html.DisplayNameFor(model => model.CodiceCliente)
                    </label>
                    <select asp-for="CodiceCliente" class="form-select select2-ajax" id="codiceCliente">
                        <option value="">-- Tutti i clienti --</option>
                        @if (Model.CodiceCliente.HasValue)
                        {
                            <option value="@Model.CodiceCliente" selected>@Model.CodiceCliente @(!string.IsNullOrEmpty(Model.RagioneSocialeCliente) ? " - " + Model.RagioneSocialeCliente : "")</option>
                        }
                    </select>
                    <small class="text-muted">Cerca per codice o ragione sociale (min. 2 caratteri)</small>
                </div>

                <!-- Regione -->
                <div class="col-md-2">
                    <label asp-for="Regione" class="form-label fw-bold">
                        <i class="bi bi-map me-1"></i>@Html.DisplayNameFor(model => model.Regione)
                    </label>
                    <select asp-for="Regione" class="form-select" id="regione">
                        <option value="">-- Tutte --</option>
                    </select>
                </div>

                <!-- Provincia -->
                <div class="col-md-2">
                    <label asp-for="Provincia" class="form-label fw-bold">
                        <i class="bi bi-geo-alt me-1"></i>@Html.DisplayNameFor(model => model.Provincia)
                    </label>
                    <select asp-for="Provincia" class="form-select" id="provincia">
                        <option value="">-- Tutte --</option>
                    </select>
                </div>
            </div>

            <!-- RIGA 2: Comune, Agente, Ordinamento, Pulsanti -->
            <div class="row g-2" style="margin-top: 0.5rem;">
                <!-- Comune -->
                <div class="col-md-2">
                    <label asp-for="Comune" class="form-label fw-bold">
                        <i class="bi bi-building me-1"></i>@Html.DisplayNameFor(model => model.Comune)
                    </label>
                    <select asp-for="Comune" class="form-select" id="comune">
                        <option value="">-- Tutti --</option>
                    </select>
                </div>

                <!-- Agente -->
                @if (ViewBag.IsAgente == true)
                {
                    <!-- L'utente è un agente: mostra il nome dell'agente -->
                    <div class="col-md-2">
                        <label asp-for="CodiceAgente" class="form-label fw-bold">
                            <i class="bi bi-person-badge me-1"></i>Agente
                        </label>
                        <input type="text" class="form-control" value="@ViewBag.NomeAgenteUtente" disabled />
                        <input type="hidden" asp-for="CodiceAgente" value="@ViewBag.CodiceAgenteUtente" />
                    </div>
                }
                else
                {
                    <!-- Admin o Manager: mostra il dropdown completo -->
                    <div class="col-md-2">
                        <label asp-for="CodiceAgente" class="form-label fw-bold">
                            <i class="bi bi-person-badge me-1"></i>@Html.DisplayNameFor(model => model.CodiceAgente)
                        </label>
                        <select asp-for="CodiceAgente" class="form-select" id="agente">
                            <option value="">-- Tutti --</option>
                        </select>
                    </div>
                }

                <!-- Stato Evasione -->
                <div class="col-md-2">
                    <label asp-for="StatoEvasioneFiltro" class="form-label fw-bold">
                        <i class="bi bi-check2-square me-1"></i>@Html.DisplayNameFor(model => model.StatoEvasioneFiltro)
                    </label>
                    <select asp-for="StatoEvasioneFiltro" class="form-select" id="statoEvasione">
                        <option value="">-- Tutti --</option>
                        <option value="Da Evadere">Da Evadere</option>
                        <option value="Parzialmente Evasa">Parzialmente Evasa</option>
                        <option value="Completamente Evasa">Completamente Evasa</option>
                    </select>
                </div>

                <!-- Ordinamento -->
                <div class="col-md-2">
                    <label asp-for="OrdinamentoPer" class="form-label fw-bold">
                        <i class="bi bi-sort-down me-1"></i>@Html.DisplayNameFor(model => model.OrdinamentoPer)
                    </label>
                    <select asp-for="OrdinamentoPer" class="form-select">
                        <option value="DataConsegna">Data Consegna</option>
                        <option value="Cliente">Cliente</option>
                        <option value="Ordine">Numero Ordine</option>
                    </select>
                </div>

                <!-- Pulsanti -->
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="bi bi-search me-2"></i>Cerca
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="resetFiltri()">
                        <i class="bi bi-x-circle me-2"></i>Pulisci Filtri
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- RISULTATI -->
    @if (Model.Ordini != null && Model.Ordini.Any())
    {
        <!-- PAGINAZIONE TOP (generata via JS) -->
        <div id="paginazioneTop" class="d-flex justify-content-between align-items-center mb-3"></div>

        <!-- ACCORDION ORDINI -->
        <div class="accordion" id="accordionOrdini" style="margin-bottom: 3rem;">
            @for (int i = 0; i < Model.Ordini.Count; i++)
            {
                var ordine = Model.Ordini[i];
                var accordionId = $"ordine{i}";
                var collapseId = $"collapse{i}";
                
                // Verifica se l'ordine ha righe in ritardo
                var oggi = DateTime.Today;
                var hasRitardo = ordine.Righe.Any(r => r.DataConsegna < oggi && r.QuantitaRimanente > 0);

                <div class="card result-card mb-3 @(hasRitardo ? "ordine-in-ritardo" : "")">
                    <!-- Header Ordine (Cliccabile) -->
                    <div class="accordion-header-custom collapsed" 
                         type="button" 
                         data-bs-toggle="collapse" 
                         data-bs-target="#@collapseId" 
                         aria-expanded="false" 
                         aria-controls="@collapseId">
                        <div class="d-flex justify-content-between align-items-start flex-wrap">
                            <div class="flex-grow-1">
                                <h5 class="mb-1">
                                    <i class="bi bi-file-earmark-text me-2"></i>
                                    <strong>Ordine @ordine.NumeroOrdineCompleto</strong> - @ordine.RagioneSociale
                                </h5>
                                <div class="header-info-inline opacity-90">
                                    <span><i class="bi bi-calendar-check me-1"></i>@ordine.DataOrdine.ToString("dd/MM/yyyy")</span>
                                    @if (ordine.Righe.Any())
                                    {
                                        <span><i class="bi bi-truck me-1"></i>Consegna: <strong>@ordine.Righe.Min(r => r.DataConsegna).ToString("dd/MM/yyyy")</strong></span>
                                    }
                                    @if (!string.IsNullOrEmpty(ordine.IndirizzoCompletoCliente))
                                    {
                                        <span class="@(ordine.HasDestinazioneDiversa ? "destinazione-diversa" : "")">
                                            <i class="bi bi-geo-alt me-1"></i>@ordine.IndirizzoCompletoCliente
                                            @if (ordine.HasDestinazioneDiversa && !string.IsNullOrEmpty(ordine.DescrizioneDestinazione))
                                            {
                                                <span class="badge-destinazione-diversa">
                                                    <i class="bi bi-truck-front-fill"></i> @ordine.DescrizioneDestinazione
                                                </span>
                                            }
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(ordine.RiferimentoOrdine))
                                    {
                                        <span><i class="bi bi-tag me-1"></i>Rif: @ordine.RiferimentoOrdine</span>
                                    }
                                    @if (!string.IsNullOrEmpty(ordine.NomeAgente))
                                    {
                                        <span><i class="bi bi-person-badge me-1"></i>@ordine.NomeAgente</span>
                                    }
                                </div>
                            </div>
                            <div class="text-end ms-3">
                                @if (ordine.HasEmailInviata)
                                {
                                    <span class="badge bg-success badge-custom me-2" title="Email inviata il @ordine.DataEmailInviata?.ToString("dd/MM/yyyy HH:mm")" data-bs-toggle="tooltip">
                                        <i class="bi bi-envelope-check me-1"></i>EMAIL
                                    </span>
                                }
                                @if (hasRitardo)
                                {
                                    <span class="badge badge-ritardo badge-custom me-2">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>IN RITARDO
                                    </span>
                                }
                                <span class="badge @ordine.StatoEvasioneCssClass badge-custom me-2">
                                    <i class="bi bi-check2-square me-1"></i>@ordine.StatoEvasione
                                </span>
                                <span class="badge bg-light text-dark badge-custom me-2">
                                    <i class="bi bi-list-ol me-1"></i>@ordine.NumeroRighe righe
                                </span>
                                <span class="badge bg-warning text-dark badge-custom">
                                    <i class="bi bi-currency-euro me-1"></i>€ @ordine.TotaleOrdine.ToString("N2")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Body Ordine (Collassabile) -->
                    <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#accordionOrdini">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-sm table-righe table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Riga</th>
                                            <th>Articolo</th>
                                            <th>Descrizione</th>
                                            <th class="text-center">Data Consegna</th>
                                            <th class="text-end">Quantità</th>
                                            <th class="text-end">Evasa</th>
                                            <th class="text-end">Da Evadere</th>
                                            <th class="text-end">Prezzo</th>
                                            <th class="text-end">Valore</th>
                                            <th class="text-center">Stato</th>
                                            <th class="text-end bg-success text-white">Esistenza</th>
                                            <th class="text-end bg-success text-white">Impegnato</th>
                                            <th class="text-end bg-success text-white">Disponibile</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var riga in ordine.Righe.OrderBy(r => r.RigaOrdine))
                                        {
                                            var rigaInRitardo = riga.DataConsegna < oggi && riga.QuantitaRimanente > 0;
                                            <tr class="@(rigaInRitardo ? "riga-in-ritardo" : "")">
                                                <td><strong>@riga.RigaOrdine</strong></td>
                                                <td><code>@riga.CodiceArticolo</code></td>
                                                <td>@(riga.DescrizioneArticolo ?? "-")</td>
                                                <td class="text-center">
                                                    <span class="badge @(rigaInRitardo ? "bg-danger" : "bg-info")">
                                                        @if (rigaInRitardo)
                                                        {
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                        }
                                                        @riga.DataConsegna.ToString("dd/MM/yyyy")
                                                    </span>
                                                </td>
                                                <td class="text-end">@riga.Quantita.ToString("N2") @riga.UnitaMisura</td>
                                                <td class="text-end">@riga.QuantitaEvasa.ToString("N2")</td>
                                                <td class="text-end"><strong>@riga.QuantitaRimanente.ToString("N2")</strong></td>
                                                <td class="text-end">€ @riga.Prezzo.ToString("N2")</td>
                                                <td class="text-end"><strong>€ @riga.ValoreRiga.ToString("N2")</strong></td>
                                                <td class="text-center">
                                                    <span class="badge @riga.StatoEvasioneCssClass">@riga.StatoEvasione</span>
                                                </td>
                                                <td class="text-end" style="background-color: #d4edda;">
                                                    <span class="@(riga.Esistenza <= 0 ? "text-danger fw-bold" : "")">@riga.Esistenza.ToString("N2")</span>
                                                </td>
                                                <td class="text-end" style="background-color: #d4edda;">
                                                    <span class="@(riga.ImpegnatoAttuale > 0 ? "text-warning fw-bold" : "")">@riga.ImpegnatoAttuale.ToString("N2")</span>
                                                </td>
                                                <td class="text-end" style="background-color: #d4edda;">
                                                    <strong class="@(riga.Disponibile < 0 ? "text-danger" : "text-success")">@riga.Disponibile.ToString("N2")</strong>
                                                </td>
                                            </tr>
                                            @if (!string.IsNullOrEmpty(riga.NoteRiga))
                                            {
                                                <tr>
                                                    <td colspan="13" class="bg-light">
                                                        <small><i class="bi bi-chat-left-text me-1"></i><strong>Note:</strong> @riga.NoteRiga</small>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                    <tfoot class="table-light">
                                        <tr class="fw-bold">
                                            <td colspan="4" class="text-end">TOTALE ORDINE:</td>
                                            <td class="text-end">@ordine.TotaleQuantita.ToString("N2")</td>
                                            <td colspan="2" class="text-end">@ordine.TotaleQuantitaDaEvadere.ToString("N2")</td>
                                            <td colspan="2" class="text-end">€ @ordine.TotaleOrdine.ToString("N2")</td>
                                            <td></td>
                                            <td colspan="3" style="background-color: #d4edda;"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- PAGINAZIONE BOTTOM (generata via JS) -->
        <div id="paginazioneBottom" class="d-flex justify-content-between align-items-center mb-3"></div>
    }
    else if (Model.Ordini != null && !Model.Ordini.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>
            Nessun ordine trovato con i filtri specificati.
        </div>
    }
</div>

@section Scripts {
    <!-- jQuery (richiesto da Select2) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // Inizializza tooltip Bootstrap per i badge email
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
        });
    </script>

    <script>
        $(document).ready(function () {
            // ===== INIZIALIZZAZIONE SELECT2 PER CLIENTI =====
            $('#codiceCliente').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Tutti i clienti --',
                allowClear: true,
                ajax: {
                    url: '@Url.Action("SearchClienti", "InterrogazioniDB")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data.results
                        };
                    },
                    cache: true
                },
                minimumInputLength: 2
            });

            // ===== CARICAMENTO INIZIALE DATI DROPDOWN =====
            caricaRegioni();
            caricaProvince();
            caricaComuni();
            
            // Carica agenti solo se l'utente NON è un agente
            @if (ViewBag.IsAgente != true)
            {
                <text>caricaAgenti();</text>
            }

            // ===== FUNZIONE: Carica Regioni =====
            function caricaRegioni() {
                $.ajax({
                    url: '@Url.Action("GetRegioni", "InterrogazioniDB")',
                    type: 'GET',
                    success: function (regioni) {
                        var $select = $('#regione');
                        $select.empty();
                        $select.append('<option value="">-- Tutte le regioni --</option>');
                        $.each(regioni, function (i, regione) {
                            var selected = regione === '@Model.Regione' ? 'selected' : '';
                            $select.append('<option value="' + regione + '" ' + selected + '>' + regione + '</option>');
                        });
                    }
                });
            }

            // ===== FUNZIONE: Carica Province =====
            function caricaProvince(regioneSelezionata) {
                var url = '@Url.Action("GetProvince", "InterrogazioniDB")';
                if (regioneSelezionata) {
                    url += '?regione=' + encodeURIComponent(regioneSelezionata);
                }

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (province) {
                        var $select = $('#provincia');
                        $select.empty();
                        $select.append('<option value="">-- Tutte le province --</option>');
                        $.each(province, function (i, provincia) {
                            var selected = provincia === '@Model.Provincia' ? 'selected' : '';
                            $select.append('<option value="' + provincia + '" ' + selected + '>' + provincia + '</option>');
                        });
                    }
                });
            }

            // ===== FUNZIONE: Carica Comuni =====
            function caricaComuni(provinciaSelezionata) {
                var url = '@Url.Action("GetComuni", "InterrogazioniDB")';
                if (provinciaSelezionata) {
                    url += '?provincia=' + encodeURIComponent(provinciaSelezionata);
                }

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (comuni) {
                        var $select = $('#comune');
                        $select.empty();
                        $select.append('<option value="">-- Tutti i comuni --</option>');
                        $.each(comuni, function (i, comune) {
                            var selected = comune === '@Model.Comune' ? 'selected' : '';
                            $select.append('<option value="' + comune + '" ' + selected + '>' + comune + '</option>');
                        });
                    }
                });
            }

            // ===== FUNZIONE: Carica Agenti =====
            function caricaAgenti() {
                $.ajax({
                    url: '@Url.Action("GetAgenti", "InterrogazioniDB")',
                    type: 'GET',
                    success: function (agenti) {
                        var $select = $('#agente');
                        $select.empty();
                        $select.append('<option value="">-- Tutti gli agenti --</option>');
                        $.each(agenti, function (i, agente) {
                            var selected = agente.codice === @(Model.CodiceAgente?.ToString() ?? "null") ? 'selected' : '';
                            $select.append('<option value="' + agente.codice + '" ' + selected + '>' + agente.descrizione + '</option>');
                        });
                    }
                });
            }

            // ===== EVENTI: Cambio Regione → Ricarica Province =====
            $('#regione').on('change', function () {
                var regioneSelezionata = $(this).val();
                caricaProvince(regioneSelezionata);
                $('#provincia').val(''); // Reset provincia
                $('#comune').empty().append('<option value="">-- Tutti i comuni --</option>'); // Reset comune
            });

            // ===== EVENTI: Cambio Provincia → Ricarica Comuni =====
            $('#provincia').on('change', function () {
                var provinciaSelezionata = $(this).val();
                caricaComuni(provinciaSelezionata);
                $('#comune').val(''); // Reset comune
            });
        });

        // ===== PAGINAZIONE CLIENT-SIDE =====
        var paginazioneConfig = {
            elementiPerPagina: 12,
            paginaCorrente: 1,
            cards: [],
            totalePagine: 0
        };

        function inizializzaPaginazione() {
            var accordion = document.getElementById('accordionOrdini');
            if (!accordion) return;
            
            paginazioneConfig.cards = Array.from(accordion.querySelectorAll(':scope > .card.result-card'));
            paginazioneConfig.totalePagine = Math.ceil(paginazioneConfig.cards.length / paginazioneConfig.elementiPerPagina);
            paginazioneConfig.paginaCorrente = 1;
            
            if (paginazioneConfig.cards.length > 0) {
                mostraPagina(1);
            }
        }

        function mostraPagina(numeroPagina) {
            var config = paginazioneConfig;
            config.paginaCorrente = numeroPagina;
            
            var inizio = (numeroPagina - 1) * config.elementiPerPagina;
            var fine = inizio + config.elementiPerPagina;
            
            for (var i = 0; i < config.cards.length; i++) {
                config.cards[i].style.display = (i >= inizio && i < fine) ? '' : 'none';
            }
            
            aggiornaPaginazioneUI();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function aggiornaPaginazioneUI() {
            var config = paginazioneConfig;
            var totale = config.cards.length;
            var pag = config.paginaCorrente;
            var tp = config.totalePagine;
            var inizio = (pag - 1) * config.elementiPerPagina + 1;
            var fine = Math.min(pag * config.elementiPerPagina, totale);
            
            var riepilogoHtml = '<span class="text-muted">Mostro <strong>' + inizio + '</strong>–<strong>' + fine + '</strong> di <strong>' + totale + '</strong> ordini</span>';
            var navHtml = '';
            
            if (tp > 1) {
                navHtml = '<nav><ul class="pagination pagination-sm mb-0">';
                navHtml += '<li class="page-item ' + (pag <= 1 ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="mostraPagina(1)" title="Prima pagina"><i class="bi bi-chevron-double-left"></i></a></li>';
                navHtml += '<li class="page-item ' + (pag <= 1 ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="mostraPagina(' + (pag - 1) + ')" title="Precedente"><i class="bi bi-chevron-left"></i></a></li>';
                
                var startP = Math.max(1, pag - 2);
                var endP = Math.min(tp, pag + 2);
                
                if (startP > 1) {
                    navHtml += '<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="mostraPagina(1)">1</a></li>';
                    if (startP > 2) navHtml += '<li class="page-item disabled"><span class="page-link">&hellip;</span></li>';
                }
                for (var p = startP; p <= endP; p++) {
                    navHtml += '<li class="page-item ' + (p === pag ? 'active' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="mostraPagina(' + p + ')">' + p + '</a></li>';
                }
                if (endP < tp) {
                    if (endP < tp - 1) navHtml += '<li class="page-item disabled"><span class="page-link">&hellip;</span></li>';
                    navHtml += '<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="mostraPagina(' + tp + ')">' + tp + '</a></li>';
                }
                
                navHtml += '<li class="page-item ' + (pag >= tp ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="mostraPagina(' + (pag + 1) + ')" title="Successiva"><i class="bi bi-chevron-right"></i></a></li>';
                navHtml += '<li class="page-item ' + (pag >= tp ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="mostraPagina(' + tp + ')" title="Ultima pagina"><i class="bi bi-chevron-double-right"></i></a></li>';
                navHtml += '</ul></nav>';
            }
            
            var topEl = document.getElementById('paginazioneTop');
            var bottomEl = document.getElementById('paginazioneBottom');
            if (topEl) topEl.innerHTML = '<div>' + riepilogoHtml + '</div>' + navHtml;
            if (bottomEl) bottomEl.innerHTML = '<span class="text-muted">Pagina <strong>' + pag + '</strong> di <strong>' + tp + '</strong></span>' + navHtml;
        }

        document.addEventListener('DOMContentLoaded', function() {
            inizializzaPaginazione();
        });

        // ===== FUNZIONE: Reset Filtri =====
        function resetFiltri() {
            document.getElementById('formFiltri').reset();
            $('#codiceCliente').val(null).trigger('change'); // Reset Select2
            $('#regione').val('');
            $('#provincia').empty().append('<option value="">-- Tutte le province --</option>');
            $('#comune').empty().append('<option value="">-- Tutti i comuni --</option>');
            $('#agente').val('');
            $('#statoEvasione').val('');
            
            // Imposta date del mese corrente
            var oggi = new Date();
            var primoGiornoMese = new Date(oggi.getFullYear(), oggi.getMonth(), 1);
            var ultimoGiornoMese = new Date(oggi.getFullYear(), oggi.getMonth() + 1, 0);
            
            // Formatta date in formato YYYY-MM-DD per input type="date"
            var dataInizio = primoGiornoMese.toISOString().split('T')[0];
            var dataFine = ultimoGiornoMese.toISOString().split('T')[0];
            
            $('#DataConsegnaDa').val(dataInizio);
            $('#DataConsegnaA').val(dataFine);
        }
    </script>

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

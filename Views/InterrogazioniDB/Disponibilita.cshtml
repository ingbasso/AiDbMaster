        // Funzione per popolare il popup movimenti nota con i dati
        function popolaDettaglioMovimentiNota(data) {
            console.log('Dati movimenti nota ricevuti:', data);
            
            // Header
            var articoloText = data.codiceArticolo;
            if (data.descrizioneArticolo) {
                articoloText += ' - ' + data.descrizioneArticolo;
            }
            $('#dettaglioArticoloMovimentiNota').text(articoloText);
            
            var dataInizioFormatted = new Date(data.dataInizio).toLocaleDateString('it-IT');
            var dataFineFormatted = new Date(data.dataFine).toLocaleDateString('it-IT');
            $('#dettaglioPeriodoMovimentiNota').text(dataInizioFormatted + ' → ' + dataFineFormatted);
            
            $('#dettaglioNotaGenerata').text(data.notaGenerata);

            // Unità di misura
            var unitaMisura = data.unitaMisura || 'pz';

            // Tabella movimenti
            var tbody = $('#tabellaMovimentiNota');
            tbody.empty();

            if (data.movimenti && data.movimenti.length > 0) {
                data.movimenti.forEach(function(mov) {
                    var dataFormatted = new Date(mov.data).toLocaleDateString('it-IT');
                    
                    // Formatta la quantità con segno (2 decimali)
                    var quantitaText = '';
                    if (mov.tipo === 'Esistenza') {
                        quantitaText = mov.quantita.toFixed(2) + ' ' + unitaMisura;
                    } else if (mov.quantita >= 0) {
                        quantitaText = '<span class="text-success fw-bold">+' + mov.quantita.toFixed(2) + ' ' + unitaMisura + '</span>';
                    } else {
                        quantitaText = '<span class="text-danger fw-bold">' + mov.quantita.toFixed(2) + ' ' + unitaMisura + '</span>';
                    }
                    
                    // Formatta il progressivo (2 decimali)
                    var progressivoClass = mov.progressivo >= 0 ? 'text-success' : 'text-danger';
                    var progressivoText = '<span class="' + progressivoClass + ' fw-bold">' + mov.progressivo.toFixed(2) + ' ' + unitaMisura + '</span>';
                    
                    // Badge per il tipo
                    var tipoBadgeClass = '';
                    var tipoIcon = '';
                    switch(mov.tipo) {
                        case 'Esistenza':
                            tipoBadgeClass = 'bg-secondary';
                            tipoIcon = 'bi-box-seam';
                            break;
                        case 'Ordine Cliente':
                            tipoBadgeClass = 'bg-danger';
                            tipoIcon = 'bi-cart-dash';
                            break;
                        case 'Ordine Produzione':
                            tipoBadgeClass = 'bg-success';
                            tipoIcon = 'bi-gear';
                            break;
                        default:
                            tipoBadgeClass = 'bg-light text-dark';
                            tipoIcon = 'bi-question';
                    }
                    
                    // Riga esistenza in grassetto
                    var rowClass = mov.tipo === 'Esistenza' ? 'fw-bold' : '';
                    
                    var row = '<tr class="' + rowClass + '">' +
                              '<td class="text-center">' + dataFormatted + '</td>' +
                              '<td><span class="badge ' + tipoBadgeClass + '"><i class="bi ' + tipoIcon + ' me-1"></i>' + mov.tipo + '</span></td>' +
                              '<td>' + mov.descrizione + '</td>' +
                              '<td class="text-end">' + quantitaText + '</td>' +
                              '<td class="text-end">' + progressivoText + '</td>' +
                              '</tr>';
                    tbody.append(row);
                });
            } else {
                tbody.append('<tr><td colspan="5" class="text-center text-muted">Nessun movimento trovato nel periodo</td></tr>');
            }
        }

        // Funzione per rendere un elemento trascinabile
        function makeDraggable(modalId, headerId) {
            const modal = document.getElementById(modalId);
            const header = document.getElementById(headerId);
            
            if (!modal || !header) return;
            
            let isDragging = false;
            let currentX;
            let currentY;
            let initialX;
            let initialY;
            let xOffset = 0;
            let yOffset = 0;

            header.addEventListener('mousedown', dragStart);
            document.addEventListener('mousemove', drag);
            document.addEventListener('mouseup', dragEnd);

            function dragStart(e) {
                initialX = e.clientX - xOffset;
                initialY = e.clientY - yOffset;

                if (e.target === header || header.contains(e.target)) {
                    isDragging = true;
                }
            }

            function drag(e) {
                if (isDragging) {
                    e.preventDefault();
                    
                    currentX = e.clientX - initialX;
                    currentY = e.clientY - initialY;

                    xOffset = currentX;
                    yOffset = currentY;

                    setTranslate(currentX, currentY, modal.querySelector('.modal-dialog'));
                }
            }

            function dragEnd(e) {
                initialX = currentX;
                initialY = currentY;
                isDragging = false;
            }

            function setTranslate(xPos, yPos, el) {
                el.style.transform = `translate(${xPos}px, ${yPos}px)`;
            }
        }
    </script>

@section Scripts {
    <!-- Include Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Inizializza Select2 con AJAX
            $('#codiceArticolo').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Seleziona un articolo --',
                allowClear: true,
                minimumInputLength: 2,
                width: '100%', // ✅ Larghezza fluida per adattarsi al container
                ajax: {
                    url: '@Url.Action("SearchArticoli", "InterrogazioniDB")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                },
                language: {
                    noResults: function() {
                        return "Nessun articolo trovato";
                    },
                    searching: function() {
                        return "Ricerca in corso...";
                    },
                    inputTooShort: function() {
                        return "Inserisci almeno 2 caratteri";
                    }
                }
            });

            // ✅ Riadatta Select2 quando la sidebar cambia dimensione
            // Ascolta l'evento di fine transizione della sidebar
            const sidebar = document.querySelector('.sidebar, #sidebar-wrapper, .offcanvas');
            if (sidebar) {
                // Opzione 1: Ascolta transitionend sulla sidebar
                sidebar.addEventListener('transitionend', function() {
                    setTimeout(function() {
                        $('#codiceArticolo').select2('destroy').select2({
                            theme: 'bootstrap-5',
                            placeholder: '-- Seleziona un articolo --',
                            allowClear: true,
                            minimumInputLength: 2,
                            width: '100%',
                            ajax: {
                                url: '@Url.Action("SearchArticoli", "InterrogazioniDB")',
                                dataType: 'json',
                                delay: 250,
                                data: function (params) {
                                    return {
                                        term: params.term,
                                        page: params.page || 1
                                    };
                                },
                                processResults: function (data) {
                                    return {
                                        results: data
                                    };
                                },
                                cache: true
                            },
                            language: {
                                noResults: function() {
                                    return "Nessun articolo trovato";
                                },
                                searching: function() {
                                    return "Ricerca in corso...";
                                },
                                inputTooShort: function() {
                                    return "Inserisci almeno 2 caratteri";
                                }
                            }
                        });
                    }, 100); // Piccolo delay per permettere al layout di stabilizzarsi
                });
            }

            // Opzione 2: Ascolta il resize della finestra (fallback universale)
            let resizeTimer;
            $(window).on('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function() {
                    // Non distruggere se l'utente sta cercando
                    if (!$('#codiceArticolo').hasClass('select2-hidden-accessible') || 
                        !$('.select2-container--open').length) {
                        return;
                    }
                    $('#codiceArticolo').select2('close');
                }, 300);
            });
        });

        // Funzione per pulire il form
        function resetForm() {
            $('#codiceArticolo').val(null).trigger('change');
            // Le date sono ora calcolate automaticamente da ParametriChiave
        }

        // Funzione per mostrare il dettaglio delle produzioni
        function mostraDettaglioProduzioni(codiceArticolo, dataRiferimento) {
            // Reset UI
            $('#loadingProduzioni').show();
            $('#contenutoDettaglioProduzioni').hide();
            $('#erroreDettaglioProduzioni').hide();
            
            // Mostra il modal SENZA backdrop
            var modal = new bootstrap.Modal(document.getElementById('popupDettaglioProduzioni'), {
                backdrop: false,
                keyboard: true
            });
            modal.show();

            // Chiamata AJAX
            $.ajax({
                url: '@Url.Action("GetDettaglioProduzioni", "InterrogazioniDB")',
                type: 'GET',
                data: {
                    codiceArticolo: codiceArticolo,
                    dataRiferimento: dataRiferimento
                },
                success: function(response) {
                    popolaDettaglioProduzioni(response);
                    $('#loadingProduzioni').hide();
                    $('#contenutoDettaglioProduzioni').show();
                },
                error: function(xhr, status, error) {
                    $('#loadingProduzioni').hide();
                    $('#messaggioErrore').text('Errore durante il caricamento dei dati: ' + error);
                    $('#erroreDettaglioProduzioni').show();
                }
            });
        }

        // Funzione per popolare il popup con i dati
        function popolaDettaglioProduzioni(data) {
            // Header
            var articoloText = data.codiceArticolo;
            if (data.descrizioneArticolo) {
                articoloText += ' - ' + data.descrizioneArticolo;
            }
            $('#dettaglioArticolo').text(articoloText);
            
            var dataRifFormatted = new Date(data.dataRiferimento).toLocaleDateString('it-IT');
            $('#dettaglioDataRiferimento').text(dataRifFormatted);

            // Unità di misura (default 'pz' se non presente)
            var unitaMisura = data.unitaMisura || 'pz';

            // Tabella produzioni
            var tbody = $('#tabellaProduzioni');
            tbody.empty();

            var totaleQuantita = 0;

            if (data.produzioni && data.produzioni.length > 0) {
                data.produzioni.forEach(function(prod) {
                    var dataFineProdFormatted = new Date(prod.dataFinePrevista).toLocaleDateString('it-IT');
                    var dataDisponibilitaFormatted = new Date(prod.dataDisponibilita).toLocaleDateString('it-IT');
                    
                    var rowClass = prod.disponibileEntroData ? 'table-success' : 'table-warning';
                    
                    var row = '<tr class="' + rowClass + '">' +
                              '<td><strong>' + prod.numeroOrdine + '</strong></td>' +
                              '<td class="text-end">' + prod.quantita.toFixed(2) + ' ' + unitaMisura + '</td>' +
                              '<td class="text-center">' + dataFineProdFormatted + '</td>' +
                              '<td class="text-center">' + prod.giorniAsciugatura + ' gg</td>' +
                              '<td class="text-center"><strong>' + dataDisponibilitaFormatted + '</strong></td>' +
                              '</tr>';
                    tbody.append(row);
                    
                    if (prod.disponibileEntroData) {
                        totaleQuantita += prod.quantita;
                    }
                });
            } else {
                tbody.append('<tr><td colspan="5" class="text-center text-muted">Nessuna produzione programmata</td></tr>');
            }

            // Totale nel footer
            $('#totaleProduzione').text(totaleQuantita.toFixed(2) + ' ' + unitaMisura);
        }


@model AiDbMaster.ViewModels.DisponibilitaViewModel

@{
    ViewData["Title"] = "Disponibilità Articolo";
}

<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="container">
    <div class="content-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-boxes me-2 text-primary"></i>Disponibilità Articolo</h2>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Torna al Menu
                </a>
            </div>
        </div>

        <!-- Messaggio di feedback -->
        @if (!string.IsNullOrEmpty(ViewBag.Message))
        {
            <div class="alert alert-@ViewBag.MessageType alert-dismissible fade show" role="alert">
                <i class="bi bi-@(ViewBag.MessageType == "success" ? "check-circle" : 
                                  ViewBag.MessageType == "warning" ? "exclamation-triangle" : 
                                  ViewBag.MessageType == "danger" ? "x-circle" : "info-circle") me-2"></i>
                @ViewBag.Message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Form di Ricerca -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-search me-2"></i>Parametri di Ricerca</h5>
            </div>
            <div class="card-body">
                <form asp-action="Disponibilita" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="CodiceArticolo" class="form-label fw-bold">
                                <i class="bi bi-box-seam me-1"></i>@Html.DisplayNameFor(model => model.CodiceArticolo)
                            </label>
                            <select asp-for="CodiceArticolo" class="form-select select2-ajax" id="codiceArticolo">
                                <option value="">-- Seleziona un articolo --</option>
                                @if (!string.IsNullOrEmpty(Model.CodiceArticolo))
                                {
                                    <option value="@Model.CodiceArticolo" selected>@Model.CodiceArticolo @(!string.IsNullOrEmpty(Model.DescrizioneArticolo) ? " - " + Model.DescrizioneArticolo : "")</option>
                                }
                            </select>
                            <small class="text-muted">Cerca per codice articolo o descrizione (minimo 2 caratteri)</small>
                            <span asp-validation-for="CodiceArticolo" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-4 mb-3">
                            <label asp-for="DataRiferimento" class="form-label fw-bold">
                                <i class="bi bi-calendar me-1"></i>@Html.DisplayNameFor(model => model.DataRiferimento)
                            </label>
                            <input asp-for="DataRiferimento" type="date" class="form-control" />
                            <small class="text-muted">Se vuoto: data odierna</small>
                            <span asp-validation-for="DataRiferimento" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-search me-2"></i>Cerca Disponibilità
                        </button>
                        <button type="reset" class="btn btn-outline-secondary btn-lg" onclick="resetForm()">
                            <i class="bi bi-x-circle me-2"></i>Pulisci
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Risultati -->
        @if (Model.Risultati != null)
        {
            if (Model.Risultati.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-table me-2"></i>Risultati per: <strong>@Model.CodiceArticolo</strong>
                            @if (!string.IsNullOrEmpty(Model.DescrizioneArticolo))
                            {
                                <span> - @Model.DescrizioneArticolo</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Statistiche Riepilogative -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-1">Magazzini</h6>
                                        <h3 class="text-primary mb-0">@Model.Risultati.Count</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-1">Tot. Esistenza</h6>
                                        <h3 class="text-info mb-0">@Model.Risultati.Sum(r => r.Esistenza).ToString("N2")</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-1">Tot. Disponibile</h6>
                                        <h3 class="@(Model.Risultati.Sum(r => r.Disponibile) > 0 ? "text-success" : "text-danger") mb-0">
                                            @Model.Risultati.Sum(r => r.Disponibile).ToString("N2")
                                        </h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-light">
                                    <div class="card-body text-center">
                                        <h6 class="text-muted mb-1">Tot. Ord. Fornitori</h6>
                                        <h3 class="text-warning mb-0">@Model.Risultati.Sum(r => r.OrdinatoFornitoriDataOdierna).ToString("N2")</h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabella Dettagliata -->
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Codice Articolo</th>
                                        <th>Magazzino</th>
                                        <th class="text-end">Esistenza</th>
                                        <th class="text-end">Impegnato</th>
                                        <th class="text-end">Disponibile</th>
                                        <th class="text-end">Ord. Fornitori</th>
                                        <th class="text-end">Totale Previsto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var riga in Model.Risultati)
                                    {
                                        <tr class="@riga.RowCssClass">
                                            <td><strong>@riga.CodiceArticolo</strong></td>
                                            <td><span class="badge bg-info">@riga.CodiceMagazzino</span></td>
                                            <td class="text-end">@riga.Esistenza.ToString("N2")</td>
                                            <td class="text-end">@riga.ImpegnatoDataOdierna.ToString("N2")</td>
                                            <td class="text-end">
                                                <strong class="@(riga.Disponibile > 0 ? "text-success" : 
                                                                riga.Disponibile == 0 ? "text-warning" : "text-danger")">
                                                    @riga.Disponibile.ToString("N2")
                                                </strong>
                                            </td>
                                            <td class="text-end">@riga.OrdinatoFornitoriDataOdierna.ToString("N2")</td>
                                            <td class="text-end"><strong>@riga.TotalePrevisto.ToString("N2")</strong></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th colspan="2">TOTALI</th>
                                        <th class="text-end">@Model.Risultati.Sum(r => r.Esistenza).ToString("N2")</th>
                                        <th class="text-end">@Model.Risultati.Sum(r => r.ImpegnatoDataOdierna).ToString("N2")</th>
                                        <th class="text-end">
                                            <strong class="@(Model.Risultati.Sum(r => r.Disponibile) > 0 ? "text-success" : "text-danger")">
                                                @Model.Risultati.Sum(r => r.Disponibile).ToString("N2")
                                            </strong>
                                        </th>
                                        <th class="text-end">@Model.Risultati.Sum(r => r.OrdinatoFornitoriDataOdierna).ToString("N2")</th>
                                        <th class="text-end"><strong>@Model.Risultati.Sum(r => r.TotalePrevisto).ToString("N2")</strong></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Legenda -->
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i><strong>Legenda:</strong>
                                <span class="ms-3"><span class="badge bg-success">Verde</span> = Disponibile</span>
                                <span class="ms-2"><span class="badge bg-warning text-dark">Giallo</span> = Esaurito</span>
                                <span class="ms-2"><span class="badge bg-danger">Rosso</span> = Negativo</span>
                            </small>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <!-- Include Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Inizializza Select2 con AJAX
            $('#codiceArticolo').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Seleziona un articolo --',
                allowClear: true,
                minimumInputLength: 2,
                ajax: {
                    url: '@Url.Action("SearchArticoli", "InterrogazioniDB")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                },
                language: {
                    noResults: function() {
                        return "Nessun articolo trovato";
                    },
                    searching: function() {
                        return "Ricerca in corso...";
                    },
                    inputTooShort: function() {
                        return "Inserisci almeno 2 caratteri";
                    }
                }
            });
        });

        // Funzione per pulire il form
        function resetForm() {
            $('#codiceArticolo').val(null).trigger('change');
            $('input[name="DataRiferimento"]').val('');
        }
    </script>
}


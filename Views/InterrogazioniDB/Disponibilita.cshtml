@model AiDbMaster.ViewModels.DisponibilitaViewModel

@{
    ViewData["Title"] = "Disponibilità Articolo";
}

<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<style>
    /* Fix z-index del modal per evitare che il backdrop copra il contenuto */
    #popupDettaglioProduzioni.modal {
        z-index: 1055 !important;
    }
    #popupDettaglioProduzioni .modal-dialog {
        z-index: 1056 !important;
    }
    .modal-backdrop {
        z-index: 1050 !important;
    }
    
    /* Stili per intestazioni raggruppate tabella - VERSIONE AGGIORNATA 2025 */
    th.header-anagrafica {
        background-color: #6c757d !important;  /* Grigio medio */
        background: #6c757d !important;
        color: white !important;
        font-weight: bold !important;
        text-align: center !important;
    }
    th.header-disponibilita-attuale {
        background-color: #28a745 !important;  /* Verde brillante */
        background: #28a745 !important;
        color: white !important;
        font-weight: bold !important;
        text-align: center !important;
    }
    th.header-disponibilita-prevista {
        background-color: #fd7e14 !important;  /* Arancione brillante */
        background: #fd7e14 !important;
        color: white !important;
        font-weight: bold !important;
        text-align: center !important;
    }
    
    /* Popup più larghi */
    .modal-xxl {
        max-width: 95% !important;
        width: 95% !important;
    }
    
    @@media (min-width: 1200px) {
        .modal-xxl {
            max-width: 1600px !important;
            width: 95% !important;
        }
    }
    
    /* Header popup dettaglio movimenti nota */
    #headerMovimentiNota {
        background-color: #17a2b8 !important;
        background: #17a2b8 !important;
        color: white !important;
    }
    #headerMovimentiNota .modal-title,
    #headerMovimentiNota h5,
    #popupDettaglioMovimentiNotaLabel {
        color: white !important;
    }
</style>

<div class="px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-boxes me-2 text-primary"></i>Disponibilità Articolo</h2>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Torna al Menu
            </a>
        </div>
    </div>

        <!-- Form di Ricerca -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-search me-2"></i>Parametri di Ricerca</h5>
            </div>
            <div class="card-body">
                <form asp-action="Disponibilita" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label asp-for="CodiceArticolo" class="form-label fw-bold">
                                <i class="bi bi-box-seam me-1"></i>@Html.DisplayNameFor(model => model.CodiceArticolo)
                            </label>
                            <select asp-for="CodiceArticolo" class="form-select select2-ajax" id="codiceArticolo">
                                <option value="">-- Seleziona un articolo --</option>
                                @if (!string.IsNullOrEmpty(Model.CodiceArticolo))
                                {
                                    <option value="@Model.CodiceArticolo" selected>@Model.CodiceArticolo @(!string.IsNullOrEmpty(Model.DescrizioneArticolo) ? " - " + Model.DescrizioneArticolo : "")</option>
                                }
                            </select>
                            <small class="text-muted">Cerca per codice articolo o descrizione (minimo 2 caratteri)</small>
                            <span asp-validation-for="CodiceArticolo" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-4 mb-3 d-flex align-items-center">
                            <div class="alert alert-info mb-0 py-2 px-3 w-100">
                                <i class="bi bi-calendar-range me-2"></i>
                                <strong>Data riferimento:</strong>
                                <span class="badge bg-primary">@Model.DataFine.ToString("dd/MM/yyyy")</span>
                                <small class="text-muted ms-1">(@Model.GiorniImpegno giorni)</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-search me-2"></i>Cerca Disponibilità
                        </button>
                        <button type="reset" class="btn btn-outline-secondary btn-lg" onclick="resetForm()">
                            <i class="bi bi-x-circle me-2"></i>Pulisci
                        </button>
                        <div class="form-check form-switch ms-3">
                            <input asp-for="VisualizzaSostitutivi" class="form-check-input" type="checkbox" id="visualizzaSostitutivi" style="cursor: pointer;" />
                            <label class="form-check-label" for="visualizzaSostitutivi" style="cursor: pointer;">
                                <i class="bi bi-arrow-left-right me-1"></i>Visualizza Sostitutivi
                            </label>
                        </div>
                        <button type="submit" name="submitAction" value="outlet" class="btn btn-warning btn-lg ms-auto">
                            <i class="bi bi-tag me-2"></i>Outlet
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Risultati -->
        @if (Model.Risultati != null)
        {
            if (Model.Risultati.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-table me-2"></i>Risultati per: <strong>@Model.CodiceArticolo</strong>
                            @if (!string.IsNullOrEmpty(Model.DescrizioneArticolo))
                            {
                                <span> - @Model.DescrizioneArticolo</span>
                            }
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Tabella Dettagliata -->
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <!-- Intestazioni raggruppate -->
                                    <tr>
                                        <th colspan="4" class="header-anagrafica">ANAGRAFICA</th>
                                        <th colspan="@(User.IsInRole("Agenti") ? 2 : 4)" class="header-disponibilita-attuale">ANALISI DISPONIBILITA'</th>
                                        <th class="header-disponibilita-prevista">NOTE PREVISIONE</th>
                                    </tr>
                                    <!-- Intestazioni colonne -->
                                    <tr class="table-dark">
                                        <!-- Anagrafica -->
                                        <th>Codice Articolo</th>
                                        <th>Descrizione Articolo</th>
                                        <th>U.M.</th>
                                        <th>Magazzino</th>
                                        <!-- Analisi Disponibilita -->
                                        @if (!User.IsInRole("Agenti"))
                                        {
                                            <th class="text-end">Esistenza</th>
                                            <th class="text-end">Pronto</th>
                                        }
                                        <th class="text-end">Impegnato</th>
                                        <th class="text-end">Disponibile</th>
                                        <!-- Note Previsione -->
                                        <th>Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var riga in Model.Risultati)
                                    {
                                        <tr class="@riga.RowCssClass">
                                            <!-- Anagrafica -->
                                            <td>
                                                <strong>@riga.CodiceArticolo</strong>
                                                @if (riga.IsSupermarket)
                                                {
                                                    <span class="badge bg-info ms-1" title="Articolo Supermarket: disponibilità = esistenza">
                                                        <i class="bi bi-shop me-1"></i>SM
                                                    </span>
                                                }
                                            </td>
                                            <td>@riga.DescrizioneArticolo</td>
                                            <td class="text-center"><span class="badge bg-secondary">@riga.UnitaMisura</span></td>
                                            <td><span class="badge bg-info">@riga.CodiceMagazzino</span></td>
                                            <!-- Analisi Disponibilita -->
                                            @if (!User.IsInRole("Agenti"))
                                            {
                                                <td class="text-end">@riga.Esistenza.ToString("N2")</td>
                                                <td class="text-end">
                                                    <span class="@(riga.Pronto > 0 ? "text-primary" : "text-muted") fw-bold">
                                                        @riga.Pronto.ToString("N2")
                                                    </span>
                                                </td>
                                            }
                                            <td class="text-end">
                                                @if (!User.IsInRole("Agenti"))
                                                {
                                                    <span class="@(riga.ImpegnatoAttuale > 0 ? "text-danger" : "text-muted") fw-bold" style="cursor: pointer;" 
                                                          onclick="mostraDettaglioImpegnatoAttuale('@riga.CodiceArticolo', '@Model.DataFine.ToString("yyyy-MM-dd")')"
                                                          title="Clicca per vedere il dettaglio ordini">
                                                        @riga.ImpegnatoAttuale.ToString("N2")
                                                        <i class="bi bi-info-circle-fill ms-1"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="@(riga.ImpegnatoAttuale > 0 ? "text-danger" : "text-muted") fw-bold">
                                                        @riga.ImpegnatoAttuale.ToString("N2")
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (!User.IsInRole("Agenti") || riga.DisponibileAttuale > 0)
                                                {
                                                    <strong class="@(riga.DisponibileAttuale > 0 ? "text-success" : 
                                                                    riga.DisponibileAttuale == 0 ? "text-warning" : "text-danger")">
                                                        @riga.DisponibileAttuale.ToString("N2")
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <strong class="text-muted">N/D</strong>
                                                }
                                            </td>
                                            <!-- Note Previsione (dinamiche) -->
                                            <td>
                                                @if (!string.IsNullOrEmpty(riga.NotaPrevisione))
                                                {
                                                    @if (!User.IsInRole("Agenti"))
                                                    {
                                                        <span class="@riga.NotaCssClass" style="cursor: pointer; text-decoration: underline;"
                                                              onclick="mostraDettaglioMovimentiNota('@riga.CodiceArticolo', @riga.Esistenza.ToString(System.Globalization.CultureInfo.InvariantCulture), '@Model.DataFine.ToString("yyyy-MM-dd")')"
                                                              title="Clicca per vedere il dettaglio dei movimenti">
                                                            @if (riga.DisponibilitaDaVerificare)
                                                            {
                                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-search me-1"></i>
                                                            }
                                                            @riga.NotaPrevisione
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="@riga.NotaCssClass">
                                                            @if (riga.DisponibilitaDaVerificare)
                                                            {
                                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                            }
                                                            @riga.NotaPrevisione
                                                        </span>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-secondary">
                                    <tr>
                                        <th colspan="4">TOTALI</th>
                                        <!-- Analisi Disponibilita -->
                                        @if (!User.IsInRole("Agenti"))
                                        {
                                            <th class="text-end">@Model.Risultati.Sum(r => r.Esistenza).ToString("N2")</th>
                                            <th class="text-end">
                                                <strong class="text-primary">
                                                    @Model.Risultati.Sum(r => r.Pronto).ToString("N2")
                                                </strong>
                                            </th>
                                        }
                                        <th class="text-end">@Model.Risultati.Sum(r => r.ImpegnatoAttuale).ToString("N2")</th>
                                        <th class="text-end">
                                            @{
                                                var totDisponibile = Model.Risultati.Sum(r => r.DisponibileAttuale);
                                            }
                                            @if (!User.IsInRole("Agenti") || totDisponibile > 0)
                                            {
                                                <strong class="@(totDisponibile > 0 ? "text-success" : "text-danger")">
                                                    @totDisponibile.ToString("N2")
                                                </strong>
                                            }
                                            else
                                            {
                                                <strong class="text-muted">N/D</strong>
                                            }
                                        </th>
                                        <!-- Note Previsione -->
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            }

            @* Tabelle articoli sostitutivi *@
            @if (Model.ArticoliSostitutivi != null && Model.ArticoliSostitutivi.Any())
            {
                foreach (var articoloSostitutivo in Model.ArticoliSostitutivi)
                {
                    <div class="card mt-4 shadow-sm">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="bi bi-arrow-left-right me-2"></i>
                                <strong>Articolo Sostitutivo:</strong> @articoloSostitutivo.CodiceArticolo - @articoloSostitutivo.DescrizioneArticolo
                            </h5>
                        </div>
                        <div class="card-body">
                            <!-- Tabella Dettagliata -->
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <!-- Intestazioni raggruppate -->
                                        <tr>
                                            <th colspan="4" class="header-anagrafica">ANAGRAFICA</th>
                                            <th colspan="@(User.IsInRole("Agenti") ? 2 : 4)" class="header-disponibilita-attuale">ANALISI DISPONIBILITA'</th>
                                            <th class="header-disponibilita-prevista">NOTE PREVISIONE</th>
                                        </tr>
                                        <!-- Intestazioni colonne -->
                                        <tr class="table-dark">
                                            <!-- Anagrafica -->
                                            <th>Codice Articolo</th>
                                            <th>Descrizione Articolo</th>
                                            <th>U.M.</th>
                                            <th>Magazzino</th>
                                            <!-- Analisi Disponibilita -->
                                            @if (!User.IsInRole("Agenti"))
                                            {
                                                <th class="text-end">Esistenza</th>
                                                <th class="text-end">Pronto</th>
                                            }
                                            <th class="text-end">Impegnato</th>
                                            <th class="text-end">Disponibile</th> 
                                            <!-- Note Previsione -->
                                            <th>Note</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var riga in articoloSostitutivo.Risultati)
                                        {
                                            <tr class="@riga.RowCssClass">
                                                <!-- Anagrafica -->
                                                <td>
                                                    <strong>@riga.CodiceArticolo</strong>
                                                    @if (riga.IsSupermarket)
                                                    {
                                                        <span class="badge bg-info ms-1" title="Articolo Supermarket: disponibilità = esistenza">
                                                            <i class="bi bi-shop me-1"></i>SM
                                                        </span>
                                                    }
                                                </td>
                                                <td>@riga.DescrizioneArticolo</td>
                                                <td class="text-center"><span class="badge bg-secondary">@riga.UnitaMisura</span></td>
                                                <td><span class="badge bg-info">@riga.CodiceMagazzino</span></td>
                                                <!-- Analisi Disponibilita -->
                                                @if (!User.IsInRole("Agenti"))
                                                {
                                                    <td class="text-end">@riga.Esistenza.ToString("N2")</td>
                                                    <td class="text-end">
                                                        <span class="@(riga.Pronto > 0 ? "text-primary" : "text-muted") fw-bold">
                                                            @riga.Pronto.ToString("N2")
                                                        </span>
                                                    </td>
                                                }
                                                <td class="text-end">
                                                    @if (!User.IsInRole("Agenti"))
                                                    {
                                                        <span class="@(riga.ImpegnatoAttuale > 0 ? "text-danger" : "text-muted") fw-bold" style="cursor: pointer;" 
                                                              onclick="mostraDettaglioImpegnatoAttuale('@riga.CodiceArticolo', '@Model.DataFine.ToString("yyyy-MM-dd")')"
                                                              title="Clicca per vedere il dettaglio ordini">
                                                            @riga.ImpegnatoAttuale.ToString("N2")
                                                            <i class="bi bi-info-circle-fill ms-1"></i>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="@(riga.ImpegnatoAttuale > 0 ? "text-danger" : "text-muted") fw-bold">
                                                            @riga.ImpegnatoAttuale.ToString("N2")
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    @if (!User.IsInRole("Agenti") || riga.DisponibileAttuale > 0)
                                                    {
                                                        <strong class="@(riga.DisponibileAttuale > 0 ? "text-success" : 
                                                                         riga.DisponibileAttuale == 0 ? "text-warning" : "text-danger")">
                                                            @riga.DisponibileAttuale.ToString("N2")
                                                        </strong>
                                                    }
                                                    else
                                                    {
                                                        <strong class="text-muted">N/D</strong>
                                                    }
                                                </td>
                                                <!-- Note Previsione (dinamiche) -->
                                                <td>
                                                    @if (!string.IsNullOrEmpty(riga.NotaPrevisione))
                                                    {
                                                        @if (!User.IsInRole("Agenti"))
                                                        {
                                                            <span class="@riga.NotaCssClass" style="cursor: pointer; text-decoration: underline;"
                                                                  onclick="mostraDettaglioMovimentiNota('@riga.CodiceArticolo', @riga.Esistenza.ToString(System.Globalization.CultureInfo.InvariantCulture), '@Model.DataFine.ToString("yyyy-MM-dd")')"
                                                                  title="Clicca per vedere il dettaglio dei movimenti">
                                                                @if (riga.DisponibilitaDaVerificare)
                                                                {
                                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-search me-1"></i>
                                                                }
                                                                @riga.NotaPrevisione
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="@riga.NotaCssClass">
                                                                @if (riga.DisponibilitaDaVerificare)
                                                                {
                                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-check-circle-fill me-1"></i>
                                                                }
                                                                @riga.NotaPrevisione
                                                            </span>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-secondary">
                                        <tr>
                                            <th colspan="4">TOTALI</th>
                                            <!-- Analisi Disponibilita -->
                                            @if (!User.IsInRole("Agenti"))
                                            {
                                                <th class="text-end">@articoloSostitutivo.Risultati.Sum(r => r.Esistenza).ToString("N2")</th>
                                                <th class="text-end">
                                                    <strong class="text-primary">
                                                        @articoloSostitutivo.Risultati.Sum(r => r.Pronto).ToString("N2")
                                                    </strong>
                                                </th>
                                            }
                                            <th class="text-end">@articoloSostitutivo.Risultati.Sum(r => r.ImpegnatoAttuale).ToString("N2")</th>
                                            <th class="text-end">
                                                @{
                                                    var totDispSost = articoloSostitutivo.Risultati.Sum(r => r.DisponibileAttuale);
                                                }
                                                @if (!User.IsInRole("Agenti") || totDispSost > 0)
                                                {
                                                    <strong class="@(totDispSost > 0 ? "text-success" : "text-danger")">
                                                        @totDispSost.ToString("N2")
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <strong class="text-muted">N/D</strong>
                                                }
                                            </th>
                                            <!-- Note Previsione -->
                                            <th></th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            }
        }

        @* ===== Tabella articoli Outlet (indipendente dalla ricerca singolo articolo) ===== *@
        @if (Model.ArticoliOutlet != null && Model.ArticoliOutlet.Any())
        {
            <div class="card mt-4 shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-tag-fill me-2"></i>
                        <strong>Articoli Outlet</strong> - @Model.ArticoliOutlet.Count articoli con Outlet = S
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th colspan="4" class="header-anagrafica">ANAGRAFICA</th>
                                    <th colspan="@(User.IsInRole("Agenti") ? 2 : 4)" class="header-disponibilita-attuale">ANALISI DISPONIBILITA'</th>
                                    <th class="header-disponibilita-prevista">NOTE PREVISIONE</th>
                                    <th class="bg-warning text-white text-center">SCONTO</th>
                                </tr>
                                <tr class="table-dark">
                                    <th>Codice Articolo</th>
                                    <th>Descrizione Articolo</th>
                                    <th>U.M.</th>
                                    <th>Magazzino</th>
                                    @if (!User.IsInRole("Agenti"))
                                    {
                                        <th class="text-end">Esistenza</th>
                                        <th class="text-end">Pronto</th>
                                    }
                                    <th class="text-end">Impegnato</th>
                                    <th class="text-end">Disponibile</th>
                                    <th>Note</th>
                                    <th class="text-center">Sconto Extra</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var articoloOutlet in Model.ArticoliOutlet)
                                {
                                    @foreach (var riga in articoloOutlet.Risultati)
                                    {
                                        <tr class="@riga.RowCssClass">
                                            <td>
                                                <strong>@riga.CodiceArticolo</strong>
                                                @if (riga.IsSupermarket)
                                                {
                                                    <span class="badge bg-info ms-1" title="Articolo Supermarket: disponibilità = esistenza">
                                                        <i class="bi bi-shop me-1"></i>SM
                                                    </span>
                                                }
                                            </td>
                                            <td>@riga.DescrizioneArticolo</td>
                                            <td class="text-center"><span class="badge bg-secondary">@riga.UnitaMisura</span></td>
                                            <td><span class="badge bg-info">@riga.CodiceMagazzino</span></td>
                                            @if (!User.IsInRole("Agenti"))
                                            {
                                                <td class="text-end">@riga.Esistenza.ToString("N2")</td>
                                                <td class="text-end">
                                                    <span class="@(riga.Pronto > 0 ? "text-primary" : "text-muted") fw-bold">
                                                        @riga.Pronto.ToString("N2")
                                                    </span>
                                                </td>
                                            }
                                            <td class="text-end">
                                                @if (!User.IsInRole("Agenti"))
                                                {
                                                    <span class="@(riga.ImpegnatoAttuale > 0 ? "text-danger" : "text-muted") fw-bold" style="cursor: pointer;"
                                                          onclick="mostraDettaglioImpegnatoAttuale('@riga.CodiceArticolo', '@Model.DataFine.ToString("yyyy-MM-dd")')"
                                                          title="Clicca per vedere il dettaglio ordini">
                                                        @riga.ImpegnatoAttuale.ToString("N2")
                                                        <i class="bi bi-info-circle-fill ms-1"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="@(riga.ImpegnatoAttuale > 0 ? "text-danger" : "text-muted") fw-bold">
                                                        @riga.ImpegnatoAttuale.ToString("N2")
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (!User.IsInRole("Agenti") || riga.DisponibileAttuale > 0)
                                                {
                                                    <strong class="@(riga.DisponibileAttuale > 0 ? "text-success" :
                                                                    riga.DisponibileAttuale == 0 ? "text-warning" : "text-danger")">
                                                        @riga.DisponibileAttuale.ToString("N2")
                                                    </strong>
                                                }
                                                else
                                                {
                                                    <strong class="text-muted">N/D</strong>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(riga.NotaPrevisione))
                                                {
                                                    @if (!User.IsInRole("Agenti"))
                                                    {
                                                        <span class="@riga.NotaCssClass" style="cursor: pointer; text-decoration: underline;"
                                                              onclick="mostraDettaglioMovimentiNota('@riga.CodiceArticolo', @riga.Esistenza.ToString(System.Globalization.CultureInfo.InvariantCulture), '@Model.DataFine.ToString("yyyy-MM-dd")')"
                                                              title="Clicca per vedere il dettaglio dei movimenti">
                                                            @if (riga.DisponibilitaDaVerificare)
                                                            {
                                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-search me-1"></i>
                                                            }
                                                            @riga.NotaPrevisione
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="@riga.NotaCssClass">
                                                            @if (riga.DisponibilitaDaVerificare)
                                                            {
                                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                            }
                                                            @riga.NotaPrevisione
                                                        </span>
                                                    }
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (articoloOutlet.PercScontoExtra.HasValue)
                                                {
                                                    <span class="badge bg-danger fs-6" title="Sconto extra provvigione">
                                                        <i class="bi bi-percent me-1"></i>@articoloOutlet.PercScontoExtra.Value.ToString("N0")%
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="table-secondary">
                                <tr>
                                    <th colspan="4">TOTALI</th>
                                    @if (!User.IsInRole("Agenti"))
                                    {
                                        <th class="text-end">@Model.ArticoliOutlet.SelectMany(a => a.Risultati).Sum(r => r.Esistenza).ToString("N2")</th>
                                        <th class="text-end">
                                            <strong class="text-primary">
                                                @Model.ArticoliOutlet.SelectMany(a => a.Risultati).Sum(r => r.Pronto).ToString("N2")
                                            </strong>
                                        </th>
                                    }
                                    <th class="text-end">@Model.ArticoliOutlet.SelectMany(a => a.Risultati).Sum(r => r.ImpegnatoAttuale).ToString("N2")</th>
                                    <th class="text-end">
                                        @{
                                            var totDispOutlet = Model.ArticoliOutlet.SelectMany(a => a.Risultati).Sum(r => r.DisponibileAttuale);
                                        }
                                        @if (!User.IsInRole("Agenti") || totDispOutlet > 0)
                                        {
                                            <strong class="@(totDispOutlet > 0 ? "text-success" : "text-danger")">
                                                @totDispOutlet.ToString("N2")
                                            </strong>
                                        }
                                        else
                                        {
                                            <strong class="text-muted">N/D</strong>
                                        }
                                    </th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (Model.RicercaOutlet)
        {
            <div class="card mt-4 shadow-sm">
                <div class="card-body text-center py-4">
                    <i class="bi bi-tag text-warning" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Nessun articolo Outlet trovato</h5>
                    <p class="text-muted">Non ci sono articoli con il flag Outlet = 'S' nell'anagrafica.</p>
                </div>
            </div>
        }
</div>


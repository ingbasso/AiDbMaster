@model AiDbMaster.Models.TabellaAgenti

@{
    ViewData["Title"] = "Dettagli Agente";
    ViewBag.UseFluidContainer = true;
    var clientiAssociati = ViewBag.ClientiAssociati as List<AiDbMaster.Models.AnagraficaClienti> ?? new List<AiDbMaster.Models.AnagraficaClienti>();
    var statisticheProvincia = ViewBag.StatisticheProvincia;
}

<div class="content-container" style="width: 95%; margin: 0 auto;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-person-workspace me-2 text-primary"></i>Dettagli Agente</h2>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Torna all'elenco
                </a>
            </div>
        </div>

        <div class="row">
            <!-- Informazioni Principali -->
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Informazioni Principali</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.CodiceAgente)</label>
                                    <div class="form-control-plaintext bg-light p-3 rounded">
                                        <i class="bi bi-person-badge me-2 text-primary"></i>
                                        <strong class="fs-4">@Html.DisplayFor(model => model.CodiceAgente)</strong>
                                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" 
                                                onclick="copyToClipboard('@Model.CodiceAgente')" title="Copia Codice">
                                            <i class="bi bi-clipboard"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Stato</label>
                                    <div class="form-control-plaintext bg-light p-3 rounded text-center">
                                        <span class="@Model.StatoAgenteCssClass fs-5">@Model.StatoAgente</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.DescrizioneAgente)</label>
                            <div class="form-control-plaintext bg-light p-3 rounded">
                                @if (!string.IsNullOrEmpty(Model.DescrizioneAgente))
                                {
                                    <strong class="fs-5">@Html.DisplayFor(model => model.DescrizioneAgente)</strong>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Nome non specificato</span>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nome Completo</label>
                            <div class="form-control-plaintext bg-light p-2 rounded">
                                <strong>@Model.NomeCompleto</strong>
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" 
                                        onclick="copyToClipboard('@Model.NomeCompleto')" title="Copia Nome Completo">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Indirizzo -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Indirizzo e Localizzazione</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.HasIndirizzoCompleto)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Indirizzo Completo</label>
                                <div class="form-control-plaintext bg-light p-3 rounded">
                                    <i class="bi bi-house me-2 text-success"></i>
                                    @Html.DisplayFor(model => model.IndirizzoCompleto)
                                </div>
                            </div>
                        }

                        <div class="row">
                            @if (!string.IsNullOrEmpty(Model.IndirizzoAgente))
                            {
                                <div class="col-md-8">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.IndirizzoAgente)</label>
                                        <div class="form-control-plaintext bg-light p-2 rounded">
                                            @Html.DisplayFor(model => model.IndirizzoAgente)
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.CapAgente))
                            {
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.CapAgente)</label>
                                        <div class="form-control-plaintext bg-light p-2 rounded">
                                            <span class="badge bg-info">@Html.DisplayFor(model => model.CapAgente)</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="row">
                            @if (!string.IsNullOrEmpty(Model.CittaAgente))
                            {
                                <div class="col-md-8">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.CittaAgente)</label>
                                        <div class="form-control-plaintext bg-light p-2 rounded">
                                            <i class="bi bi-building me-2 text-primary"></i>
                                            @Html.DisplayFor(model => model.CittaAgente)
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.ProvinciaAgente))
                            {
                                <div class="col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">@Html.DisplayNameFor(model => model.ProvinciaAgente)</label>
                                        <div class="form-control-plaintext bg-light p-2 rounded">
                                            <span class="badge bg-warning text-dark fs-6">@Html.DisplayFor(model => model.ProvinciaAgente)</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (string.IsNullOrEmpty(Model.IndirizzoAgente) && string.IsNullOrEmpty(Model.CittaAgente))
                        {
                            <div class="text-center text-muted p-4">
                                <i class="bi bi-geo-alt-slash" style="font-size: 3rem;"></i>
                                <p class="mt-2">Informazioni di indirizzo non disponibili</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Clienti Associati -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-people me-2"></i>Clienti Associati
                            <span class="badge bg-light text-dark ms-2">@clientiAssociati.Count</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (clientiAssociati.Any())
                        {
                            <!-- Controlli paginazione -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <label class="me-2">Righe per pagina:</label>
                                    <select id="pageSizeClienti" class="form-select form-select-sm d-inline-block" style="width: auto;">
                                        <option value="10">10</option>
                                        <option value="20" selected>20</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                    </select>
                                </div>
                                <div id="paginationInfoClienti" class="text-muted small"></div>
                            </div>
                            
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0" id="tabellaClienti">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Codice</th>
                                            <th>Ragione Sociale</th>
                                            <th>Città</th>
                                            <th>Provincia</th>
                                            <th>Azioni</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyClienti">
                                        @foreach (var cliente in clientiAssociati)
                                        {
                                            <tr data-codice="@cliente.CodiceCliente" data-ragione="@cliente.RagioneSociale">
                                                <td>
                                                    <span class="badge bg-primary">@cliente.CodiceCliente</span>
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(cliente.RagioneSociale))
                                                    {
                                                        <strong>@cliente.RagioneSociale</strong>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted fst-italic">Non specificato</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(cliente.Citta))
                                                    {
                                                        @cliente.Citta
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(cliente.Provincia))
                                                    {
                                                        <span class="badge bg-info">@cliente.Provincia</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-warning" 
                                                            onclick="mostraOrdiniCliente(@cliente.CodiceCliente, this)" 
                                                            data-ragione="@(cliente.RagioneSociale ?? "")"
                                                            title="Visualizza Ordini">
                                                        <i class="bi bi-cart3"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            
                            <!-- Controlli paginazione in basso -->
                            <nav class="mt-3">
                                <ul class="pagination pagination-sm justify-content-center mb-0" id="paginationClienti">
                                </ul>
                            </nav>
                        }
                        else
                        {
                            <div class="text-center text-muted p-4">
                                <i class="bi bi-person-x" style="font-size: 3rem;"></i>
                                <p class="mt-2">Nessun cliente associato a questo agente</p>
                            </div>
                        }
                    </div>
                </div>
                
                <!-- Popup Ordini Cliente (Trascinabile) -->
                <div class="modal fade" id="popupOrdiniCliente" tabindex="-1" aria-labelledby="popupOrdiniClienteLabel" aria-hidden="true" style="z-index: 9999;">
                    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="z-index: 10000;">
                        <div class="modal-content">
                            <div class="modal-header bg-warning text-dark" style="cursor: move;" id="popupOrdiniHeader">
                                <h5 class="modal-title" id="popupOrdiniClienteLabel">
                                    <i class="bi bi-cart3 me-2"></i>Ordini Cliente: <span id="nomeClientePopup"></span>
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body" id="ordiniClienteContent">
                                <div class="text-center py-5">
                                    <div class="spinner-border text-warning" role="status">
                                        <span class="visually-hidden">Caricamento...</span>
                                    </div>
                                    <p class="mt-2">Caricamento ordini...</p>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <span class="me-auto text-muted" id="totaleOrdiniInfo"></span>
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Informazioni Aggiuntive -->
            <div class="col-lg-4">
                <!-- Riepilogo -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Riepilogo</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Codice Agente</label>
                            <div class="form-control-plaintext bg-light p-2 rounded text-center">
                                <span class="badge bg-primary fs-4">@Model.CodiceAgente</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Stato Operativo</label>
                            <div class="form-control-plaintext bg-light p-2 rounded text-center">
                                <span class="@Model.StatoAgenteCssClass fs-5">@Model.StatoAgente</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.InfoLocalizzazione))
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Localizzazione</label>
                                <div class="form-control-plaintext bg-light p-2 rounded text-center">
                                    <i class="bi bi-geo-alt me-1 text-warning"></i>
                                    <strong>@Model.InfoLocalizzazione</strong>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold">Indirizzo Completo</label>
                            <div class="form-control-plaintext bg-light p-2 rounded text-center">
                                @if (Model.HasIndirizzoCompleto)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>Disponibile
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-x-circle me-1"></i>Non Disponibile
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Statistiche Provincia -->
                @if (statisticheProvincia != null && !string.IsNullOrEmpty(Model.ProvinciaAgente))
                {
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Statistiche Provincia @Model.ProvinciaAgente</h5>
                        </div>
                        <div class="card-body">
                            <div class="row text-center mb-3">
                                <div class="col-6">
                                    <div class="border-end">
                                        <h6 class="text-muted">Tot. Agenti</h6>
                                        <h4 class="text-primary">@(statisticheProvincia?.TotaleAgenti ?? 0)</h4>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <h6 class="text-muted">Città</h6>
                                    <h4 class="text-info">@(statisticheProvincia?.CittaDistinte ?? 0)</h4>
                                </div>
                            </div>
                            
                            <div class="row text-center">
                                <div class="col-6">
                                    <h6 class="text-muted">Attivi</h6>
                                    <h5 class="text-success">@(statisticheProvincia?.AgentiAttivi ?? 0)</h5>
                                </div>
                                <div class="col-6">
                                    <h6 class="text-muted">Inattivi</h6>
                                    <h5 class="text-secondary">@(statisticheProvincia?.AgentiInattivi ?? 0)</h5>
                                </div>
                            </div>

                            @if (statisticheProvincia?.TotaleAgenti > 0)
                            {
                                <hr>
                                <div class="text-center">
                                    <small class="text-muted">
                                        Percentuale attivi: 
                                        <strong>@Math.Round((double)statisticheProvincia.AgentiAttivi / statisticheProvincia.TotaleAgenti * 100, 1)%</strong>
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Informazioni Tecniche -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Informazioni Tecniche</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Descrizione Completa</label>
                            <div class="form-control-plaintext bg-light p-2 rounded">
                                <small class="font-monospace">@Model.DescrizioneCompleta</small>
                                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" 
                                        onclick="copyToClipboard('@Model.DescrizioneCompleta')" title="Copia Descrizione">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Codice:</span>
                            <strong class="text-primary">@Model.CodiceAgente</strong>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Stato:</span>
                            <span class="@Model.StatoAgenteCssClass">@Model.StatoAgente</span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.ProvinciaAgente))
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted">Provincia:</span>
                                <span class="badge bg-info">@Model.ProvinciaAgente</span>
                            </div>
                        }
                        @if (Model.HasIndirizzoCompleto)
                        {
                            <hr class="my-2">
                            <small class="text-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Dati di indirizzo completi
                            </small>
                        }
                    </div>
                </div>

                <!-- Azioni Rapide -->
                <div class="card mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Azioni Rapide</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-outline-primary" 
                                    onclick="copyToClipboard('@Model.CodiceAgente')">
                                <i class="bi bi-clipboard me-2"></i>Copia Codice Agente
                            </button>
                            @if (!string.IsNullOrEmpty(Model.DescrizioneAgente))
                            {
                                <button type="button" class="btn btn-outline-info" 
                                        onclick="copyToClipboard('@Model.DescrizioneAgente')">
                                    <i class="bi bi-clipboard me-2"></i>Copia Nome Agente
                                </button>
                            }
                            <button type="button" class="btn btn-outline-success" 
                                    onclick="copyToClipboard('@Model.NomeCompleto')">
                                <i class="bi bi-clipboard me-2"></i>Copia Nome Completo
                            </button>
                            @if (Model.HasIndirizzoCompleto)
                            {
                                <button type="button" class="btn btn-outline-warning" 
                                        onclick="copyToClipboard('@Model.IndirizzoCompleto')">
                                    <i class="bi bi-clipboard me-2"></i>Copia Indirizzo
                                </button>
                            }
                            <button type="button" class="btn btn-outline-secondary" 
                                    onclick="copyToClipboard('@Model.DescrizioneCompleta')">
                                <i class="bi bi-clipboard me-2"></i>Copia Descrizione Completa
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Copia negli appunti
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                showToast('Testo copiato negli appunti: ' + text, 'success');
            }).catch(function(err) {
                console.error('Errore nella copia: ', err);
                showToast('Errore nella copia del testo', 'error');
            });
        }

        // Funzione per mostrare toast
        function showToast(message, type) {
            const toastContainer = document.getElementById('toast-container') || createToastContainer();
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0`;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            toastContainer.appendChild(toast);
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
            
            toast.addEventListener('hidden.bs.toast', function() {
                toast.remove();
            });
        }

        // Crea il container per i toast se non esiste
        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            container.style.zIndex = '1055';
            document.body.appendChild(container);
            return container;
        }

        // ========== PAGINAZIONE CLIENTI ==========
        let currentPageClienti = 1;
        let pageSizeClienti = 20;
        let allRowsClienti = [];

        $(document).ready(function() {
            // Salva tutte le righe
            allRowsClienti = $('#tbodyClienti tr').toArray();
            
            // Inizializza paginazione
            updatePaginationClienti();
            
            // Evento cambio page size
            $('#pageSizeClienti').change(function() {
                pageSizeClienti = parseInt($(this).val());
                currentPageClienti = 1;
                updatePaginationClienti();
            });
            
            // Rendi il popup trascinabile
            makePopupDraggable('popupOrdiniCliente', 'popupOrdiniHeader');
        });

        function updatePaginationClienti() {
            const totalRows = allRowsClienti.length;
            const totalPages = Math.ceil(totalRows / pageSizeClienti);
            const startIndex = (currentPageClienti - 1) * pageSizeClienti;
            const endIndex = Math.min(startIndex + pageSizeClienti, totalRows);
            
            // Nascondi tutte le righe e mostra solo quelle della pagina corrente
            $(allRowsClienti).hide();
            $(allRowsClienti.slice(startIndex, endIndex)).show();
            
            // Aggiorna info paginazione
            $('#paginationInfoClienti').text(`Visualizzati ${startIndex + 1}-${endIndex} di ${totalRows} clienti`);
            
            // Genera pulsanti paginazione
            let paginationHtml = '';
            
            // Pulsante precedente
            paginationHtml += `<li class="page-item ${currentPageClienti === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="goToPageClienti(${currentPageClienti - 1}); return false;">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>`;
            
            // Numeri pagina
            const startPage = Math.max(1, currentPageClienti - 2);
            const endPage = Math.min(totalPages, currentPageClienti + 2);
            
            if (startPage > 1) {
                paginationHtml += `<li class="page-item"><a class="page-link" href="#" onclick="goToPageClienti(1); return false;">1</a></li>`;
                if (startPage > 2) {
                    paginationHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
            }
            
            for (let i = startPage; i <= endPage; i++) {
                paginationHtml += `<li class="page-item ${i === currentPageClienti ? 'active' : ''}">
                    <a class="page-link" href="#" onclick="goToPageClienti(${i}); return false;">${i}</a>
                </li>`;
            }
            
            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    paginationHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
                }
                paginationHtml += `<li class="page-item"><a class="page-link" href="#" onclick="goToPageClienti(${totalPages}); return false;">${totalPages}</a></li>`;
            }
            
            // Pulsante successivo
            paginationHtml += `<li class="page-item ${currentPageClienti === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="goToPageClienti(${currentPageClienti + 1}); return false;">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>`;
            
            $('#paginationClienti').html(paginationHtml);
        }

        function goToPageClienti(page) {
            const totalPages = Math.ceil(allRowsClienti.length / pageSizeClienti);
            if (page >= 1 && page <= totalPages) {
                currentPageClienti = page;
                updatePaginationClienti();
            }
        }

        // ========== POPUP ORDINI CLIENTE ==========
        function mostraOrdiniCliente(codiceCliente, btn) {
            console.log('mostraOrdiniCliente chiamata con:', codiceCliente);
            
            const ragioneSociale = $(btn).data('ragione') || '';
            console.log('Ragione sociale:', ragioneSociale);
            
            $('#nomeClientePopup').text(codiceCliente + ' - ' + ragioneSociale);
            $('#ordiniClienteContent').html(`
                <div class="text-center py-5">
                    <div class="spinner-border text-warning" role="status">
                        <span class="visually-hidden">Caricamento...</span>
                    </div>
                    <p class="mt-2">Caricamento ordini...</p>
                </div>
            `);
            $('#totaleOrdiniInfo').text('');
            
            var modalElement = document.getElementById('popupOrdiniCliente');
            console.log('Modal element:', modalElement);
            
            if (!modalElement) {
                console.error('Modal non trovato!');
                alert('Errore: Modal non trovato');
                return;
            }
            
            // Sposta il modal nel body per evitare problemi di z-index/overflow
            if (modalElement.parentElement !== document.body) {
                document.body.appendChild(modalElement);
                console.log('Modal spostato nel body');
            }
            
            var modal = new bootstrap.Modal(modalElement);
            modal.show();
            console.log('Modal mostrato');
            
            // Carica ordini via AJAX
            $.get('@Url.Action("GetOrdiniCliente", "TabellaAgenti")', { codiceCliente: codiceCliente })
                .done(function(response) {
                    if (response.success && response.data && response.data.length > 0) {
                        let html = '<div class="accordion" id="accordionOrdini">';
                        let totaleOrdini = 0;
                        
                        response.data.forEach((ordine, index) => {
                            const collapseId = 'collapseOrdine' + index;
                            const totaleOrdine = ordine.righe.reduce((sum, r) => sum + r.valore, 0);
                            totaleOrdini += totaleOrdine;
                            
                            html += `
                                <div class="card mb-2">
                                    <div class="card-header p-0">
                                        <button class="btn btn-link w-100 text-start text-decoration-none p-3 ${index > 0 ? 'collapsed' : ''}" 
                                                type="button" data-bs-toggle="collapse" 
                                                data-bs-target="#${collapseId}">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong><i class="bi bi-file-earmark-text me-2"></i>Ordine ${ordine.numeroOrdineCompleto}</strong>
                                                    <span class="ms-3 text-muted">
                                                        <i class="bi bi-calendar me-1"></i>${ordine.dataOrdine}
                                                    </span>
                                                    ${ordine.riferimentoOrdine ? '<span class="ms-2 badge bg-secondary">' + ordine.riferimentoOrdine + '</span>' : ''}
                                                </div>
                                                <div>
                                                    <span class="badge bg-info me-2">${ordine.righe.length} righe</span>
                                                    <span class="badge bg-warning text-dark">€ ${totaleOrdine.toFixed(2)}</span>
                                                </div>
                                            </div>
                                        </button>
                                    </div>
                                    <div id="${collapseId}" class="collapse ${index === 0 ? 'show' : ''}" data-bs-parent="#accordionOrdini">
                                        <div class="card-body p-2">
                                            <div class="table-responsive">
                                                <table class="table table-sm table-striped table-hover mb-0" style="font-size: 0.85rem;">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Riga</th>
                                                            <th>Articolo</th>
                                                            <th>Descrizione</th>
                                                            <th class="text-center">Data Consegna</th>
                                                            <th class="text-end">Quantità</th>
                                                            <th class="text-end">Evasa</th>
                                                            <th class="text-end">Da Evadere</th>
                                                            <th class="text-end">Prezzo</th>
                                                            <th class="text-end">Valore</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        ${ordine.righe.map(r => `
                                                            <tr>
                                                                <td><strong>${r.rigaOrdine}</strong></td>
                                                                <td><code>${r.codiceArticolo}</code></td>
                                                                <td>${r.descrizioneArticolo || '-'}</td>
                                                                <td class="text-center"><span class="badge bg-info">${r.dataConsegna}</span></td>
                                                                <td class="text-end">${r.quantita.toFixed(2)} ${r.unitaMisura || ''}</td>
                                                                <td class="text-end">${r.quantitaEvasa.toFixed(2)}</td>
                                                                <td class="text-end"><strong>${r.quantitaDaEvadere.toFixed(2)}</strong></td>
                                                                <td class="text-end">€ ${r.prezzo.toFixed(2)}</td>
                                                                <td class="text-end"><strong>€ ${r.valore.toFixed(2)}</strong></td>
                                                            </tr>
                                                        `).join('')}
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                        
                        html += '</div>';
                        $('#ordiniClienteContent').html(html);
                        $('#totaleOrdiniInfo').html(`<strong>${response.data.length}</strong> ordini - Totale: <strong>€ ${totaleOrdini.toFixed(2)}</strong>`);
                    } else {
                        $('#ordiniClienteContent').html(`
                            <div class="alert alert-info text-center">
                                <i class="bi bi-info-circle me-2"></i>
                                Nessun ordine trovato per questo cliente.
                            </div>
                        `);
                    }
                })
                .fail(function() {
                    $('#ordiniClienteContent').html(`
                        <div class="alert alert-danger text-center">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            Errore durante il caricamento degli ordini.
                        </div>
                    `);
                });
        }

        // ========== POPUP TRASCINABILE ==========
        function makePopupDraggable(modalId, headerId) {
            const modal = document.getElementById(modalId);
            const header = document.getElementById(headerId);
            
            if (!modal || !header) return;
            
            let isDragging = false;
            let currentX, currentY, initialX, initialY;
            let xOffset = 0, yOffset = 0;
            
            header.addEventListener('mousedown', dragStart);
            document.addEventListener('mousemove', drag);
            document.addEventListener('mouseup', dragEnd);
            
            // Reset posizione quando il modal viene chiuso
            modal.addEventListener('hidden.bs.modal', function() {
                const dialog = modal.querySelector('.modal-dialog');
                dialog.style.transform = '';
                xOffset = 0;
                yOffset = 0;
            });
            
            function dragStart(e) {
                if (e.target.closest('.btn-close')) return;
                
                initialX = e.clientX - xOffset;
                initialY = e.clientY - yOffset;
                isDragging = true;
                header.style.cursor = 'grabbing';
            }
            
            function drag(e) {
                if (!isDragging) return;
                
                e.preventDefault();
                currentX = e.clientX - initialX;
                currentY = e.clientY - initialY;
                xOffset = currentX;
                yOffset = currentY;
                
                const dialog = modal.querySelector('.modal-dialog');
                dialog.style.transform = `translate(${currentX}px, ${currentY}px)`;
            }
            
            function dragEnd() {
                isDragging = false;
                header.style.cursor = 'move';
            }
        }
    </script>
}

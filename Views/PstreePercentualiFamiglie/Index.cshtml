@model AiDbMaster.ViewModels.Pstree_PercentualiFamiglieIndexViewModel

@{
    ViewData["Title"] = "Gestione Percentuali Famiglie";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-percent text-primary"></i> Gestione Percentuali Famiglie</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
        </div>
    }

    <!-- FILTRI -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0"><i class="bi bi-funnel"></i> Filtri</h6>
        </div>
        <div class="card-body">
            <form method="get" asp-controller="PstreePercentualiFamiglie" asp-action="Index" id="filterForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label for="anno" class="form-label">
                            <i class="bi bi-calendar"></i> Anno
                        </label>
                        <select name="anno" id="anno" class="form-select" onchange="this.form.submit()">
                            @foreach (var a in Model.AnniDisponibili)
                            {
                                <option value="@a" selected="@(a == Model.Anno)">@a</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="sede" class="form-label">
                            <i class="bi bi-building"></i> Sede
                        </label>
                        <select name="sede" id="sede" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Tutte --</option>
                            @foreach (var s in Model.Sedi)
                            {
                                <option value="@s.Id" selected="@(s.Id == Model.SedeSelezionata)">@s.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-7">
                        <div class="d-flex gap-2">
                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Completo</span>
                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Parziale</span>
                            <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Non configurato</span>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- LISTA VOCI CE -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul"></i> Voci Conto Economico</span>
            <span class="badge bg-light text-dark">@Model.VociCE.Count voci</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead style="background-color: #5b9bd5;">
                        <tr>
                            <th style="width: 80px; border: none; background-color: #5b9bd5 !important; color: white !important;">Codice</th>
                            <th style="border: none; background-color: #5b9bd5 !important; color: white !important;">Descrizione</th>
                            <th style="width: 100px; border: none; background-color: #5b9bd5 !important; color: white !important; text-align: center;">Tipo</th>
                            <th style="width: 150px; border: none; background-color: #5b9bd5 !important; color: white !important; text-align: center;">Stato</th>
                            <th style="width: 200px; border: none; background-color: #5b9bd5 !important; color: white !important; text-align: center;">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var voce in Model.VociCE)
                        {
                            <tr>
                                <td><code>@voce.IdCodiceConto</code></td>
                                <td>@voce.DescrizioneConto</td>
                                <td class="text-center">
                                    <span class="badge @(voce.TipoConto == "R" ? "bg-success" : voce.TipoConto == "C" ? "bg-danger" : "bg-secondary")">
                                        @voce.TipoConto
                                    </span>
                                </td>
                                <td class="text-center">
                                    <i class="bi @voce.StatoIcona"></i>
                                    <span class="ms-1">@voce.StatoTesto</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="PstreePercentualiFamiglie" asp-action="Edit" 
                                           asp-route-idCodiceConto="@voce.IdCodiceConto"
                                           asp-route-anno="@Model.Anno"
                                           asp-route-sede="@Model.SedeSelezionata"
                                           class="btn btn-outline-primary" title="Modifica percentuali">
                                            <i class="bi bi-pencil"></i> Modifica
                                        </a>
                                        @if (voce.HasPercentuali)
                                        {
                                            <form asp-controller="PstreePercentualiFamiglie" asp-action="DeleteAll" method="post" style="display: inline;"
                                                  onsubmit="return confirm('Sei sicuro di voler eliminare TUTTE le percentuali per questa voce?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idCodiceConto" value="@voce.IdCodiceConto" />
                                                <input type="hidden" name="anno" value="@Model.Anno" />
                                                <input type="hidden" name="sede" value="@Model.SedeSelezionata" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Elimina tutte le percentuali">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Info -->
    <div class="card mt-3">
        <div class="card-body py-2">
            <small class="text-muted">
                <strong>Info:</strong> 
                Per ogni voce del conto economico, configura le percentuali di distribuzione tra le famiglie.
                La somma delle percentuali per ogni mese deve essere esattamente <strong>100%</strong>.
            </small>
        </div>
    </div>
</div>

@model AiDbMaster.Models.PstreeAssociazioniCE

@{
    ViewData["Title"] = "Elimina Associazione";
    var pdc = ViewBag.PianoDeiConti as AiDbMaster.Models.PstreeListaPianoDeiConti;
    var conto = ViewBag.ContoEconomico as AiDbMaster.Models.PstreeStrutturaContoEconomico;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-trash text-danger"></i> Elimina Associazione</h2>
        <a asp-action="Index" asp-controller="PstreeAssociazioniCE" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Conferma Eliminazione</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-circle"></i>
                        Sei sicuro di voler eliminare questa associazione?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Codice PdC</dt>
                        <dd class="col-sm-8">
                            <code>@Model.CodicePdC</code>
                            @if (pdc != null)
                            {
                                <span class="ms-2">- @pdc.DescrizionePdC</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Conto Economico</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-primary">@Model.IdCodiceConto</span>
                            @if (conto != null)
                            {
                                <span class="ms-1">@conto.DescrizioneConto</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" asp-controller="PstreeAssociazioniCE">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Conferma Eliminazione
                            </button>
                            <a asp-action="Index" asp-controller="PstreeAssociazioniCE" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

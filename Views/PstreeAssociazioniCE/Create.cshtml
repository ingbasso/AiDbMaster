@model AiDbMaster.Models.PstreeAssociazioniCE

@{
    ViewData["Title"] = "Nuova Associazione";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-plus-circle text-success"></i> Nuova Associazione</h2>
        <a asp-action="Index" asp-controller="PstreeAssociazioniCE" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-link-45deg"></i> Associa Piano dei Conti a Conto Economico</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" asp-controller="PstreeAssociazioniCE">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="CodicePdC" class="form-label">
                                <i class="bi bi-book"></i> Codice Piano dei Conti <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CodicePdC" class="form-select">
                                <option value="">-- Seleziona un conto --</option>
                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.CodiciPdC)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="CodicePdC" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdCodiceConto" class="form-label">
                                <i class="bi bi-diagram-3"></i> Conto Economico <span class="text-danger">*</span>
                            </label>
                            <select asp-for="IdCodiceConto" class="form-select">
                                @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.ContiEconomico)
                                {
                                    <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                }
                            </select>
                            <span asp-validation-for="IdCodiceConto" class="text-danger"></span>
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Salva
                            </button>
                            <a asp-action="Index" asp-controller="PstreeAssociazioniCE" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model AiDbMaster.Models.PstreeAssociazioniCE

@{
    ViewData["Title"] = "Dettagli Associazione";
    var pdc = ViewBag.PianoDeiConti as AiDbMaster.Models.PstreeListaPianoDeiConti;
    var conto = ViewBag.ContoEconomico as AiDbMaster.Models.PstreeStrutturaContoEconomico;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-eye text-info"></i> Dettagli Associazione</h2>
        <a asp-action="Index" asp-controller="PstreeAssociazioniCE" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-link-45deg"></i> Associazione #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-12">
                            <label class="form-label text-muted small">Piano dei Conti</label>
                            <div class="fs-5 fw-bold">
                                <code>@Model.CodicePdC</code>
                                @if (pdc != null)
                                {
                                    <span class="ms-2">- @pdc.DescrizionePdC</span>
                                    @if (pdc.TipoPdC == "P")
                                    {
                                        <span class="badge bg-info ms-2">Patrimoniale</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success ms-2">Economico</span>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-12">
                            <label class="form-label text-muted small">Conto Economico</label>
                            <div class="fs-5 fw-bold">
                                <span class="badge bg-primary me-2">@Model.IdCodiceConto</span>
                                @if (conto != null)
                                {
                                    @conto.DescrizioneConto
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-gear"></i> Azioni</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-controller="PstreeAssociazioniCE" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Modifica
                        </a>
                        <a asp-action="Delete" asp-controller="PstreeAssociazioniCE" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> Elimina
                        </a>
                        <a asp-action="Index" asp-controller="PstreeAssociazioniCE" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Torna all'elenco
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

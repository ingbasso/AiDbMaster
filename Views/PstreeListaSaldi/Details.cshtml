@model AiDbMaster.Models.PstreeListaSaldi

@{
    ViewData["Title"] = "Dettagli Saldo";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-coin text-primary"></i> Dettagli Saldo</h2>
        <a asp-controller="PstreeListaSaldi" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row">
        <!-- Colonna principale -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle"></i> 
                        @if (ViewBag.PianoDeiConti != null)
                        {
                            var pdc = (AiDbMaster.Models.PstreeListaPianoDeiConti)ViewBag.PianoDeiConti;
                            @($"{pdc.CodicePdC} - {pdc.DescrizionePdC}")
                        }
                        else
                        {
                            @Model.CodicePdC
                        }
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Codice Piano dei Conti</label>
                            <div class="fw-bold"><code class="fs-5">@Model.CodicePdC</code></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Descrizione</label>
                            <div class="fw-bold fs-5">
                                @if (ViewBag.PianoDeiConti != null)
                                {
                                    var pdc = (AiDbMaster.Models.PstreeListaPianoDeiConti)ViewBag.PianoDeiConti;
                                    @pdc.DescrizionePdC
                                    <br/>
                                    @if (pdc.TipoPdC == "P")
                                    {
                                        <span class="badge bg-info">
                                            <i class="bi bi-building"></i> Patrimoniale
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-graph-up"></i> Economico
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted"><em>Conto non trovato nel Piano dei Conti</em></span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Dare</label>
                            <div class="fs-4 text-success fw-bold">
                                @String.Format("{0:C}", Model.Dare ?? 0)
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Avere</label>
                            <div class="fs-4 text-danger fw-bold">
                                @String.Format("{0:C}", Model.Avere ?? 0)
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small">Saldo</label>
                            @{
                                var saldoClass = Model.Saldo >= 0 ? "text-success" : "text-danger";
                            }
                            <div class="fs-4 @saldoClass fw-bold">
                                @String.Format("{0:C}", Model.Saldo)
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-muted small">Mese</label>
                            <div>
                                @if (Model.Mese.HasValue)
                                {
                                    <span class="badge bg-info fs-6">@Model.NomeMese</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-muted small">Anno</label>
                            <div>
                                @if (Model.Anno.HasValue)
                                {
                                    <span class="badge bg-primary fs-6">@Model.Anno</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-muted small">Famiglia</label>
                            <div>
                                @if (Model.IdFamiglia.HasValue && ViewBag.Famiglia != null)
                                {
                                    var famiglia = (AiDbMaster.Models.PstreeListaFamiglie)ViewBag.Famiglia;
                                    <span class="badge bg-success fs-6">
                                        <i class="bi bi-layers"></i> @famiglia.Id - @famiglia.NomeFamiglia
                                    </span>
                                }
                                else if (Model.IdFamiglia.HasValue)
                                {
                                    <span class="badge bg-secondary fs-6">ID: @Model.IdFamiglia</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label text-muted small">Sede</label>
                            <div>
                                @if (Model.IdSede.HasValue && ViewBag.Sede != null)
                                {
                                    var sede = (AiDbMaster.Models.PstreeListaSedi)ViewBag.Sede;
                                    <span class="badge bg-secondary fs-6">
                                        <i class="bi bi-building"></i> @sede.Id - @sede.Sede
                                    </span>
                                }
                                else if (Model.IdSede.HasValue)
                                {
                                    <span class="badge bg-secondary fs-6">ID: @Model.IdSede</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Colonna laterale -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Informazioni Record</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-database"></i> Origine Dati</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0 text-muted small">
                        Questo record proviene da fonti esterne.
                        I dati sono in sola lettura.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Pulsanti azione -->
    <div class="mt-4">
        <a asp-controller="PstreeListaSaldi" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>
</div>

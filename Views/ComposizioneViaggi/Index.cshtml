@{
    ViewData["Title"] = "Composizione Viaggi";
    ViewBag.UseFluidContainer = true;
}

@section Styles {
<style>
    .page-wrapper {
        display: flex;
        gap: 16px;
        padding: 0 8px;
        height: calc(100vh - 100px);
    }
    .page-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
    }
    .composizione-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
    .panel-right {
        width: 460px;
        min-width: 460px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .filtri-bar {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 12px;
    }
    .tab-content-area {
        flex: 1;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .griglia-righe {
        flex: 1;
        overflow-y: auto;
        padding: 0;
    }
    .carrello-panel {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }
    .carrello-header {
        padding: 10px 12px;
        border-bottom: 1px solid #dee2e6;
        background: #f8f9fa;
        border-radius: 8px 8px 0 0;
        flex-shrink: 0;
    }
    .carrello-scroll {
        flex: 1;
        overflow-y: auto;
    }
    .carrello-body {
        padding: 12px;
    }
    .carrello-footer {
        padding: 10px 12px;
        border-top: 1px solid #dee2e6;
        background: #f8f9fa;
    }
    .carrello-footer .footer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px 10px;
    }
    .carrello-footer .footer-grid .span-full {
        grid-column: 1 / -1;
    }
    .carrello-item {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 8px 10px;
        margin-bottom: 6px;
        font-size: 0.82rem;
        position: relative;
    }
    .carrello-item .btn-remove {
        position: absolute;
        top: 4px;
        right: 4px;
        padding: 0 4px;
        font-size: 0.75rem;
        line-height: 1;
    }
    .nav-tabs .nav-link {
        font-size: 0.85rem;
        padding: 8px 12px;
        white-space: nowrap;
    }
    .nav-tabs {
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
    }
    .tab-badge {
        font-size: 0.7rem;
        padding: 2px 6px;
        margin-left: 4px;
    }
    .table-righe {
        font-size: 0.82rem;
        margin-bottom: 0;
    }
    .table-righe th {
        position: sticky;
        top: 0;
        background: #f8f9fa;
        z-index: 1;
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    .table-righe td {
        vertical-align: middle;
        padding: 6px 8px;
    }
    .table-righe tr.testata-header {
        background: linear-gradient(135deg, #e8f0fe, #d6e4f7);
        cursor: pointer;
        user-select: none;
    }
    .table-righe tr.testata-header:hover {
        background: linear-gradient(135deg, #d6e4f7, #c4d8f0);
    }
    .table-righe tr.testata-header.testata-completa {
        background: linear-gradient(135deg, #d4edda, #c3e6cb);
        opacity: 0.75;
    }
    .table-righe tr.testata-header.testata-completa:hover {
        background: linear-gradient(135deg, #c3e6cb, #b1dfbb);
    }
    .table-righe tr.testata-header.testata-completa td {
        border-bottom-color: #a3d9a5;
    }
    .table-righe tr.testata-header td {
        padding: 6px 8px;
        border-bottom: 2px solid #b8cce4;
        font-size: 0.8rem;
    }
    .testata-info { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center; }
    .testata-info .ti-label { font-size: 0.7rem; color: #6c757d; text-transform: uppercase; letter-spacing: 0.3px; }
    .testata-info .ti-value { font-weight: 600; }
    .testata-note { font-size: 0.75rem; color: #6c757d; font-style: italic; margin-top: 2px; }
    .table-righe tr.gia-assegnata {
        opacity: 0.5;
        text-decoration: line-through;
    }
    .table-righe tr.selezionata {
        background-color: #d4edda !important;
    }
    .province-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }
    .province-chip {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 16px;
        font-size: 0.8rem;
        cursor: pointer;
        border: 1px solid #dee2e6;
        background: #fff;
        transition: all 0.2s;
        user-select: none;
    }
    .province-chip:hover { background: #e9ecef; }
    .province-chip.active {
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }
    .peso-totale-badge {
        font-size: 1.1rem;
        font-weight: 600;
    }
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 40px;
        color: #6c757d;
    }
    .empty-state i { font-size: 3rem; margin-bottom: 12px; }
    .spinner-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
    }
    .qta-input {
        width: 72px;
        padding: 2px 4px;
        font-size: 0.82rem;
        text-align: right;
        border: 1px solid #86b7fe;
        border-radius: 4px;
        outline: none;
        background: #fff;
    }
    .qta-input:focus { box-shadow: 0 0 0 2px rgba(13,110,253,.25); }
    .qta-input.qta-warning {
        border-color: #ffc107;
        background: #fff9e6;
        box-shadow: 0 0 0 2px rgba(255,193,7,.3);
    }
    .qta-static { display: inline; }
    .link-articolo {
        color: #0d6efd;
        text-decoration: none;
        cursor: pointer;
    }
    .link-articolo:hover {
        text-decoration: underline;
        color: #0a58ca;
    }
    .form-section { margin-bottom: 0; }
    .form-section label {
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 2px;
        color: #6c757d;
    }
</style>
}

<div class="page-wrapper">
    <!-- ===== COLONNA SINISTRA (titolo + filtri + griglia) ===== -->
    <div class="page-main">
        <div class="d-flex align-items-center mb-2" style="gap:16px;">
            <h4 class="mb-0" style="white-space:nowrap;">
                <i class="bi bi-puzzle me-2"></i>Composizione Viaggi
            </h4>
            <div class="d-flex align-items-center gap-2">
                <span style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.3px; color:#6c757d; white-space:nowrap;">
                    <i class="bi bi-calendar-event me-1"></i>Data Consegna
                </span>
                <input type="date" id="dataConsegnaDa" class="form-control form-control-sm" style="width:150px;" />
                <span style="font-size:0.78rem; color:#6c757d;">—</span>
                <input type="date" id="dataConsegnaA" class="form-control form-control-sm" style="width:150px;" />
                <div class="form-check ms-3" style="white-space:nowrap;">
                    <input class="form-check-input" type="checkbox" id="filtroPortoFranco" checked />
                    <label class="form-check-label" for="filtroPortoFranco" style="font-size:0.78rem; font-weight:600; color:#6c757d;">
                        Porto Franco
                    </label>
                </div>
            </div>
            <div id="alertContainer" class="ms-auto"></div>
        </div>

        <div class="composizione-container">
            <!-- Barra filtri province -->
            <div class="filtri-bar">
                <label class="form-label mb-1" style="font-size:0.78rem; font-weight:600; text-transform:uppercase; letter-spacing:0.3px; color:#6c757d;">
                    <i class="bi bi-geo-alt me-1"></i>Province
                </label>
                <div id="provinceContainer" class="province-chips">
                    <span class="text-muted" style="font-size:0.82rem;">Caricamento province...</span>
                </div>
            </div>

            <!-- Tab tipo mezzo + griglia -->
            <div class="tab-content-area">
                <ul class="nav nav-tabs" id="tabTipiMezzo" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-tipo="MotriceGru" data-bs-toggle="tab" type="button" role="tab">
                            Motrice Gru <span class="badge bg-secondary tab-badge" id="badge-MotriceGru">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="AutotrenoGru" data-bs-toggle="tab" type="button" role="tab">
                            Autotreno Gru <span class="badge bg-secondary tab-badge" id="badge-AutotrenoGru">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="AutotrenoAbbinato" data-bs-toggle="tab" type="button" role="tab">
                            Autotr. Abb. <span class="badge bg-secondary tab-badge" id="badge-AutotrenoAbbinato">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="AutotrenoNoGru" data-bs-toggle="tab" type="button" role="tab">
                            Autotr. No Gru <span class="badge bg-secondary tab-badge" id="badge-AutotrenoNoGru">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="Bilico" data-bs-toggle="tab" type="button" role="tab">
                            Bilico <span class="badge bg-secondary tab-badge" id="badge-Bilico">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="BilicoInAbbinamento" data-bs-toggle="tab" type="button" role="tab">
                            Bilico Abb. <span class="badge bg-secondary tab-badge" id="badge-BilicoInAbbinamento">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="MotriceInAbbinamento" data-bs-toggle="tab" type="button" role="tab">
                            Motrice Abb. <span class="badge bg-secondary tab-badge" id="badge-MotriceInAbbinamento">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="Trasporto" data-bs-toggle="tab" type="button" role="tab">
                            Trasporto <span class="badge bg-secondary tab-badge" id="badge-Trasporto">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="TrasportoPosa" data-bs-toggle="tab" type="button" role="tab">
                            Trasp. Posa <span class="badge bg-secondary tab-badge" id="badge-TrasportoPosa">0</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-tipo="NessunMezzo" data-bs-toggle="tab" type="button" role="tab">
                            <i class="bi bi-question-circle me-1"></i>Nessun Mezzo <span class="badge bg-warning text-dark tab-badge" id="badge-NessunMezzo">0</span>
                        </button>
                    </li>
                </ul>
                <div class="griglia-righe" id="grigliaRighe">
                    <div class="empty-state">
                        <i class="bi bi-funnel"></i>
                        <p>Seleziona almeno una provincia per visualizzare le righe ordine</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== COLONNA DESTRA (CARRELLO) — parte dall'alto ===== -->
    <div class="panel-right">
        <div class="carrello-panel">
            <div class="carrello-header">
                <h6 class="mb-1"><i class="bi bi-cart3 me-2"></i>Viaggio in composizione</h6>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted" style="font-size:0.82rem;">
                        Righe: <strong id="carrelloCount">0</strong>
                    </span>
                    <span class="peso-totale-badge">
                        <i class="bi bi-box-seam me-1"></i><span id="carrelloPesoTotale">0.00</span> Kg
                    </span>
                </div>
            </div>
            <div class="carrello-scroll">
                <div class="carrello-body" id="carrelloBody">
                    <div class="empty-state" style="padding:20px;">
                        <i class="bi bi-cart-plus" style="font-size:2rem;"></i>
                        <p class="mb-0" style="font-size:0.85rem;">Seleziona righe dalla griglia</p>
                    </div>
                </div>
                <div class="carrello-footer">
                    <div class="footer-grid">
                        <div class="form-section span-full">
                            <label>Data Consegna</label>
                            <input type="date" id="viaggioDataConsegna" class="form-control form-control-sm" />
                        </div>
                        <div class="form-section">
                            <label>Ora Partenza</label>
                            <input type="time" id="viaggioOraPartenza" class="form-control form-control-sm" value="06:00" />
                        </div>
                        <div class="form-section">
                            <label>Ora Arrivo</label>
                            <input type="time" id="viaggioOraArrivo" class="form-control form-control-sm" />
                        </div>
                        <div class="form-section span-full">
                            <label>Tipo Trasporto</label>
                            <select id="viaggioTipoTrasporto" class="form-select form-select-sm">
                                <option value="">-- Seleziona --</option>
                            </select>
                        </div>
                        <div class="form-section">
                            <label>Mezzo Interno</label>
                            <select id="viaggioMezzoInterno" class="form-select form-select-sm">
                                <option value="">-- Nessuno --</option>
                            </select>
                        </div>
                        <div class="form-section">
                            <label>Mezzo Esterno</label>
                            <select id="viaggioMezzoEsterno" class="form-select form-select-sm">
                                <option value="">-- Nessuno --</option>
                            </select>
                        </div>
                        <div class="form-section span-full">
                            <label>Autista</label>
                            <select id="viaggioAutista" class="form-select form-select-sm">
                                <option value="">-- Nessuno --</option>
                            </select>
                        </div>
                        <div class="form-section span-full">
                            <label>Note</label>
                            <textarea id="viaggioNote" class="form-control form-control-sm" rows="1"></textarea>
                        </div>
                        <div class="span-full" style="margin-top:4px;">
                            <button id="btnCreaViaggio" class="btn btn-success w-100" disabled>
                                <i class="bi bi-check-circle me-1"></i>Crea Viaggio
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Popup Disponibilità Articolo -->
<div class="modal fade" id="popupDisponibilita" tabindex="-1" aria-labelledby="popupDisponibilitaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="max-width:95%; width:95%;">
        <div class="modal-content">
            <div class="modal-header bg-info text-white" id="headerDisponibilita" style="cursor: move;">
                <h5 class="modal-title" id="popupDisponibilitaLabel">
                    <i class="bi bi-boxes me-2"></i>Disponibilità Articolo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="loadingDisponibilita" class="text-center py-5">
                    <div class="spinner-border text-info" role="status">
                        <span class="visually-hidden">Caricamento...</span>
                    </div>
                    <p class="mt-3 text-muted">Caricamento disponibilità...</p>
                </div>
                <div id="contenutoDisponibilita" style="display:none;">
                    <div class="alert alert-light border mb-3 py-2">
                        <div class="row">
                            <div class="col-md-8">
                                <strong><i class="bi bi-box-seam me-1"></i></strong>
                                <span id="dispArticoloInfo"></span>
                            </div>
                            <div class="col-md-4 text-end">
                                <strong><i class="bi bi-calendar-event me-1"></i>Rif.:</strong>
                                <span id="dispDataRif" class="badge bg-primary"></span>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-sm">
                            <thead>
                                <tr>
                                    <th class="bg-secondary text-white text-center" colspan="4">ANAGRAFICA</th>
                                    <th class="bg-success text-white text-center" colspan="4">ANALISI DISPONIBILITÀ</th>
                                    <th class="bg-warning text-white text-center">NOTE PREVISIONE</th>
                                </tr>
                                <tr class="table-dark">
                                    <th>Codice</th>
                                    <th>Descrizione</th>
                                    <th>U.M.</th>
                                    <th>Mag.</th>
                                    <th class="text-end">Esistenza</th>
                                    <th class="text-end">Pronto</th>
                                    <th class="text-end">Impegnato</th>
                                    <th class="text-end">Disponibile</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody id="tabellaDisponibilita"></tbody>
                        </table>
                    </div>
                </div>
                <div id="erroreDisponibilita" style="display:none;" class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <span id="msgErroreDisponibilita"></span>
                </div>
            </div>
            <div class="modal-footer py-1">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Chiudi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(function () {
    // Stato applicazione
    let provinceSelezionate = [];
    let tipoMezzoAttivo = 'MotriceGru';
    let righeCarrello = [];  // { rigaId, ordine, cliente, articolo, quantita, pesoKg, provincia, localita }
    let datiViaggio = null;

    const urlGetProvince = '@Url.Action("GetProvince", "ComposizioneViaggi")';
    const urlGetRighe = '@Url.Action("GetRighePerTipoMezzo", "ComposizioneViaggi")';
    const urlGetConteggi = '@Url.Action("GetConteggiTipiMezzo", "ComposizioneViaggi")';
    const urlGetDatiViaggio = '@Url.Action("GetDatiViaggio", "ComposizioneViaggi")';
    const urlCreaViaggio = '@Url.Action("CreaViaggio", "ComposizioneViaggi")';
    const urlDisponibilita = '@Url.Action("GetDisponibilitaArticoloJson", "InterrogazioniDB")';

    // ===== INIZIALIZZAZIONE =====
    caricaProvince();
    caricaDatiViaggio();

    // Imposta data consegna viaggio a oggi
    $('#viaggioDataConsegna').val(new Date().toISOString().split('T')[0]);

    // Event: click su tab
    $('#tabTipiMezzo .nav-link').on('click', function () {
        tipoMezzoAttivo = $(this).data('tipo');
        caricaRighe();
    });

    // Event: cambio filtro date e porto
    $('#dataConsegnaDa, #dataConsegnaA, #filtroPortoFranco').on('change', function () {
        caricaRighe();
        caricaConteggi();
    });

    // Event: crea viaggio
    $('#btnCreaViaggio').on('click', creaViaggio);

    // ===== PROVINCE =====
    function caricaProvince() {
        $.getJSON(urlGetProvince, function (data) {
            const container = $('#provinceContainer');
            container.empty();

            if (!data || data.length === 0) {
                container.html('<span class="text-muted" style="font-size:0.82rem;">Nessuna provincia trovata</span>');
                return;
            }

            // Aggiungi chip "Tutte"
            const chipTutte = $('<span class="province-chip" data-sigla="__ALL__">Tutte</span>');
            chipTutte.on('click', function () {
                const isActive = $(this).hasClass('active');
                if (isActive) {
                    $('.province-chip').removeClass('active');
                    provinceSelezionate = [];
                } else {
                    $('.province-chip').addClass('active');
                    provinceSelezionate = data.map(p => p.sigla);
                }
                caricaRighe();
                caricaConteggi();
            });
            container.append(chipTutte);

            data.forEach(function (p) {
                const chip = $(`<span class="province-chip" data-sigla="${p.sigla}">${p.sigla}</span>`);
                chip.on('click', function () {
                    $(this).toggleClass('active');
                    // Aggiorna "Tutte"
                    const tutteActive = $('.province-chip:not([data-sigla="__ALL__"])').length ===
                                        $('.province-chip.active:not([data-sigla="__ALL__"])').length;
                    $('.province-chip[data-sigla="__ALL__"]').toggleClass('active', tutteActive);

                    provinceSelezionate = [];
                    $('.province-chip.active:not([data-sigla="__ALL__"])').each(function () {
                        provinceSelezionate.push($(this).data('sigla'));
                    });
                    caricaRighe();
                    caricaConteggi();
                });
                container.append(chip);
            });
        });
    }

    // ===== CONTEGGI BADGE =====
    function caricaConteggi() {
        const params = new URLSearchParams();
        provinceSelezionate.forEach(p => params.append('province', p));

        $.getJSON(urlGetConteggi + '?' + params.toString(), function (data) {
            Object.keys(data).forEach(function (tipo) {
                const badge = $(`#badge-${tipo}`);
                badge.text(data[tipo]);
                badge.toggleClass('bg-primary', data[tipo] > 0).toggleClass('bg-secondary', data[tipo] === 0);
            });
        });
    }

    // ===== GRIGLIA RIGHE =====
    function caricaRighe() {
        if (provinceSelezionate.length === 0) {
            $('#grigliaRighe').html(`
                <div class="empty-state">
                    <i class="bi bi-funnel"></i>
                    <p>Seleziona almeno una provincia per visualizzare le righe ordine</p>
                </div>`);
            return;
        }

        $('#grigliaRighe').html('<div class="spinner-loading"><div class="spinner-border text-primary" role="status"></div></div>');

        const params = new URLSearchParams();
        params.append('tipoMezzo', tipoMezzoAttivo);
        provinceSelezionate.forEach(p => params.append('province', p));

        const dataDa = $('#dataConsegnaDa').val();
        const dataA = $('#dataConsegnaA').val();
        if (dataDa) params.append('dataConsegnaDa', dataDa);
        if (dataA) params.append('dataConsegnaA', dataA);
        if ($('#filtroPortoFranco').is(':checked')) params.append('portoFranco', 'true');

        $.getJSON(urlGetRighe + '?' + params.toString(), function (data) {
            if (!data || data.length === 0) {
                $('#grigliaRighe').html(`
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Nessuna riga trovata per questo tipo mezzo e queste province</p>
                    </div>`);
                return;
            }

            // Raggruppa per ordineId (testata)
            const grouped = {};
            data.forEach(r => {
                if (!grouped[r.ordineId]) {
                    grouped[r.ordineId] = {
                        ordineId: r.ordineId,
                        numeroOrdine: r.numeroOrdine,
                        cliente: r.cliente,
                        provincia: r.provincia,
                        localita: r.localita,
                        indirizzoDestinazione: r.indirizzoDestinazione || '',
                        agente: r.agente || '',
                        riferimentoOrdine: r.riferimentoOrdine || '',
                        noteTestata: r.noteTestata || '',
                        righe: []
                    };
                }
                grouped[r.ordineId].righe.push(r);
            });

            const numCols = 8;
            let html = `<table class="table table-hover table-righe">
                <thead>
                    <tr>
                        <th style="width:35px;"><input type="checkbox" id="checkAll" title="Seleziona tutte" /></th>
                        <th>Articolo</th>
                        <th>Descrizione</th>
                        <th class="text-end">Qta Rim.</th>
                        <th>UM</th>
                        <th class="text-end">Peso Kg</th>
                        <th>Consegna</th>
                        <th>Stato</th>
                    </tr>
                </thead>
                <tbody>`;

            Object.values(grouped).forEach(function (testata) {
                const dest = testata.indirizzoDestinazione
                    ? `${testata.localita} - ${testata.indirizzoDestinazione}`
                    : testata.localita;

                const tutteAssegnate = testata.righe.length > 0 && testata.righe.every(r => r.giaAssegnata);
                const testataClasses = 'testata-header' + (tutteAssegnate ? ' testata-completa' : '');

                let infoHtml = `<span class="ti-value"><i class="bi bi-file-earmark-text me-1"></i>${testata.numeroOrdine}</span>`;
                infoHtml += `<span class="ti-value"><i class="bi bi-person me-1"></i>${testata.cliente}</span>`;
                infoHtml += `<span><span class="badge bg-info text-dark">${testata.provincia}</span> ${dest}</span>`;
                if (testata.agente) infoHtml += `<span><span class="ti-label">Agente:</span> ${testata.agente}</span>`;
                if (testata.riferimentoOrdine) infoHtml += `<span><span class="ti-label">Rif:</span> ${testata.riferimentoOrdine}</span>`;
                if (tutteAssegnate) infoHtml += `<span class="badge bg-success ms-1"><i class="bi bi-check2-all me-1"></i>In viaggio</span>`;

                let noteHtml = '';
                if (testata.noteTestata) noteHtml = `<div class="testata-note"><i class="bi bi-sticky me-1"></i>${testata.noteTestata}</div>`;

                html += `<tr class="${testataClasses}" data-ordine-id="${testata.ordineId}">
                    <td><input type="checkbox" class="testata-check" data-ordine-id="${testata.ordineId}" title="Seleziona tutte le righe di questo ordine" ${tutteAssegnate ? 'disabled' : ''} /></td>
                    <td colspan="${numCols - 1}">
                        <div class="testata-info">${infoHtml}</div>
                        ${noteHtml}
                    </td>
                </tr>`;

                testata.righe.forEach(function (r) {
                    const inCarrello = righeCarrello.some(c => c.rigaId === r.rigaId);
                    const carrelloItem = inCarrello ? righeCarrello.find(c => c.rigaId === r.rigaId) : null;
                    const trClass = r.giaAssegnata ? 'gia-assegnata' : (inCarrello ? 'selezionata' : '');
                    const disabled = r.giaAssegnata ? 'disabled' : '';
                    const checked = inCarrello ? 'checked' : '';
                    const qtaRim = (r.quantita - r.quantitaEvasa);
                    const qtaAttuale = carrelloItem ? carrelloItem.quantita : qtaRim;
                    const pesoTotRiga = (r.pesoKgUnitario * qtaAttuale);
                    const showInput = inCarrello && !r.giaAssegnata;
                    const isWarning = qtaAttuale > qtaRim;

                    html += `<tr class="${trClass}" data-riga-id="${r.rigaId}" data-ordine-id="${testata.ordineId}">
                        <td><input type="checkbox" class="riga-check" value="${r.rigaId}" ${disabled} ${checked}
                            data-ordine="${r.numeroOrdine}"
                            data-cliente="${r.cliente}"
                            data-articolo="${r.codiceArticolo}"
                            data-descrizione="${r.descrizioneArticolo}"
                            data-quantita="${qtaRim}"
                            data-peso="${r.pesoKgUnitario}"
                            data-peso-totale="${pesoTotRiga}"
                            data-provincia="${r.provincia}"
                            data-localita="${r.localita}" /></td>
                        <td><a href="#" class="link-articolo" data-codice="${r.codiceArticolo}" title="Apri Disponibilità"><strong>${r.codiceArticolo}</strong></a></td>
                        <td title="${r.descrizioneArticolo}">${r.descrizioneArticolo}</td>
                        <td class="text-end">
                            <span class="qta-static" ${showInput ? 'style="display:none"' : ''}>${qtaRim.toFixed(2)}</span>
                            <input type="number" class="qta-input ${isWarning ? 'qta-warning' : ''}" value="${qtaAttuale.toFixed(2)}"
                                step="0.01" min="0" data-max="${qtaRim}" data-riga-id="${r.rigaId}"
                                data-peso-unitario="${r.pesoKgUnitario}"
                                ${showInput ? '' : 'style="display:none"'} />
                        </td>
                        <td>${r.unitaMisura}</td>
                        <td class="text-end peso-cell" data-riga-id="${r.rigaId}">${pesoTotRiga.toFixed(2)}</td>
                        <td>${r.dataConsegna}</td>
                        <td><span class="${r.statoEvasione === 'A' ? 'badge bg-primary' : 'badge bg-warning text-dark'}">${r.descrizioneStatoEvasione}</span></td>
                    </tr>`;
                });
            });

            html += '</tbody></table>';
            $('#grigliaRighe').html(html);

            // Event: checkbox singola riga
            $('.riga-check').on('change', function () {
                const rigaId = parseInt($(this).val());
                const $tr = $(this).closest('tr');
                if ($(this).is(':checked')) {
                    $tr.find('.qta-static').hide();
                    $tr.find('.qta-input').show().focus().select();
                    aggiungiAlCarrello($(this));
                } else {
                    $tr.find('.qta-input').hide();
                    $tr.find('.qta-static').show();
                    rimuoviDalCarrello(rigaId);
                }
                aggiornaCheckTestata($tr.data('ordine-id'));
            });

            // Event: modifica quantita' inline
            $('.qta-input').on('input', function () {
                const $input = $(this);
                const rigaId = parseInt($input.data('riga-id'));
                const maxQta = parseFloat($input.data('max'));
                const pesoUnit = parseFloat($input.data('peso-unitario'));
                let nuovaQta = parseFloat($input.val()) || 0;

                $input.toggleClass('qta-warning', nuovaQta > maxQta);

                const nuovoPeso = nuovaQta * pesoUnit;
                $(`.peso-cell[data-riga-id="${rigaId}"]`).text(nuovoPeso.toFixed(2));

                const item = righeCarrello.find(c => c.rigaId === rigaId);
                if (item) {
                    item.quantita = nuovaQta;
                    item.pesoKgTotale = nuovoPeso;
                    const $cb = $(`.riga-check[value="${rigaId}"]`);
                    $cb.data('quantita', nuovaQta);
                    $cb.data('peso-totale', nuovoPeso);
                    aggiornaCarrello();
                }
            });

            // Event: checkbox testata (seleziona/deseleziona tutte le righe di quell'ordine)
            $('.testata-check').on('change', function () {
                const ordineId = $(this).data('ordine-id');
                const checked = $(this).is(':checked');
                $(`.riga-check`).each(function () {
                    if ($(this).closest('tr').data('ordine-id') === ordineId && !$(this).is(':disabled')) {
                        const rigaId = parseInt($(this).val());
                        const inCarrello = righeCarrello.some(c => c.rigaId === rigaId);
                        if (checked && !inCarrello) {
                            $(this).prop('checked', true);
                            aggiungiAlCarrello($(this));
                        } else if (!checked && inCarrello) {
                            $(this).prop('checked', false);
                            rimuoviDalCarrello(rigaId);
                        }
                    }
                });
            });

            // Event: seleziona tutte (globale)
            $('#checkAll').on('change', function () {
                const checked = $(this).is(':checked');
                $('.riga-check:not(:disabled)').each(function () {
                    const rigaId = parseInt($(this).val());
                    const inCarrello = righeCarrello.some(c => c.rigaId === rigaId);
                    if (checked && !inCarrello) {
                        $(this).prop('checked', true);
                        aggiungiAlCarrello($(this));
                    } else if (!checked && inCarrello) {
                        $(this).prop('checked', false);
                        rimuoviDalCarrello(rigaId);
                    }
                });
                $('.testata-check').prop('checked', checked);
            });

            // Sincronizza stato checkbox testata con le righe
            function aggiornaCheckTestata(ordineId) {
                const righeOrdine = $(`.riga-check`).filter(function() {
                    return $(this).closest('tr').data('ordine-id') === ordineId && !$(this).is(':disabled');
                });
                const tutteChecked = righeOrdine.length > 0 && righeOrdine.filter(':checked').length === righeOrdine.length;
                $(`.testata-check[data-ordine-id="${ordineId}"]`).prop('checked', tutteChecked);
            }

            // Event: click su codice articolo → apre popup Disponibilità
            $('.link-articolo').on('click', function (e) {
                e.preventDefault();
                const codice = $(this).data('codice');
                apriPopupDisponibilita(codice);
            });
        }).fail(function (xhr) {
            const msg = xhr.responseJSON?.message || 'Errore nel caricamento';
            $('#grigliaRighe').html(`<div class="empty-state"><i class="bi bi-exclamation-triangle text-danger"></i><p>${msg}</p></div>`);
        });
    }

    // ===== CARRELLO =====
    function aggiungiAlCarrello($checkbox) {
        const rigaId = parseInt($checkbox.val());
        if (righeCarrello.some(c => c.rigaId === rigaId)) return;

        const $tr = $checkbox.closest('tr');
        const $qtaInput = $tr.find('.qta-input');
        const pesoUnit = parseFloat($checkbox.data('peso'));
        const qtaMax = parseFloat($checkbox.data('quantita'));
        const qta = $qtaInput.length && $qtaInput.is(':visible') ? (parseFloat($qtaInput.val()) || qtaMax) : qtaMax;

        righeCarrello.push({
            rigaId: rigaId,
            ordine: $checkbox.data('ordine'),
            cliente: $checkbox.data('cliente'),
            articolo: $checkbox.data('articolo'),
            descrizione: $checkbox.data('descrizione'),
            quantita: qta,
            qtaMax: qtaMax,
            pesoKgUnitario: pesoUnit,
            pesoKgTotale: pesoUnit * qta,
            provincia: $checkbox.data('provincia'),
            localita: $checkbox.data('localita')
        });

        $checkbox.closest('tr').addClass('selezionata');
        aggiornaCarrello();
    }

    function rimuoviDalCarrello(rigaId) {
        righeCarrello = righeCarrello.filter(c => c.rigaId !== rigaId);
        $(`.riga-check[value="${rigaId}"]`).prop('checked', false);
        const $tr = $(`tr[data-riga-id="${rigaId}"]`);
        $tr.removeClass('selezionata');
        const $qtaInput = $tr.find('.qta-input');
        if ($qtaInput.length) {
            $qtaInput.val(parseFloat($qtaInput.data('max')).toFixed(2)).removeClass('qta-warning').hide();
            $tr.find('.qta-static').show();
            const pesoUnit = parseFloat($qtaInput.data('peso-unitario'));
            const maxQta = parseFloat($qtaInput.data('max'));
            $(`.peso-cell[data-riga-id="${rigaId}"]`).text((pesoUnit * maxQta).toFixed(2));
        }
        aggiornaCarrello();
    }

    function aggiornaCarrello() {
        const body = $('#carrelloBody');
        const count = righeCarrello.length;
        const pesoTotale = righeCarrello.reduce((sum, r) => sum + r.pesoKgTotale, 0);

        $('#carrelloCount').text(count);
        $('#carrelloPesoTotale').text(pesoTotale.toFixed(2));
        $('#btnCreaViaggio').prop('disabled', count === 0);

        if (count === 0) {
            body.html(`<div class="empty-state" style="padding:20px;">
                <i class="bi bi-cart-plus" style="font-size:2rem;"></i>
                <p class="mb-0" style="font-size:0.85rem;">Seleziona righe dalla griglia</p>
            </div>`);
            return;
        }

        // Raggruppa per provincia + localita
        const grouped = {};
        righeCarrello.forEach(r => {
            const key = `${r.provincia} - ${r.localita}`;
            if (!grouped[key]) grouped[key] = [];
            grouped[key].push(r);
        });

        let html = '';
        Object.keys(grouped).sort().forEach(key => {
            html += `<div class="mb-2"><small class="fw-bold text-muted"><i class="bi bi-geo-alt me-1"></i>${key}</small></div>`;
            grouped[key].forEach(r => {
                html += `<div class="carrello-item">
                    <button class="btn btn-sm btn-outline-danger btn-remove" onclick="window.rimuoviRiga(${r.rigaId})">&times;</button>
                    <div><strong>${r.ordine}</strong> - ${r.cliente}</div>
                    <div class="text-muted">${r.articolo} - Qta: ${r.quantita.toFixed(2)} - ${r.pesoKgTotale.toFixed(2)} Kg</div>
                </div>`;
            });
        });
        body.html(html);
        controllaPesoMax();
    }

    window.rimuoviRiga = function (rigaId) {
        rimuoviDalCarrello(rigaId);
    };

    // ===== DATI VIAGGIO (DROPDOWN) =====
    function caricaDatiViaggio() {
        // Stato iniziale: disabilita campi mezzo/autista
        $('#viaggioMezzoInterno, #viaggioMezzoEsterno, #viaggioAutista').prop('disabled', true);

        $.getJSON(urlGetDatiViaggio, function (data) {
            datiViaggio = data;

            const selTipo = $('#viaggioTipoTrasporto');
            data.tipiTrasporto.forEach(t => selTipo.append(`<option value="${t.id}" data-codice="${t.codice}">${t.descrizione}</option>`));

            const selMI = $('#viaggioMezzoInterno');
            data.mezziInterni.forEach(m => selMI.append(`<option value="${m.id}" data-portata="${m.portataMaxKg}">${m.descrizione}</option>`));

            const selME = $('#viaggioMezzoEsterno');
            data.mezziEsterni.forEach(m => selME.append(`<option value="${m.id}">${m.descrizione}</option>`));

            const selAut = $('#viaggioAutista');
            data.autisti.forEach(a => selAut.append(`<option value="${a.id}">${a.nome}</option>`));
        });
    }

    // Toggle campi in base al tipo trasporto selezionato
    function isEsterno(codice, descrizione) {
        const c = (codice || '').toUpperCase();
        const d = (descrizione || '').toUpperCase();
        return c.includes('EST') || c.includes('VETTORE') || c.includes('TERZI')
            || d.includes('ESTER') || d.includes('VETTORE') || d.includes('TERZI');
    }

    $('#viaggioTipoTrasporto').on('change', function () {
        const $opt = $(this).find(':selected');
        const codice = $opt.data('codice') || '';
        const desc = $opt.text() || '';

        if (!$(this).val()) {
            $('#viaggioMezzoInterno, #viaggioMezzoEsterno, #viaggioAutista').prop('disabled', true).val('');
            return;
        }

        if (isEsterno(codice, desc)) {
            $('#viaggioMezzoEsterno').prop('disabled', false);
            $('#viaggioMezzoInterno').prop('disabled', true).val('');
            $('#viaggioAutista').prop('disabled', true).val('');
        } else {
            $('#viaggioMezzoInterno').prop('disabled', false);
            $('#viaggioAutista').prop('disabled', false);
            $('#viaggioMezzoEsterno').prop('disabled', true).val('');
        }
        controllaPesoMax();
    });

    // Auto-calcolo ora arrivo quando cambia ora partenza e il campo è vuoto
    function calcolaPlaceholderOraArrivo() {
        const oraPartenza = $('#viaggioOraPartenza').val();
        if (oraPartenza && !$('#viaggioOraArrivo').val()) {
            const [hh, mm] = oraPartenza.split(':').map(Number);
            const totMin = hh * 60 + mm + 240;
            const h = String(Math.floor(totMin / 60) % 24).padStart(2, '0');
            const m = String(totMin % 60).padStart(2, '0');
            $('#viaggioOraArrivo').attr('placeholder', `${h}:${m} (auto)`);
        }
    }

    $('#viaggioOraPartenza').on('change', calcolaPlaceholderOraArrivo);
    calcolaPlaceholderOraArrivo();

    // Warning peso max del mezzo selezionato
    $('#viaggioMezzoInterno').on('change', function () { controllaPesoMax(); });

    function controllaPesoMax() {
        const $opt = $('#viaggioMezzoInterno').find(':selected');
        const portata = parseFloat($opt.data('portata')) || 0;
        if (portata <= 0) { $('#pesoWarning').remove(); return; }

        const pesoTotale = righeCarrello.reduce((sum, r) => sum + r.pesoKgTotale, 0);
        if (pesoTotale > portata) {
            if ($('#pesoWarning').length === 0) {
                $('#carrelloPesoTotale').closest('.peso-totale-badge')
                    .after(`<div id="pesoWarning" class="text-warning" style="font-size:0.72rem;"><i class="bi bi-exclamation-triangle me-1"></i>Supera portata max ${portata.toFixed(0)} Kg</div>`);
            } else {
                $('#pesoWarning').html(`<i class="bi bi-exclamation-triangle me-1"></i>Supera portata max ${portata.toFixed(0)} Kg`);
            }
        } else {
            $('#pesoWarning').remove();
        }
    }

    // ===== CREA VIAGGIO =====
    function creaViaggio() {
        if (righeCarrello.length === 0) return;

        const tipoTrasportoId = parseInt($('#viaggioTipoTrasporto').val());
        if (!tipoTrasportoId) {
            showAlert('Selezionare un tipo trasporto', 'warning');
            return;
        }

        const dataConsegna = $('#viaggioDataConsegna').val();
        if (!dataConsegna) {
            showAlert('Inserire la data consegna', 'warning');
            return;
        }

        const oraPartenza = $('#viaggioOraPartenza').val() || '06:00';
        const oraArrivo = $('#viaggioOraArrivo').val() || null;

        const payload = {
            righe: righeCarrello.map(r => ({ rigaId: r.rigaId, quantita: r.quantita })),
            dataConsegna: dataConsegna,
            tipoTrasportoId: tipoTrasportoId,
            mezzoTrasportoId: parseInt($('#viaggioMezzoInterno').val()) || null,
            mezzoTrasportoEsternoId: parseInt($('#viaggioMezzoEsterno').val()) || null,
            autistaId: parseInt($('#viaggioAutista').val()) || null,
            oraPartenza: oraPartenza + ':00',
            oraArrivo: oraArrivo ? oraArrivo + ':00' : null,
            durataStimataMinuti: 240,
            note: $('#viaggioNote').val() || null
        };

        $('#btnCreaViaggio').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Creazione...');

        $.ajax({
            url: urlCreaViaggio,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (result) {
                if (result.success) {
                    showAlert(result.message, 'success');
                    righeCarrello = [];
                    aggiornaCarrello();
                    caricaRighe();
                    caricaConteggi();
                    // Reset form
                    $('#viaggioNote').val('');
                } else {
                    showAlert(result.message, 'danger');
                }
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || 'Errore nella creazione del viaggio';
                showAlert(msg, 'danger');
            },
            complete: function () {
                $('#btnCreaViaggio').prop('disabled', righeCarrello.length === 0)
                    .html('<i class="bi bi-check-circle me-1"></i>Crea Viaggio');
            }
        });
    }

    // ===== POPUP DISPONIBILITÀ =====
    function apriPopupDisponibilita(codiceArticolo) {
        $('#loadingDisponibilita').show();
        $('#contenutoDisponibilita').hide();
        $('#erroreDisponibilita').hide();

        var modal = new bootstrap.Modal(document.getElementById('popupDisponibilita'), {
            backdrop: false,
            keyboard: true
        });
        modal.show();

        const ieri = new Date();
        ieri.setDate(ieri.getDate() - 1);
        const dataRif = new Date(ieri);
        dataRif.setDate(dataRif.getDate() + 60);
        const dataStr = dataRif.toISOString().split('T')[0];

        $.ajax({
            url: urlDisponibilita,
            type: 'GET',
            data: { codiceArticolo: codiceArticolo, dataRiferimento: dataStr },
            success: function (data) {
                $('#dispArticoloInfo').html(`<strong>${data.codiceArticolo}</strong> - ${data.descrizioneArticolo}`);
                $('#dispDataRif').text(data.dataRiferimento);

                const tbody = $('#tabellaDisponibilita');
                tbody.empty();

                if (data.righe && data.righe.length > 0) {
                    data.righe.forEach(function (r) {
                        const rowClass = r.isSupermarket ? 'table-info' : (r.isFuoriProduzione ? 'table-warning' : '');
                        const dispClass = r.disponibileAttuale > 0 ? 'text-success' : (r.disponibileAttuale === 0 ? 'text-warning' : 'text-danger');
                        const prontoClass = r.pronto > 0 ? 'text-primary fw-bold' : 'text-muted';
                        const impClass = r.impegnatoAttuale > 0 ? 'text-danger fw-bold' : 'text-muted';

                        let notaHtml = '';
                        if (r.notaPrevisione) {
                            const notaIcon = r.disponibilitaDaVerificare
                                ? '<i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>'
                                : '<i class="bi bi-check-circle-fill me-1 text-success"></i>';
                            notaHtml = `${notaIcon}${r.notaPrevisione}`;
                        }

                        const smBadge = r.isSupermarket ? ' <span class="badge bg-info ms-1">SM</span>' : '';

                        tbody.append(`<tr class="${rowClass}">
                            <td><strong>${r.codiceArticolo}</strong>${smBadge}</td>
                            <td>${r.descrizioneArticolo}</td>
                            <td class="text-center"><span class="badge bg-secondary">${r.unitaMisura}</span></td>
                            <td><span class="badge bg-info">${r.codiceMagazzino}</span></td>
                            <td class="text-end">${r.esistenza.toFixed(2)}</td>
                            <td class="text-end"><span class="${prontoClass}">${r.pronto.toFixed(2)}</span></td>
                            <td class="text-end"><span class="${impClass}">${r.impegnatoAttuale.toFixed(2)}</span></td>
                            <td class="text-end"><strong class="${dispClass}">${r.disponibileAttuale.toFixed(2)}</strong></td>
                            <td style="font-size:0.78rem;">${notaHtml}</td>
                        </tr>`);
                    });
                } else {
                    tbody.append('<tr><td colspan="9" class="text-center text-muted">Nessun dato trovato</td></tr>');
                }

                $('#loadingDisponibilita').hide();
                $('#contenutoDisponibilita').show();
            },
            error: function (xhr) {
                $('#loadingDisponibilita').hide();
                const msg = xhr.responseJSON?.error || 'Errore durante il caricamento';
                $('#msgErroreDisponibilita').text(msg);
                $('#erroreDisponibilita').show();
            }
        });
    }

    // ===== UTILITY =====
    function showAlert(message, type) {
        const alert = $(`<div class="alert alert-${type} alert-dismissible fade show" role="alert" style="font-size:0.85rem;">
            ${type === 'danger' ? '<i class="bi bi-x-circle me-1"></i>' : '<i class="bi bi-check-circle me-1"></i>'}
            ${message}
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>`);
        $('#alertContainer').html(alert);
        setTimeout(() => alert.alert('close'), 5000);
    }
});
</script>
}

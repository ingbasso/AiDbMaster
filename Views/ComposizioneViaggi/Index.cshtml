    function apriPopupEditCostoME(mezzo) {
        editMeIdCorrente = mezzo.id;
        $('#editMeVettore').text(mezzo.nomeVettore);
        $('#editMeLocalita').text(`${mezzo.comune} (${mezzo.provincia}) - ${mezzo.regione}`);

    // Supporto per spedizione manuale da carrello (più righe)
    window.apriSpedManualeDaCarrello = function() {
        if (righeCarrello.length === 0) return;

        spedManualeRighe = righeCarrello.map(r => ({
            rigaId: r.rigaId,
            articolo: r.articolo,
            descrizione: r.descrizione,
            qtaDaSpedire: r.quantita,
            peso: r.pesoKgUnitario
        }));

        let html = `<table class="table table-sm mb-0" style="font-size:0.8rem;">
            <thead><tr class="table-dark"><th>Articolo</th><th>Descrizione</th><th class="text-end">Qta</th></tr></thead>
            <tbody>`;

        spedManualeRighe.forEach(r => {
            html += `<tr>
                <td><strong>${r.articolo}</strong></td>
                <td>${r.descrizione}</td>
                <td class="text-end">${r.qtaDaSpedire.toFixed(2)}</td>
            </tr>`;
        });

        html += '</tbody></table>';
        $('#spedManRigheContainer').html(html);
        $('#spedManData').val(new Date().toISOString().split('T')[0]);
        $('#spedManNote').val('');

        var modal = new bootstrap.Modal(document.getElementById('popupSpedizioneManuale'), {
            backdrop: false,
            keyboard: true
        });
        modal.show();
    };

    $('#btnConfermaSpedManuale').on('click', function () {
        inviaSpedizioneManuale(false);
    });

    function inviaSpedizioneManuale(forzaQuantita) {
        const $btn = $('#btnConfermaSpedManuale');
        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Invio...');

        // Aggiorna quantità dagli input se presenti
        $('.sped-man-qta').each(function () {
            const idx = parseInt($(this).data('idx'));
            const val = parseFloat($(this).val()) || 0;
            if (spedManualeRighe[idx]) spedManualeRighe[idx].qtaDaSpedire = val;
        });

        const payload = {
            righe: spedManualeRighe.map(r => ({ rigaId: r.rigaId, quantita: r.qtaDaSpedire })),
            dataSpedizione: $('#spedManData').val() || null,
            note: $('#spedManNote').val() || null,
            forzaQuantita: forzaQuantita === true
        };

        $.ajax({
            url: urlSpedizioneManuale,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (result) {
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('popupSpedizioneManuale'))?.hide();
                    showAlert(result.message, 'success');
                    righeCarrello = [];
                    aggiornaCarrello();
                    caricaRighe();
                    caricaConteggi();
                } else {
                    showAlert(result.message, 'danger');
                }
            },
            error: function (xhr) {
                const resp = xhr.responseJSON;
                if (resp && resp.quantitaEccedente) {
                    if (confirm('ATTENZIONE - Quantità eccedenti:\n\n' + (resp.message || '') + '\n\nVuoi procedere comunque con la spedizione manuale?')) {
                        inviaSpedizioneManuale(true);
                        return;
                    }
                } else {
                    const msg = resp?.message || 'Errore nella registrazione';
                    showAlert(msg, 'danger');
                }
            },
            complete: function () {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Conferma Spedizione');
            }
        });
    }

    // ===== MODAL DRAGGABLE =====
    function makeModalDraggable(modalEl) {
        var dialog = modalEl.querySelector('.modal-dialog');
        var header = modalEl.querySelector('.modal-header');
        var dragging = false;
        var startX = 0, startY = 0;
        var currentX = 0, currentY = 0;

        header.style.cursor = 'move';
        header.addEventListener('mousedown', function(e) {
            if (e.target.closest('.btn-close') || e.target.closest('input') || e.target.closest('select') || e.target.closest('button')) return;
            startX = e.clientX - currentX;
            startY = e.clientY - currentY;
            dragging = true;
            e.preventDefault();
        });

        document.addEventListener('mousemove', function(e) {
            if (!dragging) return;
            currentX = e.clientX - startX;
            currentY = e.clientY - startY;
            dialog.style.transform = 'translate(' + currentX + 'px, ' + currentY + 'px)';
        });

        document.addEventListener('mouseup', function() { dragging = false; });
        modalEl.addEventListener('show.bs.modal', function() {
            currentX = 0;
            currentY = 0;
            dialog.style.transform = '';
        });
    }

    makeModalDraggable(document.getElementById('popupDisponibilita'));
    makeModalDraggable(document.getElementById('popupViaggiOrdine'));
    makeModalDraggable(document.getElementById('popupSpedizioneManuale'));
    makeModalDraggable(document.getElementById('popupSelezionaQta'));
    makeModalDraggable(document.getElementById('popupDettaglioMovimentiNotaCV'));
    makeModalDraggable(document.getElementById('popupSceltaMezzoEsterno'));
    makeModalDraggable(document.getElementById('popupEditCostoME'));

    // ===== UTILITY =====
    function showAlert(message, type) {
        const alert = $(`<div class="alert alert-${type} alert-dismissible fade show" role="alert" style="font-size:0.85rem;">
            ${type === 'danger' ? '<i class="bi bi-x-circle me-1"></i>' : '<i class="bi bi-check-circle me-1"></i>'}
            ${message}
            <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
        </div>`);
        $('#alertContainer').html(alert);
        setTimeout(() => alert.alert('close'), 5000);
    }

    // ===== TOGGLE PANNELLO VIAGGIO =====
    $('#btnTogglePanel').on('click', function () {
        const panel = $('#panelRight');
        const btn = $(this);
        panel.toggleClass('collapsed');
        btn.toggleClass('panel-hidden');
    });
});
</script>
}

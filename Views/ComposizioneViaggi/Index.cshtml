    function inizializzaFiltriME() {
        const container = $('#meChipProvinceContainer');
        container.empty();

        const province = [...new Set(mezziEsterniData.map(m => m.provincia).filter(p => p))].sort();

        meProvinceAttive = provinceSelezionate.length > 0
            ? provinceSelezionate.filter(p => province.includes(p))
            : [];

        const chipTutte = $('<span class="province-chip me-chip-prov" data-sigla="__ALL__">Tutte</span>');
        chipTutte.on('click', function () {
            if ($(this).hasClass('active')) {
                $('.me-chip-prov').removeClass('active');
                meProvinceAttive = [];
            } else {
                $('.me-chip-prov').addClass('active');
                meProvinceAttive = province.slice();
            }
            applicaFiltriME();
        });
        container.append(chipTutte);

        province.forEach(function (prov) {
            const chip = $(`<span class="province-chip me-chip-prov" data-sigla="${prov}">${prov}</span>`);
            if (meProvinceAttive.includes(prov)) chip.addClass('active');
            chip.on('click', function () {
                $(this).toggleClass('active');
                meProvinceAttive = [];
                $('.me-chip-prov.active:not([data-sigla="__ALL__"])').each(function () {
                    meProvinceAttive.push($(this).data('sigla'));
                });
                const tutteActive = $('.me-chip-prov:not([data-sigla="__ALL__"])').length ===
                                    $('.me-chip-prov.active:not([data-sigla="__ALL__"])').length;
                $('.me-chip-prov[data-sigla="__ALL__"]').toggleClass('active', tutteActive);
                applicaFiltriME();
            });
            container.append(chip);
        });

        if (meProvinceAttive.length > 0 && meProvinceAttive.length === province.length) {
            chipTutte.addClass('active');
        }

        aggiornaCascadeME();
    }

    function aggiornaCascadeME() {
        const filtrati = getFiltratiByCascade(true);

        const regioni = [...new Set(filtrati.map(m => m.regione).filter(r => r))].sort();
        const selR = $('#meFiltroRegione');
        const prevR = selR.val();
        selR.html('<option value="">-- Tutte --</option>');
        regioni.forEach(r => selR.append(`<option value="${r}">${r}</option>`));
        if (prevR && regioni.includes(prevR)) selR.val(prevR);

        const vettori = [...new Set(filtrati.map(m => m.nomeVettore).filter(v => v))].sort();
        const selV = $('#meFiltroVettore');
        const prevV = selV.val();
        selV.html('<option value="">-- Tutti --</option>');
        vettori.forEach(v => selV.append(`<option value="${v}">${v}</option>`));
        if (prevV && vettori.includes(prevV)) selV.val(prevV);

        const tipi = [...new Set(filtrati.map(m => m.tipoMezzo).filter(t => t))].sort();
        const selT = $('#meFiltroTipoMezzo');
        const prevT = selT.val();
        selT.html('<option value="">-- Tutti --</option>');
        tipi.forEach(t => selT.append(`<option value="${t}">${t}</option>`));
        if (prevT && tipi.includes(prevT)) selT.val(prevT);
    }

    function getFiltratiByCascade(soloProvince) {
        let filtrati = mezziEsterniData;
        if (meProvinceAttive.length > 0) {
            filtrati = filtrati.filter(m => meProvinceAttive.includes(m.provincia));
        }
        if (soloProvince) return filtrati;

        const reg = $('#meFiltroRegione').val();
        const vet = $('#meFiltroVettore').val();
        const tipo = $('#meFiltroTipoMezzo').val();
        if (reg) filtrati = filtrati.filter(m => m.regione === reg);
        if (vet) filtrati = filtrati.filter(m => m.nomeVettore === vet);
        if (tipo) filtrati = filtrati.filter(m => m.tipoMezzo === tipo);
        return filtrati;
    }

    function applicaFiltriME() {
        aggiornaCascadeME();
        const filtrati = getFiltratiByCascade(false);
        renderTabelaME(filtrati);
    }

    function renderTabelaME(mezzi) {
        const body = $('#meTabellaBody');
        body.empty();

        $('#meContatoreRisultati').text(`${mezzi.length} mezz${mezzi.length === 1 ? 'o' : 'i'} trovat${mezzi.length === 1 ? 'o' : 'i'} su ${mezziEsterniData.length} totali`);

        if (mezzi.length === 0) {
            body.html('<tr><td colspan="11" class="text-center py-4 text-muted"><i class="bi bi-search me-1"></i>Nessun mezzo trovato con i filtri selezionati</td></tr>');
            return;
        }

        const selId = $('#viaggioMezzoEsterno').val();

        mezzi.forEach(function (m) {
            const isSelected = selId && parseInt(selId) === m.id;
            const gruIcon = m.gru
                ? '<i class="bi bi-check-circle-fill me-gru-ok"></i>'
                : '<i class="bi bi-x-circle me-gru-no"></i>';
            const trasbordoIcon = m.trasbordo
                ? '<i class="bi bi-check-circle-fill me-trasbordo-ok"></i>'
                : '<i class="bi bi-x-circle me-trasbordo-no"></i>';
            const rowClass = isSelected ? 'table-success' : '';

            body.append(`<tr class="${rowClass}" data-mezzo-id="${m.id}">
                <td><button class="btn btn-primary btn-sm btn-seleziona-mezzo" title="Seleziona">
                    <i class="bi bi-check-lg"></i></button></td>
                <td><strong class="me-vettore-link" data-mezzo-id="${m.id}" title="Clicca per modificare il costo">${m.nomeVettore}</strong></td>
                <td>${m.comune}</td>
                <td><span class="badge bg-info text-dark">${m.provincia}</span></td>
                <td>${m.regione}</td>
                <td>${m.tipoMezzo}</td>
                <td class="text-end">${m.costo > 0 ? '€ ' + m.costo.toFixed(2) : '-'}</td>
                <td class="text-end">${m.portataMax > 0 ? m.portataMax.toLocaleString('it-IT') + ' Kg' : '-'}</td>
                <td class="text-center">${gruIcon}</td>
                <td class="text-center">${trasbordoIcon}</td>
                <td style="max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="${(m.note || '').replace(/"/g, '&quot;')}">${m.note || ''}</td>
            </tr>`);
        });

        body.find('.btn-seleziona-mezzo').on('click', function () {
            const id = $(this).closest('tr').data('mezzo-id');
            const mezzo = mezziEsterniData.find(m => m.id === id);
            if (mezzo) selezionaMezzoEsterno(mezzo);
        });

        body.find('.me-vettore-link').on('click', function (e) {
            e.stopPropagation();
            const id = $(this).data('mezzo-id');
            const mezzo = mezziEsterniData.find(m => m.id === id);
            if (mezzo) apriPopupEditCostoME(mezzo);
        });

        body.find('tr').on('dblclick', function () {
            const id = $(this).data('mezzo-id');
            const mezzo = mezziEsterniData.find(m => m.id === id);
            if (mezzo) selezionaMezzoEsterno(mezzo);
        });
    }


        controllaPesoMax();
    });

    $('#viaggioConRimorchio').on('change', function () { controllaPesoMax(); });

    function controllaPesoMax() {
        let portata = 0;
        let labelMezzo = '';

        const $optInt = $('#viaggioMezzoInterno').find(':selected');
        const conRimorchio = $('#viaggioConRimorchio').is(':checked');
        const portataInt = parseFloat($optInt.data('portata')) || 0;

        if (portataInt > 0) {
            portata = portataInt;
            labelMezzo = $optInt.text();
            if (conRimorchio) {
                const portataRim = parseFloat($optInt.data('portata-rimorchio')) || 0;
                if (portataRim > 0) { portata = portataRim; labelMezzo += ' (rim.)'; }
            }
        }

        const mezzoEstId = $('#viaggioMezzoEsterno').val();
        if (!portata && mezzoEstId && mezziEsterniData.length > 0) {
            const me = mezziEsterniData.find(m => m.id === parseInt(mezzoEstId));
            if (me && me.portataMax > 0) {
                portata = me.portataMax;
                labelMezzo = me.nomeVettore;
            }
        }

        const pesoTotale = righeCarrello.reduce((sum, r) => sum + r.pesoKgTotale, 0);

        if (portata <= 0) {
            $('#pesoWarning').remove();
            $('#indicatoreCarico').hide();
            return;
        }

        const perc = Math.round((pesoTotale / portata) * 100);
        const manca = portata - pesoTotale;

        $('#indicatoreCaricoLabel').text(`${labelMezzo} — Portata: ${portata.toLocaleString('it-IT')} Kg`);

        let barClass = 'bg-info';
        let percText = '';
        if (perc <= 50) { barClass = 'bg-info'; }
        else if (perc <= 80) { barClass = 'bg-success'; }
        else if (perc <= 100) { barClass = 'bg-warning'; }
        else { barClass = 'bg-danger'; }

        if (manca > 0) {
            percText = `${perc}% — mancano ${manca.toFixed(0)} Kg`;
        } else if (manca < 0) {
            percText = `${perc}% — eccedenza ${Math.abs(manca).toFixed(0)} Kg`;
        } else {
            percText = `100% — carico completo`;
        }

        $('#indicatoreCaricoPerc').text(percText)
            .removeClass('text-info text-success text-warning text-danger')
            .addClass(barClass === 'bg-info' ? 'text-info' : barClass === 'bg-success' ? 'text-success' : barClass === 'bg-warning' ? 'text-warning' : 'text-danger');
        $('#indicatoreCaricoBar').css('width', Math.min(perc, 100) + '%')
            .removeClass('bg-info bg-success bg-warning bg-danger').addClass(barClass);
        $('#indicatoreCarico').show();

        if (pesoTotale > portata) {
            const label = conRimorchio && portataInt > 0 ? 'portata max con rimorchio' : 'portata max';
            if ($('#pesoWarning').length === 0) {
                $('#carrelloPesoTotale').closest('.peso-totale-badge')
                    .after(`<div id="pesoWarning" class="text-warning" style="font-size:0.72rem;"><i class="bi bi-exclamation-triangle me-1"></i>Supera ${label} ${portata.toFixed(0)} Kg</div>`);
            } else {
                $('#pesoWarning').html(`<i class="bi bi-exclamation-triangle me-1"></i>Supera ${label} ${portata.toFixed(0)} Kg`);
            }
        } else {
            $('#pesoWarning').remove();
        }
    }


    function caricaViaggioInModifica() {
        $.getJSON(urlGetViaggio + '?viaggioId=' + viaggioIdInModifica, function (resp) {
            if (!resp.success) {
                showAlert('Viaggio non trovato: ' + (resp.message || ''), 'danger');
                resetModalitaModifica();
                return;
            }

            const v = resp.viaggio;
            const righe = resp.righe;

            // Pre-popola il form con un piccolo ritardo per dare tempo ai dropdown di caricarsi
            function compilaForm() {
                if (!datiViaggio) {
                    setTimeout(compilaForm, 200);
                    return;
                }

                $('#viaggioDataConsegna').val(v.dataConsegna);
                $('#viaggioTipoTrasporto').val(v.tipoTrasportoId).trigger('change');

                setTimeout(function () {
                    if (v.mezzoTrasportoId) {
                        $('#viaggioMezzoInterno').val(v.mezzoTrasportoId);
                    }
                    if (v.autistaId) {
                        $('#viaggioAutista').val(v.autistaId);
                    }
                    if (v.mezzoTrasportoEsternoId) {
                        $('#viaggioMezzoEsterno').val(v.mezzoTrasportoEsternoId);
                        $('#viaggioMezzoEsternoDisplay').val(v.mezzoEsternoDisplay);
                        $('#btnClearMezzoEsterno').show();
                        if (v.costoTrasporto) {
                            $('#viaggioCostoTrasporto').val(v.costoTrasporto.toFixed(2));
                            $('#viaggioCostoTrasportoWrap').show();
                        }
                    }
                    if (v.oraPartenza) $('#viaggioOraPartenza').val(v.oraPartenza);
                    if (v.oraArrivo) $('#viaggioOraArrivo').val(v.oraArrivo);
                    if (v.note) $('#viaggioNote').val(v.note);
                    if (v.conRimorchio) {
                        $('#viaggioConRimorchio').prop('checked', true);
                        $('#viaggioConRimorchioWrap').show();
                    }
                }, 100);
            }
            compilaForm();

            // Popola il carrello con le righe del viaggio
            righeCarrello = righe.map(r => ({
                rigaId: r.rigaId,
                ordine: r.ordine,
                cliente: r.cliente,
                articolo: r.codiceArticolo,
                descrizione: r.descrizione,
                quantita: r.quantita,
                qtaMax: r.qtaMax,
                pesoKgUnitario: r.pesoKgUnitario,
                pesoKgTotale: r.pesoKgTotale,
                provincia: r.provincia,
                localita: r.localita
            }));

            aggiornaCarrello();

            showAlert(`Viaggio #${viaggioIdInModifica} caricato in modifica (${righe.length} righe). Puoi aggiungere o rimuovere righe, poi clicca "Salva Modifiche".`, 'info');
        }).fail(function () {
            showAlert('Errore nel caricamento del viaggio', 'danger');
            resetModalitaModifica();
        });
    }

    function salvaModificheViaggio(forzaQuantita) {
        if (righeCarrello.length === 0) {
            showAlert('Aggiungere almeno una riga al viaggio', 'warning');
            return;
        }

        const tipoTrasportoId = parseInt($('#viaggioTipoTrasporto').val());
        if (!tipoTrasportoId) {
            showAlert('Selezionare un tipo trasporto', 'warning');
            return;
        }

        const dataConsegna = $('#viaggioDataConsegna').val();
        if (!dataConsegna) {
            showAlert('Inserire la data consegna', 'warning');
            return;
        }

        const oraPartenza = $('#viaggioOraPartenza').val() || '06:00';
        const oraArrivo = $('#viaggioOraArrivo').val() || null;

        const payload = {
            viaggioId: viaggioIdInModifica,
            righe: righeCarrello.map(r => ({ rigaId: r.rigaId, quantita: r.quantita })),
            dataConsegna: dataConsegna,
            tipoTrasportoId: tipoTrasportoId,
            mezzoTrasportoId: parseInt($('#viaggioMezzoInterno').val()) || null,
            mezzoTrasportoEsternoId: parseInt($('#viaggioMezzoEsterno').val()) || null,
            autistaId: parseInt($('#viaggioAutista').val()) || null,
            oraPartenza: oraPartenza + ':00',
            oraArrivo: oraArrivo ? oraArrivo + ':00' : null,
            note: $('#viaggioNote').val() || null,
            conRimorchio: $('#viaggioConRimorchio').is(':checked'),
            costoTrasporto: parseFloat($('#viaggioCostoTrasporto').val()) || null
        };

        $('#btnCreaViaggio').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Salvataggio...');

        $.ajax({
            url: urlModificaViaggio,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (result) {
                if (result.success) {
                    showAlert(result.message, 'success');
                    caricaRighe();
                    caricaConteggi();
                    // Ricarica il viaggio per aggiornare i dati nel carrello
                    caricaViaggioInModifica();
                } else {
                    showAlert(result.message, 'danger');
                }
            },
            error: function (xhr) {
                const resp = xhr.responseJSON;
                const msg = resp?.message || 'Errore nel salvataggio delle modifiche';
                showAlert(msg, 'danger');
            },
            complete: function () {
                $('#btnCreaViaggio').prop('disabled', righeCarrello.length === 0)
                    .html('<i class="bi bi-save me-1"></i>Salva Modifiche');
            }
        });
    }

    function creaViaggio(forzaQuantita) {
        if (righeCarrello.length === 0) return;

        const tipoTrasportoId = parseInt($('#viaggioTipoTrasporto').val());
        if (!tipoTrasportoId) {
            showAlert('Selezionare un tipo trasporto', 'warning');
            return;
        }

        const dataConsegna = $('#viaggioDataConsegna').val();
        if (!dataConsegna) {
            showAlert('Inserire la data consegna', 'warning');
            return;
        }

        const oraPartenza = $('#viaggioOraPartenza').val() || '06:00';
        const oraArrivo = $('#viaggioOraArrivo').val() || null;

        const payload = {
            righe: righeCarrello.map(r => ({ rigaId: r.rigaId, quantita: r.quantita })),
            dataConsegna: dataConsegna,
            tipoTrasportoId: tipoTrasportoId,
            mezzoTrasportoId: parseInt($('#viaggioMezzoInterno').val()) || null,
            mezzoTrasportoEsternoId: parseInt($('#viaggioMezzoEsterno').val()) || null,
            autistaId: parseInt($('#viaggioAutista').val()) || null,
            oraPartenza: oraPartenza + ':00',
            oraArrivo: oraArrivo ? oraArrivo + ':00' : null,
            durataStimataMinuti: 240,
            note: $('#viaggioNote').val() || null,
            conRimorchio: $('#viaggioConRimorchio').is(':checked'),
            costoTrasporto: parseFloat($('#viaggioCostoTrasporto').val()) || null,
            forzaQuantita: forzaQuantita === true
        };

        $('#btnCreaViaggio').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Creazione...');

        $.ajax({
            url: urlCreaViaggio,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (result) {
                if (result.success) {
                    showAlert(result.message, 'success');
                    righeCarrello = [];
                    aggiornaCarrello();
                    caricaRighe();
                    caricaConteggi();
                    $('#viaggioNote').val('');
                    $('#viaggioConRimorchio').prop('checked', false);
                    $('#viaggioConRimorchioWrap').hide();
                    clearMezzoEsterno();
                } else {
                    showAlert(result.message, 'danger');
                }
            },
            error: function (xhr) {
                const resp = xhr.responseJSON;
                if (resp && resp.quantitaEccedente) {
                    const dettaglio = (resp.message || '').replace(/\n/g, '<br>');
                    if (confirm('ATTENZIONE - Quantità eccedenti:\n\n' + (resp.message || '') + '\n\nVuoi procedere comunque con la creazione del viaggio?')) {
                        creaViaggio(true);
                        return;
                    }
                } else {
                    const msg = resp?.message || 'Errore nella creazione del viaggio';
                    showAlert(msg, 'danger');
                }
            },
            complete: function () {
                const label = modalitaModifica
                    ? '<i class="bi bi-save me-1"></i>Salva Modifiche'
                    : '<i class="bi bi-check-circle me-1"></i>Crea Viaggio';
                $('#btnCreaViaggio').prop('disabled', righeCarrello.length === 0).html(label);
            }
        });
    }

    // ===== POPUP DISPONIBILITÀ =====
    let dispDataIso = '';

    function apriPopupDisponibilita(codiceArticolo) {
        $('#loadingDisponibilita').show();
        $('#contenutoDisponibilita').hide();
        $('#erroreDisponibilita').hide();

        var modal = new bootstrap.Modal(document.getElementById('popupDisponibilita'), {
            backdrop: false,
            keyboard: true
        });
        modal.show();

        const ieri = new Date();
        ieri.setDate(ieri.getDate() - 1);
        const dataRif = new Date(ieri);
        dataRif.setDate(dataRif.getDate() + 60);
        const dataStr = dataRif.toISOString().split('T')[0];
        dispDataIso = dataStr;

        $.ajax({
            url: urlDisponibilita,
            type: 'GET',
            data: { codiceArticolo: codiceArticolo, dataRiferimento: dataStr },
            success: function (data) {
                $('#dispArticoloInfo').html(`<strong>${data.codiceArticolo}</strong> - ${data.descrizioneArticolo}`);
                $('#dispDataRif').text(data.dataRiferimento);

                const tbody = $('#tabellaDisponibilita');
                tbody.empty();

                if (data.righe && data.righe.length > 0) {
                    data.righe.forEach(function (r) {
                        const rowClass = r.isSupermarket ? 'table-info' : (r.isFuoriProduzione ? 'table-warning' : '');
                        const dispClass = r.disponibileAttuale > 0 ? 'text-success' : (r.disponibileAttuale === 0 ? 'text-warning' : 'text-danger');
                        const prontoClass = r.pronto > 0 ? 'text-primary fw-bold' : 'text-muted';
                        const impClass = r.impegnatoAttuale > 0 ? 'text-danger fw-bold' : 'text-muted';

                        let notaHtml = '';
                        if (r.notaPrevisione) {
                            const notaIcon = r.disponibilitaDaVerificare
                                ? '<i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>'
                                : '<i class="bi bi-search me-1"></i>';
                            notaHtml = `<span class="nota-previsione-link" onclick="mostraDettaglioMovimentiNotaCV('${r.codiceArticolo}', ${r.esistenza}, '${dispDataIso}')" title="Clicca per dettaglio previsione">${notaIcon}${r.notaPrevisione}</span>`;
                        }

                        const smBadge = r.isSupermarket ? ' <span class="badge bg-info ms-1">SM</span>' : '';

                        tbody.append(`<tr class="${rowClass}">
                            <td><strong>${r.codiceArticolo}</strong>${smBadge}</td>
                            <td>${r.descrizioneArticolo}</td>
                            <td class="text-center"><span class="badge bg-secondary">${r.unitaMisura}</span></td>
                            <td><span class="badge bg-info">${r.codiceMagazzino}</span></td>
                            <td class="text-end">${r.esistenza.toFixed(2)}</td>
                            <td class="text-end"><span class="${prontoClass}">${r.pronto.toFixed(2)}</span></td>
                            <td class="text-end"><span class="${impClass}">${r.impegnatoAttuale.toFixed(2)}</span></td>
                            <td class="text-end"><strong class="${dispClass}">${r.disponibileAttuale.toFixed(2)}</strong></td>
                            <td style="font-size:0.78rem;">${notaHtml}</td>
                        </tr>`);
                    });
                } else {
                    tbody.append('<tr><td colspan="9" class="text-center text-muted">Nessun dato trovato</td></tr>');
                }

                $('#loadingDisponibilita').hide();
                $('#contenutoDisponibilita').show();
            },
            error: function (xhr) {
                $('#loadingDisponibilita').hide();
                const msg = xhr.responseJSON?.error || 'Errore durante il caricamento';
                $('#msgErroreDisponibilita').text(msg);
                $('#erroreDisponibilita').show();
            }
        });
    }

    // ===== POPUP DETTAGLIO PREVISIONE DISPONIBILITÀ =====
    window.mostraDettaglioMovimentiNotaCV = function(codiceArticolo, esistenza, dataRiferimento) {
        $('#loadingMovimentiNotaCV').show();
        $('#contenutoMovimentiNotaCV').hide();
        $('#erroreMovimentiNotaCV').hide();

        var modal = new bootstrap.Modal(document.getElementById('popupDettaglioMovimentiNotaCV'), {
            backdrop: false,
            keyboard: true
        });
        modal.show();

        $.ajax({
            url: urlDettaglioMovimentiNota,
            type: 'GET',
            data: {
                codiceArticolo: codiceArticolo,
                esistenza: esistenza,
                dataRiferimento: dataRiferimento
            },
            success: function(data) {
                var articoloText = data.codiceArticolo;
                if (data.descrizioneArticolo) articoloText += ' - ' + data.descrizioneArticolo;
                $('#cvArticoloMovimentiNota').text(articoloText);

                var dataInizioFmt = new Date(data.dataInizio).toLocaleDateString('it-IT');
                var dataFineFmt = new Date(data.dataFine).toLocaleDateString('it-IT');
                $('#cvPeriodoMovimentiNota').text(dataInizioFmt + ' → ' + dataFineFmt);
                $('#cvNotaGenerata').text(data.notaGenerata);

                var um = data.unitaMisura || 'pz';
                var tbody = $('#tabellaMovimentiNotaCV');
                tbody.empty();

                if (data.movimenti && data.movimenti.length > 0) {
                    data.movimenti.forEach(function(mov) {
                        var dataFmt = new Date(mov.data).toLocaleDateString('it-IT');

                        var qtaText = '';
                        if (mov.tipo === 'Esistenza') {
                            qtaText = mov.quantita.toFixed(2) + ' ' + um;
                        } else if (mov.quantita >= 0) {
                            qtaText = '<span class="text-success fw-bold">+' + mov.quantita.toFixed(2) + ' ' + um + '</span>';
                        } else {
                            qtaText = '<span class="text-danger fw-bold">' + mov.quantita.toFixed(2) + ' ' + um + '</span>';
                        }

                        var progClass = mov.progressivo >= 0 ? 'text-success' : 'text-danger';
                        var progText = '<span class="' + progClass + ' fw-bold">' + mov.progressivo.toFixed(2) + ' ' + um + '</span>';

                        var tipoBadge = 'bg-light text-dark';
                        var tipoIcon = 'bi-question';
                        switch(mov.tipo) {
                            case 'Esistenza': tipoBadge = 'bg-secondary'; tipoIcon = 'bi-box-seam'; break;
                            case 'Ordine Cliente': tipoBadge = 'bg-danger'; tipoIcon = 'bi-cart-dash'; break;
                            case 'Ordine Produzione': tipoBadge = 'bg-success'; tipoIcon = 'bi-gear'; break;
                            case 'Ordine Fornitore': tipoBadge = 'bg-info'; tipoIcon = 'bi-truck'; break;
                        }

                        var rowClass = mov.tipo === 'Esistenza' ? 'fw-bold' : '';

                        var emailHtml = '';
                        if (mov.tipo === 'Ordine Cliente') {
                            if (mov.emailInviata) {
                                var dataEmailFmt = mov.dataInvioEmail ? new Date(mov.dataInvioEmail).toLocaleDateString('it-IT') : '';
                                emailHtml = '<span class="text-success" title="Email inviata il ' + dataEmailFmt + '"><i class="bi bi-envelope-check-fill fs-5"></i></span>';
                            } else {
                                emailHtml = '<span class="text-muted" title="Email non inviata"><i class="bi bi-envelope-x fs-5"></i></span>';
                            }
                        }

                        tbody.append('<tr class="' + rowClass + '">' +
                            '<td class="text-center">' + dataFmt + '</td>' +
                            '<td><span class="badge ' + tipoBadge + '"><i class="bi ' + tipoIcon + ' me-1"></i>' + mov.tipo + '</span></td>' +
                            '<td>' + mov.descrizione + '</td>' +
                            '<td class="text-end">' + qtaText + '</td>' +
                            '<td class="text-end">' + progText + '</td>' +
                            '<td class="text-center">' + emailHtml + '</td>' +
                            '</tr>');
                    });
                } else {
                    tbody.append('<tr><td colspan="6" class="text-center text-muted">Nessun movimento trovato nel periodo</td></tr>');
                }

                $('#loadingMovimentiNotaCV').hide();
                $('#contenutoMovimentiNotaCV').show();
            },
            error: function(xhr) {
                $('#loadingMovimentiNotaCV').hide();
                var msg = xhr.responseJSON?.error || 'Errore durante il caricamento';
                $('#msgErroreMovimentiNotaCV').text(msg);
                $('#erroreMovimentiNotaCV').show();
            }
        });
    };


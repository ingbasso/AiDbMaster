@section Scripts {
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(function () {
    // Stato applicazione
    let provinceSelezionate = [];
    let comuniSelezionati = [];
    let clientiSelezionati = [];
    let tipoMezzoAttivo = 'MotriceGru';
    let righeCarrello = [];
    let datiViaggio = null;
    let viaggioIdInModifica = @(ViewBag.ViaggioId != null ? ViewBag.ViaggioId.ToString() : "null");
    let modalitaModifica = viaggioIdInModifica !== null;

    const urlGetProvince = '@Url.Action("GetProvince", "ComposizioneViaggi")';
    const urlGetComuniClienti = '@Url.Action("GetComuniClienti", "ComposizioneViaggi")';
    const urlGetRighe = '@Url.Action("GetRighePerTipoMezzo", "ComposizioneViaggi")';
    const urlGetConteggi = '@Url.Action("GetConteggiTipiMezzo", "ComposizioneViaggi")';
    const urlGetDatiViaggio = '@Url.Action("GetDatiViaggio", "ComposizioneViaggi")';
    const urlCreaViaggio = '@Url.Action("CreaViaggio", "ComposizioneViaggi")';
    const urlGetViaggio = '@Url.Action("GetViaggio", "ComposizioneViaggi")';
    const urlModificaViaggio = '@Url.Action("ModificaViaggio", "ComposizioneViaggi")';
    const urlDisponibilita = '@Url.Action("GetDisponibilitaArticoloJson", "InterrogazioniDB")';
    const urlViaggiOrdine = '@Url.Action("GetViaggiPerOrdine", "ComposizioneViaggi")';
    const urlSpedizioneManuale = '@Url.Action("CreaSpedizioneManuale", "ComposizioneViaggi")';
    const urlDettaglioMovimentiNota = '@Url.Action("GetDettaglioMovimentiNota", "InterrogazioniDB")';
    const urlGetMezziEsterni = '@Url.Action("GetMezziEsterni", "ComposizioneViaggi")';
    const urlUpdateCostoME = '@Url.Action("UpdateCostoMezzoEsterno", "ComposizioneViaggi")';

    // ===== COMPONENTE MULTI-SELECT DROPDOWN =====
    function creaMultiSelect(containerId, options, onChange, opts) {
        opts = opts || {};
        const $wrap = $('#' + containerId);
        const placeholder = $wrap.data('placeholder') || 'Seleziona...';
        $wrap.empty();
        $wrap.data('ms-selected', []);

        const $toggle = $(`<div class="multi-select-toggle"><span class="ms-text">${placeholder}</span><i class="bi bi-chevron-down ms-arrow"></i></div>`);
        const $dd = $('<div class="multi-select-dropdown"></div>');

        // Barra ricerca
        const $search = $('<div class="ms-search"><input type="text" placeholder="Cerca..." /></div>');
        $dd.append($search);

        // Opzione "Tutte/Tutti"
        const allLabel = opts.allLabel || 'Tutte';
        const $allOpt = $(`<div class="ms-option all-option" data-value="__ALL__"><input type="checkbox" /><span>${allLabel}</span></div>`);
        $dd.append($allOpt);

        // Opzioni
        options.forEach(function (o) {
            const $opt = $(`<div class="ms-option" data-value="${o.value}"><input type="checkbox" /><span>${o.label}</span></div>`);
            $dd.append($opt);
        });

        $wrap.append($toggle).append($dd);

        function getSelected() {
            const sel = [];
            $dd.find('.ms-option:not(.all-option)').each(function () {
                if ($(this).find('input').prop('checked')) sel.push($(this).data('value'));
            });
            return sel;
        }

        function updateToggleText() {
            const sel = getSelected();
            const total = options.length;
            if (sel.length === 0) {
                $toggle.find('.ms-text').text(placeholder);
            } else if (sel.length === total) {
                $toggle.find('.ms-text').text(allLabel);
            } else if (sel.length <= 3) {
                const labels = sel.map(v => {
                    const o = options.find(x => String(x.value) === String(v));
                    return o ? o.label : v;
                });
                $toggle.find('.ms-text').text(labels.join(', '));
            } else {
                $toggle.find('.ms-text').text(sel.length + ' selezionati');
            }
            $wrap.data('ms-selected', sel);
        }

        function syncAllCheckbox() {
            const total = $dd.find('.ms-option:not(.all-option):visible').length;
            const checked = $dd.find('.ms-option:not(.all-option):visible input:checked').length;
            $allOpt.find('input').prop('checked', total > 0 && checked === total);
        }

        // Click opzione singola
        $dd.on('click', '.ms-option:not(.all-option)', function (e) {
            e.stopPropagation();
            const $cb = $(this).find('input');
            if (!$(e.target).is('input')) $cb.prop('checked', !$cb.prop('checked'));
            $(this).toggleClass('selected', $cb.prop('checked'));
            syncAllCheckbox();
            updateToggleText();
            if (onChange) onChange(getSelected());
        });

        // Click "Tutte"
        $allOpt.on('click', function (e) {
            e.stopPropagation();
            const $cb = $(this).find('input');
            if (!$(e.target).is('input')) $cb.prop('checked', !$cb.prop('checked'));
            const isChecked = $cb.prop('checked');
            $dd.find('.ms-option:not(.all-option):visible').each(function () {
                $(this).find('input').prop('checked', isChecked);
                $(this).toggleClass('selected', isChecked);
            });
            updateToggleText();
            if (onChange) onChange(getSelected());
        });

        // Ricerca
        $search.find('input').on('input', function () {
            const term = $(this).val().toLowerCase();
            $dd.find('.ms-option:not(.all-option)').each(function () {
                const text = $(this).find('span').text().toLowerCase();
                $(this).toggle(text.includes(term));
            });
            syncAllCheckbox();
        });

        // Toggle apertura/chiusura
        $toggle.on('click', function (e) {
            e.stopPropagation();
            // Chiudi tutti gli altri dropdown
            $('.multi-select-dropdown.show').not($dd).removeClass('show');
            $('.multi-select-toggle.open').not($toggle).removeClass('open');
            $dd.toggleClass('show');
            $toggle.toggleClass('open');
            if ($dd.hasClass('show')) $search.find('input').focus();
        });

        // Chiudi dropdown se click fuori
        $(document).on('click.ms_' + containerId, function (e) {
            if (!$wrap.is(e.target) && $wrap.has(e.target).length === 0) {
                $dd.removeClass('show');
                $toggle.removeClass('open');
            }
        });

        // Metodo per settare valori programmaticamente
        $wrap.data('ms-setOptions', function (newOptions, keepSelected) {
            const prevSel = keepSelected ? getSelected().map(String) : [];
            $dd.find('.ms-option:not(.all-option)').remove();
            options = newOptions;
            newOptions.forEach(function (o) {
                const checked = prevSel.includes(String(o.value)) ? 'checked' : '';
                const selClass = checked ? ' selected' : '';
                const $opt = $(`<div class="ms-option${selClass}" data-value="${o.value}"><input type="checkbox" ${checked} /><span>${o.label}</span></div>`);
                $dd.append($opt);
            });
            syncAllCheckbox();
            updateToggleText();
        });

        // Metodo per ottenere i selezionati
        $wrap.data('ms-getSelected', getSelected);

        // Metodo per resettare
        $wrap.data('ms-reset', function () {
            $dd.find('input').prop('checked', false);
            $dd.find('.ms-option').removeClass('selected');
            updateToggleText();
        });
    }

    // ===== INIZIALIZZAZIONE =====
    const oggi = new Date();
    caricaProvince();
    caricaDatiViaggio();

    // Imposta data consegna viaggio a oggi
    $('#viaggioDataConsegna').val(oggi.toISOString().split('T')[0]);

    // Event: click su tab
    $('#tabTipiMezzo .nav-link').on('click', function () {
        tipoMezzoAttivo = $(this).data('tipo');
        caricaRighe();
    });

    // Event: cambio filtro date e porto
    $('#dataConsegnaDa, #dataConsegnaA, #filtroPortoFranco, #filtroOrdiniEvasi, #filtroOrdiniSpediti').on('change', function () {
        caricaRighe();
        caricaConteggi();
    });

    // Event: cambio filtro numero ordine e anno ordine
    $('#filtroNumeroOrdine, #filtroAnnoOrdine').on('change', function () {
        caricaRighe();
        caricaConteggi();
    });

    // Event: crea viaggio / salva modifiche
    $('#btnCreaViaggio').on('click', function () {
        if (modalitaModifica) {
            salvaModificheViaggio();
        } else {
            creaViaggio();
        }
    });

    // Event: nuovo viaggio (reset modalità modifica)
    $('#btnNuovoViaggio').on('click', function () {
        resetModalitaModifica();
    });

    // Se in modalità modifica, carica i dati del viaggio
    if (modalitaModifica) {
        impostaModalitaModifica();
        caricaViaggioInModifica();
    }

    // ===== PROVINCE / COMUNI / CLIENTI =====
    function caricaProvince() {
        $.getJSON(urlGetProvince, function (data) {
            if (!data || data.length === 0) {
                creaMultiSelect('ddProvince', [], onProvinceCambiata, { allLabel: 'Tutte' });
                creaMultiSelect('ddComuni', [], onComuneCambiato, { allLabel: 'Tutti' });
                creaMultiSelect('ddClienti', [], onClienteCambiato, { allLabel: 'Tutti' });
                return;
            }

            const opzioni = data.map(p => ({ value: p.sigla, label: p.sigla }));
            creaMultiSelect('ddProvince', opzioni, onProvinceCambiata, { allLabel: 'Tutte' });
            creaMultiSelect('ddComuni', [], onComuneCambiato, { allLabel: 'Tutti' });
            creaMultiSelect('ddClienti', [], onClienteCambiato, { allLabel: 'Tutti' });
        });
    }

    function onProvinceCambiata(selezionate) {
        provinceSelezionate = selezionate;
        comuniSelezionati = [];
        clientiSelezionati = [];
        caricaComuniClienti();
        caricaRighe();
        caricaConteggi();
    }

    function onComuneCambiato(selezionati) {
        comuniSelezionati = selezionati;
        clientiSelezionati = [];
        caricaComuniClienti(true);
        caricaRighe();
        caricaConteggi();
    }

    function onClienteCambiato(selezionati) {
        clientiSelezionati = selezionati.map(v => parseInt(v));
        caricaRighe();
        caricaConteggi();
    }

    function caricaComuniClienti(soloClienti) {
        const params = new URLSearchParams();
        provinceSelezionate.forEach(p => params.append('province', p));
        comuniSelezionati.forEach(c => params.append('comuni', c));

        $.getJSON(urlGetComuniClienti + '?' + params.toString(), function (data) {
            if (!soloClienti) {
                const opzComuni = (data.comuni || []).map(c => ({ value: c.nome, label: c.nome }));
                const setOpts = $('#ddComuni').data('ms-setOptions');
                if (setOpts) setOpts(opzComuni, false);
            }

            const opzClienti = (data.clienti || []).map(c => ({ value: String(c.codice), label: c.ragioneSociale + ' (' + c.codice + ')' }));
            const setOptsC = $('#ddClienti').data('ms-setOptions');
            if (setOptsC) setOptsC(opzClienti, false);
        });
    }

    // ===== CONTEGGI BADGE =====
    const tuttiTipiMezzo = ['MotriceGru','AutotrenoGru','AutotrenoAbbinato','AutotrenoNoGru','Bilico','BilicoInAbbinamento','MotriceInAbbinamento','Trasporto','TrasportoPosa','NessunMezzo'];

    function resetBadges() {
        tuttiTipiMezzo.forEach(function (tipo) {
            $(`#badge-${tipo}`).text('0').css('opacity', '0.35');
            $(`#tabTipiMezzo button[data-tipo="${tipo}"]`).removeClass('tab-has-ordini').addClass('tab-vuoto');
        });
    }

    function caricaConteggi() {
        const hasNumeroOrdine = $('#filtroNumeroOrdine').val() !== '';
        if (provinceSelezionate.length === 0 && !hasNumeroOrdine) {
            resetBadges();
            return;
        }

        const params = buildFiltriParams();

        $.getJSON(urlGetConteggi + '?' + params.toString(), function (data) {
            tuttiTipiMezzo.forEach(function (tipo) {
                var count = data[tipo] || 0;

                var badge = $(`#badge-${tipo}`);
                badge.text(count);
                badge.css('opacity', count > 0 ? '1' : '0.35');

                var tabBtn = $(`#tabTipiMezzo button[data-tipo="${tipo}"]`);
                tabBtn.toggleClass('tab-has-ordini', count > 0);
                tabBtn.toggleClass('tab-vuoto', count === 0);
            });
        });
    }

    // ===== HELPER: costruisce i parametri di filtro comuni =====
    function buildFiltriParams() {
        const params = new URLSearchParams();
        provinceSelezionate.forEach(p => params.append('province', p));
        comuniSelezionati.forEach(c => params.append('comuni', c));
        clientiSelezionati.forEach(c => params.append('clienti', c));
        const dataDa = $('#dataConsegnaDa').val();
        const dataA = $('#dataConsegnaA').val();
        if (dataDa) params.append('dataConsegnaDa', dataDa);
        if (dataA) params.append('dataConsegnaA', dataA);
        const numOrdine = $('#filtroNumeroOrdine').val();
        const annoOrdine = $('#filtroAnnoOrdine').val();
        if (numOrdine) params.append('numeroOrdine', numOrdine);
        if (annoOrdine) params.append('annoOrdine', annoOrdine);
        if ($('#filtroPortoFranco').is(':checked')) params.append('portoFranco', 'true');
        if (!$('#filtroOrdiniEvasi').is(':checked')) params.append('escludiEvasi', 'true');
        if (!$('#filtroOrdiniSpediti').is(':checked')) params.append('escludiSpediti', 'true');
        if (viaggioIdInModifica) params.append('viaggioIdInModifica', viaggioIdInModifica);
        return params;
    }

    // ===== GRIGLIA RIGHE =====
    function caricaRighe() {
        const hasNumeroOrdine = $('#filtroNumeroOrdine').val() !== '';
        if (provinceSelezionate.length === 0 && !hasNumeroOrdine) {
            $('#grigliaRighe').html(`
                <div class="empty-state">
                    <i class="bi bi-funnel"></i>
                    <p>Seleziona almeno una provincia o un numero ordine per visualizzare le righe ordine</p>
                </div>`);
            return;
        }

        $('#grigliaRighe').html('<div class="spinner-loading"><div class="spinner-border text-primary" role="status"></div></div>');

        const params = buildFiltriParams();
        params.append('tipoMezzo', tipoMezzoAttivo);

        $.getJSON(urlGetRighe + '?' + params.toString(), function (data) {
            // Aggiorna badge del tab attivo con il conteggio reale delle righe
            var badgeAttivo = $(`#badge-${tipoMezzoAttivo}`);
            var tabBtnAttivo = $(`#tabTipiMezzo button[data-tipo="${tipoMezzoAttivo}"]`);
            var countAttivo = data ? data.length : 0;
            badgeAttivo.text(countAttivo);
            badgeAttivo.css('opacity', countAttivo > 0 ? '1' : '0.35');
            tabBtnAttivo.toggleClass('tab-has-ordini', countAttivo > 0);
            tabBtnAttivo.toggleClass('tab-vuoto', countAttivo === 0);

            if (!data || data.length === 0) {
                $('#grigliaRighe').html(`
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Nessuna riga trovata per questo tipo mezzo e questi filtri</p>
                    </div>`);
                return;
            }

            // Raggruppa per ordineId (testata)
            const grouped = {};
            data.forEach(r => {
                if (!grouped[r.ordineId]) {
                    grouped[r.ordineId] = {
                        ordineId: r.ordineId,
                        numeroOrdine: r.numeroOrdine,
                        cliente: r.cliente,
                        provincia: r.provincia,
                        localita: r.localita,
                        indirizzoDestinazione: r.indirizzoDestinazione || '',
                        agente: r.agente || '',
                        riferimentoOrdine: r.riferimentoOrdine || '',
                        noteTestata: r.noteTestata || '',
                        righe: []
                    };
                }
                grouped[r.ordineId].righe.push(r);
            });

            const numCols = 8;
            let html = `<table class="table table-hover table-righe">
                <thead>
                    <tr>
                        <th style="width:35px;"><input type="checkbox" id="checkAll" title="Seleziona tutte" /></th>
                        <th>Articolo</th>
                        <th>Descrizione</th>
                        <th style="min-width:180px;">Quantità</th>
                        <th>UM</th>
                        <th class="text-end">Peso Kg</th>
                        <th>Consegna</th>
                        <th style="width:40px;"></th>
                    </tr>
                </thead>
                <tbody>`;

            Object.values(grouped).forEach(function (testata) {
                const dest = testata.indirizzoDestinazione
                    ? `${testata.localita} - ${testata.indirizzoDestinazione}`
                    : testata.localita;

                const tutteSpedite = testata.righe.length > 0 && testata.righe.every(r => r.completamenteSpedita);
                const almenoUnaParziale = testata.righe.some(r => r.statoSpedizione === 'PS' || r.statoSpedizione === 'SP');
                const testataClasses = 'testata-header' + (tutteSpedite ? ' testata-completa' : '');

                // Verifica se la testata ha righe spedite solo manualmente
                const tutteManuale = tutteSpedite && testata.righe.every(r => r.soloManuale);
                const qualcunaManuale = testata.righe.some(r => r.hasManuali);

                let statoSpedTestata = 'NS';
                if (tutteSpedite) statoSpedTestata = 'SP';
                else if (almenoUnaParziale) statoSpedTestata = 'PS';

                let badgeSpedTestata = '';
                if (statoSpedTestata === 'SP' && tutteManuale) {
                    badgeSpedTestata = '<span class="badge bg-warning text-dark ms-1"><i class="bi bi-box-arrow-up-right me-1"></i>Spedita Manualmente</span>';
                } else if (statoSpedTestata === 'SP') {
                    badgeSpedTestata = '<span class="badge bg-success ms-1"><i class="bi bi-check2-all me-1"></i>Spedita</span>';
                } else if (statoSpedTestata === 'PS' && qualcunaManuale) {
                    badgeSpedTestata = '<span class="badge bg-info text-dark ms-1"><i class="bi bi-truck me-1"></i>Parz. Spedita</span><span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;"><i class="bi bi-box-arrow-up-right me-1"></i>+ Man.</span>';
                } else if (statoSpedTestata === 'PS') {
                    badgeSpedTestata = '<span class="badge bg-info text-dark ms-1"><i class="bi bi-truck me-1"></i>Parz. Spedita</span>';
                }

                let infoHtml = `<span class="ti-value"><i class="bi bi-file-earmark-text me-1"></i>${testata.numeroOrdine}</span>`;
                infoHtml += `<span class="ti-value"><i class="bi bi-person me-1"></i>${testata.cliente}</span>`;
                infoHtml += `<span><span class="badge bg-info text-dark">${testata.provincia}</span> ${dest}</span>`;
                if (testata.agente) infoHtml += `<span><span class="ti-label">Agente:</span> ${testata.agente}</span>`;
                if (testata.riferimentoOrdine) infoHtml += `<span><span class="ti-label">Rif:</span> ${testata.riferimentoOrdine}</span>`;
                infoHtml += badgeSpedTestata;

                let noteHtml = '';
                if (testata.noteTestata) noteHtml = `<div class="testata-note"><i class="bi bi-sticky me-1"></i>${testata.noteTestata}</div>`;

                html += `<tr class="${testataClasses}" data-ordine-id="${testata.ordineId}">
                    <td><input type="checkbox" class="testata-check" data-ordine-id="${testata.ordineId}" title="Seleziona tutte le righe di questo ordine" ${tutteSpedite ? 'disabled' : ''} /></td>
                    <td colspan="${numCols - 1}">
                        <div class="testata-info">${infoHtml}</div>
                        ${noteHtml}
                    </td>
                </tr>`;

                testata.righe.forEach(function (r) {
                    const inCarrello = righeCarrello.some(c => c.rigaId === r.rigaId);
                    const carrelloItem = inCarrello ? righeCarrello.find(c => c.rigaId === r.rigaId) : null;
                    const isSpedita = r.completamenteSpedita;
                    const trClass = isSpedita ? 'gia-assegnata' : (inCarrello ? 'selezionata' : '');
                    const disabled = isSpedita ? 'disabled' : '';
                    const checked = inCarrello ? 'checked' : '';
                    const qtaDaSpedire = r.qtaDaSpedire;
                    const qtaAttuale = carrelloItem ? carrelloItem.quantita : qtaDaSpedire;
                    const pesoTotRiga = (r.pesoKgUnitario * qtaAttuale);
                    const showInput = inCarrello && !isSpedita;
                    const isWarning = qtaAttuale > qtaDaSpedire;

                    // Percentuali per le barre
                    const qtaOrd = r.quantita || 1;
                    const pctEvasa = Math.min(100, (r.quantitaEvasa / qtaOrd) * 100);
                    const pctSpedita = Math.min(100, (r.qtaGiaAssegnataViaggi / qtaOrd) * 100);

                    // Disallineamento: evasa != spedita
                    const desync = Math.abs(r.quantitaEvasa - r.qtaGiaAssegnataViaggi) > 0.001;
                    let desyncHtml = '';
                    if (desync) {
                        const diff = r.quantitaEvasa - r.qtaGiaAssegnataViaggi;
                        if (diff > 0) {
                            desyncHtml = `<div class="qta-desync"><i class="bi bi-exclamation-triangle-fill"></i> ${diff.toFixed(2)} evasi non spediti</div>`;
                        } else {
                            desyncHtml = `<div class="qta-desync"><i class="bi bi-exclamation-triangle-fill"></i> ${Math.abs(diff).toFixed(2)} spediti non evasi</div>`;
                        }
                    }

                    const barSpedClass = r.soloManuale ? 'bar-spedizione-manuale' : 'bar-spedizione';
                    const spedLabel = r.soloManuale ? 'Man.' : (r.hasManuali ? 'Sped*' : 'Sped');

                    const qtaCellHtml = `<div class="qta-cell-detail">
                        <div class="d-flex align-items-center gap-1">
                            <span class="qta-main">${qtaDaSpedire.toFixed(2)}</span>
                            <span class="qta-sub">da sped. su ${qtaOrd.toFixed(2)}</span>
                        </div>
                        <div class="qta-bars">
                            <div class="qta-bar-row">
                                <span class="bar-label">DDT</span>
                                <div class="qta-bar-track"><div class="qta-bar-fill bar-evasione" style="width:${pctEvasa}%"></div></div>
                                <span class="bar-value">${r.quantitaEvasa.toFixed(2)}</span>
                            </div>
                            <div class="qta-bar-row">
                                <span class="bar-label">${spedLabel}</span>
                                <div class="qta-bar-track"><div class="qta-bar-fill ${barSpedClass}" style="width:${pctSpedita}%"></div></div>
                                <span class="bar-value">${r.qtaGiaAssegnataViaggi.toFixed(2)}</span>
                            </div>
                        </div>
                        ${desyncHtml}
                    </div>`;

                    html += `<tr class="${trClass}" data-riga-id="${r.rigaId}" data-ordine-id="${testata.ordineId}">
                        <td><input type="checkbox" class="riga-check" value="${r.rigaId}" ${disabled} ${checked}
                            data-ordine="${r.numeroOrdine}"
                            data-cliente="${r.cliente}"
                            data-articolo="${r.codiceArticolo}"
                            data-descrizione="${r.descrizioneArticolo}"
                            data-quantita="${qtaDaSpedire}"
                            data-peso="${r.pesoKgUnitario}"
                            data-peso-totale="${pesoTotRiga}"
                            data-provincia="${r.provincia}"
                            data-localita="${r.localita}"
                            data-qta-per-pallet="${r.qtaPerPallet}"
                            data-um="${r.unitaMisura}" /></td>
                        <td><a href="#" class="link-articolo" data-codice="${r.codiceArticolo}" title="Apri Disponibilità"><strong>${r.codiceArticolo}</strong></a></td>
                        <td title="${r.descrizioneArticolo}">${r.descrizioneArticolo}</td>
                        <td>
                            <div class="qta-static" ${showInput ? 'style="display:none"' : ''}>${qtaCellHtml}</div>
                            <input type="number" class="qta-input ${isWarning ? 'qta-warning' : ''}" value="${qtaAttuale.toFixed(2)}"
                                step="0.01" min="0" data-max="${qtaDaSpedire}" data-riga-id="${r.rigaId}"
                                data-peso-unitario="${r.pesoKgUnitario}"
                                ${showInput ? '' : 'style="display:none"'} />
                        </td>
                        <td>${r.unitaMisura}</td>
                        <td class="text-end peso-cell" data-riga-id="${r.rigaId}">${pesoTotRiga.toFixed(2)}</td>
                        <td>${r.dataConsegna}</td>
                        <td>${isSpedita ? '' : `<button class="btn btn-outline-warning btn-sm px-1 py-0 btn-sped-manuale" data-riga-id="${r.rigaId}" data-articolo="${r.codiceArticolo}" data-descrizione="${r.descrizioneArticolo}" data-qta-da-spedire="${qtaDaSpedire}" data-peso="${r.pesoKgUnitario}" title="Spedizione Manuale"><i class="bi bi-box-arrow-up-right" style="font-size:0.75rem;"></i></button>`}</td>
                    </tr>`;
                });
            });

            html += '</tbody></table>';
            $('#grigliaRighe').html(html);

            // Event: checkbox singola riga → apre popup quantità
            $('.riga-check').on('change', function () {
                const $cb = $(this);
                const rigaId = parseInt($cb.val());
                const $tr = $cb.closest('tr');
                if ($cb.is(':checked')) {
                    apriPopupSelezionaQta($cb);
                } else {
                    $tr.find('.qta-input').hide();
                    $tr.find('.qta-static').show();
                    rimuoviDalCarrello(rigaId);
                    aggiornaCheckTestata($tr.data('ordine-id'));
                }
            });

            // Event: modifica quantita' inline (dopo conferma popup, l'input resta visibile)
            $('.qta-input').on('input', function () {
                const $input = $(this);
                const rigaId = parseInt($input.data('riga-id'));
                const maxQta = parseFloat($input.data('max'));
                const pesoUnit = parseFloat($input.data('peso-unitario'));
                let nuovaQta = parseFloat($input.val()) || 0;

                $input.toggleClass('qta-warning', nuovaQta > maxQta);

                const nuovoPeso = nuovaQta * pesoUnit;
                $(`.peso-cell[data-riga-id="${rigaId}"]`).text(nuovoPeso.toFixed(2));

                const item = righeCarrello.find(c => c.rigaId === rigaId);
                if (item) {
                    item.quantita = nuovaQta;
                    item.pesoKgTotale = nuovoPeso;
                    const $cb = $(`.riga-check[value="${rigaId}"]`);
                    $cb.data('quantita', nuovaQta);
                    $cb.data('peso-totale', nuovoPeso);
                    aggiornaCarrello();
                }
            });

            // Event: checkbox testata (seleziona/deseleziona tutte le righe di quell'ordine)
            $('.testata-check').on('change', function () {
                const ordineId = $(this).data('ordine-id');
                const checked = $(this).is(':checked');
                $(`.riga-check`).each(function () {
                    if ($(this).closest('tr').data('ordine-id') === ordineId && !$(this).is(':disabled')) {
                        const rigaId = parseInt($(this).val());
                        const inCarrello = righeCarrello.some(c => c.rigaId === rigaId);
                        if (checked && !inCarrello) {
                            $(this).prop('checked', true);
                            aggiungiAlCarrello($(this));
                        } else if (!checked && inCarrello) {
                            $(this).prop('checked', false);
                            rimuoviDalCarrello(rigaId);
                        }
                    }
                });
            });

            // Event: seleziona tutte (globale)
            $('#checkAll').on('change', function () {
                const checked = $(this).is(':checked');
                $('.riga-check:not(:disabled)').each(function () {
                    const rigaId = parseInt($(this).val());
                    const inCarrello = righeCarrello.some(c => c.rigaId === rigaId);
                    if (checked && !inCarrello) {
                        $(this).prop('checked', true);
                        aggiungiAlCarrello($(this));
                    } else if (!checked && inCarrello) {
                        $(this).prop('checked', false);
                        rimuoviDalCarrello(rigaId);
                    }
                });
                $('.testata-check').prop('checked', checked);
            });

            // Sincronizza stato checkbox testata con le righe
            window.aggiornaCheckTestata = function(ordineId) {
                const righeOrdine = $(`.riga-check`).filter(function() {
                    return $(this).closest('tr').data('ordine-id') === ordineId && !$(this).is(':disabled');
                });
                const tutteChecked = righeOrdine.length > 0 && righeOrdine.filter(':checked').length === righeOrdine.length;
                $(`.testata-check[data-ordine-id="${ordineId}"]`).prop('checked', tutteChecked);
            };

            // Event: click su codice articolo → apre popup Disponibilità
            $('.link-articolo').on('click', function (e) {
                e.preventDefault();
                const codice = $(this).data('codice');
                apriPopupDisponibilita(codice);
            });

            // Event: click sulla testata ordine → apre popup Viaggi Ordine
            $('.testata-header').on('click', function (e) {
                if ($(e.target).is('input[type="checkbox"]') || $(e.target).closest('input[type="checkbox"]').length) return;
                const ordineId = $(this).data('ordine-id');
                apriPopupViaggiOrdine(ordineId);
            });

            // Event: click su bottone spedizione manuale
            $('.btn-sped-manuale').on('click', function (e) {
                e.stopPropagation();
                apriPopupSpedizioneManuale($(this));
            });
        }).fail(function (xhr) {
            const msg = xhr.responseJSON?.message || 'Errore nel caricamento';
            $('#grigliaRighe').html(`<div class="empty-state"><i class="bi bi-exclamation-triangle text-danger"></i><p>${msg}</p></div>`);
        });
    }

    // ===== POPUP SELEZIONA QUANTITÀ =====
    let sqtaCheckbox = null;
    let sqtaModalInstance = null;
    let sqtaQtaPerPallet = 0;
    let sqtaPesoUnit = 0;
    let sqtaMaxQta = 0;

    function apriPopupSelezionaQta($cb) {
        sqtaCheckbox = $cb;
        const articolo = $cb.data('articolo');
        const descrizione = $cb.data('descrizione');
        sqtaMaxQta = parseFloat($cb.data('quantita')) || 0;
        sqtaPesoUnit = parseFloat($cb.data('peso')) || 0;
        sqtaQtaPerPallet = parseFloat($cb.data('qta-per-pallet')) || 0;
        const um = $cb.data('um') || 'pz';

        // Popola info
        $('#sqtaArticolo').text(articolo + ' - ' + descrizione);
        $('#sqtaMaxDisp').text(sqtaMaxQta.toFixed(2) + ' ' + um);
        $('#sqtaUM').text(um);

        if (sqtaQtaPerPallet > 0) {
            $('#sqtaPalletInfo').text(sqtaQtaPerPallet.toFixed(2) + ' ' + um + '/pallet');
            $('#sqtaPalletSection').show();
            $('#sqtaPesoPallet').text((sqtaQtaPerPallet * sqtaPesoUnit).toFixed(2) + ' Kg');
        } else {
            $('#sqtaPalletInfo').text('N/D');
            $('#sqtaPalletSection').hide();
            $('#sqtaPesoPallet').text('-');
        }

        $('#sqtaPesoUnit').text(sqtaPesoUnit.toFixed(3) + ' Kg');

        // Bottoni rapidi pallet
        const container = $('#sqtaPltQuickBtns');
        container.empty();
        if (sqtaQtaPerPallet > 0) {
            const maxPlt = Math.floor(sqtaMaxQta / sqtaQtaPerPallet);
            const resto = sqtaMaxQta - (maxPlt * sqtaQtaPerPallet);
            for (let i = 1; i <= Math.min(maxPlt, 10); i++) {
                const isMax = (i === maxPlt && resto < 0.001);
                container.append(`<button class="btn btn-outline-primary btn-sm sqta-plt-quick" data-plt="${i}">${i} plt${isMax ? ' <small>(MAX)</small>' : ''}</button>`);
            }
            if (resto > 0.001) {
                container.append(`<button class="btn btn-outline-success btn-sm sqta-plt-quick" data-plt="-1" title="Tutta la quantità disponibile"><i class="bi bi-check2-all me-1"></i>Tutto (${sqtaMaxQta.toFixed(2)})</button>`);
            }
        }

        // Default: se c'è pallet, imposta 1 pallet; altrimenti tutta la quantità
        if (sqtaQtaPerPallet > 0 && sqtaMaxQta >= sqtaQtaPerPallet) {
            const defaultPlt = Math.floor(sqtaMaxQta / sqtaQtaPerPallet);
            $('#sqtaPltCount').val(defaultPlt);
            sqtaAggiornaDaPallet(defaultPlt);
        } else {
            $('#sqtaPltCount').val(0);
            $('#sqtaQtaManuale').val(sqtaMaxQta.toFixed(2));
            sqtaAggiornaCalcoli(sqtaMaxQta);
        }

        const modalEl = document.getElementById('popupSelezionaQta');
        sqtaModalInstance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl, {
            backdrop: false,
            keyboard: true
        });
        sqtaModalInstance.show();
    }

    function sqtaAggiornaDaPallet(nPallet) {
        const qta = nPallet * sqtaQtaPerPallet;
        $('#sqtaQtaManuale').val(qta.toFixed(2));
        sqtaAggiornaCalcoli(qta);

        // Evidenzia bottone rapido attivo
        $('.sqta-plt-quick').removeClass('active btn-primary').addClass('btn-outline-primary');
        $(`.sqta-plt-quick[data-plt="${nPallet}"]`).removeClass('btn-outline-primary').addClass('active btn-primary');

        // Resto / Eccedenza
        const diff = sqtaMaxQta - qta;
        if (diff > 0.001) {
            $('#sqtaRestoInfo').html(`<i class="bi bi-info-circle me-1"></i>Residuo: <strong>${diff.toFixed(2)}</strong> rimangono da spedire`)
                .removeClass('text-warning').show();
        } else if (diff < -0.001) {
            $('#sqtaRestoInfo').html(`<i class="bi bi-exclamation-triangle me-1"></i>Eccedenza: <strong>${Math.abs(diff).toFixed(2)}</strong> in più rispetto alla qta da spedire`)
                .addClass('text-warning').show();
        } else {
            $('#sqtaRestoInfo').hide();
        }
    }

    function sqtaAggiornaCalcoli(qta) {
        const pesoTot = qta * sqtaPesoUnit;
        $('#sqtaPesoTotale').text(pesoTot.toFixed(2) + ' Kg');

        // Controlla se è multiplo pallet
        if (sqtaQtaPerPallet > 0) {
            const numPlt = qta / sqtaQtaPerPallet;
            const isIntero = Math.abs(numPlt - Math.round(numPlt)) < 0.001;
            if (isIntero || qta === 0) {
                $('#sqtaPalletWarning').hide();
            } else {
                $('#sqtaPalletWarning').html(`<i class="bi bi-exclamation-triangle me-1"></i>${numPlt.toFixed(2)} pallet (non intero)`).show();
            }
        } else {
            $('#sqtaPalletWarning').hide();
        }
    }

    // Eventi del popup
    $(document).on('click', '#sqtaPltMinus', function () {
        let val = parseInt($('#sqtaPltCount').val()) || 0;
        if (val > 0) {
            val--;
            $('#sqtaPltCount').val(val);
            sqtaAggiornaDaPallet(val);
        }
    });

    $(document).on('click', '#sqtaPltPlus', function () {
        let val = parseInt($('#sqtaPltCount').val()) || 0;
        val++;
        $('#sqtaPltCount').val(val);
        sqtaAggiornaDaPallet(val);
    });

    $(document).on('input', '#sqtaPltCount', function () {
        let val = parseInt($(this).val()) || 0;
        if (val < 0) val = 0;
        sqtaAggiornaDaPallet(val);
    });

    $(document).on('click', '.sqta-plt-quick', function () {
        const plt = parseInt($(this).data('plt'));
        if (plt === -1) {
            // "Tutto": imposta la quantità massima
            $('#sqtaPltCount').val(Math.floor(sqtaMaxQta / sqtaQtaPerPallet));
            $('#sqtaQtaManuale').val(sqtaMaxQta.toFixed(2));
            sqtaAggiornaCalcoli(sqtaMaxQta);
            $('.sqta-plt-quick').removeClass('active btn-primary btn-success').addClass('btn-outline-primary');
            $(this).removeClass('btn-outline-primary btn-outline-success').addClass('active btn-success');
            const resto = 0;
            $('#sqtaRestoInfo').hide();
        } else {
            $('#sqtaPltCount').val(plt);
            sqtaAggiornaDaPallet(plt);
        }
    });

    $(document).on('input', '#sqtaQtaManuale', function () {
        let qta = parseFloat($(this).val()) || 0;
        sqtaAggiornaCalcoli(qta);
        // Aggiorna conteggio pallet se possibile
        if (sqtaQtaPerPallet > 0) {
            const pltCalc = Math.floor(qta / sqtaQtaPerPallet);
            $('#sqtaPltCount').val(pltCalc);
            // Aggiorna evidenziazione bottoni rapidi
            $('.sqta-plt-quick').removeClass('active btn-primary btn-success').addClass('btn-outline-primary');
            if (Math.abs(qta - (pltCalc * sqtaQtaPerPallet)) < 0.001) {
                $(`.sqta-plt-quick[data-plt="${pltCalc}"]`).removeClass('btn-outline-primary').addClass('active btn-primary');
            }
            // Resto
            const resto = sqtaMaxQta - qta;
            if (resto > 0.001 && qta < sqtaMaxQta) {
                $('#sqtaRestoInfo').html(`<i class="bi bi-info-circle me-1"></i>Residuo: <strong>${resto.toFixed(2)}</strong> rimangono da spedire`).show();
            } else {
                $('#sqtaRestoInfo').hide();
            }
        }
    });

    function chiudiPopupQta() {
        if (sqtaModalInstance) sqtaModalInstance.hide();
    }

    // Conferma: aggiunge al carrello con la quantità scelta
    window.confermaQtaSpedizione = function () {
        if (!sqtaCheckbox) {
            chiudiPopupQta();
            return;
        }

        var qta = parseFloat(document.getElementById('sqtaQtaManuale').value) || 0;

        if (qta <= 0) {
            sqtaCheckbox.prop('checked', false);
            sqtaCheckbox = null;
            chiudiPopupQta();
            return;
        }

        var $cb = sqtaCheckbox;
        var rigaId = parseInt($cb.val());
        var $tr = $cb.closest('tr');

        var $qtaInput = $tr.find('.qta-input');
        $qtaInput.val(qta.toFixed(2));
        $tr.find('.qta-static').hide();
        $qtaInput.show();

        var nuovoPeso = qta * sqtaPesoUnit;
        $(`.peso-cell[data-riga-id="${rigaId}"]`).text(nuovoPeso.toFixed(2));

        if (!righeCarrello.some(function(c) { return c.rigaId === rigaId; })) {
            righeCarrello.push({
                rigaId: rigaId,
                ordine: $cb.data('ordine'),
                cliente: $cb.data('cliente'),
                articolo: $cb.data('articolo'),
                descrizione: $cb.data('descrizione'),
                quantita: qta,
                qtaMax: sqtaMaxQta,
                pesoKgUnitario: sqtaPesoUnit,
                pesoKgTotale: nuovoPeso,
                provincia: $cb.data('provincia'),
                localita: $cb.data('localita')
            });
        } else {
            var item = righeCarrello.find(function(c) { return c.rigaId === rigaId; });
            item.quantita = qta;
            item.pesoKgTotale = nuovoPeso;
        }

        $tr.addClass('selezionata');
        aggiornaCarrello();
        aggiornaCheckTestata($tr.data('ordine-id'));

        sqtaCheckbox = null;
        chiudiPopupQta();
    };

    // Annulla / chiusura X: deseleziona la checkbox
    document.getElementById('popupSelezionaQta').addEventListener('hidden.bs.modal', function () {
        if (sqtaCheckbox && !righeCarrello.some(function(c) { return c.rigaId === parseInt(sqtaCheckbox.val()); })) {
            sqtaCheckbox.prop('checked', false);
        }
        sqtaCheckbox = null;
    });

    // ===== CARRELLO =====
    function aggiungiAlCarrello($checkbox) {
        const rigaId = parseInt($checkbox.val());
        if (righeCarrello.some(c => c.rigaId === rigaId)) return;

        const $tr = $checkbox.closest('tr');
        const $qtaInput = $tr.find('.qta-input');
        const pesoUnit = parseFloat($checkbox.data('peso'));
        const qtaMax = parseFloat($checkbox.data('quantita'));
        const qta = $qtaInput.length && $qtaInput.is(':visible') ? (parseFloat($qtaInput.val()) || qtaMax) : qtaMax;

        righeCarrello.push({
            rigaId: rigaId,
            ordine: $checkbox.data('ordine'),
            cliente: $checkbox.data('cliente'),
            articolo: $checkbox.data('articolo'),
            descrizione: $checkbox.data('descrizione'),
            quantita: qta,
            qtaMax: qtaMax,
            pesoKgUnitario: pesoUnit,
            pesoKgTotale: pesoUnit * qta,
            provincia: $checkbox.data('provincia'),
            localita: $checkbox.data('localita')
        });

        $checkbox.closest('tr').addClass('selezionata');
        aggiornaCarrello();
    }

    function rimuoviDalCarrello(rigaId) {
        righeCarrello = righeCarrello.filter(c => c.rigaId !== rigaId);
        $(`.riga-check[value="${rigaId}"]`).prop('checked', false);
        const $tr = $(`tr[data-riga-id="${rigaId}"]`);
        $tr.removeClass('selezionata');
        const $qtaInput = $tr.find('.qta-input');
        if ($qtaInput.length) {
            $qtaInput.val(parseFloat($qtaInput.data('max')).toFixed(2)).removeClass('qta-warning').hide();
            $tr.find('.qta-static').show();
            const pesoUnit = parseFloat($qtaInput.data('peso-unitario'));
            const maxQta = parseFloat($qtaInput.data('max'));
            $(`.peso-cell[data-riga-id="${rigaId}"]`).text((pesoUnit * maxQta).toFixed(2));
        }
        aggiornaCarrello();
    }

    function aggiornaCarrello() {
        const body = $('#carrelloBody');
        const count = righeCarrello.length;
        const pesoTotale = righeCarrello.reduce((sum, r) => sum + r.pesoKgTotale, 0);

        $('#carrelloCount').text(count);
        $('#carrelloPesoTotale').text(pesoTotale.toFixed(2));
        $('#btnCreaViaggio').prop('disabled', count === 0);

        if (count === 0) {
            body.html(`<div class="empty-state" style="padding:20px;">
                <i class="bi bi-cart-plus" style="font-size:2rem;"></i>
                <p class="mb-0" style="font-size:0.85rem;">Seleziona righe dalla griglia</p>
            </div>`);
            $('#pesoWarning').remove();
            $('#indicatoreCarico').hide();
            return;
        }

        // Raggruppa per provincia + localita
        const grouped = {};
        righeCarrello.forEach(r => {
            const key = `${r.provincia} - ${r.localita}`;
            if (!grouped[key]) grouped[key] = [];
            grouped[key].push(r);
        });

        let html = '';
        Object.keys(grouped).sort().forEach(key => {
            html += `<div class="mb-2"><small class="fw-bold text-muted"><i class="bi bi-geo-alt me-1"></i>${key}</small></div>`;
            grouped[key].forEach(r => {
                html += `<div class="carrello-item">
                    <button class="btn btn-sm btn-outline-danger btn-remove" onclick="window.rimuoviRiga(${r.rigaId})">&times;</button>
                    <div><strong>${r.ordine}</strong> - ${r.cliente}</div>
                    <div class="text-muted">${r.articolo} - Qta: ${r.quantita.toFixed(2)} - ${r.pesoKgTotale.toFixed(2)} Kg</div>
                </div>`;
            });
        });
        body.html(html);
        controllaPesoMax();
    }

    window.rimuoviRiga = function (rigaId) {
        rimuoviDalCarrello(rigaId);
    };

    // ===== DATI VIAGGIO (DROPDOWN) =====
    function caricaDatiViaggio() {
        $('#viaggioMezzoInterno, #viaggioAutista').prop('disabled', true);
        $('#btnSceltaMezzoEsterno').prop('disabled', true);

        $.getJSON(urlGetDatiViaggio, function (data) {
            datiViaggio = data;

            const selTipo = $('#viaggioTipoTrasporto');
            data.tipiTrasporto.forEach(t => selTipo.append(`<option value="${t.id}" data-codice="${t.codice}">${t.descrizione}</option>`));

            const selMI = $('#viaggioMezzoInterno');
            data.mezziInterni.forEach(m => selMI.append(`<option value="${m.id}" data-portata="${m.portataMaxKg}" data-rimorchio="${m.rimorchioDisponibile}" data-portata-rimorchio="${m.portataMaxConRimorchioKg || 0}">${m.descrizione}</option>`));

            const selAut = $('#viaggioAutista');
            data.autisti.forEach(a => selAut.append(`<option value="${a.id}">${a.nome}</option>`));
        });
    }

    // Toggle campi in base al tipo trasporto selezionato
    function isEsterno(codice, descrizione) {
        const c = (codice || '').toUpperCase();
        const d = (descrizione || '').toUpperCase();
        return c.includes('EST') || c.includes('VETTORE') || c.includes('TERZI')
            || d.includes('ESTER') || d.includes('VETTORE') || d.includes('TERZI');
    }

    $('#viaggioTipoTrasporto').on('change', function () {
        const $opt = $(this).find(':selected');
        const codice = $opt.data('codice') || '';
        const desc = $opt.text() || '';

        if (!$(this).val()) {
            $('#viaggioMezzoInterno, #viaggioAutista').prop('disabled', true).val('');
            clearMezzoEsterno();
            $('#btnSceltaMezzoEsterno').prop('disabled', true);
            return;
        }

        if (isEsterno(codice, desc)) {
            $('#btnSceltaMezzoEsterno').prop('disabled', false);
            $('#viaggioMezzoInterno').prop('disabled', true).val('');
            $('#viaggioAutista').prop('disabled', true).val('');
        } else {
            $('#viaggioMezzoInterno').prop('disabled', false);
            $('#viaggioAutista').prop('disabled', false);
            clearMezzoEsterno();
            $('#btnSceltaMezzoEsterno').prop('disabled', true);
        }
        controllaPesoMax();
    });


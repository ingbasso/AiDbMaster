    function apriPopupMezzoEsterno() {
        const body = $('#meTabellaBody');
        body.html('<tr><td colspan="11" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div> Caricamento...</td></tr>');
        $('#meChipProvinceContainer').empty();
        $('#meFiltroRegione').html('<option value="">-- Tutte --</option>');
        $('#meFiltroVettore').html('<option value="">-- Tutti --</option>');
        $('#meFiltroTipoMezzo').html('<option value="">-- Tutti --</option>');

        var modal = new bootstrap.Modal(document.getElementById('popupSceltaMezzoEsterno'), {
            backdrop: false,
            keyboard: true
        });

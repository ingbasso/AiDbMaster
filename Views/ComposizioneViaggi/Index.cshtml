    $('#btnSalvaCostoME').on('click', function () {
        const $btn = $(this);
        const nuovoCosto = parseFloat($('#editMeCosto').val());

        if (isNaN(nuovoCosto) || nuovoCosto < 0) {
            $('#editMeAlert').html('<div class="alert alert-warning py-1" style="font-size:0.8rem;"><i class="bi bi-exclamation-triangle me-1"></i>Inserire un costo valido</div>').show();
            return;
        }

        $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Salvataggio...');

        $.ajax({
            url: urlUpdateCostoME,
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ id: editMeIdCorrente, costo: nuovoCosto }),
            success: function (result) {
                if (result.success) {
                    const mezzo = mezziEsterniData.find(m => m.id === editMeIdCorrente);
                    if (mezzo) mezzo.costo = nuovoCosto;
                    applicaFiltriME();
                    bootstrap.Modal.getInstance(document.getElementById('popupEditCostoME'))?.hide();
                    $('#editMeAlert').hide();
                } else {
                    $('#editMeAlert').html(`<div class="alert alert-danger py-1" style="font-size:0.8rem;"><i class="bi bi-x-circle me-1"></i>${result.message}</div>`).show();
                }
            },
            error: function (xhr) {
                const msg = xhr.responseJSON?.message || 'Errore nel salvataggio';
                $('#editMeAlert').html(`<div class="alert alert-danger py-1" style="font-size:0.8rem;"><i class="bi bi-x-circle me-1"></i>${msg}</div>`).show();
            },
            complete: function () {
                $btn.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Salva');
            }
        });
    });

    // Auto-calcolo ora arrivo quando cambia ora partenza e il campo è vuoto
    function calcolaPlaceholderOraArrivo() {
        const oraPartenza = $('#viaggioOraPartenza').val();
        if (oraPartenza && !$('#viaggioOraArrivo').val()) {
            const [hh, mm] = oraPartenza.split(':').map(Number);
            const totMin = hh * 60 + mm + 240;
            const h = String(Math.floor(totMin / 60) % 24).padStart(2, '0');
            const m = String(totMin % 60).padStart(2, '0');
            $('#viaggioOraArrivo').attr('placeholder', `${h}:${m} (auto)`);
        }
    }


                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span id="meContatoreRisultati" class="text-muted" style="font-size:0.78rem;"></span>
                </div>
                <!-- Tabella mezzi -->
                <div class="table-responsive" style="max-height:55vh;">

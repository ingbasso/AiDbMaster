@model IEnumerable<AiDbMaster.Models.PstreeStrutturaContoEconomico>

@{
    ViewData["Title"] = "Struttura Conto Economico - Vista Albero";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-diagram-2 text-primary"></i> Struttura Conto Economico - Vista Albero</h2>
        <div>
            <a asp-controller="PstreeStrutturaContoEconomico" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-list"></i> Vista Lista
            </a>
            <a asp-controller="PstreeStrutturaContoEconomico" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Nuovo Conto
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Struttura Gerarchica</h5>
            <div>
                <button class="btn btn-sm btn-outline-secondary" id="expandAll">
                    <i class="bi bi-arrows-fullscreen"></i> Espandi tutto
                </button>
                <button class="btn btn-sm btn-outline-secondary" id="collapseAll">
                    <i class="bi bi-fullscreen-exit"></i> Comprimi tutto
                </button>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="tree-container">
                    @foreach (var root in Model.OrderBy(m => m.IdCodiceConto))
                    {
                        @await Html.PartialAsync("_TreeNode", root)
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-folder2-open text-muted" style="font-size: 4rem;"></i>
                    <h5 class="text-muted mt-3">Nessun conto presente</h5>
                    <p class="text-muted">Inizia creando la struttura del tuo conto economico.</p>
                    <a asp-controller="PstreeStrutturaContoEconomico" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-lg"></i> Crea il primo conto
                    </a>
                </div>
            }
        </div>
    </div>
    
    <!-- Legenda -->
    <div class="card mt-4">
        <div class="card-header bg-light">
            <h6 class="mb-0"><i class="bi bi-info-circle"></i> Legenda Tipi Conto</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <span class="badge bg-success">R - Ricavo</span>
                    <small class="text-muted d-block">Voci di ricavo</small>
                </div>
                <div class="col-md-4">
                    <span class="badge bg-danger">C - Costo</span>
                    <small class="text-muted d-block">Voci di costo</small>
                </div>
                <div class="col-md-4">
                    <span class="badge bg-primary">T - Totale</span>
                    <small class="text-muted d-block">Righe di totale</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .tree-container {
            font-size: 0.95rem;
        }
        
        .tree-node-content:hover {
            background-color: #f8f9fa;
        }
        
        .toggle-btn {
            transition: transform 0.2s;
        }
        
        .toggle-btn i {
            transition: transform 0.2s;
            transform: rotate(180deg);
        }
        
        .toggle-btn.collapsed i {
            transform: rotate(0deg);
        }
    </style>
}

@section Scripts {
    <script>
        document.getElementById('expandAll').addEventListener('click', function() {
            document.querySelectorAll('.collapse').forEach(function(el) {
                var bsCollapse = new bootstrap.Collapse(el, { toggle: false });
                bsCollapse.show();
            });
            document.querySelectorAll('.toggle-btn').forEach(function(btn) {
                btn.classList.remove('collapsed');
            });
        });
        
        document.getElementById('collapseAll').addEventListener('click', function() {
            document.querySelectorAll('.collapse.show').forEach(function(el) {
                var bsCollapse = new bootstrap.Collapse(el, { toggle: false });
                bsCollapse.hide();
            });
            document.querySelectorAll('.toggle-btn').forEach(function(btn) {
                btn.classList.add('collapsed');
            });
        });
    </script>
}

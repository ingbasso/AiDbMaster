@model AiDbMaster.ViewModels.MezziTrasportoEsterniIndexViewModel

@{
    ViewData["Title"] = "Mezzi Trasporto Esterni";
    ViewBag.UseFluidContainer = true;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="bi bi-truck-flatbed me-2 text-primary"></i>Mezzi Trasporto Esterni</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm me-2" permission-required="MezziTrasportoEsterni:Create">
                <i class="bi bi-plus-circle me-1"></i>Nuovo Mezzo Esterno
            </a>
            <a asp-controller="ConsegneKanban" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Torna al Kanban
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtri -->
    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-funnel me-1"></i>Filtri</div>
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label">Comune</label>
                    <select name="comune" class="form-select form-select-sm">
                        <option value="">-- Tutti --</option>
                        @foreach (var c in Model.ComuniDisponibili)
                        {
                            <option value="@c" selected="@(Model.FiltroComune == c)">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Provincia</label>
                    <select name="provincia" class="form-select form-select-sm">
                        <option value="">-- Tutte --</option>
                        @foreach (var p in Model.ProvinceDisponibili)
                        {
                            <option value="@p" selected="@(Model.FiltroProvincia == p)">@p</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Regione</label>
                    <select name="regione" class="form-select form-select-sm">
                        <option value="">-- Tutte --</option>
                        @foreach (var r in Model.RegioniDisponibili)
                        {
                            <option value="@r" selected="@(Model.FiltroRegione == r)">@r</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Tipo Mezzo</label>
                    <select name="tipoMezzo" class="form-select form-select-sm">
                        <option value="">-- Tutti --</option>
                        @foreach (var t in Model.TipiMezzoDisponibili)
                        {
                            <option value="@t" selected="@(Model.FiltroTipoMezzo == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Gru</label>
                    <select name="gru" class="form-select form-select-sm">
                        <option value="">-- Tutti --</option>
                        <option value="true" selected="@(Model.FiltroGru == true)">Si</option>
                        <option value="false" selected="@(Model.FiltroGru == false)">No</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                        <i class="bi bi-search me-1"></i>Filtra
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Griglia -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-list-ul me-1"></i>Elenco mezzi esterni</span>
            <span class="badge bg-secondary">@Model.TotaleRecord record</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Comune</th>
                            <th>Prov.</th>
                            <th>Regione</th>
                            <th>Nome Vettore</th>
                            <th>Tipo Mezzo</th>
                            <th class="text-end">Costo</th>
                            <th class="text-end">Portata Max</th>
                            <th class="text-center">Gru</th>
                            <th class="text-center">Trasbordo</th>
                            <th>Note</th>
                            <th class="text-center" style="width:120px;">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Mezzi.Any())
                        {
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox me-1"></i>Nessun record trovato
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.Mezzi)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Comune</strong></td>
                                <td>@item.Provincia</td>
                                <td>@item.Regione</td>
                                <td>@item.NomeVettore</td>
                                <td>@item.TipoMezzo</td>
                                <td class="text-end">@item.Costo.ToString("N2")</td>
                                <td class="text-end">@item.PortataMax.ToString("N0")</td>
                                <td class="text-center">
                                    @if (item.Gru)
                                    {
                                        <span class="badge bg-success">Si</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Trasbordo)
                                    {
                                        <span class="badge bg-success">Si</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td><small>@item.Note</small></td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"
                                       permission-required="MezziTrasportoEsterni:Edit" title="Modifica">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"
                                            permission-required="MezziTrasportoEsterni:Delete" title="Elimina">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalePagine > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Pagina @Model.PaginaCorrente di @Model.TotalePagine
                    (@Model.TotaleRecord record totali)
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HaPaginaPrecedente ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-comune="@Model.FiltroComune"
                               asp-route-provincia="@Model.FiltroProvincia"
                               asp-route-regione="@Model.FiltroRegione"
                               asp-route-tipoMezzo="@Model.FiltroTipoMezzo"
                               asp-route-gru="@Model.FiltroGru"
                               asp-route-pagina="@(Model.PaginaCorrente - 1)">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>

                        @{
                            var startPage = Math.Max(1, Model.PaginaCorrente - 2);
                            var endPage = Math.Min(Model.TotalePagine, startPage + 4);
                            startPage = Math.Max(1, endPage - 4);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-comune="@Model.FiltroComune"
                                   asp-route-provincia="@Model.FiltroProvincia"
                                   asp-route-regione="@Model.FiltroRegione"
                                   asp-route-tipoMezzo="@Model.FiltroTipoMezzo"
                                   asp-route-gru="@Model.FiltroGru"
                                   asp-route-pagina="1">1</a>
                            </li>
                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }

                        @for (var i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == Model.PaginaCorrente ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-comune="@Model.FiltroComune"
                                   asp-route-provincia="@Model.FiltroProvincia"
                                   asp-route-regione="@Model.FiltroRegione"
                                   asp-route-tipoMezzo="@Model.FiltroTipoMezzo"
                                   asp-route-gru="@Model.FiltroGru"
                                   asp-route-pagina="@i">@i</a>
                            </li>
                        }

                        @if (endPage < Model.TotalePagine)
                        {
                            @if (endPage < Model.TotalePagine - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-comune="@Model.FiltroComune"
                                   asp-route-provincia="@Model.FiltroProvincia"
                                   asp-route-regione="@Model.FiltroRegione"
                                   asp-route-tipoMezzo="@Model.FiltroTipoMezzo"
                                   asp-route-gru="@Model.FiltroGru"
                                   asp-route-pagina="@Model.TotalePagine">@Model.TotalePagine</a>
                            </li>
                        }

                        <li class="page-item @(!Model.HaPaginaSuccessiva ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-comune="@Model.FiltroComune"
                               asp-route-provincia="@Model.FiltroProvincia"
                               asp-route-regione="@Model.FiltroRegione"
                               asp-route-tipoMezzo="@Model.FiltroTipoMezzo"
                               asp-route-gru="@Model.FiltroGru"
                               asp-route-pagina="@(Model.PaginaCorrente + 1)">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@foreach (var item in Model.Mezzi)
{
    <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Conferma eliminazione</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Sei sicuro di voler eliminare il mezzo esterno?</p>
                    <ul class="list-unstyled mb-0">
                        <li><strong>ID:</strong> @item.Id</li>
                        <li><strong>Comune:</strong> @item.Comune</li>
                        <li><strong>Vettore:</strong> @item.NomeVettore</li>
                        <li><strong>Tipo Mezzo:</strong> @item.TipoMezzo</li>
                    </ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Elimina</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@model AiDbMaster.Models.MezzoTrasportoEsterno

@{
    ViewData["Title"] = "Nuovo Mezzo Esterno";
    ViewBag.UseFluidContainer = true;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Nuovo Mezzo Esterno</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="card">
        <div class="card-header"><i class="bi bi-truck-flatbed me-1"></i>Dati mezzo esterno</div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Comune <span class="text-danger">*</span></label>
                        <input asp-for="Comune" class="form-control" maxlength="50" required />
                        <span asp-validation-for="Comune" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Provincia</label>
                        <input asp-for="Provincia" class="form-control" maxlength="50" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Regione</label>
                        <input asp-for="Regione" class="form-control" maxlength="50" />
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-4">
                        <label class="form-label">Nome Vettore</label>
                        <input asp-for="NomeVettore" class="form-control" maxlength="50" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Tipo Mezzo</label>
                        <input asp-for="TipoMezzo" class="form-control" maxlength="50" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Costo <span class="text-danger">*</span></label>
                        <input asp-for="Costo" class="form-control" type="number" min="0" step="0.01" required />
                        <span asp-validation-for="Costo" class="text-danger"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Portata Max</label>
                        <input asp-for="PortataMax" class="form-control" type="number" min="0" />
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input asp-for="Gru" class="form-check-input" />
                            <label class="form-check-label" asp-for="Gru">Gru</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-4">
                            <input asp-for="Trasbordo" class="form-check-input" />
                            <label class="form-check-label" asp-for="Trasbordo">Trasbordo</label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Note</label>
                        <textarea asp-for="Note" class="form-control" rows="2"></textarea>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-lg me-1"></i>Annulla
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Salva
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ===== POPUP DISPONIBILITÀ ARTICOLO =====
        var urlDisponibilita = '@Url.Action("GetDisponibilitaArticoloJson", "InterrogazioniDB")';
        var urlDettaglioMovimenti = '@Url.Action("GetDettaglioMovimentiNota", "InterrogazioniDB")';

        // Sposta i modal nel body al caricamento per evitare problemi di z-index/overflow
        document.addEventListener('DOMContentLoaded', function () {
            var modalDisp = document.getElementById('popupDisponibilita');
            if (modalDisp) document.body.appendChild(modalDisp);
            var modalMov = document.getElementById('popupDettaglioMovimenti');
            if (modalMov) document.body.appendChild(modalMov);
        });

        var dispDataIso = '';

        function apriPopupDisponibilita(codiceArticolo) {
            $('#loadingDisponibilita').show();
            $('#contenutoDisponibilita').hide();
            $('#erroreDisponibilita').hide();

            var modalEl = document.getElementById('popupDisponibilita');
            var existingModal = bootstrap.Modal.getInstance(modalEl);
            var modal = existingModal || new bootstrap.Modal(modalEl, {
                backdrop: false,
                keyboard: true
            });
            modal.show();

            var oggi = new Date();
            oggi.setDate(oggi.getDate() - 1);
            var dataRif = new Date(oggi);
            dataRif.setDate(dataRif.getDate() + 60);
            var dataStr = dataRif.toISOString().split('T')[0];
            dispDataIso = dataStr;

            $.ajax({
                url: urlDisponibilita,
                type: 'GET',
                data: { codiceArticolo: codiceArticolo, dataRiferimento: dataStr },
                success: function (data) {
                    $('#dispArticoloInfo').html('<strong>' + data.codiceArticolo + '</strong> - ' + data.descrizioneArticolo);
                    $('#dispDataRif').text(data.dataRiferimento);

                    var tbody = $('#tabellaDisponibilita');
                    tbody.empty();

                    if (data.righe && data.righe.length > 0) {
                        data.righe.forEach(function (r) {
                            var rowClass = r.isSupermarket ? 'table-info' : (r.isFuoriProduzione ? 'table-warning' : '');
                            var dispClass = r.disponibileAttuale > 0 ? 'text-success' : (r.disponibileAttuale === 0 ? 'text-warning' : 'text-danger');
                            var prontoClass = r.pronto > 0 ? 'text-primary fw-bold' : 'text-muted';
                            var impClass = r.impegnatoAttuale > 0 ? 'text-danger fw-bold' : 'text-muted';

                            var notaHtml = '';
                            if (r.notaPrevisione) {
                                var notaIcon = r.disponibilitaDaVerificare
                                    ? '<i class="bi bi-exclamation-triangle-fill me-1 text-warning"></i>'
                                    : '<i class="bi bi-search me-1"></i>';
                                notaHtml = '<span style="cursor:pointer; text-decoration:underline dotted;" onclick="mostraDettaglioMovimenti(\'' + r.codiceArticolo + '\', ' + r.esistenza + ', \'' + dispDataIso + '\')" title="Clicca per dettaglio previsione">' + notaIcon + r.notaPrevisione + '</span>';
                            }

                            var smBadge = r.isSupermarket ? ' <span class="badge bg-info ms-1">SM</span>' : '';

                            tbody.append(
                                '<tr class="' + rowClass + '">' +
                                '<td><strong>' + r.codiceArticolo + '</strong>' + smBadge + '</td>' +
                                '<td>' + r.descrizioneArticolo + '</td>' +
                                '<td class="text-center"><span class="badge bg-secondary">' + r.unitaMisura + '</span></td>' +
                                '<td><span class="badge bg-info">' + r.codiceMagazzino + '</span></td>' +
                                '<td class="text-end">' + r.esistenza.toFixed(2) + '</td>' +
                                '<td class="text-end"><span class="' + prontoClass + '">' + r.pronto.toFixed(2) + '</span></td>' +
                                '<td class="text-end"><span class="' + impClass + '">' + r.impegnatoAttuale.toFixed(2) + '</span></td>' +
                                '<td class="text-end"><strong class="' + dispClass + '">' + r.disponibileAttuale.toFixed(2) + '</strong></td>' +
                                '<td style="font-size:0.78rem;">' + notaHtml + '</td>' +
                                '</tr>'
                            );
                        });
                    } else {
                        tbody.append('<tr><td colspan="9" class="text-center text-muted">Nessun dato trovato</td></tr>');
                    }

                    $('#loadingDisponibilita').hide();
                    $('#contenutoDisponibilita').show();
                },
                error: function (xhr) {
                    $('#loadingDisponibilita').hide();
                    var msg = (xhr.responseJSON && xhr.responseJSON.error) || 'Errore durante il caricamento';
                    $('#msgErroreDisponibilita').text(msg);
                    $('#erroreDisponibilita').show();
                }
            });
        }

        // Rendi i modal trascinabili dall'header
        function makeModalDraggable(modalEl) {
            if (!modalEl) return;
            var dialog = modalEl.querySelector('.modal-dialog');
            var header = modalEl.querySelector('.modal-header');
            var dragging = false;
            var startX = 0, startY = 0;
            var currentX = 0, currentY = 0;

            header.style.cursor = 'move';
            header.addEventListener('mousedown', function (e) {
                if (e.target.closest('.btn-close') || e.target.closest('button')) return;
                startX = e.clientX - currentX;
                startY = e.clientY - currentY;
                dragging = true;
                e.preventDefault();
            });

            document.addEventListener('mousemove', function (e) {
                if (!dragging) return;
                currentX = e.clientX - startX;
                currentY = e.clientY - startY;
                dialog.style.transform = 'translate(' + currentX + 'px, ' + currentY + 'px)';
            });

            document.addEventListener('mouseup', function () { dragging = false; });
            modalEl.addEventListener('show.bs.modal', function () {
                currentX = 0;
                currentY = 0;
                dialog.style.transform = '';
            });
        }

        makeModalDraggable(document.getElementById('popupDisponibilita'));
        makeModalDraggable(document.getElementById('popupDettaglioMovimenti'));

        // ===== POPUP DETTAGLIO PREVISIONE DISPONIBILITÀ =====
        function mostraDettaglioMovimenti(codiceArticolo, esistenza, dataRiferimento) {
            $('#loadingMovimenti').show();
            $('#contenutoMovimenti').hide();
            $('#erroreMovimenti').hide();

            var modalEl = document.getElementById('popupDettaglioMovimenti');
            var existingModal = bootstrap.Modal.getInstance(modalEl);
            var modal = existingModal || new bootstrap.Modal(modalEl, {
                backdrop: false,
                keyboard: true
            });
            modal.show();

            $.ajax({
                url: urlDettaglioMovimenti,
                type: 'GET',
                data: {
                    codiceArticolo: codiceArticolo,
                    esistenza: esistenza,
                    dataRiferimento: dataRiferimento
                },
                success: function (data) {
                    var articoloText = data.codiceArticolo;
                    if (data.descrizioneArticolo) articoloText += ' - ' + data.descrizioneArticolo;
                    $('#otArticoloMovimenti').text(articoloText);

                    var dataInizioFmt = new Date(data.dataInizio).toLocaleDateString('it-IT');
                    var dataFineFmt = new Date(data.dataFine).toLocaleDateString('it-IT');
                    $('#otPeriodoMovimenti').text(dataInizioFmt + ' → ' + dataFineFmt);
                    $('#otNotaGenerata').text(data.notaGenerata);

                    var um = data.unitaMisura || 'pz';
                    var tbody = $('#tabellaMovimenti');
                    tbody.empty();

                    if (data.movimenti && data.movimenti.length > 0) {
                        data.movimenti.forEach(function (mov) {
                            var dataFmt = new Date(mov.data).toLocaleDateString('it-IT');

                            var qtaText = '';
                            if (mov.tipo === 'Esistenza') {
                                qtaText = mov.quantita.toFixed(2) + ' ' + um;
                            } else if (mov.quantita >= 0) {
                                qtaText = '<span class="text-success fw-bold">+' + mov.quantita.toFixed(2) + ' ' + um + '</span>';
                            } else {
                                qtaText = '<span class="text-danger fw-bold">' + mov.quantita.toFixed(2) + ' ' + um + '</span>';
                            }

                            var progClass = mov.progressivo >= 0 ? 'text-success' : 'text-danger';
                            var progText = '<span class="' + progClass + ' fw-bold">' + mov.progressivo.toFixed(2) + ' ' + um + '</span>';

                            var tipoBadge = 'bg-light text-dark';
                            var tipoIcon = 'bi-question';
                            switch (mov.tipo) {
                                case 'Esistenza': tipoBadge = 'bg-secondary'; tipoIcon = 'bi-box-seam'; break;
                                case 'Ordine Cliente': tipoBadge = 'bg-danger'; tipoIcon = 'bi-cart-dash'; break;
                                case 'Ordine Produzione': tipoBadge = 'bg-success'; tipoIcon = 'bi-gear'; break;
                                case 'Ordine Fornitore': tipoBadge = 'bg-info'; tipoIcon = 'bi-truck'; break;
                            }

                            var rowClass = mov.tipo === 'Esistenza' ? 'fw-bold' : '';

                            var emailHtml = '';
                            if (mov.tipo === 'Ordine Cliente') {
                                if (mov.emailInviata) {
                                    var dataEmailFmt = mov.dataInvioEmail ? new Date(mov.dataInvioEmail).toLocaleDateString('it-IT') : '';
                                    emailHtml = '<span class="text-success" title="Email inviata il ' + dataEmailFmt + '"><i class="bi bi-envelope-check-fill fs-5"></i></span>';
                                } else {
                                    emailHtml = '<span class="text-muted" title="Email non inviata"><i class="bi bi-envelope-x fs-5"></i></span>';
                                }
                            }

                            tbody.append('<tr class="' + rowClass + '">' +
                                '<td class="text-center">' + dataFmt + '</td>' +
                                '<td><span class="badge ' + tipoBadge + '"><i class="bi ' + tipoIcon + ' me-1"></i>' + mov.tipo + '</span></td>' +
                                '<td>' + mov.descrizione + '</td>' +
                                '<td class="text-end">' + qtaText + '</td>' +
                                '<td class="text-end">' + progText + '</td>' +
                                '<td class="text-center">' + emailHtml + '</td>' +
                                '</tr>');
                        });
                    } else {
                        tbody.append('<tr><td colspan="6" class="text-center text-muted">Nessun movimento trovato nel periodo</td></tr>');
                    }

                    $('#loadingMovimenti').hide();
                    $('#contenutoMovimenti').show();
                },
                error: function (xhr) {
                    $('#loadingMovimenti').hide();
                    var msg = (xhr.responseJSON && xhr.responseJSON.error) || 'Errore durante il caricamento';
                    $('#msgErroreMovimenti').text(msg);
                    $('#erroreMovimenti').show();
                }
            });
        }

        // Funzione globale per toggle righe ordine (usa onclick diretto)
        function toggleRigheOrdine(ordineId, btn) {
            var righeContainer = document.getElementById('righe-' + ordineId);
            var icon = btn.querySelector('i');
            var spinner = document.getElementById('spinner-' + ordineId);
            var content = document.getElementById('righe-content-' + ordineId);

            if (righeContainer.style.display === 'none') {
                // Mostra le righe
                righeContainer.style.display = '';
                icon.className = 'bi bi-chevron-down';

                // Carica le righe dal server se non già caricate
                if (!content.dataset.loaded) {
                    spinner.classList.remove('d-none');

                    fetch('@Url.Action("GetRigheOrdine", "OrdiniTestate")?ordineId=' + ordineId)
                        .then(function(response) {
                            if (!response.ok) throw new Error('HTTP ' + response.status);
                            return response.text();
                        })
                        .then(function(html) {
                            content.innerHTML = html;
                            content.dataset.loaded = 'true';
                            spinner.classList.add('d-none');
                        })
                        .catch(function(err) {
                            content.innerHTML = '<div class="alert alert-danger">Errore nel caricamento delle righe: ' + err.message + '</div>';
                            spinner.classList.add('d-none');
                        });
                }
            } else {
                // Nascondi le righe
                righeContainer.style.display = 'none';
                icon.className = 'bi bi-chevron-right';
            }
        }

        // Inizializza tooltip Bootstrap per badge email
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });

            // Anima il chevron dei filtri
            var filtriCollapse = document.getElementById('filtriCollapse');
            var chevron = document.getElementById('filtriChevron');
            if (filtriCollapse && chevron) {
                filtriCollapse.addEventListener('shown.bs.collapse', function () {
                    chevron.className = 'bi bi-chevron-up';
                });
                filtriCollapse.addEventListener('hidden.bs.collapse', function () {
                    chevron.className = 'bi bi-chevron-down';
                });
            }
        });

        // Gestione switch tipo ordine
        $(document).ready(function() {
            // Gestione cambio tipo ordine
            $('input[name="tipoOrdineSwitch"]').change(function() {
                const tipoOrdine = $(this).val();
                $('#hiddenTipoOrdine').val(tipoOrdine);
                $('#filterForm').submit();
            });

            // Auto-submit per filtri
            $('#annoOrdine, #codiceCliente, #codiceAgente, #statoOrdine, #pageSize, #dataInizio, #dataFine').change(function() {
                $('#filterForm').submit();
            });

            // Ricerca con debounce
            let searchTimeout;
            $('#search').on('input', function() {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(function() {
                    $('#filterForm').submit();
                }, 500);
            });

            // Handler toggle righe rimosso - usa funzione globale toggleRigheOrdine()
        });

        // Reset filtri
        function resetFilters() {
            const tipoOrdine = $('input[name="tipoOrdineSwitch"]:checked').val();
            window.location.href = '@Url.Action("Index", "OrdiniTestate")?tipoOrdine=' + tipoOrdine;
        }

        // Evidenzia termini di ricerca
        @if (!string.IsNullOrEmpty(search))
        {
            <text>
            $(document).ready(function() {
                highlightSearchTerms('@Html.Raw(Html.Encode(search))');
            });
            </text>
        }

        function highlightSearchTerms(searchTerm) {
            if (!searchTerm) return;
            
            const regex = new RegExp(`(${searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
            $('.ordine-row').each(function() {
                const $row = $(this);
                $row.find('td').each(function() {
                    const $cell = $(this);
                    const html = $cell.html();
                    const highlightedHtml = html.replace(regex, '<mark class="bg-warning">$1</mark>');
                    $cell.html(highlightedHtml);
                });
            });
        }
    </script>
}


@model IEnumerable<AiDbMaster.Models.ViaggioConsegna>

@{
    ViewData["Title"] = "Viaggi Consegna";
    ViewBag.UseFluidContainer = true;
    var dataDa = (DateTime)(ViewBag.DataDa ?? DateTime.Today);
    var dataA = (DateTime)(ViewBag.DataA ?? DateTime.Today.AddDays(7));
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="bi bi-calendar-event me-2 text-primary"></i>Viaggi Consegna</h2>
        <a asp-controller="ConsegneKanban" asp-action="Index" asp-route-dataInizio="@dataDa.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Torna al Kanban
        </a>
    </div>

    <div class="card mb-3">
        <div class="card-header">Filtri periodo</div>
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Data da</label>
                    <input type="date" name="dataDa" class="form-control" value="@dataDa.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Data a</label>
                    <input type="date" name="dataA" class="form-control" value="@dataA.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i>Filtra</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Elenco viaggi</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Data</th>
                            <th>Tipo Trasporto</th>
                            <th>Mezzo</th>
                            <th>Partenza</th>
                            <th>Arrivo</th>
                            <th>Stato</th>
                            <th class="text-end">Righe</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var arrivoEff = item.OraArrivo ?? item.OraPartenza.Add(TimeSpan.FromMinutes(item.DurataStimataMinuti));
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.DataConsegna.ToString("dd/MM/yyyy")</td>
                                <td>@(item.TipoTrasporto?.Descrizione ?? "N/D")</td>
                                <td>@(item.MezzoTrasporto?.Descrizione ?? (item.MezzoTrasportoEsterno != null ? $"{item.MezzoTrasportoEsterno.NomeVettore} - {item.MezzoTrasportoEsterno.TipoMezzo}" : "N/D"))</td>
                                <td>@item.OraPartenza.ToString(@"hh\:mm")</td>
                                <td>@arrivoEff.ToString(@"hh\:mm")</td>
                                <td>
                                    <span class="badge @(item.Stato == "Annullato" ? "bg-danger" : "bg-primary")">@item.Stato</span>
                                </td>
                                <td class="text-end">@item.Righe.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

     data-bs-backdrop="false" data-bs-keyboard="true" style="z-index: 1070;">
    <div class="modal-dialog" style="box-shadow: 0 8px 32px rgba(0,0,0,0.3); margin-top: 120px !important;">
        <div class="modal-content">
            <form id="cancellaViaggioForm" asp-action="CancellaViaggio" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="nascondiWeekend" value="@Model.NascondiWeekend.ToString().ToLowerInvariant()" />
                <input type="hidden" name="viaggioId" id="cancellaViaggioId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Cancella viaggio</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1"><strong>Sei sicuro di voler cancellare questo viaggio?</strong></p>
                    <div id="cancellaViaggioDesc" class="alert alert-warning py-2 mb-2"></div>
                    <p class="text-danger mb-0"><i class="bi bi-exclamation-circle me-1"></i>Tutte le righe assegnate verranno liberate. L'operazione non è reversibile.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Cancella viaggio</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        (function() {
            var scrollEl = document.getElementById('kanbanScroll');

            function resizeKanban() {
                var rect = scrollEl.getBoundingClientRect();
                var footer = document.querySelector('.footer');
                var footerH = footer ? footer.offsetHeight : 0;
                var available = window.innerHeight - rect.top - footerH - 10;
                scrollEl.style.height = Math.max(300, available) + 'px';
            }
            resizeKanban();
            window.addEventListener('resize', resizeKanban);
            setTimeout(resizeKanban, 500);

            var mezzoAutistaMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MezzoAutistaDefaultMap));
            var mezzoEsternoInfoMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MezzoEsternoInfoMap));
            var mezzoRimorchioMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MezzoRimorchioMap));

            function aggiornaRimorchioVisibilita(selectEl, wrapId, checkboxId) {
                var info = mezzoRimorchioMap[selectEl.value];
                var wrap = document.getElementById(wrapId);
                var chk = document.getElementById(checkboxId);
                if (info && info.RimorchioDisponibile) {
                    wrap.style.display = '';
                } else {
                    wrap.style.display = 'none';
                    chk.checked = false;
                }
            }

            // --- Sistema filtro a cascata Mezzi Esterni per Regione/Provincia/Comune ---
            var allMezziEsterni = {};
            document.querySelectorAll('select[id$="MezzoEsterno"]').forEach(function(sel) {
                var opts = [];
                for (var i = 1; i < sel.options.length; i++) {
                    opts.push({ value: sel.options[i].value, text: sel.options[i].text });
                }
                allMezziEsterni[sel.id] = opts;
            });

            function initFiltroLocalita(wrapId, tipoSelId) {
                var wrap = document.getElementById(wrapId);
                if (!wrap) return;
                var nomeVettoreSel = wrap.querySelector('.filtro-nomevettore');
                var regioneSel = wrap.querySelector('.filtro-regione');
                var provinciaSel = wrap.querySelector('.filtro-provincia');
                var comuneSel = wrap.querySelector('.filtro-comune');
                var targetId = regioneSel.dataset.target;

                function getValoriUnici(campo, filtroNomeVettore, filtroRegione, filtroProvincia) {
                    var valori = new Set();
                    Object.keys(mezzoEsternoInfoMap).forEach(function(id) {
                        var m = mezzoEsternoInfoMap[id];
                        if (filtroNomeVettore && m.NomeVettore !== filtroNomeVettore) return;
                        if (filtroRegione && m.Regione !== filtroRegione) return;
                        if (filtroProvincia && m.Provincia !== filtroProvincia) return;
                        var v = m[campo];
                        if (v) valori.add(v);
                    });
                    return Array.from(valori).sort();
                }

                function popolaSelect(sel, valori, defaultLabel, preselect) {
                    var prev = sel.value;
                    sel.innerHTML = '<option value="">' + defaultLabel + '</option>';
                    valori.forEach(function(v) {
                        var opt = document.createElement('option');
                        opt.value = v; opt.text = v;
                        sel.appendChild(opt);
                    });
                    if (preselect && valori.indexOf(preselect) !== -1) {
                        sel.value = preselect;
                    } else if (prev && valori.indexOf(prev) !== -1) {
                        sel.value = prev;
                    }
                }

                function filtraMezziEsterni() {
                    var targetSel = document.getElementById(targetId);
                    if (!targetSel) return;
                    var vet = nomeVettoreSel.value;
                    var reg = regioneSel.value;
                    var prov = provinciaSel.value;
                    var com = comuneSel.value;
                    var prevVal = targetSel.value;
                    targetSel.innerHTML = '<option value="">-- seleziona mezzo --</option>';

                    var optsOriginali = allMezziEsterni[targetId] || [];
                    optsOriginali.forEach(function(o) {
                        var info = mezzoEsternoInfoMap[o.value];
                        if (!info) return;
                        if (vet && info.NomeVettore !== vet) return;
                        if (reg && info.Regione !== reg) return;
                        if (prov && info.Provincia !== prov) return;
                        if (com && info.Comune !== com) return;
                        var opt = document.createElement('option');
                        opt.value = o.value; opt.text = o.text;
                        targetSel.appendChild(opt);
                    });
                    if (prevVal) {
                        for (var i = 0; i < targetSel.options.length; i++) {
                            if (targetSel.options[i].value === prevVal) { targetSel.value = prevVal; break; }
                        }
                    }
                }

                function aggiornaFiltri(preNomeVettore, preRegione, preProvincia, preComune) {
                    popolaSelect(nomeVettoreSel, getValoriUnici('NomeVettore'), '-- tutti --', preNomeVettore);
                    popolaSelect(regioneSel, getValoriUnici('Regione', nomeVettoreSel.value), '-- tutte --', preRegione);
                    popolaSelect(provinciaSel, getValoriUnici('Provincia', nomeVettoreSel.value, regioneSel.value), '-- tutte --', preProvincia);
                    popolaSelect(comuneSel, getValoriUnici('Comune', nomeVettoreSel.value, regioneSel.value, provinciaSel.value), '-- tutti --', preComune);
                    filtraMezziEsterni();
                }

                nomeVettoreSel.addEventListener('change', function() {
                    regioneSel.value = '';
                    provinciaSel.value = '';
                    comuneSel.value = '';
                    aggiornaFiltri(nomeVettoreSel.value);
                });
                regioneSel.addEventListener('change', function() {
                    provinciaSel.value = '';
                    comuneSel.value = '';
                    aggiornaFiltri(nomeVettoreSel.value, regioneSel.value);
                });
                provinciaSel.addEventListener('change', function() {
                    comuneSel.value = '';
                    aggiornaFiltri(nomeVettoreSel.value, regioneSel.value, provinciaSel.value);
                });
                comuneSel.addEventListener('change', function() {
                    filtraMezziEsterni();
                });

                var tipoSel = document.getElementById(tipoSelId);
                if (tipoSel) {
                    tipoSel.addEventListener('change', function() {
                        var opt = tipoSel.options[tipoSel.selectedIndex];
                        var testo = opt ? opt.text.toLowerCase() : '';
                        var isEsterno = tipoSel.value && testo.indexOf('interno') === -1;
                        wrap.style.display = isEsterno ? '' : 'none';
                    });
                }

                return {
                    show: function() { wrap.style.display = ''; },
                    hide: function() { wrap.style.display = 'none'; },
                    reset: function() {
                        nomeVettoreSel.value = ''; regioneSel.value = ''; provinciaSel.value = ''; comuneSel.value = '';
                        aggiornaFiltri();
                        wrap.style.display = 'none';
                    },
                    preselect: function(provincia, comune) {
                        var matchProv = '';
                        if (provincia) {
                            var provUp = provincia.toUpperCase().trim();
                            Object.keys(mezzoEsternoInfoMap).forEach(function(id) {
                                var m = mezzoEsternoInfoMap[id];
                                if (m.Provincia && m.Provincia.toUpperCase().trim() === provUp) matchProv = m.Provincia;
                            });
                        }
                        aggiornaFiltri('', '', matchProv, '');
                    },
                    refresh: aggiornaFiltri
                };
            }

            var filtroNew = initFiltroLocalita('newFiltroLocalitaWrap', 'newTipoTrasporto');
            var filtroDayDrop = initFiltroLocalita('dayDropFiltroLocalitaWrap', 'dayDropTipoTrasporto');
            var filtroEdit = initFiltroLocalita('editFiltroLocalitaWrap', 'editTipoTrasporto');

            var btnScrollLeft = document.getElementById('btnScrollLeft');
            var btnScrollRight = document.getElementById('btnScrollRight');
            var btnScrollOggi = document.getElementById('btnScrollOggi');
            btnScrollLeft.addEventListener('click', function() { scrollEl.scrollBy({ left: -900, behavior: 'smooth' }); });
            btnScrollRight.addEventListener('click', function() { scrollEl.scrollBy({ left: 900, behavior: 'smooth' }); });

            function scrollToToday(smooth) {
                var todayCol = document.querySelector('.kanban-column[data-is-today]');
                if (!todayCol) return;
                var stickyWidth = 0;
                var colLeft = todayCol.offsetLeft;
                var colWidth = todayCol.offsetWidth;
                var visibleWidth = scrollEl.clientWidth - stickyWidth;
                var targetScroll = colLeft - stickyWidth - (visibleWidth / 2) + (colWidth / 2);
                scrollEl.scrollTo({ left: targetScroll, behavior: smooth ? 'smooth' : 'auto' });
            }

            btnScrollOggi.addEventListener('click', function() { scrollToToday(true); });
            scrollToToday(false);

            // --- Logica Nuovo Viaggio: tipo trasporto -> mezzo interno/esterno ---
            var newTipoSel = document.getElementById('newTipoTrasporto');
            var newMezzoInt = document.getElementById('newMezzoInterno');
            var newMezzoEst = document.getElementById('newMezzoEsterno');

            function aggiornaStatoMezziNew() {
                var opt = newTipoSel.options[newTipoSel.selectedIndex];
                var testo = opt ? opt.text.toLowerCase() : '';
                if (!newTipoSel.value) {
                    newMezzoInt.disabled = true; newMezzoInt.value = '';
                    newMezzoEst.disabled = true; newMezzoEst.value = '';
                    if (filtroNew) filtroNew.hide();
                } else if (testo.indexOf('interno') !== -1) {
                    newMezzoInt.disabled = false;
                    newMezzoEst.disabled = true; newMezzoEst.value = '';
                    if (filtroNew) filtroNew.hide();
                } else {
                    newMezzoInt.disabled = true; newMezzoInt.value = '';
                    newMezzoEst.disabled = false;
                    document.getElementById('newOraPartenza').value = '00:00';
                    document.getElementById('newOraArrivo').value = '00:01';
                    if (filtroNew) { filtroNew.show(); filtroNew.refresh(); }
                }
            }
            newTipoSel.addEventListener('change', aggiornaStatoMezziNew);
            newMezzoInt.addEventListener('change', function() {
                var autistaId = mezzoAutistaMap[newMezzoInt.value];
                if (autistaId) document.getElementById('newAutista').value = autistaId;
                aggiornaRimorchioVisibilita(newMezzoInt, 'newConRimorchioWrap', 'newConRimorchio');
            });
            newMezzoEst.addEventListener('change', function() {
                var info = mezzoEsternoInfoMap[newMezzoEst.value];
                if (info) {
                    document.getElementById('newCostoTrasporto').value = info.Costo;
                    document.getElementById('newGru').checked = info.Gru;
                    document.getElementById('newTrasbordo').checked = info.Trasbordo;
                }
            });

            // --- Trip assign modal (drop su viaggio specifico) ---
            var dropModalEl = document.getElementById('dropAssignModal');
            var dropModal = new bootstrap.Modal(dropModalEl);
            var isSubmittingDrop = false;
            document.getElementById('assignForm').addEventListener('submit', function() { isSubmittingDrop = true; });

            function openDropModal(ctx) {
                document.getElementById('assignViaggioId').value = ctx.destViaggioId;
                document.getElementById('assignOrdineRigaId').value = ctx.ordineRigaId;
                document.getElementById('assignViaggioRigaId').value = ctx.viaggioRigaId || '';
                var qtaNumAssign = parseFloat(ctx.defaultQuantita);
                document.getElementById('assignQuantita').value = isNaN(qtaNumAssign) ? '' : qtaNumAssign.toFixed(2).replace('.', ',');
                document.getElementById('assignNoteRiga').value = ctx.noteRiga || '';
                document.getElementById('dropInfoText').innerText = ctx.infoText;
                dropModal.show();
            }

            dropModalEl.addEventListener('hidden.bs.modal', function () {
                if (!isSubmittingDrop) {
                    document.getElementById('assignViaggioId').value = '';
                    document.getElementById('assignOrdineRigaId').value = '';
                    document.getElementById('assignViaggioRigaId').value = '';
                    document.getElementById('assignQuantita').value = '';
                    document.getElementById('assignNoteRiga').value = '';
                }
                isSubmittingDrop = false;
            });

            // --- Day drop modal (drop su giorno) ---
            var dayModalEl = document.getElementById('dayDropModal');
            var dayModal = new bootstrap.Modal(dayModalEl);
            var isSubmittingDay = false;
            var gestisciDropUrl = '@Url.Action("GestisciDropRiga")';
            var creaEAssegnaUrl = '@Url.Action("AssegnaRigaAGiorno")';

            document.getElementById('dayDropForm').addEventListener('submit', function() { isSubmittingDay = true; });

            function openDayDropModal(ctx) {
                document.getElementById('dayDropOrdineRigaId').value = ctx.ordineRigaId;
                document.getElementById('dayDropViaggioRigaId').value = ctx.viaggioRigaId || '';
                document.getElementById('dayDropDataConsegna').value = ctx.giorno;
                document.getElementById('dayDropGiornoLabel').innerText = ctx.giornoLabel;
                var qtaNum = parseFloat(ctx.defaultQuantita);
                document.getElementById('dayDropQuantita').value = isNaN(qtaNum) ? '' : qtaNum.toFixed(2).replace('.', ',');
                document.getElementById('dayDropNoteRiga').value = ctx.noteRiga || '';
                document.getElementById('dayDropInfoText').innerText = ctx.infoText;

                var viaggiList = document.getElementById('dayDropViaggiList');
                var viaggiSection = document.getElementById('dayDropViaggiSection');
                viaggiList.innerHTML = '';

                var viaggi = ctx.viaggi || [];
                if (viaggi.length === 0) {
                    viaggiSection.style.display = 'none';
                    document.getElementById('dayDropSceltaNuovo').checked = true;
                    setDayDropModalita('nuovo');
                } else {
                    viaggiSection.style.display = '';
                    viaggi.forEach(function(v, idx) {
                        var card = document.createElement('label');
                        card.className = 'viaggio-radio-card d-flex align-items-center gap-2';
                        card.innerHTML =
                            '<input type="radio" name="sceltaViaggio" class="form-check-input mt-0" value="' + v.Id + '"' + (idx === 0 ? ' checked' : '') + '>' +
                            '<span>' + escapeHtml(v.Desc) + '</span>';
                        viaggiList.appendChild(card);
                    });
                    if (viaggi.length > 0) {
                        viaggiList.querySelector('input[type=radio]').checked = true;
                        setDayDropModalita('esistente');
                    }
                }

                if (filtroDayDrop) {
                    filtroDayDrop.reset();
                    if (ctx.provinciaDest) {
                        filtroDayDrop.preselect(ctx.provinciaDest, ctx.comuneDest);
                    }
                }

                updateDayDropUI();
                dayModal.show();
            }

            function setDayDropModalita(mode) {
                document.getElementById('dayDropModalita').value = mode;
                updateDayDropUI();
            }

            function updateDayDropUI() {
                var mode = document.getElementById('dayDropModalita').value;
                var nuovoSection = document.getElementById('dayDropNuovoSection');
                nuovoSection.style.display = mode === 'nuovo' ? '' : 'none';

                if (mode !== 'nuovo' && filtroDayDrop) {
                    document.getElementById('dayDropFiltroLocalitaWrap').style.display = 'none';
                }

                var viaggiCards = document.querySelectorAll('#dayDropViaggiList .viaggio-radio-card');
                viaggiCards.forEach(function(c) {
                    var radio = c.querySelector('input[type=radio]');
                    c.classList.toggle('selected', radio && radio.checked);
                });

                if (mode === 'nuovo') {
                    document.getElementById('dayDropTipoTrasporto').required = true;
                    document.getElementById('dayDropOraPartenza').required = true;
                } else {
                    document.getElementById('dayDropTipoTrasporto').required = false;
                    document.getElementById('dayDropOraPartenza').required = false;
                }

                var form = document.getElementById('dayDropForm');
                if (mode === 'esistente') {
                    var selected = document.querySelector('input[name="sceltaViaggio"]:checked');
                    form.action = gestisciDropUrl;
                    var hiddenViaggio = document.getElementById('dayDropViaggioEsistenteId');
                    if (!hiddenViaggio) {
                        hiddenViaggio = document.createElement('input');
                        hiddenViaggio.type = 'hidden';
                        hiddenViaggio.name = 'viaggioDestId';
                        hiddenViaggio.id = 'dayDropViaggioEsistenteId';
                        form.appendChild(hiddenViaggio);
                    }
                    hiddenViaggio.value = selected ? selected.value : '';
                } else {
                    form.action = creaEAssegnaUrl;
                    var hiddenViaggio = document.getElementById('dayDropViaggioEsistenteId');
                    if (hiddenViaggio) hiddenViaggio.remove();
                }
            }

            document.addEventListener('change', function(e) {
                if (e.target.name === 'sceltaViaggio') {
                    if (e.target.value === 'nuovo') {
                        setDayDropModalita('nuovo');
                    } else {
                        setDayDropModalita('esistente');
                    }
                }
            });

            // --- Logica condizionale Mezzo Interno/Esterno in base a TipoTrasporto ---
            var dayDropTipoSel = document.getElementById('dayDropTipoTrasporto');
            var dayDropMezzo = document.getElementById('dayDropMezzo');
            var dayDropMezzoEsterno = document.getElementById('dayDropMezzoEsterno');

            function aggiornaStatoMezzi() {
                var opt = dayDropTipoSel.options[dayDropTipoSel.selectedIndex];
                var testo = opt ? opt.text.toLowerCase() : '';

                if (!dayDropTipoSel.value) {
                    dayDropMezzo.disabled = true;
                    dayDropMezzo.value = '';
                    dayDropMezzoEsterno.disabled = true;
                    dayDropMezzoEsterno.value = '';
                    if (filtroDayDrop) filtroDayDrop.hide();
                } else if (testo.indexOf('interno') !== -1) {
                    dayDropMezzo.disabled = false;
                    dayDropMezzoEsterno.disabled = true;
                    dayDropMezzoEsterno.value = '';
                    if (filtroDayDrop) filtroDayDrop.hide();
                } else {
                    dayDropMezzo.disabled = true;
                    dayDropMezzo.value = '';
                    dayDropMezzoEsterno.disabled = false;
                    document.getElementById('dayDropOraPartenza').value = '00:00';
                    document.getElementById('dayDropOraArrivo').value = '00:01';
                    if (filtroDayDrop) { filtroDayDrop.show(); filtroDayDrop.refresh(); }
                }
            }

            dayDropTipoSel.addEventListener('change', aggiornaStatoMezzi);
            dayDropMezzo.addEventListener('change', function() {
                var autistaId = mezzoAutistaMap[dayDropMezzo.value];
                if (autistaId) document.getElementById('dayDropAutista').value = autistaId;
                aggiornaRimorchioVisibilita(dayDropMezzo, 'dayDropConRimorchioWrap', 'dayDropConRimorchio');
            });
            dayDropMezzoEsterno.addEventListener('change', function() {
                var info = mezzoEsternoInfoMap[dayDropMezzoEsterno.value];
                if (info) {
                    document.getElementById('dayDropCostoTrasporto').value = info.Costo;
                    document.getElementById('dayDropGru').checked = info.Gru;
                    document.getElementById('dayDropTrasbordo').checked = info.Trasbordo;
                }
            });

            dayModalEl.addEventListener('hidden.bs.modal', function () {
                if (!isSubmittingDay) {
                    document.getElementById('dayDropOrdineRigaId').value = '';
                    document.getElementById('dayDropViaggioRigaId').value = '';
                    document.getElementById('dayDropQuantita').value = '';
                    document.getElementById('dayDropNoteRiga').value = '';
                    document.getElementById('dayDropNoteViaggio').value = '';
                    document.getElementById('dayDropTipoTrasporto').value = '';
                    document.getElementById('dayDropMezzo').value = '';
                    document.getElementById('dayDropMezzo').disabled = true;
                    document.getElementById('dayDropMezzoEsterno').value = '';
                    document.getElementById('dayDropMezzoEsterno').disabled = true;
                    document.getElementById('dayDropOraPartenza').value = '';
                    document.getElementById('dayDropOraArrivo').value = '';
                    document.getElementById('dayDropAutista').value = '';
                    document.getElementById('dayDropCostoTrasporto').value = '0';
                    document.getElementById('dayDropPrezzoVendita').value = '0';
                    document.getElementById('dayDropTempoPausa').value = '0';
                    document.getElementById('dayDropTempoScarico').value = '0';
                    document.getElementById('dayDropGru').checked = false;
                    document.getElementById('dayDropTrasbordo').checked = false;
                    document.getElementById('dayDropConRimorchio').checked = false;
                    document.getElementById('dayDropConRimorchioWrap').style.display = 'none';
                    if (filtroDayDrop) filtroDayDrop.reset();
                    var h = document.getElementById('dayDropViaggioEsistenteId');
                    if (h) h.remove();
                }
                isSubmittingDay = false;
            });

            // --- Funzione per rendere un modal trascinabile dalla header ---
            function makeModalDraggable(modalEl) {
                var dialog = modalEl.querySelector('.modal-dialog');
                var header = modalEl.querySelector('.modal-header');
                var dragging = false;
                var startX = 0, startY = 0;
                var currentX = 0, currentY = 0;

                header.style.cursor = 'move';
                header.addEventListener('mousedown', function(e) {
                    if (e.target.closest('.btn-close') || e.target.closest('input') || e.target.closest('select') || e.target.closest('button')) return;
                    startX = e.clientX - currentX;
                    startY = e.clientY - currentY;
                    dragging = true;
                    e.preventDefault();
                });

                document.addEventListener('mousemove', function(e) {
                    if (!dragging) return;
                    currentX = e.clientX - startX;
                    currentY = e.clientY - startY;
                    dialog.style.transform = 'translate(' + currentX + 'px, ' + currentY + 'px)';
                });

                document.addEventListener('mouseup', function() { dragging = false; });
                modalEl.addEventListener('show.bs.modal', function() {
                    currentX = 0;
                    currentY = 0;
                    dialog.style.transform = '';
                });
            }

            makeModalDraggable(dayModalEl);
            makeModalDraggable(document.getElementById('modalNuovoViaggio'));
            makeModalDraggable(document.getElementById('dropAssignModal'));
            makeModalDraggable(document.getElementById('liberaRigaModal'));
            makeModalDraggable(document.getElementById('disponibilitaModal'));

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(str));
                return div.innerHTML;
            }

            // --- Common card data extraction ---
            function getCardData(card) {
                return {
                    ordineRigaId: card.dataset.ordineRigaId,
                    defaultQuantita: card.dataset.qtaResidua,
                    sourceType: card.dataset.sourceType || 'pending',
                    viaggioRigaId: card.dataset.viaggioRigaId || '',
                    noteRiga: card.dataset.noteRiga || '',
                    provinciaDest: card.dataset.provinciaDest || '',
                    comuneDest: card.dataset.comuneDest || '',
                    warningPeso: (card.innerText || '').includes('N/D')
                        ? '\n⚠️ ATTENZIONE: articolo senza peso unitario! Il peso non verrà calcolato.'
                        : ''
                };
            }

            // --- SortableJS: Pending list (backlog) ---
            var pending = document.getElementById('pendingList');
            if (pending) {
                Sortable.create(pending, {
                    group: { name: 'righeKanban', pull: 'clone', put: false },
                    sort: false,
                    draggable: '.pending-card',
                    animation: 150,
                    scroll: scrollEl,
                    scrollSensitivity: 150,
                    scrollSpeed: 20,
                    bubbleScroll: true
                });
            }

            // --- SortableJS: Trip dropzones (within trips, solo giorni non passati) ---
            document.querySelectorAll('.kanban-column:not([data-past]) .trip-dropzone').forEach(function(zone) {
                Sortable.create(zone, {
                    group: { name: 'righeKanban', pull: true, put: true },
                    draggable: '.assigned-card, .pending-card',
                    animation: 150,
                    scroll: scrollEl,
                    scrollSensitivity: 150,
                    scrollSpeed: 20,
                    bubbleScroll: true,
                    onAdd: function(evt) {
                        var data = getCardData(evt.item);
                        evt.item.remove();
                        var infoText = (data.sourceType === 'assigned'
                            ? 'Stai spostando/modificando una riga già assegnata.'
                            : 'Stai assegnando una nuova riga dal backlog.') + data.warningPeso;
                        openDropModal({
                            destViaggioId: evt.to.dataset.viaggioId,
                            ordineRigaId: data.ordineRigaId,
                            viaggioRigaId: data.viaggioRigaId,
                            defaultQuantita: data.defaultQuantita,
                            noteRiga: data.noteRiga,
                            infoText: infoText
                        });
                    }
                });
            });

            // --- SortableJS: Day drop hints (solo giorni non passati) ---
            document.querySelectorAll('.kanban-column:not([data-past]) .day-drop-hint').forEach(function(hint) {
                Sortable.create(hint, {
                    group: { name: 'righeKanban', pull: false, put: true },
                    sort: false,
                    draggable: '.pending-card, .assigned-card',
                    animation: 150,
                    emptyInsertThreshold: 80,
                    onAdd: function(evt) {
                        var data = getCardData(evt.item);
                        evt.item.remove();
                        hint.classList.remove('day-hint-drag-over');

                        var viaggiJson = hint.dataset.viaggi || '[]';
                        var viaggi = [];
                        try { viaggi = JSON.parse(viaggiJson); } catch(e) {}

                        var infoText = (data.sourceType === 'assigned'
                            ? 'Stai spostando/modificando una riga già assegnata.'
                            : 'Stai assegnando una nuova riga dal backlog.') + data.warningPeso;

                        openDayDropModal({
                            ordineRigaId: data.ordineRigaId,
                            viaggioRigaId: data.viaggioRigaId,
                            defaultQuantita: data.defaultQuantita,
                            noteRiga: data.noteRiga,
                            provinciaDest: data.provinciaDest,
                            comuneDest: data.comuneDest,
                            infoText: infoText,
                            giorno: hint.dataset.giorno,
                            giornoLabel: hint.dataset.giornoLabel,
                            viaggi: viaggi
                        });
                    }
                });
            });
            // --- Click su testata viaggio per modificarlo ---
            var editViaggioModalEl = document.getElementById('editViaggioModal');
            var editViaggioModal = new bootstrap.Modal(editViaggioModalEl);
            makeModalDraggable(editViaggioModalEl);
            var editTipoSel = document.getElementById('editTipoTrasporto');
            var editMezzoInt = document.getElementById('editMezzoInterno');
            var editMezzoEst = document.getElementById('editMezzoEsterno');

            function aggiornaStatoMezziEdit() {
                var opt = editTipoSel.options[editTipoSel.selectedIndex];
                var testo = opt ? opt.text.toLowerCase() : '';
                if (!editTipoSel.value) {
                    editMezzoInt.disabled = true; editMezzoInt.value = '';
                    editMezzoEst.disabled = true; editMezzoEst.value = '';
                    if (filtroEdit) filtroEdit.hide();
                } else if (testo.indexOf('interno') !== -1) {
                    editMezzoInt.disabled = false;
                    editMezzoEst.disabled = true; editMezzoEst.value = '';
                    if (filtroEdit) filtroEdit.hide();
                } else {
                    editMezzoInt.disabled = true; editMezzoInt.value = '';
                    editMezzoEst.disabled = false;
                    if (filtroEdit) { filtroEdit.show(); filtroEdit.refresh(); }
                }
            }
            editTipoSel.addEventListener('change', aggiornaStatoMezziEdit);
            editMezzoInt.addEventListener('change', function() {
                var autistaId = mezzoAutistaMap[editMezzoInt.value];
                if (autistaId) document.getElementById('editAutista').value = autistaId;
                aggiornaRimorchioVisibilita(editMezzoInt, 'editConRimorchioWrap', 'editConRimorchio');
            });
            editMezzoEst.addEventListener('change', function() {
                var info = mezzoEsternoInfoMap[editMezzoEst.value];
                if (info) {
                    document.getElementById('editCostoTrasporto').value = info.Costo;
                    document.getElementById('editGru').checked = info.Gru;
                    document.getElementById('editTrasbordo').checked = info.Trasbordo;
                }
            });

            document.querySelectorAll('.trip-card-header').forEach(function(header) {
                header.addEventListener('click', function(e) {
                    if (e.defaultPrevented) return;
                    var viaggioId = header.dataset.viaggioId;
                    if (viaggioId) {
                        window.location.href = '@Url.Action("Index", "ComposizioneViaggi")' + '?viaggioId=' + viaggioId;
                    }
                });
            });

            // --- Click su riga assegnata per liberarla (con distinzione dblclick) ---
            var liberaModalEl = document.getElementById('liberaRigaModal');
            var liberaModal = new bootstrap.Modal(liberaModalEl);

            document.querySelectorAll('.assigned-card').forEach(function(card) {
                var clickTimer = null;
                card.addEventListener('click', function(e) {
                    if (e.defaultPrevented) return;
                    clearTimeout(clickTimer);
                    clickTimer = setTimeout(function() {
                        var viaggioRigaId = card.dataset.viaggioRigaId;
                        var info = card.querySelector('.fw-semibold');
                        var dettaglio = card.querySelector('small');
                        var dropzone = card.closest('.trip-dropzone');
                        var righeCount = dropzone ? parseInt(dropzone.dataset.righeCount || '0') : 0;

                        document.getElementById('liberaViaggioRigaId').value = viaggioRigaId;
                        document.getElementById('liberaRigaInfo').innerHTML =
                            '<strong>' + escapeHtml(info ? info.innerText : '') + '</strong><br>' +
                            '<small class="text-muted">' + escapeHtml(dettaglio ? dettaglio.innerText : '') + '</small>';
                        document.getElementById('liberaRigaWarning').style.display = righeCount <= 1 ? '' : 'none';
                        liberaModal.show();
                    }, 300);
                });
                card.addEventListener('dblclick', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    clearTimeout(clickTimer);
                    var codice = card.dataset.codiceArticolo;
                    if (codice) openDisponibilita(codice);
                });
            });

            // --- Doppio click su pending-card per disponibilità ---
            document.querySelectorAll('.pending-card').forEach(function(card) {
                card.addEventListener('dblclick', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var codice = card.dataset.codiceArticolo;
                    if (codice) openDisponibilita(codice);
                });
            });

            // --- Cancella viaggio ---
            var cancellaModalEl = document.getElementById('cancellaViaggioModal');
            var cancellaModal = new bootstrap.Modal(cancellaModalEl);
            makeModalDraggable(cancellaModalEl);

            document.querySelectorAll('.btn-cancella-viaggio').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    document.getElementById('cancellaViaggioId').value = btn.dataset.viaggioId;
                    document.getElementById('cancellaViaggioDesc').innerText = btn.dataset.viaggioDesc;
                    cancellaModal.show();
                });
            });

            // --- Popup disponibilità articolo ---
            var dispModalEl = document.getElementById('disponibilitaModal');
            var dispModal = new bootstrap.Modal(dispModalEl);
            var dispUrl = '@Url.Action("GetDisponibilitaArticolo")';

            function openDisponibilita(codiceArticolo) {
                var body = document.getElementById('disponibilitaBody');
                body.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary" role="status"></div><div class="mt-2">Caricamento...</div></div>';
                dispModal.show();

                fetch(dispUrl + '?codiceArticolo=' + encodeURIComponent(codiceArticolo))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (!data.success) {
                            body.innerHTML = '<div class="alert alert-warning mb-0">' + escapeHtml(data.message) + '</div>';
                            return;
                        }
                        var dispClass = data.disponibile > 0 ? 'text-success' : 'text-danger';
                        var fmt = function(v) { return v.toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
                        body.innerHTML =
                            '<table class="table table-sm table-bordered mb-0">' +
                            '<tr><th class="bg-light" style="width:40%">Articolo</th><td><strong>' + escapeHtml(data.codiceArticolo) + '</strong></td></tr>' +
                            '<tr><th class="bg-light">Descrizione</th><td>' + escapeHtml(data.descrizione) + '</td></tr>' +
                            '<tr><th class="bg-light">Unità di misura</th><td>' + escapeHtml(data.unitaMisura) + '</td></tr>' +
                            '<tr><th class="bg-light">Esistenza (Mag. 1)</th><td>' + fmt(data.esistenza) + '</td></tr>' +
                            '<tr><th class="bg-light">Impegnato</th><td>' + fmt(data.impegnato) + '</td></tr>' +
                            '<tr><th class="bg-light">Disponibile</th><td class="fw-bold fs-6 ' + dispClass + '">' + fmt(data.disponibile) + '</td></tr>' +
                            '<tr><th class="bg-light">Pronto</th><td>' + fmt(data.pronto) + '</td></tr>' +
                            '</table>';
                    })
                    .catch(function() {
                        body.innerHTML = '<div class="alert alert-danger mb-0">Errore nel caricamento dei dati.</div>';
                    });
            }
        })();
    </script>
}

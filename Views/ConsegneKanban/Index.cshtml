@model AiDbMaster.ViewModels.ConsegneKanbanViewModel

@{
    ViewData["Title"] = "Calendario Consegne";
    ViewBag.UseFluidContainer = true;
}

@section Styles {
    <style>
        .container-fluid {
            font-size: 0.82rem;
        }

        .modal-header.bg-primary {
            background: var(--bs-primary) !important;
            border-bottom-color: rgba(255,255,255,0.2);
        }

        .modal-header.bg-primary .modal-title,
        .modal-header.bg-primary .btn-close {
            color: #fff !important;
        }

        .container-fluid .text-muted {
            color: #5a6370 !important;
        }

        .kanban-scroll {
            overflow-x: scroll;
            overflow-y: hidden;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 8px;
            background: #f3f5f7;
            scrollbar-width: auto;
            scrollbar-color: #6c7a89 #dfe6ec;
        }

        .kanban-scroll::-webkit-scrollbar {
            height: 14px;
        }

        .kanban-scroll::-webkit-scrollbar-thumb {
            background: #9aa7b5;
            border-radius: 8px;
        }

        .kanban-scroll::-webkit-scrollbar-track {
            background: #dfe6ec;
            border-radius: 8px;
        }

        .kanban-wrap {
            display: grid;
            gap: 12px;
            padding-bottom: 12px;
            min-width: max-content;
        }

        .kanban-column {
            background: #f8f9fa;
            border-radius: 10px;
            border: 1px solid #dee2e6;
            min-height: 650px;
        }

        .kanban-column.kanban-column-past {
            background: #e9ecef;
        }

        .kanban-column.kanban-column-past .kanban-column-header {
            background: #f0f2f4;
            color: #343a40;
        }

        .kanban-column.kanban-column-past .trip-card {
            background: #f0f2f4;
            border-color: #ced4da;
        }

        .kanban-column.kanban-column-past .trip-card-header {
            background: #e2e6ea !important;
            border-bottom-color: #ced4da !important;
            color: #495057;
        }

        .kanban-column.kanban-column-past .assigned-card {
            background: #f0f2f4;
            border-left-color: #6c757d;
            color: #495057;
        }

        .kanban-column.kanban-column-past .day-drop-hint,
        .kanban-column.kanban-column-past .trip-dropzone {
            pointer-events: none;
            opacity: 0.5;
        }

        .kanban-column.kanban-column-sticky {
            position: sticky;
            left: 0;
            z-index: 10;
            background: #f0f2f5;
            box-shadow: 4px 0 8px rgba(0,0,0,0.08);
        }

        .kanban-column-header {
            padding: 10px 12px;
            border-bottom: 1px solid #dee2e6;
            background: #fff;
            border-radius: 10px 10px 0 0;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        .kanban-column {
            display: flex;
            flex-direction: column;
        }

        .kanban-column-body {
            padding: 10px;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            flex: 1;
            min-height: 200px;
            max-height: 600px;
            overflow-y: auto;
        }

        .kanban-column-body::-webkit-scrollbar {
            width: 8px;
        }
        .kanban-column-body::-webkit-scrollbar-thumb {
            background: #b0bec5;
            border-radius: 4px;
        }
        .kanban-column-body::-webkit-scrollbar-track {
            background: #eceff1;
            border-radius: 4px;
        }

        .kanban-column-body.day-drag-over {
            background: #e8f0fe;
            border: 2px dashed #0d6efd;
            border-radius: 0 0 10px 10px;
        }

        .day-drop-hint.day-hint-drag-over {
            background: #e8f0fe;
            border-color: #0d6efd;
        }

        .pending-card, .assigned-card {
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        .pending-card {
            border-left: 4px solid #0d6efd;
            margin-bottom: 8px;
            background: #fff;
            border-radius: 8px;
            padding: 8px 10px;
            cursor: grab;
        }

        .pending-card.no-weight {
            border-left-color: #dc3545;
            background: #fff5f5;
        }

        .pending-card.parziale {
            border-left-color: #fd7e14;
            background: #fff8f0;
        }

        .trip-print-buttons .btn {
            padding: 1px 5px;
            font-size: 0.72rem;
            line-height: 1.4;
            background: rgba(255,255,255,0.7);
            border-color: #888;
            color: #333;
        }

        .trip-print-buttons .btn:hover {
            background: #fff;
            border-color: #0d6efd;
            color: #0d6efd;
        }

        .trip-print-buttons .btn-cancella-viaggio:hover {
            background: #dc3545 !important;
            border-color: #dc3545 !important;
            color: #fff !important;
        }

        .badge-parziale {
            font-size: 0.7rem;
            padding: 1px 6px;
            border-radius: 4px;
            background: #fd7e14;
            color: #fff;
            font-weight: 600;
        }

        .sortable-ghost {
            opacity: 0.4;
            background: #d0e4ff !important;
        }

        .sortable-chosen {
            box-shadow: 0 4px 16px rgba(13, 110, 253, 0.35);
        }

        .sortable-drag {
            opacity: 0.9;
        }

        .pending-group-header {
            background: #dbeafe;
            border: 1px solid #93c5fd;
            border-radius: 6px;
            padding: 6px 8px;
            margin: 10px 0 8px 0;
        }

        .trip-card {
            border-radius: 8px;
            border: 1px solid #dbe3ea;
            background: #fff;
            margin-bottom: 10px;
        }

        .trip-card-header {
            padding: 8px 10px;
            border-bottom: 1px solid #edf2f7;
            border-radius: 8px 8px 0 0;
        }

        .trip-card-header.tipo-interno {
            background: #d1fae5;
            border-bottom-color: #6ee7b7;
        }

        .trip-card-header.tipo-esterno {
            background: #fef9c3;
            border-bottom-color: #fde047;
        }

        .trip-dropzone {
            min-height: 50px;
            padding: 8px;
            background: #fbfdff;
            border: 2px dashed #dbe3ea;
            border-radius: 6px;
            margin: 8px;
        }

        .assigned-card {
            border-left: 3px solid #198754;
            background: #fff;
            border-radius: 6px;
            padding: 6px 8px;
            margin-bottom: 6px;
            cursor: grab;
            transition: background 0.15s;
        }

        .assigned-card:hover {
            background: #f0f7f4;
        }

        .day-drop-hint {
            color: #9aa7b5;
            font-size: 0.8rem;
            text-align: center;
            padding: 12px 8px;
            border: 2px dashed #dce4ed;
            border-radius: 8px;
            margin-top: 6px;
            min-height: 48px;
            transition: background 0.15s, border-color 0.15s;
        }

        #dayDropModal .modal-dialog,
        #dropAssignModal .modal-dialog,
        #modalNuovoViaggio .modal-dialog,
        #editViaggioModal .modal-dialog,
        #liberaRigaModal .modal-dialog,
        #disponibilitaModal .modal-dialog {
            margin-top: 120px !important;
        }
        

        #dayDropModal .viaggio-radio-card {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 8px 12px;
            margin-bottom: 6px;
            cursor: pointer;
            transition: background 0.15s, border-color 0.15s;
        }
        #dayDropModal .viaggio-radio-card:hover,
        #dayDropModal .viaggio-radio-card.selected {
            background: #e8f0fe;
            border-color: #0d6efd;
        }

        #dayDropModal .nuovo-viaggio-section {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 12px;
            background: #f8f9fa;
        }
    </style>
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h5 class="mb-0"><i class="bi bi-calendar3 me-2 text-primary"></i>Calendario Consegne</h5>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" onclick="this.parentElement.remove(); location.reload();" aria-label="Chiudi"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" onclick="this.parentElement.remove(); location.reload();" aria-label="Chiudi"></button>
        </div>
    }

    <div class="card mb-2">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center flex-wrap gap-3">
                <div class="text-nowrap">
                    <small class="text-muted">Consegne</small>
                    <strong class="ms-1">@Model.DataInizio.ToString("dd/MM") - @Model.DataFine.ToString("dd/MM/yyyy")</strong>
                </div>
                <form method="get" asp-action="Index" class="mb-0">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="nascondiWeekend" name="nascondiWeekend" value="true" @(Model.NascondiWeekend ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label text-nowrap" for="nascondiWeekend">Nascondi weekend</label>
                    </div>
                </form>
                <div class="text-nowrap">
                    <small class="text-muted">Durata viaggio default</small>
                    <strong class="ms-1">@Model.DurataDefaultMinuti min</strong>
                </div>
                <div class="d-flex gap-1 ms-auto flex-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" id="btnScrollLeft" title="Scorri giorni a sinistra">
                        <i class="bi bi-chevron-double-left"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" id="btnScrollOggi" title="Vai a oggi">
                        <i class="bi bi-calendar-check me-1"></i>Oggi
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" id="btnScrollRight" title="Scorri giorni a destra">
                        <i class="bi bi-chevron-double-right"></i>
                    </button>
                    <a href="@Url.Action("ExportGanttConsegne")" class="btn btn-sm btn-outline-success text-nowrap" title="Export Gantt mezzi (14 giorni)">
                        <i class="bi bi-bar-chart-steps me-1"></i>Gantt
                    </a>
                    <button type="button" class="btn btn-sm btn-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#modalNuovoViaggio">
                        <i class="bi bi-plus-circle me-1"></i>Nuovo Viaggio
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="kanban-scroll" id="kanbanScroll">
    <div class="kanban-wrap" style="grid-template-columns: repeat(@Model.Giorni.Count, 360px);">
        @* Colonna "Da pianificare" nascosta temporaneamente *@

        @foreach (var giorno in Model.Giorni)
        {
            var isToday = giorno.Data.Date == DateTime.Today;
            var isPast = giorno.Data.Date < DateTime.Today;
            var mezziInterni = giorno.Viaggi.Count(v => v.MezzoTrasportoId.HasValue);
            var mezziEsterni = giorno.Viaggi.Count(v => v.MezzoTrasportoEsternoId.HasValue);
            <div class="kanban-column @(isPast ? "kanban-column-past" : "")" @(isToday ? "data-is-today=\"true\"" : "") @(isPast ? "data-past=\"true\"" : "")>
                <div class="kanban-column-header @(isToday ? "bg-primary text-white" : "")">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>@giorno.Etichetta @(isToday ? "★ OGGI" : "")</strong>
                            <div><small class="@(isToday ? "text-white-50" : "text-muted")">@giorno.Viaggi.Count viaggi — <i class="bi bi-truck"></i> @mezziInterni int. | <i class="bi bi-box-seam"></i> @mezziEsterni est.</small></div>
                        </div>
                        @if (giorno.Viaggi.Any())
                        {
                            <div class="d-flex gap-1">
                                <a href="@Url.Action("StampaDistintaCarico", new { data = giorno.Data.ToString("yyyy-MM-dd") })" target="_blank"
                                   class="btn btn-sm @(isToday ? "btn-outline-light" : "btn-outline-secondary")" title="Distinta carico giornaliera (magazzino)"
                                   style="padding: 1px 6px; font-size: 0.7rem;">
                                    <i class="bi bi-card-checklist"></i>
                                </a>
                                <a href="@Url.Action("ExportPlanningGiornaliero", new { data = giorno.Data.ToString("yyyy-MM-dd") })"
                                   class="btn btn-sm @(isToday ? "btn-outline-light" : "btn-outline-secondary")" title="Export planning Excel"
                                   style="padding: 1px 6px; font-size: 0.7rem;">
                                    <i class="bi bi-file-earmark-excel"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
                <div class="kanban-column-body day-sortable" data-giorno="@giorno.Data.ToString("yyyy-MM-dd")">
                    @foreach (var viaggio in giorno.Viaggi)
                    {
                        var barClass = viaggio.PercentualeCarico > 100 ? "bg-danger" : viaggio.PercentualeCarico > 90 ? "bg-warning" : "bg-success";
                        <div class="trip-card">
                            <div class="trip-card-header @(viaggio.TipoTrasporto.Contains("Interno", StringComparison.OrdinalIgnoreCase) ? "tipo-interno" : "tipo-esterno")"
                                 style="cursor:pointer;"
                                 data-viaggio-id="@viaggio.Id"
                                 data-data-consegna="@viaggio.DataConsegna.ToString("yyyy-MM-dd")"
                                 data-tipo-trasporto-id="@viaggio.TipoTrasportoId"
                                 data-mezzo-trasporto-id="@(viaggio.MezzoTrasportoId?.ToString() ?? "")"
                                 data-mezzo-esterno-id="@(viaggio.MezzoTrasportoEsternoId?.ToString() ?? "")"
                                 data-ora-partenza="@viaggio.OraPartenza.ToString(@"hh\:mm")"
                                 data-ora-arrivo="@viaggio.OraArrivoEffettiva.ToString(@"hh\:mm")"
                                 data-note="@(viaggio.Note ?? "")"
                                 data-autista-id="@(viaggio.AutistaId?.ToString() ?? "")"
                                 data-costo-trasporto="@((viaggio.CostoTrasporto ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                 data-prezzo-vendita="@((viaggio.PrezzoVendita ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                 data-tempo-pausa="@((viaggio.TempoPausa ?? 0))"
                                 data-tempo-scarico="@((viaggio.TempoScarico ?? 0))"
                                 data-gru="@((viaggio.Gru ?? false).ToString().ToLowerInvariant())"
                                 data-trasbordo="@((viaggio.Trasbordo ?? false).ToString().ToLowerInvariant())"
                                 data-con-rimorchio="@viaggio.ConRimorchio.ToString().ToLowerInvariant()">
                                <div class="fw-bold d-flex align-items-center gap-1 flex-wrap">
                                    <span>@viaggio.Mezzo</span>
                                    @if (viaggio.ConRimorchio) { <span class="badge bg-secondary text-white" style="font-size:0.65rem;"><i class="bi bi-truck-flatbed"></i> Rim.</span> }
                                    @if (viaggio.Gru == true) { <span class="badge bg-info text-dark" style="font-size:0.65rem;"><i class="bi bi-arrow-up-circle"></i> Gru</span> }
                                    @if (viaggio.Trasbordo == true) { <span class="badge bg-warning text-dark" style="font-size:0.65rem;"><i class="bi bi-arrow-left-right"></i> Trasb.</span> }
                                </div>
                                <div><small>@viaggio.TipoTrasporto | @viaggio.OraPartenza.ToString(@"hh\:mm") - @viaggio.OraArrivoEffettiva.ToString(@"hh\:mm")@(viaggio.Autista != null ? $" | {viaggio.Autista}" : "")</small></div>
                                @if (viaggio.Destinazioni.Any())
                                {
                                    <div><small><i class="bi bi-geo-alt"></i> @string.Join(" · ", viaggio.Destinazioni)</small></div>
                                }
                                <div class="mt-1">
                                    <small>Carico: @viaggio.PesoTotaleKg.ToString("N0") / @viaggio.PortataMaxKg.ToString("N0") Kg</small>
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar @barClass" style="width: @Math.Min(100, viaggio.PercentualeCarico)%"></div>
                                    </div>
                                </div>
                                <div class="mt-1 d-flex gap-1 trip-print-buttons">
                                    <a href="@Url.Action("StampaFoglioViaggio", new { id = viaggio.Id })" target="_blank" class="btn btn-sm" title="Foglio viaggio (autista)" onclick="event.stopPropagation();">
                                        <i class="bi bi-file-earmark-text"></i> Viaggio
                                    </a>
                                    <button type="button" class="btn btn-sm btn-cancella-viaggio"
                                            data-viaggio-id="@viaggio.Id"
                                            data-viaggio-desc="@viaggio.Mezzo — @viaggio.DataConsegna.ToString("dd/MM/yyyy") @viaggio.OraPartenza.ToString(@"hh\:mm")"
                                            title="Cancella intero viaggio"
                                            onclick="event.stopPropagation();"
                                            style="border-color:#dc3545; color:#dc3545;">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="trip-dropzone" data-viaggio-id="@viaggio.Id" data-righe-count="@viaggio.Righe.Count">
                                @if (!viaggio.Righe.Any())
                                {
                                    <small class="text-muted">Trascina qui le righe da pianificare</small>
                                }
                                @foreach (var riga in viaggio.Righe)
                                {
                                    <div class="assigned-card"
                                         data-source-type="assigned"
                                         data-viaggio-riga-id="@riga.ViaggioRigaId"
                                         data-ordine-riga-id="@riga.OrdineRigaId"
                                         data-qta-residua="@riga.QuantitaAssegnata.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                         data-note-riga="@riga.NoteRiga"
                                         data-codice-articolo="@riga.CodiceArticolo">
                                        <div class="fw-semibold d-flex justify-content-between align-items-center">
                                            <span>@riga.OrdineCompleto - R @riga.RigaOrdine</span>
                                            <small class="fw-normal text-muted"><i class="bi bi-calendar-event"></i> @riga.DataConsegna.ToString("dd/MM")</small>
                                        </div>
                                        <div><small>@riga.CodiceArticolo - @riga.DescrizioneArticolo</small></div>
                                        <div><small>Qta: @riga.QuantitaAssegnata.ToString("N2") | Peso: @riga.PesoTotaleKg.ToString("N0") Kg</small></div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @{
                        var viaggiJson = System.Text.Json.JsonSerializer.Serialize(
                            giorno.Viaggi.Select(v => new {
                                v.Id,
                                Desc = $"{v.Mezzo} | {v.TipoTrasporto} | {v.OraPartenza.ToString("hh\\:mm")}-{v.OraArrivoEffettiva.ToString("hh\\:mm")} | Carico: {v.PesoTotaleKg.ToString("N0")}/{v.PortataMaxKg.ToString("N0")} Kg"
                            }));
                    }
                    <div class="day-drop-hint"
                         data-giorno="@giorno.Data.ToString("yyyy-MM-dd")"
                         data-giorno-label="@giorno.Etichetta"
                         data-viaggi="@viaggiJson">
                        <i class="bi bi-arrows-move me-1"></i>Trascina qui per il giorno
                    </div>
                </div>
            </div>
        }
    </div>
    </div>
</div>

<div class="modal fade" id="modalNuovoViaggio" tabindex="-1" aria-hidden="true" data-bs-backdrop="false" data-bs-keyboard="true" style="z-index: 1070;">
    <div class="modal-dialog modal-xl" style="box-shadow: 0 8px 32px rgba(0,0,0,0.3); margin-top: 120px !important;">
        <div class="modal-content">
            <form asp-action="CreaViaggio" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="nascondiWeekend" value="@Model.NascondiWeekend.ToString().ToLowerInvariant()" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Nuovo viaggio</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label">Data consegna</label>
                            <input type="date" name="dataConsegna" id="newDataConsegna" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Tipo trasporto</label>
                            <select name="tipoTrasportoId" id="newTipoTrasporto" class="form-select" required>
                                <option value="">-- seleziona --</option>
                                @foreach (var item in Model.TipiTrasporto)
                                {
                                    <option value="@item.Id">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3" id="newMezzoInternoWrap">
                            <label class="form-label">Mezzo interno</label>
                            <select name="mezzoTrasportoId" id="newMezzoInterno" class="form-select" disabled>
                                <option value="">-- seleziona tipo --</option>
                                @foreach (var item in Model.Mezzi)
                                {
                                    <option value="@item.Id">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3" id="newMezzoEsternoWrap">
                            <label class="form-label">Mezzo esterno</label>
                            <select name="mezzoTrasportoEsternoId" id="newMezzoEsterno" class="form-select" disabled>
                                <option value="">-- seleziona tipo --</option>
                                @foreach (var item in Model.MezziEsterni)
                                {
                                    <option value="@item.Id">@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mt-1 filtro-localita-row" id="newFiltroLocalitaWrap" style="display:none;">
                        <div class="col-md-3">
                            <label class="form-label"><i class="bi bi-funnel me-1"></i>Vettore</label>
                            <select class="form-select form-select-sm filtro-nomevettore" data-target="newMezzoEsterno"><option value="">-- tutti --</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><i class="bi bi-funnel me-1"></i>Regione</label>
                            <select class="form-select form-select-sm filtro-regione" data-target="newMezzoEsterno"><option value="">-- tutte --</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><i class="bi bi-funnel me-1"></i>Provincia</label>
                            <select class="form-select form-select-sm filtro-provincia" data-target="newMezzoEsterno"><option value="">-- tutte --</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label"><i class="bi bi-funnel me-1"></i>Comune</label>
                            <select class="form-select form-select-sm filtro-comune" data-target="newMezzoEsterno"><option value="">-- tutti --</option></select>
                        </div>
                    </div>
                    <div class="row g-2 mt-1">

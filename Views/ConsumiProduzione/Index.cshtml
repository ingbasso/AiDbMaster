@model AiDbMaster.ViewModels.ConsumiProduzionePrevViewModel

@{
    ViewData["Title"] = "Consumi Produzione Previsti";
}

<div class="px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clipboard-data me-2 text-primary"></i>Consumi Produzione Previsti</h2>
    </div>

    <!-- Form Filtri Date -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Parametri di Ricerca</h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label asp-for="DataDa" class="form-label fw-bold">
                            <i class="bi bi-calendar-event me-1"></i>Da Data Produzione
                        </label>
                        <input asp-for="DataDa" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="DataA" class="form-label fw-bold">
                            <i class="bi bi-calendar-event me-1"></i>A Data Produzione
                        </label>
                        <input asp-for="DataA" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-search me-2"></i>Visualizza
                        </button>
                    </div>
                </div>
            </form>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="mt-3">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div class="alert alert-danger py-2 mb-1">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error.ErrorMessage
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Risultati -->
    @if (Model.RicercaEffettuata && Model.Risultati != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-table me-2"></i>Risultati
                    <span class="badge bg-light text-dark ms-2">@Model.Risultati.Rows.Count righe</span>
                </h5>
                <small>Periodo: @Model.DataDa?.ToString("dd/MM/yyyy") - @Model.DataA?.ToString("dd/MM/yyyy")</small>
            </div>
            <div class="card-body p-0">
                @if (Model.Risultati.Rows.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-sm mb-0" id="tabellaConsumi">
                            <thead class="table-dark">
                                <tr>
                                    @foreach (System.Data.DataColumn col in Model.Risultati.Columns)
                                    {
                                        <th class="px-2 py-2" style="white-space: nowrap;">@col.ColumnName</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (System.Data.DataRow row in Model.Risultati.Rows)
                                {
                                    <tr>
                                        @foreach (System.Data.DataColumn col in Model.Risultati.Columns)
                                        {
                                            var val = row[col];
                                            var isNumeric = col.DataType == typeof(decimal) || col.DataType == typeof(double)
                                                         || col.DataType == typeof(float) || col.DataType == typeof(int)
                                                         || col.DataType == typeof(long) || col.DataType == typeof(short);
                                            var isDate = col.DataType == typeof(DateTime);

                                            <td class="px-2 py-1 @(isNumeric ? "text-end" : "")">
                                                @if (val == DBNull.Value)
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                                else if (isDate && val is DateTime dtVal)
                                                {
                                                    @dtVal.ToString("dd/MM/yyyy")
                                                }
                                                else if (isNumeric && val is decimal decVal)
                                                {
                                                    @decVal.ToString("N2")
                                                }
                                                else if (isNumeric && val is double dblVal)
                                                {
                                                    @dblVal.ToString("N2")
                                                }
                                                else if (isNumeric && val is float fltVal)
                                                {
                                                    @fltVal.ToString("N2")
                                                }
                                                else
                                                {
                                                    @val.ToString()
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3">Nessun risultato trovato</h5>
                        <p class="text-muted">La stored procedure non ha restituito dati per il periodo selezionato.</p>
                    </div>
                }
            </div>
        </div>
    }
    else if (!Model.RicercaEffettuata)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-arrow-up-circle text-info" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Seleziona il periodo e clicca "Visualizza"</h5>
                <p class="text-muted">I dati verranno caricati dalla procedura ElencoImpegniProduzione.</p>
            </div>
        </div>
    }
</div>

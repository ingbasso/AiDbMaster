@model IEnumerable<AiDbMaster.Models.Opzione>

@{
    ViewData["Title"] = "Tabella Opzioni";
    ViewBag.UseFluidContainer = true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">
            <i class="bi bi-sliders text-primary"></i> Tabella Opzioni
        </h4>
        <small class="text-muted">Gestione delle opzioni di configurazione del sistema</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuova Opzione
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Ricerca -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="max-width: 400px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Cerca per nome o valore..."
                       value="@ViewBag.CurrentSearch">
            </div>
            <button type="submit" class="btn btn-outline-primary btn-sm">Cerca</button>
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string))
            {
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-x-lg"></i> Annulla
                </a>
            }
        </form>
    </div>
</div>

<!-- Tabella -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 60px;" class="text-center">ID</th>
                        <th>Nome Opzione</th>
                        <th>Valore</th>
                        <th style="width: 140px;" class="text-center">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                Nessuna opzione trovata.
                            </td>
                        </tr>
                    }
                    @foreach (var opzione in Model)
                    {
                        var isPassword = opzione.NomeOpzione.Contains("Password", StringComparison.OrdinalIgnoreCase);
                        <tr>
                            <td class="text-center text-muted">@opzione.ID</td>
                            <td>
                                <strong>@opzione.NomeOpzione</strong>
                            </td>
                            <td>
                                @if (isPassword)
                                {
                                    <span class="text-muted fst-italic">
                                        <i class="bi bi-lock-fill me-1"></i>••••••••
                                    </span>
                                }
                                else if (string.IsNullOrEmpty(opzione.ValoreOpzione))
                                {
                                    <span class="text-muted fst-italic">(vuoto)</span>
                                }
                                else
                                {
                                    <code>@opzione.ValoreOpzione</code>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@opzione.ID" class="btn btn-outline-primary" title="Modifica">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@opzione.ID" class="btn btn-outline-danger" title="Elimina">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer text-muted small">
        Totale: <strong>@Model.Count()</strong> opzioni
    </div>
</div>

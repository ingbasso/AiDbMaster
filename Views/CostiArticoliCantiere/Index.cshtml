@model IEnumerable<AiDbMaster.Models.CostoArticoloCantiere>
@using System.Globalization
@{
    ViewData["Title"] = "Costi articoli";
    ViewBag.UseFluidContainer = true;
    var it = CultureInfo.GetCultureInfo("it-IT");
    var ricerca = ViewBag.Ricerca as string;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0"><i class="bi bi-cash-coin me-2 text-primary"></i>Costi articoli</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm me-2" permission-required="CostiArticoliCantiere:Create">
                <i class="bi bi-plus-circle me-1"></i>Nuovo articolo
            </a>
            <a asp-controller="GestioneCantieri" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Elenco cantieri
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-3">
        <div class="card-body py-2">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-6">
                    <input type="search" name="q" value="@ricerca" class="form-control form-control-sm" placeholder="Cerca per codice o descrizione" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search me-1"></i>Cerca</button>
                    @if (!string.IsNullOrEmpty(ricerca))
                    {
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Mostra tutti</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><i class="bi bi-list-ul me-1"></i>Elenco (@Model.Count())</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Codice</th>
                            <th>Descrizione</th>
                            <th class="text-end">Costo unitario</th>
                            <th class="text-end">Prezzo medio</th>
                            <th>Ultima modifica</th>
                            <th>Utente</th>
                            <th class="text-center" style="width:120px;">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Nessun articolo trovato.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.CodiceArticolo</strong></td>
                            <td>@item.Descrizione</td>
                            <td class="text-end">@item.CostoUnitario.ToString("N2", it)</td>
                            <td class="text-end">@item.PrezzoMedioVendita.ToString("N2", it)</td>
                            <td>@item.DataUltimaModifica.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.UtenteModifica ?? "—")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"
                                   permission-required="CostiArticoliCantiere:Edit" title="Modifica">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"
                                        permission-required="CostiArticoliCantiere:Delete" title="Elimina">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var item in Model)
{
    <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Conferma eliminazione</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Eliminare il costo dell'articolo <strong>@item.CodiceArticolo</strong>?</p>
                    <p class="text-muted mb-0">Le contabilità già salvate restano come sono. In una contabilità nuova questo codice non proporrà più il costo e non mostrerà più il PM.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Elimina</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

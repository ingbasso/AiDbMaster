@model AiDbMaster.Models.ImpresaPosa

@{
    ViewData["Title"] = "Nuova impresa di posa";
    ViewBag.UseFluidContainer = true;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Nuova impresa di posa</h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="card">
        <div class="card-header"><i class="bi bi-person-workspace me-1"></i>Dati impresa</div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <partial name="_Form" model="Model" />
                <hr />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">Annulla</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Salva
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

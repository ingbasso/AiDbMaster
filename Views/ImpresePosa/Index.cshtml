@model IEnumerable<AiDbMaster.Models.ImpresaPosa>

@{
    ViewData["Title"] = "Imprese di posa";
    ViewBag.UseFluidContainer = true;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0"><i class="bi bi-person-workspace me-2 text-primary"></i>Imprese di posa</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary btn-sm me-2" permission-required="ImpresePosa:Create">
                <i class="bi bi-plus-circle me-1"></i>Nuova impresa
            </a>
            <a asp-controller="GestioneCantieri" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> Elenco cantieri
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-header"><i class="bi bi-list-ul me-1"></i>Elenco imprese (@Model.Count())</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Telefono</th>
                            <th>Note</th>
                            <th class="text-center">Attiva</th>
                            <th class="text-center" style="width:120px;">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Nome</strong></td>
                            <td>@(item.Telefono ?? "—")</td>
                            <td>@(item.Note ?? "—")</td>
                            <td class="text-center">
                                @if (item.Attivo)
                                {
                                    <span class="badge bg-success">Sì</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"
                                   permission-required="ImpresePosa:Edit" title="Modifica">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id"
                                        permission-required="ImpresePosa:Delete" title="Elimina">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var item in Model)
{
    <div class="modal fade" id="deleteModal-@item.Id" tabindex="-1" data-bs-backdrop="false" data-bs-keyboard="true">
        <div class="modal-dialog" style="margin-top: 120px; box-shadow: 0 8px 32px rgba(0,0,0,0.3);">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Conferma eliminazione</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Eliminare l'impresa di posa <strong>@item.Nome</strong>?</p>
                    <p class="text-muted mb-0">Se è già usata in un cantiere non verrà cancellata: in quel caso disattivala.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Elimina</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function makeModalDraggable(modalEl) {
            var dialog = modalEl.querySelector('.modal-dialog');
            var header = modalEl.querySelector('.modal-header');
            var dragging = false;
            var startX = 0, startY = 0;
            var currentX = 0, currentY = 0;
            header.style.cursor = 'move';
            header.addEventListener('mousedown', function(e) {
                if (e.target.closest('.btn-close') || e.target.closest('input') || e.target.closest('select') || e.target.closest('button')) return;
                startX = e.clientX - currentX;
                startY = e.clientY - currentY;
                dragging = true;
                e.preventDefault();
            });
            document.addEventListener('mousemove', function(e) {
                if (!dragging) return;
                currentX = e.clientX - startX;
                currentY = e.clientY - startY;
                dialog.style.transform = 'translate(' + currentX + 'px, ' + currentY + 'px)';
            });
            document.addEventListener('mouseup', function() { dragging = false; });
            modalEl.addEventListener('show.bs.modal', function() {
                currentX = 0;
                currentY = 0;
                dialog.style.transform = '';
            });
        }
        document.querySelectorAll('.modal').forEach(makeModalDraggable);
    </script>
}

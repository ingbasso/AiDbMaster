        // Aggiorna un ordine sul server
        async function updateOrdine(id, startTime, endTime, roomId, isResize = false) {
            try {
                showLoading(true);
                
                const response = await fetch('@Url.Action("UpdateOrdine", "Schedulatore")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    },
                    body: JSON.stringify({
                        Id: id,
                        StartTime: startTime,
                        EndTime: endTime,
                        RoomId: roomId,
                        IsResize: isResize
                    })
                });

                const result = await response.json();
                
                if (response.ok && result.success) {
                    const azione = isResize ? 'ridimensionato' : 'spostato';
                    showSuccess(`Ordine ${azione} con successo` + 
                               (result.nuovaQuantita ? ` - Nuova quantità: ${result.nuovaQuantita}` : ''));
                    
                    // Ricarica i dati per aggiornare la visualizzazione (specialmente per resize che cambia la quantità)
                    if (isResize) {
                        await refreshData();
                    }
                } else {
                    throw new Error(result.message || 'Errore nell\'aggiornamento');
                }
            } catch (error) {
                console.error('Errore nell\'aggiornamento dell\'ordine:', error);
                showError('Errore nell\'aggiornamento dell\'ordine');
                
                // Ricarica i dati per ripristinare lo stato precedente
                await refreshData();
            } finally {
                showLoading(false);
            }
        }



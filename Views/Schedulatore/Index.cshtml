                // Event handlers
                eventRendered: onEventRendered,
                dragStop: onDragStop,
                resizeStop: onResizeStop,
                actionBegin: onActionBegin,
                dataBound: onDataBound
            });

            scheduleObj.appendTo('#scheduler');
            console.log('Scheduler creato con successo');
            
            // Forza lo stile dei nomi dei centri dopo il rendering
            setTimeout(() => {
                forzaStiliCentriLavoro();
            }, 1000);
            
            } catch (error) {
                console.error('Errore nella creazione dello scheduler:', error);
                throw new Error(`Creazione scheduler: ${error.message}`);
            }
        }

        // Personalizza il rendering degli eventi
        function onEventRendered(args) {
            const eventData = args.data;
            
            // Applica il colore basato sullo stato
            if (eventData.CategoryColor) {
                args.element.style.backgroundColor = eventData.CategoryColor;
            }
            
            // Calcola e visualizza sovrapposizioni con fermi
            const sovrapposizioni = calcolaSovrapposizioneFermo(eventData);
            if (sovrapposizioni.length > 0) {
                args.element.style.position = 'relative';
                
                sovrapposizioni.forEach(sovr => {
                    const fermoOverlay = document.createElement('div');
                    fermoOverlay.className = 'fermo-overlay';
                    fermoOverlay.style.cssText = `
                        position: absolute;
                        top: 0;
                        left: ${sovr.percentualeInizio}%;
                        width: ${sovr.percentualeLarghezza}%;
                        height: 100%;
                        background: repeating-linear-gradient(
                            -45deg,
                            rgba(255, 0, 0, 0.3),
                            rgba(255, 0, 0, 0.3) 10px,
                            rgba(255, 0, 0, 0.5) 10px,
                            rgba(255, 0, 0, 0.5) 20px
                        );
                        border-left: 2px solid #ff0000;
                        border-right: 2px solid #ff0000;
                        pointer-events: none;
                        z-index: 1;
                    `;
                    fermoOverlay.title = `⚠️ FERMO: ${sovr.descrizione || sovr.tipoFermo}`;
                    args.element.appendChild(fermoOverlay);
                    
                    console.log(`⚠️ Ordine ${eventData.Id} in conflitto con fermo: ${sovr.percentualeInizio.toFixed(1)}% - ${(sovr.percentualeInizio + sovr.percentualeLarghezza).toFixed(1)}%`);
                });
            }
            
            // Aggiungi barra di progressione personalizzata
            const percentuale = eventData.PercentualeCompletamento || 0;
            if (percentuale > 0) {
                const progressContainer = document.createElement('div');
                progressContainer.className = 'event-progress-container';
                progressContainer.style.cssText = `
                    position: absolute;
                    bottom: 3px;
                    left: 3px;
                    right: 3px;
                    height: 8px;
                    background: rgba(0,0,0,0.15);
                    border-radius: 4px;
                    overflow: hidden;
                    box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
                    z-index: 2;
                `;
                
                const progressBar = document.createElement('div');
                progressBar.className = 'event-progress-bar';
                progressBar.style.cssText = `
                    height: 100%;
                    width: ${percentuale}%;
                    background: linear-gradient(90deg, rgba(255,255,255,0.9), rgba(255,255,255,0.7));
                    border-radius: 4px;
                    transition: width 0.3s ease;
                    position: relative;
                `;
                
                // Barra di progressione bianca
                progressBar.style.background = 'rgba(255,255,255,0.9)';
                
                // Aggiungi un leggero effetto per eventi completati
                if (percentuale >= 100) {
                    progressBar.style.background = 'rgba(255,255,255,1)';
                    progressBar.style.boxShadow = '0 0 3px rgba(255,255,255,0.6)';
                }
                
                // Aggiungi testo percentuale se c'è spazio
                if (percentuale >= 20) {
                    const percentText = document.createElement('span');
                    percentText.style.cssText = `
                        position: absolute;
                        right: 4px;
                        top: 50%;
                        transform: translateY(-50%);
                        font-size: 0.7rem;
                        font-weight: bold;
                        color: rgba(0,0,0,0.7);
                        text-shadow: 0 1px 1px rgba(255,255,255,0.5);
                    `;
                    percentText.textContent = `${percentuale}%`;
                    progressContainer.appendChild(percentText);
                }
                
                progressContainer.appendChild(progressBar);
                args.element.appendChild(progressContainer);
            }

            // Aggiungi click listener diretto all'elemento
            args.element.style.cursor = 'pointer';
            args.element.style.pointerEvents = 'auto';
            
            // Rimuovi eventuali listener esistenti
            args.element.onclick = null;
            
            args.element.addEventListener('click', function(e) {
                console.log('=== CLICK EVENTO CATTURATO ===');
                console.log('Event target:', e.target);
                console.log('Event data:', eventData);
                console.log('Pointer events:', window.getComputedStyle(args.element).pointerEvents);
                
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation();
                
                // Apri il modal personalizzato
                openOrderDetailsModal(eventData);
                
                return false;
            }, true); // Use capture phase
            
            // Aggiungi anche un listener per mousedown come backup
            args.element.addEventListener('mousedown', function(e) {
                console.log('MouseDown su evento:', eventData.Id);
            });
        }

        // Gestisce il drag & drop
        async function onDragStop(args) {
            if (args.data && args.data.Id) {
                const idStato = args.data.IdStato || args.data.idStato;
                
                // Controllo aggiuntivo per sicurezza (non dovrebbe mai arrivare qui per stati bloccati)
                if (idStato === 3) {
                    showInfo('Gli ordini chiusi non possono essere spostati');
                    return;
                }
                
                if (idStato === 2) {
                    showInfo('Gli ordini in produzione non possono essere spostati. Usa il resize per modificare la durata');
                    return;
                }
                
                console.log('Drag completato per ordine:', args.data.Id);
                // DRAG & DROP: isResize = false, NON passare roomId (il centro non cambia)
                await updateOrdine(args.data.Id, args.data.StartTime, args.data.EndTime, null, false);
            }
        }

        // Gestisce il resize
        async function onResizeStop(args) {
            if (args.data && args.data.Id) {
                const idStato = args.data.IdStato || args.data.idStato;
                
                // Controllo per ordini chiusi
                if (idStato === 3) {
                    showInfo('Gli ordini chiusi non possono essere modificati');
                    args.cancel = true;
                    return;
                }
                
                // Controllo per ordini in produzione: la nuova data fine non può essere nel passato
                if (idStato === 2) {
                    const now = new Date();
                    if (args.data.EndTime < now) {
                        showError('Non puoi ridurre l\'ordine a una data passata. Gli ordini in produzione possono essere solo estesi nel futuro.');
                        args.cancel = true;
                        return;
                    }
                }
                
                console.log('Resize completato per ordine:', args.data.Id, 'Stato:', idStato);
                // RESIZE: isResize = true, ricalcola la quantità in base alla nuova durata
                await updateOrdine(args.data.Id, args.data.StartTime, args.data.EndTime, null, true);
            }
        }


        // Trova i dati originali completi dell'ordine
        function findOriginalOrderData(eventId) {
            const originalData = ordiniOriginali.find(o => (o.id || o.Id) == eventId);
            if (originalData) {
                return originalData;
            }
            return null;
        }

        // Gestisce i campi readonly in base allo stato dell'ordine
        function setFieldsReadonlyByStatus(idStato) {
            const isChiuso = (idStato == 3); // Stato Chiuso
            const isInProduzione = (idStato == 2); // Stato In Produzione
            
            // Lista dei campi che devono diventare readonly quando l'ordine è chiuso
            const fieldsToDisableWhenClosed = [
                'orderQuantita',
                'orderQuantitaProdotta', 
                'orderDataInizio',
                'orderDataFine',
                'orderDataFinePrevista',
                'orderCentroLavoro',
                'orderPriorita',
                'orderNote'
            ];
            
            // Lista dei campi che devono diventare readonly quando l'ordine è in produzione
            const fieldsToDisableWhenInProduction = [
                'orderCentroLavoro',
                'orderDataInizio'
            ];
            
            // Imposta readonly per tutti i campi se chiuso
            fieldsToDisableWhenClosed.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.readOnly = isChiuso;
                    field.disabled = isChiuso;
                    
                    // Aggiungi classe visiva per indicare campo disabilitato
                    if (isChiuso) {
                        field.classList.add('bg-light', 'text-muted');
                    } else {
                        field.classList.remove('bg-light', 'text-muted');
                    }
                }
            });
            
            // Imposta readonly per campi specifici se in produzione (ma non chiuso)
            if (isInProduzione && !isChiuso) {
                fieldsToDisableWhenInProduction.forEach(fieldId => {
                    const field = document.getElementById(fieldId);
                    if (field) {
                        field.readOnly = true;
                        field.disabled = true;
                        field.classList.add('bg-light', 'text-muted');
                    }
                });
            }
            
            // Il campo Stato rimane sempre modificabile
            const statoField = document.getElementById('orderStato');
            if (statoField) {
                statoField.readOnly = false;
                statoField.disabled = false;
                statoField.classList.remove('bg-light', 'text-muted');
            }
            
            // Aggiorna il pulsante di salvataggio
            const saveButton = document.getElementById('saveOrderChanges');
            if (saveButton) {
                if (isChiuso) {
                    saveButton.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Cambia Stato';
                    saveButton.title = 'Solo il cambio di stato è permesso per ordini chiusi';
                } else if (isInProduzione) {
                    saveButton.innerHTML = '<i class="bi bi-check-circle me-1"></i>Salva Modifiche';
                    saveButton.title = 'Centro di Lavoro e Data Inizio non modificabili per ordini in produzione';
                } else {
                    saveButton.innerHTML = '<i class="bi bi-check-circle me-1"></i>Salva Modifiche';
                    saveButton.title = 'Salva tutte le modifiche';
                }
            }
            
            // Mostra/nascondi l'alert per ordini con restrizioni
            const alert = document.getElementById('orderClosedAlert');
            if (alert) {
                const alertContent = alert.querySelector('.alert-content');
                if (isChiuso) {
                    alert.style.display = 'block';
                    if (alertContent) {
                        alertContent.innerHTML = '<i class="bi bi-exclamation-triangle me-2"></i><strong>Ordine Chiuso:</strong> Solo il campo "Stato" può essere modificato per ordini chiusi.';
                    }
                } else if (isInProduzione) {
                    alert.style.display = 'block';
                    if (alertContent) {
                        alertContent.innerHTML = '<i class="bi bi-info-circle me-2"></i><strong>Ordine In Produzione:</strong> Centro di Lavoro e Data Inizio non possono essere modificati.';
                    }
                } else {
                    alert.style.display = 'none';
                }
            }
        }

        // Carica i centri di lavoro nel dropdown
        async function loadCentriLavoroDropdown() {
            try {
                const response = await fetch('/Schedulatore/GetCentriLavoroDropdown');
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const centri = await response.json();
                const dropdown = document.getElementById('orderCentroLavoro');
                
                // Pulisci il dropdown
                dropdown.innerHTML = '<option value="">Seleziona Centro di Lavoro</option>';
                
                // Aggiungi le opzioni
                centri.forEach(centro => {
                    const option = document.createElement('option');
                    option.value = centro.id;
                    option.textContent = centro.nome;
                    dropdown.appendChild(option);
                });
                
                return true;
            } catch (error) {
                console.error('Errore nel caricamento centri di lavoro per dropdown:', error);
                throw error;
            }
        }

        // Apre il modal con i dettagli dell'ordine
        function openOrderDetailsModal(eventData) {
            try {
                // Chiudi eventuali modal aperti
                const existingModals = document.querySelectorAll('.modal.show');
                existingModals.forEach(modal => {
                    const modalInstance = bootstrap.Modal.getInstance(modal);
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                });
                
                // Rimuovi eventuali backdrop rimasti
                const backdrops = document.querySelectorAll('.modal-backdrop');
                backdrops.forEach(backdrop => backdrop.remove());
                
                // Ripristina scroll del body
                document.body.classList.remove('modal-open');
                document.body.style.overflow = '';
                document.body.style.paddingRight = '';
                
                // Recupera i dati originali completi
                const originalData = findOriginalOrderData(eventData.Id);
                const fullData = originalData || eventData; // Fallback ai dati filtrati se non trovati
                
                // Aggiorna il titolo del modal con il formato richiesto
                const titoloOrdine = `${fullData.tipoOrdine || fullData.TipoOrdine || ''}-${fullData.annoOrdine || fullData.AnnoOrdine || ''}-${fullData.serieOrdine || fullData.SerieOrdine || ''}-${fullData.numeroOrdine || fullData.NumeroOrdine || ''}`;
                document.getElementById('orderDetailsModalLabel').innerHTML = `<i class="bi bi-box me-2"></i>Dettagli Ordine: <span id="orderTitleLabel">${titoloOrdine}</span>`;
                
                // Popola i campi del form
                document.getElementById('orderIdListaOP').value = eventData.Id || '';
                document.getElementById('orderIdListaOPDisplay').value = eventData.Id || '';
                document.getElementById('orderCodiceArticolo').value = fullData.codiceArticolo || fullData.CodiceArticolo || '';
                document.getElementById('orderDescrizioneArticolo').value = fullData.descrizioneArticolo || fullData.DescrizioneArticolo || '';
                document.getElementById('orderQuantita').value = fullData.quantita || fullData.Quantita || '';
                document.getElementById('orderQuantitaProdotta').value = fullData.quantitaProdotta || fullData.QuantitaProdotta || '';
                
                // Calcola percentuale prodotta
                const quantita = parseFloat(fullData.quantita || fullData.Quantita || 0);
                const quantitaProdotta = parseFloat(fullData.quantitaProdotta || fullData.QuantitaProdotta || 0);
                let percentualeProdotta = 0;
                if (quantita > 0) {
                    percentualeProdotta = Math.round((quantitaProdotta / quantita) * 100 * 10) / 10;
                }
                document.getElementById('orderPercentualeProdotta').value = percentualeProdotta.toFixed(1) + '%';
                
                // Campi tempo (entrambi mostrati in secondi)
                const tempoCicloSecondi = fullData.tempoCiclo || fullData.TempoCiclo || 0;
                const tempoSetupMinuti = fullData.tempoSetup || fullData.TempoSetup || 0;
                const tempoSetupSecondi = tempoSetupMinuti * 60; // Converti da minuti a secondi
                
                document.getElementById('orderTempoCiclo').value = tempoCicloSecondi;
                document.getElementById('orderTempoSetup').value = tempoSetupSecondi;
                
                // Campi aggiuntivi
                document.getElementById('orderPriorita').value = fullData.priorita || fullData.Priorita || '2';
                document.getElementById('orderNote').value = fullData.note || fullData.Note || '';
                
                // Formatta le date per input datetime-local
                if (eventData.StartTime) {
                    document.getElementById('orderDataInizio').value = formatDateTimeLocal(eventData.StartTime);
                }
                if (eventData.EndTime) {
                    document.getElementById('orderDataFine').value = formatDateTimeLocal(eventData.EndTime);
                }
                if (eventData.DataFinePrevista) {
                    document.getElementById('orderDataFinePrevista').value = formatDateTimeLocal(eventData.DataFinePrevista);
                }
                
                // Carica il dropdown dei centri di lavoro e imposta il valore
                loadCentriLavoroDropdown().then(() => {
                    const centroLavoroId = fullData.idCentroLavoro || fullData.IdCentroLavoro || eventData.RoomId;
                    document.getElementById('orderCentroLavoro').value = String(centroLavoroId);
                }).catch(error => {
                    console.error('Errore nel caricamento dropdown:', error);
                });
                
                // Imposta stato
                const currentStato = fullData.idStato || fullData.IdStato || eventData.IdStato || '';
                document.getElementById('orderStato').value = currentStato;
                
                // Gestisci i campi readonly in base allo stato
                setFieldsReadonlyByStatus(currentStato);
                
                // Mostra il modal con configurazione senza backdrop
                const modalElement = document.getElementById('orderDetailsModal');
                const modal = new bootstrap.Modal(modalElement, {
                    backdrop: false,   // Nessun backdrop per evitare velatura
                    keyboard: true,    // Permetti chiusura con ESC
                    focus: true        // Focus automatico sul modal
                });
                
                // Aggiungi event listeners per la gestione del modal
                modalElement.addEventListener('shown.bs.modal', function() {
                    console.log('Modal aperto correttamente');
                    // Focus sul primo campo modificabile
                    const firstInput = modalElement.querySelector('input:not([readonly]):not([type="hidden"])');
                    if (firstInput) {
                        firstInput.focus();
                    }
                });
                
                modalElement.addEventListener('hidden.bs.modal', function() {
                    console.log('Modal chiuso');
                    // Assicurati che il body sia pulito
                    document.body.classList.remove('modal-open');
                    document.body.style.overflow = '';
                    document.body.style.paddingRight = '';
                    
                    // Rimuovi eventuali backdrop rimasti
                    const backdrops = document.querySelectorAll('.modal-backdrop');
                    backdrops.forEach(backdrop => backdrop.remove());
                });
                
                modal.show();
                
            } catch (error) {
                console.error('Errore nell\'apertura del modal:', error);
                showError('Errore nell\'apertura dei dettagli ordine');
            }
        }

        // Gestisce le azioni
        function onActionBegin(args) {
            // Previeni la creazione di nuovi eventi dal popup
            if (args.requestType === 'eventCreate') {
                args.cancel = true;
                showInfo('Per creare nuovi ordini, utilizzare la sezione Gestione Ordini');
                return;
            }
            
            // Controlla le regole di modifica basate sullo stato
            if (args.requestType === 'eventChange' && args.data) {
                const evento = args.data;
                const idStato = evento.IdStato || evento.idStato;
                
                console.log(`Tentativo modifica ordine ID: ${evento.Id}, Stato: ${idStato}`);
                
                // IdStato = 3 (Chiuso): NON modificabile
                if (idStato === 3) {
                    args.cancel = true;
                    showInfo('Gli ordini chiusi non possono essere modificati');
                    return;
                }
                
                // IdStato = 2 (In Produzione): Solo resize, NO spostamento
                if (idStato === 2) {
                    // Verifica se è un tentativo di spostamento (cambio di data/centro)
                    const originalEvent = ordiniData.find(o => (o.id || o.Id) === evento.Id);
                    if (originalEvent) {
                        const originalRoomId = originalEvent.roomId || originalEvent.RoomId;
                        const newRoomId = evento.RoomId || evento.roomId;
                        
                        // Se ha cambiato centro di lavoro, blocca
                        if (originalRoomId !== newRoomId) {
                            args.cancel = true;
                            showInfo('Gli ordini in produzione non possono essere spostati in altri centri di lavoro');
                            return;
                        }
                        
                        // Se ha cambiato la data di inizio, blocca (solo resize permesso)
                        const originalStart = new Date(originalEvent.startTime || originalEvent.StartTime);
                        const newStart = new Date(evento.StartTime || evento.startTime);
                        
                        if (originalStart.getTime() !== newStart.getTime()) {
                            args.cancel = true;
                            showInfo('Gli ordini in produzione possono solo essere allungati o accorciati, non spostati');
                            return;
                        }
                    }
                }
                
                console.log('Modifica permessa per ordine:', evento.Id);
            }
        }


        // Funzione per ottenere il nome del giorno abbreviato (inglese 3 lettere)
        function getDayNameShort(date) {
            const days = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'];
            const dayName = days[date.getDay()];

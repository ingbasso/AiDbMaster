        // Crea lo scheduler Syncfusion
        function createScheduler() {
            try {
                console.log('Creazione scheduler...');
                
                // Verifica che le librerie Syncfusion siano caricate
                if (typeof ej === 'undefined' || typeof ej.schedule === 'undefined') {

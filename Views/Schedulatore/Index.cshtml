                allowKeyboardInteraction: false, // Disabilita interazioni tastiera
                readonly: false,       // Mantieni modificabile via codice
                allowDragAndDrop: true, // Abilita drag & drop degli ordini
                allowResizing: true,    // Abilita ridimensionamento degli ordini
                showHeaderBar: true,

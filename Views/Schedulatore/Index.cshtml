                fermiCentriLavoro = [];
            }
        }

        // Calcola la sovrapposizione tra un ordine e i fermi del suo centro
        function calcolaSovrapposizioneFermo(ordine) {
            const fermiCentro = fermiCentriLavoro.filter(f => f.codiceCentro === ordine.RoomId);
            
            const sovrapposizioni = [];
            for (const fermo of fermiCentro) {
                // Verifica sovrapposizione
                if (ordine.StartTime < fermo.dataFine && ordine.EndTime > fermo.dataInizio) {
                    const inizioSovrapposizione = ordine.StartTime > fermo.dataInizio ? ordine.StartTime : fermo.dataInizio;
                    const fineSovrapposizione = ordine.EndTime < fermo.dataFine ? ordine.EndTime : fermo.dataFine;
                    
                    // Calcola la percentuale dell'evento occupata dal fermo
                    const durataOrdine = ordine.EndTime - ordine.StartTime;
                    const offsetInizio = inizioSovrapposizione - ordine.StartTime;
                    const durataSovrapposizione = fineSovrapposizione - inizioSovrapposizione;
                    
                    const percentualeInizio = (offsetInizio / durataOrdine) * 100;
                    const percentualeLarghezza = (durataSovrapposizione / durataOrdine) * 100;
                    
                    sovrapposizioni.push({
                        percentualeInizio: percentualeInizio,
                        percentualeLarghezza: percentualeLarghezza,
                        descrizione: fermo.descrizione,
                        tipoFermo: fermo.tipoFermo
                    });
                }
            }
            
            return sovrapposizioni;
        }


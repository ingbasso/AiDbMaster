@model AiDbMaster.Models.PstreeListaRimanenze

@{
    ViewData["Title"] = "Elimina Rimanenza";
    var famiglia = ViewBag.Famiglia as AiDbMaster.Models.PstreeListaFamiglie;
    var sede = ViewBag.Sede as AiDbMaster.Models.PstreeListaSedi;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-trash text-danger"></i> Elimina Rimanenza</h2>
        <a asp-action="Index" asp-controller="PstreeListaRimanenze" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="alert alert-warning" role="alert">
                <h5 class="alert-heading">
                    <i class="bi bi-exclamation-triangle"></i> Conferma Eliminazione
                </h5>
                <p class="mb-0">
                    Sei sicuro di voler eliminare questa rimanenza? L'operazione non può essere annullata.
                </p>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-box-seam"></i> Rimanenza da eliminare</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Id</span></dd>

                        <dt class="col-sm-4">Famiglia</dt>
                        <dd class="col-sm-8">
                            @if (famiglia != null)
                            {
                                <span>@famiglia.Id - @famiglia.NomeFamiglia</span>
                            }
                            else
                            {
                                <span>@Model.IdFamiglia</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Sede</dt>
                        <dd class="col-sm-8">@Model.IdSede</dd>

                        <dt class="col-sm-4">Periodo</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary">@Model.NomeMese @Model.Anno</span></dd>

                        <dt class="col-sm-4">Valore</dt>
                        <dd class="col-sm-8 fw-bold text-success">€ @Model.Valore.ToString("N2")</dd>
                    </dl>

                    <hr />

                    <form asp-action="Delete" asp-controller="PstreeListaRimanenze">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Conferma Eliminazione
                            </button>
                            <a asp-action="Index" asp-controller="PstreeListaRimanenze" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@model AiDbMaster.Models.ReferenteCantiere

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Nome <span class="text-danger">*</span></label>
        <input asp-for="Nome" class="form-control" maxlength="100" required />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label class="form-label">Telefono</label>
        <input asp-for="Telefono" class="form-control" maxlength="18" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" maxlength="100" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
</div>
<div class="row g-3 mt-1">
    <div class="col-md-8">
        <label class="form-label">Note</label>
        <input asp-for="Note" class="form-control" />
    </div>
    <div class="col-md-4">
        <div class="form-check mt-4">
            <input asp-for="Attivo" class="form-check-input" />
            <label class="form-check-label" asp-for="Attivo">Attivo</label>
        </div>
    </div>
</div>

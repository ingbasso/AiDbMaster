        // Salva fermo (crea o aggiorna)
        async function saveFermo() {
            const id = document.getElementById('fermoId').value;
            const isEdit = id !== '';
            
            const data = {
                id: isEdit ? parseInt(id) : null,
                codiceCentro: document.getElementById('codiceCentro').value,
                dataInizioFermo: document.getElementById('dataInizio').value,
                dataFineFermo: document.getElementById('dataFine').value || null,
                tipoFermo: parseInt(document.getElementById('tipoFermo').value),
                motivo: document.getElementById('motivo').value,
                note: document.getElementById('note').value,
                isPianificato: document.getElementById('isPianificato').checked,
                applicaATuttiICentri: document.getElementById('applicaATutti').checked
            };
            
            // Validazione base
            if (!data.codiceCentro && !data.applicaATuttiICentri) {
                showAlert('Seleziona un centro o spunta "Applica a tutti i centri"', 'warning');
                return;
            }
            
            try {
                const url = isEdit 
                    ? `@Url.Action("UpdateFermo", "CalendarioFermi")/${id}`
                    : '@Url.Action("CreateFermo", "CalendarioFermi")';
                
                const method = isEdit ? 'PUT' : 'POST';
                
                console.log('Invio dati:', data);
                console.log('URL:', url, 'Method:', method);
                
                const response = await fetch(url, {
                    method: method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                console.log('Response status:', response.status);
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const result = await response.json();
                console.log('Response data:', result);
                
                if (result.success) {
                    const message = result.message || 'Fermo salvato con successo';
                    
                    // Chiudi il modal prima di mostrare l'alert (per evitare warning ARIA)
                    const modalElement = document.getElementById('fermoModal');
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                    
                    // Mostra alert e ricarica dopo la chiusura del modal
                    setTimeout(() => {
                        showAlert(message, 'success');
                        loadFermi();
                    }, 200);
                } else {
                    const message = result.message || 'Errore durante il salvataggio';
                    showAlert(message, 'danger');
                }
            } catch (error) {
                console.error('Errore salvataggio:', error);
                showAlert('Errore durante il salvataggio: ' + error.message, 'danger');
            }
        }

        // Elimina fermo
        async function deleteFermo() {
            if (!confirm('Sei sicuro di voler eliminare questo fermo?')) return;
            
            const id = document.getElementById('fermoId').value;
            
            try {
                const response = await fetch(`@Url.Action("DeleteFermo", "CalendarioFermi")/${id}`, {
                    method: 'DELETE'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(result.message, 'success');
                    bootstrap.Modal.getInstance(document.getElementById('fermoModal')).hide();
                    loadFermi();
                } else {
                    showAlert(result.message, 'danger');
                }
            } catch (error) {
                console.error('Errore eliminazione:', error);
                showAlert('Errore durante l\'eliminazione', 'danger');
            }
        }

        // Popola dropdown centri di lavoro per modal weekend
        function popolaDropdownCentriWeekend() {
            const select = document.getElementById('weekendCentroLavoro');
            if (!select) return;
            
            // Reset dropdown
            select.innerHTML = '<option value="all" selected>Tutti i Centri di Lavoro</option>';
            
            // Aggiungi opzione per ogni centro
            centriLavoro.forEach(centro => {
                const option = document.createElement('option');
                option.value = centro.id;
                option.textContent = centro.name;
                select.appendChild(option);
            });
            
            console.log(`✅ Dropdown centri popolato con ${centriLavoro.length} centri`);
        }

        // Rendi il modal trascinabile
        function makeModalDraggable(modalElement, headerElement) {
            let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
            
            if (!modalElement || !headerElement) return;
            
            headerElement.onmousedown = dragMouseDown;

            function dragMouseDown(e) {
                e = e || window.event;
                e.preventDefault();
                pos3 = e.clientX;
                pos4 = e.clientY;
                document.onmouseup = closeDragElement;
                document.onmousemove = elementDrag;
                headerElement.style.cursor = 'grabbing';
            }

            function elementDrag(e) {
                e = e || window.event;
                e.preventDefault();
                pos1 = pos3 - e.clientX;
                pos2 = pos4 - e.clientY;
                pos3 = e.clientX;
                pos4 = e.clientY;
                
                const dialogElement = modalElement.querySelector('.modal-dialog');
                if (dialogElement) {
                    dialogElement.style.transform = `translate(${-pos1}px, ${-pos2}px)`;
                    dialogElement.style.margin = '0';
                    dialogElement.style.position = 'relative';
                    dialogElement.style.top = pos4 - pos2 + 'px';
                    dialogElement.style.left = pos3 - pos1 + 'px';
                }
            }

            function closeDragElement() {
                document.onmouseup = null;
                document.onmousemove = null;
                headerElement.style.cursor = 'move';
            }
        }

        // Apri modal genera weekend
        function openGeneraWeekendModal() {
            console.log('Apertura modal genera fermi settimanali...');
            try {
                // Inizializza anno corrente
                const annoCorrente = new Date().getFullYear();
                document.getElementById('weekendAnno').value = annoCorrente;
                
                // Inizializza settimane (settimana corrente e +10)
                const now = new Date();
                const onejan = new Date(now.getFullYear(), 0, 1);
                const weekNum = Math.ceil((((now - onejan) / 86400000) + onejan.getDay() + 1) / 7);
                document.getElementById('weekendDaSettimana').value = weekNum;
                document.getElementById('weekendASettimana').value = Math.min(weekNum + 10, 53);
                
                // Popola dropdown centri di lavoro
                popolaDropdownCentriWeekend();
                
                const modalElement = document.getElementById('generaWeekendModal');
                console.log('Modal element:', modalElement);
                
                // Rimuovi TUTTI i backdrop esistenti
                document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
                
                // Distruggi istanza esistente se presente
                let modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) {
                    modal.dispose();
                }
                
                // Crea nuova istanza
                modal = new bootstrap.Modal(modalElement, {
                    backdrop: 'static',
                    keyboard: true,
                    focus: true
                });
                
                modal.show();
                console.log('Modal aperto');
                
                // Rendi il modal trascinabile
                makeModalDraggable(modalElement, document.getElementById('generaWeekendModalHeader'));
                
                // Rimuovi backdrop dopo apertura (workaround)
                setTimeout(() => {
                    document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
                        backdrop.style.display = 'none';
                    });
                }, 100);
            } catch (error) {
                console.error('Errore apertura modal:', error);
            }
        }

        // Genera fermi settimanali automaticamente
        async function generaFermiSettimanali() {
            const anno = parseInt(document.getElementById('weekendAnno').value);
            const daSettimana = parseInt(document.getElementById('weekendDaSettimana').value);
            const aSettimana = parseInt(document.getElementById('weekendASettimana').value);
            const motivo = document.getElementById('weekendMotivo').value;
            const centroLavoro = document.getElementById('weekendCentroLavoro').value;
            const applicaATutti = centroLavoro === 'all';
            const codiceCentro = applicaATutti ? null : parseInt(centroLavoro);
            
            // Validazioni
            if (!anno || !daSettimana || !aSettimana) {
                showAlert('Compila tutti i campi obbligatori', 'warning');
                return;
            }
            
            if (aSettimana < daSettimana) {
                showAlert('"A Settimana" non può essere minore di "Da Settimana"', 'warning');
                return;
            }
            
            if (daSettimana < 1 || daSettimana > 53 || aSettimana < 1 || aSettimana > 53) {
                showAlert('Le settimane devono essere comprese tra 1 e 53', 'warning');
                return;
            }
            
            // Calcola numero totale fermi
            const numeroSettimane = aSettimana - daSettimana + 1;
            const fermiPerSettimana = 5; // 4 notturni + 1 weekend
            
            let totaleFermi;
            let centroNome = 'tutti i centri';
            
            if (applicaATutti) {
                totaleFermi = numeroSettimane * fermiPerSettimana * centriLavoro.length;
            } else {
                totaleFermi = numeroSettimane * fermiPerSettimana;
                const centro = centriLavoro.find(c => c.id == codiceCentro);
                centroNome = centro ? centro.name : 'centro selezionato';
            }
            
            // Messaggio di conferma
            const conferma = confirm(`Stai per generare ${totaleFermi} fermi per ${centroNome}.\nPeriodo: ${numeroSettimane} settimane (${fermiPerSettimana} fermi per settimana).\n\nConfermi?`);
            if (!conferma) {
                return;
            }
            
            const data = {
                anno: anno,
                daSettimana: daSettimana,
                aSettimana: aSettimana,
                motivo: motivo,
                applicaATutti: applicaATutti,
                codiceCentro: codiceCentro
            };
            
            try {
                showAlert('Generazione fermi in corso...', 'info');
                
                const response = await fetch('@Url.Action("GeneraFermiSettimanali", "CalendarioFermi")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showAlert(`✅ ${result.message}`, 'success');
                    
                    // Chiudi modal
                    const modalElement = document.getElementById('generaWeekendModal');
                    const modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                    
                    // Ricarica calendario
                    console.log('Ricarico calendario dopo generazione fermi...');
                    await loadFermi();
                } else {
                    showAlert(result.message, 'danger');
                }
            } catch (error) {
                console.error('Errore generazione fermi:', error);
                showAlert('Errore durante la generazione dei fermi', 'danger');
            }
        }

        // Formatta data per input datetime-local
        function formatDateTimeLocal(date) {
            if (!date) return '';
            const d = new Date(date);
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            const hours = String(d.getHours()).padStart(2, '0');
            const minutes = String(d.getMinutes()).padStart(2, '0');
            return `${year}-${month}-${day}T${hours}:${minutes}`;
        }

        // Mostra alert
        function showAlert(message, type = 'info') {
            // Gestisci casi in cui message è undefined o null
            if (!message || message === 'undefined') {
                message = 'Operazione completata';
                console.warn('showAlert chiamato con messaggio undefined');
            }
            
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            `;
            document.getElementById('alertContainer').innerHTML = alertHtml;
            
            // Auto-dismiss dopo 5 secondi
            setTimeout(() => {
                const alert = document.querySelector('#alertContainer .alert');
                if (alert) {
                    bootstrap.Alert.getOrCreateInstance(alert).close();
                }
            }, 5000);
        }
    </script>
}

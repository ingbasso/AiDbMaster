        // Forza gli stili dei nomi dei centri di lavoro con JavaScript diretto
        function forzaStiliCentriLavoro() {
            console.log('🎨 Forzatura stili nomi centri di lavoro...');
            
            // Trova tutte le celle delle risorse (nomi centri)
            const celleRisorse = document.querySelectorAll(
                '.e-schedule .e-resource-cells, ' +
                '.e-schedule .e-left-indent-wrap td, ' +
                '.e-schedule .e-resource-left-td'
            );
            
            console.log(`   Trovate ${celleRisorse.length} celle risorsa`);
            
            celleRisorse.forEach(cella => {
                // Applica stili inline (hanno la precedenza su tutto)
                cella.style.fontSize = '1.1rem';
                cella.style.fontWeight = '700';
                cella.style.color = '#2c3e50';
                cella.style.lineHeight = '1.4';
                
                // Applica anche a tutti i figli
                const figli = cella.querySelectorAll('*');
                figli.forEach(figlio => {
                    figlio.style.fontSize = '1.1rem';
                    figlio.style.fontWeight = '700';
                    figlio.style.color = '#2c3e50';
                });
            });
            
            console.log('✅ Stili forzati applicati');
        }
        
        // Carica centri di lavoro
        async function loadCentriLavoro() {
            try {
                console.log('Caricamento centri di lavoro...');
                const response = await fetch('@Url.Action("GetCentriLavoro", "CalendarioFermi")');
                
                console.log('Response status:', response.status);
                console.log('Response headers:', response.headers.get('content-type'));
                
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}: ${response.statusText}`);
                }
                
                const data = await response.json();
                console.log('Dati ricevuti:', data);
                
                if (data.error) {
                    throw new Error(`Errore server: ${data.message}`);
                }
                
                // Verifica se data è un array
                if (!Array.isArray(data)) {
                    console.error('I dati ricevuti non sono un array:', data);
                    throw new Error('Formato dati non valido');
                }
                
                centriLavoro = data;
                console.log(`✅ Caricati ${centriLavoro.length} centri di lavoro:`, 
                    centriLavoro.map(c => `${c.id} - ${c.name}`).join(', '));
                
                if (centriLavoro.length === 0) {
                    console.warn('⚠️ NESSUN CENTRO DI LAVORO ATTIVO TROVATO!');
                    showAlert(
                        '<strong>Attenzione!</strong> Non ci sono centri di lavoro attivi nel database. ' +
                        'Vai su <a href="/CentriLavoro" class="alert-link">Gestione Centri di Lavoro</a> per attivarne almeno uno.',
                        'warning'
                    );
                }
            } catch (error) {
                console.error('Errore nel caricamento dei centri di lavoro:', error);
                showAlert(
                    '<strong>Errore!</strong> ' + error.message + 
                    '<br>Controlla la console del browser (F12) per dettagli.',
                    'danger'
                );
                centriLavoro = []; // Assicurati che sia un array vuoto
            }
        }

        // Carica fermi dal server
        async function loadFermi() {
            console.log('📅 Caricamento fermi...');
            try {
                const response = await fetch('@Url.Action("GetFermi", "CalendarioFermi")');
                const fermiFetch = await response.json();
                
                if (fermiFetch.length > 0) {
                    // DEBUG: mostra struttura primo fermo
                    console.log('📋 Primo fermo ricevuto dal server:', fermiFetch[0]);
                    console.log('   Chiavi disponibili:', Object.keys(fermiFetch[0]));
                    console.log('   ⏰ StartTime:', fermiFetch[0].startTime);
                    console.log('   ⏰ EndTime:', fermiFetch[0].endTime);
                    
                    // usa camelCase per leggere codiceCentro
                    const centriConFermi = [...new Set(fermiFetch.map(f => f.codiceCentro))].filter(Boolean);
                    console.log(`✅ Caricati ${fermiFetch.length} fermi per i centri:`, centriConFermi.join(', '));
                } else {
                    console.log('ℹ️ Nessun fermo nel database (situazione pulita)');
                    console.log(`   Centri disponibili: ${centriLavoro.map(c => c.id).join(', ')}`);
                }
                
                // Mappa gli eventi includendo RoomId per la visualizzazione timeline
                // IMPORTANTE: ASP.NET Core serializza in camelCase, quindi usiamo lowercase
                const eventi = fermiFetch.map(fermo => ({
                    Id: fermo.id,
                    Subject: fermo.subject,
                    StartTime: new Date(fermo.startTime),
                    EndTime: new Date(fermo.endTime),
                    Description: fermo.description,
                    CategoryColor: fermo.categoryColor,
                    RoomId: fermo.codiceCentro, // IMPORTANTE: mappa codiceCentro a RoomId per le risorse
                    CodiceCentro: fermo.codiceCentro,
                    DescrizioneCentro: fermo.descrizioneCentro,
                    TipoFermo: fermo.tipoFermo,
                    IsPianificato: fermo.isPianificato,
                    StatoFermo: fermo.statoFermo
                }));
                
                if (scheduleObj) {
                    // Aggiorna data source dello scheduler
                    scheduleObj.eventSettings.dataSource = eventi;
                    
                    // FORZA IL REFRESH DELLO SCHEDULER
                    scheduleObj.refreshEvents();
                    console.log(`✅ Scheduler aggiornato con ${eventi.length} fermi`);
                } else {
                    console.error('scheduleObj non disponibile');
                }
                
            } catch (error) {
                console.error('Errore caricamento fermi:', error);
                showAlert('Errore durante il caricamento dei fermi', 'danger');
            }
        }

        // Personalizza il rendering degli eventi
        function onEventRendered(args) {
            const eventData = args.data;
            
            // Forza sempre il colore rosso FRIMA per tutti gli eventi
            const coloreRossoFRIMA = '#e74c3c';
            const coloreBordo = '#c0392b';
            
            console.log(`🎨 Rendering evento: ${eventData.Subject} - Colore: ${coloreRossoFRIMA}`);
            
            // Usa setProperty con 'important' per forzare i colori
            args.element.style.setProperty('background-color', coloreRossoFRIMA, 'important');
            args.element.style.setProperty('border-color', coloreBordo, 'important');
            args.element.style.setProperty('color', 'white', 'important');
            
            // Ottieni il tipo fermo e l'icona
            const tipoFermo = eventData.TipoFermo;
            let icon = '';
            let tipoFermoLabel = '';
            
            if (tipoFermo === 'WeekEnd') {
                icon = '<i class="bi bi-calendar-x me-1"></i>';
                tipoFermoLabel = 'WeekEnd';
            } else if (tipoFermo === 'Festivo') {
                icon = '<i class="bi bi-calendar-event me-1"></i>';
                tipoFermoLabel = 'Festivo';
            } else if (tipoFermo === 'TurnoNotturno') {
                icon = '<i class="bi bi-moon-fill me-1"></i>';
                tipoFermoLabel = 'Turno Notturno';
            }
            
            // Formatta giorno abbreviato e orari
            const startTime = new Date(eventData.StartTime);
            const endTime = new Date(eventData.EndTime);
            
            const giornoInizio = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'][startTime.getDay()];
            const giornoFine = ['Dom', 'Lun', 'Mar', 'Mer', 'Gio', 'Ven', 'Sab'][endTime.getDay()];
            const oraInizio = startTime.getHours().toString().padStart(2, '0') + ':' + startTime.getMinutes().toString().padStart(2, '0');
            const oraFine = endTime.getHours().toString().padStart(2, '0') + ':' + endTime.getMinutes().toString().padStart(2, '0');
            
            // Crea template con due righe
            const nuovoContenuto = `
                <div style="line-height: 1.2;">
                    <div style="font-weight: bold; font-size: 0.9em;">
                        ${icon}${tipoFermoLabel}
                    </div>
                    <div style="font-size: 0.75em; margin-top: 2px; opacity: 0.9;">
                        ${giornoInizio}. ${oraInizio} - ${giornoFine}. ${oraFine}
                    </div>
                </div>
            `;
            
            // Sostituisci il contenuto dell'evento
            const subjectElement = args.element.querySelector('.e-subject');
            if (subjectElement) {
                subjectElement.innerHTML = nuovoContenuto;
            }
            
            // Verifica colore applicato
            console.log(`   ✅ Colore applicato: bg=${args.element.style.backgroundColor}, border=${args.element.style.borderColor}`);
        }


        // Drag & Drop terminato
        async function onDragStop(args) {
            const evento = args.data;
            
            try {
                // RoomId contiene il nuovo centro di lavoro dopo il drag
                const nuovoCentro = evento.RoomId || evento.CodiceCentro;
                
                console.log('🔄 Drag completato - Evento:', evento.Id, 'Nuovo Centro:', nuovoCentro);
                console.log('   Data Inizio:', new Date(evento.StartTime).toLocaleString('it-IT'));
                console.log('   Data Fine:', new Date(evento.EndTime).toLocaleString('it-IT'));
                
                const response = await fetch(`@Url.Action("UpdateFermo", "CalendarioFermi")/${evento.Id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        id: evento.Id,
                        codiceCentro: nuovoCentro, // Usa il nuovo centro dopo il drag
                        dataInizioFermo: evento.StartTime,
                        dataFineFermo: evento.EndTime,
                        tipoFermo: evento.TipoFermo === 'WeekEnd' ? 0 : 1,
                        motivo: evento.Subject.split(':')[1]?.trim() || evento.Subject,
                        note: evento.Description,
                        isPianificato: evento.IsPianificato
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    // Ricarica i fermi per aggiornare la visualizzazione (senza banner)
                    setTimeout(() => loadFermi(), 300);
                } else {
                    // Mostra errore solo se fallisce
                    showAlert('❌ ' + (result.message || 'Errore nello spostamento'), 'danger');
                    loadFermi(); // Ricarica per annullare le modifiche
                }
            } catch (error) {
                console.error('Errore aggiornamento fermo:', error);
                showAlert('❌ Errore durante lo spostamento: ' + error.message, 'danger');
                loadFermi();
            }
        }


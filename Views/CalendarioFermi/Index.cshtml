        // Apri modal creazione
        function openCreateModal(startDate = null, centroId = null) {
            currentEventId = null;
            document.getElementById('fermoModalTitle').textContent = 'Nuovo Fermo';
            document.getElementById('fermoForm').reset();
            document.getElementById('fermoId').value = '';
            document.getElementById('btnDeleteFermo').style.display = 'none';
            
            if (startDate) {
                const dataStr = formatDateTimeLocal(startDate);
                document.getElementById('dataInizio').value = dataStr;
            }
            
            // Preimposta il centro di lavoro se fornito
            if (centroId) {
                document.getElementById('codiceCentro').value = centroId;
            }
            
            // Rimuovi TUTTI i backdrop esistenti
            document.querySelectorAll('.modal-backdrop').forEach(backdrop => backdrop.remove());
            
            const modalElement = document.getElementById('fermoModal');
            
            // Distruggi istanza esistente se presente
            let modal = bootstrap.Modal.getInstance(modalElement);
            if (modal) {
                modal.dispose();
            }
            
            // Crea nuova istanza SENZA backdrop
            modal = new bootstrap.Modal(modalElement, {
                backdrop: 'static',
                keyboard: true,
                focus: true
            });
            
            modal.show();
            
            // Rimuovi backdrop dopo apertura
            setTimeout(() => {
                document.querySelectorAll('.modal-backdrop').forEach(backdrop => {
                    backdrop.style.display = 'none';
                });
            }, 100);
        }


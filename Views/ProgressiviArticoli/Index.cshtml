@model IEnumerable<AiDbMaster.Models.ProgressiviArticoli>

@{
    ViewData["Title"] = "Progressivi Articoli";
    ViewBag.UseFluidContainer = true;
    var codiceArticolo = ViewBag.CurrentCodiceArticolo as string ?? "";
    var descrizioneArticolo = ViewBag.CurrentDescrizioneArticolo as string ?? "";
    var codiceMagazzino = ViewBag.CurrentCodiceMagazzino as short?;
    var sortOrder = ViewBag.CurrentSort as string ?? "articolo";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var pageSize = ViewBag.PageSize as int? ?? 50;
    var codiciMagazzino = ViewBag.CodiciMagazzino as List<short> ?? new List<short>();
}

<!-- Include Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="container-fluid">


    <div class="content-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="bi bi-boxes me-2 text-primary"></i>Progressivi Articoli</h2>
            <button type="button" class="btn btn-outline-secondary" onclick="resetFilters()">
                <i class="bi bi-arrow-clockwise"></i> Reset Filtri
            </button>
        </div>

        <!-- Filtri -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>Filtri di Ricerca</h5>
            </div>
            <div class="card-body">
                <form method="get" asp-action="Index" id="filterForm">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label for="codiceArticolo" class="form-label fw-bold">
                                <i class="bi bi-box-seam me-1"></i>Articolo
                            </label>
                            <select class="form-select" id="codiceArticolo" name="codiceArticolo">
                                <option value="">-- Cerca per codice o descrizione --</option>
                                @if (!string.IsNullOrEmpty(codiceArticolo))
                                {
                                    <option value="@codiceArticolo" selected>@codiceArticolo @(!string.IsNullOrEmpty(descrizioneArticolo) ? " - " + descrizioneArticolo : "")</option>
                                }
                            </select>
                            <small class="text-muted">Digita almeno 2 caratteri per cercare</small>
                        </div>
                        <div class="col-md-2">
                            <label for="codiceMagazzino" class="form-label fw-bold">
                                <i class="bi bi-building me-1"></i>Magazzino
                            </label>
                            <select class="form-select" id="codiceMagazzino" name="codiceMagazzino">
                                <option value="">Tutti</option>
                                @foreach (var codice in codiciMagazzino)
                                {
                                    <option value="@codice" selected="@(codiceMagazzino == codice)">@codice</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="pageSize" class="form-label fw-bold">
                                <i class="bi bi-list-ol me-1"></i>Per pagina
                            </label>
                            <select class="form-select" id="pageSize" name="pageSize">
                                <option value="25" selected="@(pageSize == 25)">25</option>
                                <option value="50" selected="@(pageSize == 50)">50</option>
                                <option value="100" selected="@(pageSize == 100)">100</option>
                                <option value="200" selected="@(pageSize == 200)">200</option>
                            </select>
                        </div>
                        <div class="col-md-auto">
                            <label class="form-label">&nbsp;</label>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-search"></i> Cerca
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="resetFilters()">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" name="sortOrder" value="@sortOrder">
                    <input type="hidden" name="page" value="1">
                </form>
            </div>
        </div>

        <!-- Tabella Progressivi Articoli -->
        <div class="card">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Elenco Progressivi Articoli</h5>
                    <small class="text-muted">
                        Visualizzati @(Model?.Count() ?? 0) di @totalCount progressivi
                    </small>
                </div>
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0" id="progressiviArticoliTable">
                            <thead class="table-dark sticky-top">
                                <tr>
                                    <th>
                                        <a asp-action="Index" 
                                           asp-route-codiceArticolo="@codiceArticolo"
                                           asp-route-codiceMagazzino="@codiceMagazzino"
                                           asp-route-pageSize="@pageSize"
                                           asp-route-sortOrder="@(sortOrder == "articolo" ? "articolo_desc" : "articolo")"
                                           class="text-white text-decoration-none">
                                            Articolo
                                            @if (sortOrder == "articolo")
                                            {
                                                <i class="bi bi-arrow-up"></i>
                                            }
                                            else if (sortOrder == "articolo_desc")
                                            {
                                                <i class="bi bi-arrow-down"></i>
                                            }
                                        </a>
                                    </th>
                                    <th>
                                        <a asp-action="Index" 
                                           asp-route-codiceArticolo="@codiceArticolo"
                                           asp-route-codiceMagazzino="@codiceMagazzino"
                                           asp-route-pageSize="@pageSize"
                                           asp-route-sortOrder="@(sortOrder == "magazzino" ? "magazzino_desc" : "magazzino")"
                                           class="text-white text-decoration-none">
                                            Mag.
                                            @if (sortOrder == "magazzino")
                                            {
                                                <i class="bi bi-arrow-up"></i>
                                            }
                                            else if (sortOrder == "magazzino_desc")
                                            {
                                                <i class="bi bi-arrow-down"></i>
                                            }
                                        </a>
                                    </th>
                                    <th>
                                        <a asp-action="Index" 
                                           asp-route-codiceArticolo="@codiceArticolo"
                                           asp-route-codiceMagazzino="@codiceMagazzino"
                                           asp-route-pageSize="@pageSize"
                                           asp-route-sortOrder="@(sortOrder == "esistenza" ? "esistenza_desc" : "esistenza")"
                                           class="text-white text-decoration-none">
                                            Esistenza
                                            @if (sortOrder == "esistenza")
                                            {
                                                <i class="bi bi-arrow-up"></i>
                                            }
                                            else if (sortOrder == "esistenza_desc")
                                            {
                                                <i class="bi bi-arrow-down"></i>
                                            }
                                        </a>
                                    </th>
                                    <th>Stato</th>
                                    <th>Azioni</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr class="progressivo-articolo-row">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-box me-2 text-primary"></i>
                                                <strong>@Html.DisplayFor(modelItem => item.CodiceArticolo)</strong>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-info text-white">@Html.DisplayFor(modelItem => item.CodiceMagazzino)</span>
                                        </td>
                                        <td>
                                            <strong class="text-primary">@item.Esistenza.ToString("N2")</strong>
                                        </td>
                                        <td>
                                            <span class="@item.StatoGiacenzaCssClass">@item.StatoGiacenza</span>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-action="Details" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-outline-info" title="Visualizza Dettagli">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                                        onclick="copyToClipboard('@item.DescrizioneCompleta')" 
                                                        title="Copia Descrizione">
                                                    <i class="bi bi-clipboard"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Paginazione -->
                    @if (totalPages > 1)
                    {
                        <div class="card-footer">
                            <nav aria-label="Navigazione pagine">
                                <ul class="pagination justify-content-center mb-0">
                                    @if (currentPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" 
                                               asp-route-codiceArticolo="@codiceArticolo"
                                               asp-route-codiceMagazzino="@codiceMagazzino"
                                               asp-route-pageSize="@pageSize"
                                               asp-route-sortOrder="@sortOrder"
                                               asp-route-page="1">
                                                <i class="bi bi-chevron-double-left"></i>
                                            </a>
                                        </li>
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" 
                                               asp-route-codiceArticolo="@codiceArticolo"
                                               asp-route-codiceMagazzino="@codiceMagazzino"
                                               asp-route-pageSize="@pageSize"
                                               asp-route-sortOrder="@sortOrder"
                                               asp-route-page="@(currentPage - 1)">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                    }

                                    @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link" asp-action="Index" 
                                               asp-route-codiceArticolo="@codiceArticolo"
                                               asp-route-codiceMagazzino="@codiceMagazzino"
                                               asp-route-pageSize="@pageSize"
                                               asp-route-sortOrder="@sortOrder"
                                               asp-route-page="@i">@i</a>
                                        </li>
                                    }

                                    @if (currentPage < totalPages)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" 
                                               asp-route-codiceArticolo="@codiceArticolo"
                                               asp-route-codiceMagazzino="@codiceMagazzino"
                                               asp-route-pageSize="@pageSize"
                                               asp-route-sortOrder="@sortOrder"
                                               asp-route-page="@(currentPage + 1)">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Index" 
                                               asp-route-codiceArticolo="@codiceArticolo"
                                               asp-route-codiceMagazzino="@codiceMagazzino"
                                               asp-route-pageSize="@pageSize"
                                               asp-route-sortOrder="@sortOrder"
                                               asp-route-page="@totalPages">
                                                <i class="bi bi-chevron-double-right"></i>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    }
                }
                else
                {
                    <div class="p-5 text-center">
                        <i class="bi bi-inbox text-primary" style="font-size: 4rem;"></i>
                        <h4 class="mt-3">Nessun progressivo articolo trovato</h4>
                        @if (!string.IsNullOrEmpty(codiceArticolo) || codiceMagazzino.HasValue)
                        {
                            <p class="text-muted">Prova a modificare i filtri di ricerca per visualizzare più risultati.</p>
                            <button type="button" class="btn btn-outline-primary mt-3" onclick="resetFilters()">
                                <i class="bi bi-arrow-clockwise"></i> Reset Filtri
                            </button>
                        }
                        else
                        {
                            <p class="text-muted">Non ci sono progressivi articoli configurati.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Include Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Inizializza Select2 con AJAX per la ricerca articoli
            $('#codiceArticolo').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Cerca per codice o descrizione --',
                allowClear: true,
                minimumInputLength: 2,
                width: '100%',
                ajax: {
                    url: '@Url.Action("SearchArticoli", "InterrogazioniDB")',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) {
                        return {
                            term: params.term,
                            page: params.page || 1
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data
                        };
                    },
                    cache: true
                },
                language: {
                    noResults: function() {
                        return "Nessun articolo trovato";
                    },
                    searching: function() {
                        return "Ricerca in corso...";
                    },
                    inputTooShort: function() {
                        return "Inserisci almeno 2 caratteri";
                    }
                }
            });

            // Auto-submit quando cambia il magazzino o elementi per pagina
            $('#codiceMagazzino, #pageSize').change(function() {
                $('#filterForm').submit();
            });

            // Submit quando si seleziona un articolo da Select2
            $('#codiceArticolo').on('select2:select', function(e) {
                $('#filterForm').submit();
            });

            // Submit quando si pulisce il campo articolo
            $('#codiceArticolo').on('select2:clear', function(e) {
                $('#filterForm').submit();
            });
        });

        // Reset dei filtri
        function resetFilters() {
            window.location.href = '@Url.Action("Index", "ProgressiviArticoli")';
        }

        // Copia negli appunti
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                showToast('Descrizione copiata negli appunti: ' + text, 'success');
            }).catch(function(err) {
                console.error('Errore nella copia: ', err);
                showToast('Errore nella copia della descrizione', 'error');
            });
        }

        // Funzione per mostrare toast
        function showToast(message, type) {
            const toastContainer = document.getElementById('toast-container') || createToastContainer();
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : type === 'info' ? 'info' : 'danger'} border-0`;
            toast.setAttribute('role', 'alert');
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            toastContainer.appendChild(toast);
            const bsToast = new bootstrap.Toast(toast);
            bsToast.show();
            
            toast.addEventListener('hidden.bs.toast', function() {
                toast.remove();
            });
        }

        // Crea il container per i toast se non esiste
        function createToastContainer() {
            const container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            container.style.zIndex = '1055';
            document.body.appendChild(container);
            return container;
        }

    </script>
}

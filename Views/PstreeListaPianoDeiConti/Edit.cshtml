@model AiDbMaster.Models.PstreeListaPianoDeiConti

@{
    ViewData["Title"] = "Modifica Conto";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-pencil text-warning"></i> Modifica Conto</h2>
        <a asp-controller="PstreeListaPianoDeiConti" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-book"></i> Modifica: @Model.CodicePdC</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="PstreeListaPianoDeiConti" asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="CodicePdC" class="form-label">
                                    <i class="bi bi-hash"></i> Codice
                                </label>
                                <input asp-for="CodicePdC" class="form-control" readonly />
                                <small class="text-muted">Il codice non può essere modificato</small>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="DescrizionePdC" class="form-label">
                                    <i class="bi bi-file-text"></i> Descrizione <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DescrizionePdC" class="form-control" placeholder="Descrizione del conto" />
                                <span asp-validation-for="DescrizionePdC" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="TipoPdC" class="form-label">
                                    <i class="bi bi-tags"></i> Tipo Conto <span class="text-danger">*</span>
                                </label>
                                <select asp-for="TipoPdC" class="form-select">
                                    <option value="">-- Seleziona --</option>
                                    <option value="P">P - Patrimoniale</option>
                                    <option value="E">E - Economico</option>
                                </select>
                                <span asp-validation-for="TipoPdC" class="text-danger"></span>
                                <small class="text-muted">P = Stato Patrimoniale, E = Conto Economico</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">&nbsp;</label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="NonAssociare" class="form-check-input" type="checkbox" />
                                    <label asp-for="NonAssociare" class="form-check-label">
                                        <i class="bi bi-slash-circle text-warning"></i> Non Associare
                                    </label>
                                </div>
                                <small class="text-muted">Se attivo, questo conto non sarà usato nelle associazioni CE</small>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-floppy"></i> Salva Modifiche
                            </button>
                            <a asp-controller="PstreeListaPianoDeiConti" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Informazioni</h6>
                </div>
                <div class="card-body">
                    <dl>
                        <dt>Codice</dt>
                        <dd><code class="fs-5">@Model.CodicePdC</code></dd>
                        
                        <dt>Tipo Attuale</dt>
                        <dd>
                            @if (Model.TipoPdC == "P")
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-calculator"></i> Patrimoniale
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-graph-up"></i> Economico
                                </span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-gear"></i> Azioni</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-controller="PstreeListaPianoDeiConti" asp-action="Details" asp-route-id="@Model.CodicePdC" class="btn btn-outline-info">
                            <i class="bi bi-eye"></i> Visualizza Dettagli
                        </a>
                        <a asp-controller="PstreeListaPianoDeiConti" asp-action="Delete" asp-route-id="@Model.CodicePdC" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> Elimina
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

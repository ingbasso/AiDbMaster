@model AiDbMaster.Models.PstreeListaPianoDeiConti

@{
    ViewData["Title"] = "Nuovo Conto";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-plus-circle text-success"></i> Nuovo Conto</h2>
        <a asp-controller="PstreeListaPianoDeiConti" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Torna all'elenco
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-book"></i> Dati Conto</h5>
                </div>
                <div class="card-body">
                    <form asp-controller="PstreeListaPianoDeiConti" asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="CodicePdC" class="form-label">
                                    <i class="bi bi-hash"></i> Codice <span class="text-danger">*</span>
                                </label>
                                <input asp-for="CodicePdC" class="form-control" placeholder="Es: 101001" />
                                <span asp-validation-for="CodicePdC" class="text-danger"></span>
                                <small class="text-muted">Codice univoco del conto (max 20 caratteri)</small>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="DescrizionePdC" class="form-label">
                                    <i class="bi bi-file-text"></i> Descrizione <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DescrizionePdC" class="form-control" placeholder="Descrizione del conto" />
                                <span asp-validation-for="DescrizionePdC" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="TipoPdC" class="form-label">
                                    <i class="bi bi-tags"></i> Tipo Conto <span class="text-danger">*</span>
                                </label>
                                <select asp-for="TipoPdC" class="form-select">
                                    <option value="">-- Seleziona --</option>
                                    <option value="P">P - Patrimoniale</option>
                                    <option value="E">E - Economico</option>
                                </select>
                                <span asp-validation-for="TipoPdC" class="text-danger"></span>
                                <small class="text-muted">P = Stato Patrimoniale, E = Conto Economico</small>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">&nbsp;</label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="NonAssociare" class="form-check-input" type="checkbox" />
                                    <label asp-for="NonAssociare" class="form-check-label">
                                        <i class="bi bi-slash-circle text-warning"></i> Non Associare
                                    </label>
                                </div>
                                <small class="text-muted">Se attivo, questo conto non sarà usato nelle associazioni CE</small>
                            </div>
                        </div>

                        <hr />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-floppy"></i> Salva
                            </button>
                            <a asp-controller="PstreeListaPianoDeiConti" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x"></i> Annulla
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Guida</h6>
                </div>
                <div class="card-body">
                    <h6><i class="bi bi-calculator text-info"></i> Tipo Patrimoniale (P)</h6>
                    <p class="small text-muted">
                        Conti che confluiscono nello Stato Patrimoniale: attività, passività, patrimonio netto.
                    </p>
                    
                    <h6><i class="bi bi-graph-up text-success"></i> Tipo Economico (E)</h6>
                    <p class="small text-muted mb-0">
                        Conti che confluiscono nel Conto Economico: ricavi, costi, proventi, oneri.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

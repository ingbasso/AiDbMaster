@model IEnumerable<AiDbMaster.Models.PstreeListaPianoDeiConti>

@{
    ViewData["Title"] = "Piano dei Conti";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-book text-primary"></i> Piano dei Conti</h2>
        <a asp-controller="PstreeListaPianoDeiConti" asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Nuovo Conto
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Chiudi"></button>
        </div>
    }

    <!-- CARDS STATISTICHE -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0">@ViewBag.TotaleConti</h3>
                    <small>Totale Conti</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0">@ViewBag.ContiPatrimoniali</h3>
                    <small><i class="bi bi-calculator"></i> Patrimoniali (P)</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h3 class="mb-0">@ViewBag.ContiEconomici</h3>
                    <small><i class="bi bi-graph-up"></i> Economici (E)</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h3 class="mb-0">@ViewBag.ContiNonAssociare</h3>
                    <small><i class="bi bi-slash-circle"></i> Non Associare</small>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTRI -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0"><i class="bi bi-funnel"></i> Filtri</h6>
        </div>
        <div class="card-body">
            <form method="get" asp-controller="PstreeListaPianoDeiConti" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="tipoPdC" class="form-label">Tipo Conto</label>
                        <select id="tipoPdC" name="tipoPdC" class="form-select">
                            @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.TipiPdC)
                            {
                                <option value="@item.Value" selected="@(item.Value == ViewBag.CurrentTipo)">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="nonAssociare" class="form-label">Non Associare</label>
                        <select id="nonAssociare" name="nonAssociare" class="form-select">
                            <option value="">-- Tutti --</option>
                            <option value="true" selected="@(ViewBag.CurrentNonAssociare == true)">Sì - Da non associare</option>
                            <option value="false" selected="@(ViewBag.CurrentNonAssociare == false)">No - Associabili</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="searchTerm" class="form-label">Cerca (codice o descrizione)</label>
                        <input type="text" id="searchTerm" name="searchTerm" class="form-control" 
                               value="@ViewBag.CurrentSearch" placeholder="Cerca...">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> Filtra
                        </button>
                        <a asp-controller="PstreeListaPianoDeiConti" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- TABELLA -->
    <div class="card shadow-sm">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-table"></i> Elenco Conti
                <span class="badge bg-secondary ms-2">@Model.Count() record</span>
            </span>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead style="background-color: #5b9bd5 !important;">
                            <tr>
                                <th style="border: none; background-color: #5b9bd5 !important; color: white !important;">Codice</th>
                                <th style="border: none; background-color: #5b9bd5 !important; color: white !important;">Descrizione</th>
                                <th style="width: 120px; border: none; background-color: #5b9bd5 !important; color: white !important;" class="text-center">Tipo</th>
                                <th style="width: 120px; border: none; background-color: #5b9bd5 !important; color: white !important;" class="text-center">Non Associare</th>
                                <th style="width: 140px; border: none; background-color: #5b9bd5 !important; color: white !important;" class="text-center">Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><code class="fw-bold">@item.CodicePdC</code></td>
                                    <td>@item.DescrizionePdC</td>
                                    <td class="text-center">
                                        @if (item.TipoPdC == "P")
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-calculator"></i> Patrimoniale
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-graph-up"></i> Economico
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (item.NonAssociare)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-slash-circle"></i> Sì
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-controller="PstreeListaPianoDeiConti" asp-action="Details" asp-route-id="@item.CodicePdC" 
                                               class="btn btn-outline-info" title="Dettagli">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="PstreeListaPianoDeiConti" asp-action="Edit" asp-route-id="@item.CodicePdC" 
                                               class="btn btn-outline-warning" title="Modifica">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-controller="PstreeListaPianoDeiConti" asp-action="Delete" asp-route-id="@item.CodicePdC" 
                                               class="btn btn-outline-danger" title="Elimina">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-book fs-1 text-muted mb-3"></i>
                    <h5 class="text-muted">Nessun conto trovato</h5>
                    <p class="text-muted">
                        @if (ViewBag.CurrentTipo != null || ViewBag.CurrentSearch != null)
                        {
                            <text>Prova a modificare i filtri di ricerca.</text>
                        }
                        else
                        {
                            <text>Aggiungi il primo conto del Piano dei Conti.</text>
                        }
                    </p>
                    <a asp-controller="PstreeListaPianoDeiConti" asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-lg"></i> Nuovo Conto
                    </a>
                </div>
            }
        </div>
    </div>
</div>

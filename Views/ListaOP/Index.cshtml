@model IEnumerable<AiDbMaster.Models.ListaOP>

@{
    ViewData["Title"] = "Gestione Ordini di Produzione";
    ViewBag.UseFluidContainer = true;
}

<div class="container-fluid">
    <!-- Header con titolo e pulsanti -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2><i class="bi bi-gear-fill text-primary"></i> @ViewData["Title"]</h2>
            <p class="text-muted">Gestisci tutti gli ordini di produzione dell'azienda</p>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Dashboard" class="btn btn-info">
                <i class="bi bi-graph-up"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Filtri -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-funnel"></i> Filtri
                <button class="btn btn-sm btn-outline-secondary float-end" type="button" data-bs-toggle="collapse" data-bs-target="#filtriCollapse">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </h5>
        </div>
        <div class="collapse show" id="filtriCollapse">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Stato</label>
                        <select name="filtroStato" class="form-select">
                            <option value="">Tutti gli stati</option>
                            @if (ViewBag.Stati != null)
                            {
                                @foreach (var stato in ViewBag.Stati)
                                {
                                    <option value="@stato.CodiceStato" selected="@(ViewBag.FiltroStato == stato.CodiceStato)">
                                        @stato.DescrizioneStato
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Centro Lavoro</label>
                        <select name="filtroCentro" class="form-select">
                            <option value="">Tutti i centri</option>
                            @if (ViewBag.CentriLavoro != null)
                            {
                                @foreach (var centro in ViewBag.CentriLavoro)
                                {
                                    <option value="@centro.CodiceCentro" selected="@(ViewBag.FiltroCentro == centro.CodiceCentro)">
                                        @centro.DescrizioneCentro
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Articolo</label>
                        <select name="filtroArticolo" id="filtroArticolo" class="form-select">
                            <option value="">Tutti gli articoli</option>
                            @if (ViewBag.Articoli != null)
                            {
                                @foreach (var articolo in ViewBag.Articoli)
                                {
                                    <option value="@articolo.CodiceArticolo" selected="@(ViewBag.FiltroArticolo == articolo.CodiceArticolo)">
                                        @articolo.CodiceArticolo - @articolo.DescrizioneArticolo
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> Filtra
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Messaggi di successo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabella ordini -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> Ordini di Produzione (@Model.Count())
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Ordine</th>
                                <th>Articolo</th>
                                <th>Quantità</th>
                                <th>Stato</th>
                                <th>Centro Lavoro</th>
                                <th>Data Inizio</th>
                                <th>Data Fine Prevista</th>
                                <th>Progresso</th>
                                <th>Azioni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ordine in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@ordine.IdentificativoCompleto</strong>
                                        @if (!string.IsNullOrEmpty(ordine.DescrOrdine))
                                        {
                                            <br><small class="text-muted">@ordine.DescrOrdine</small>
                                        }
                                    </td>
                                    <td>
                                        <strong>@ordine.CodiceArticolo</strong>
                                        <br><small>@ordine.DescrizioneArticolo</small>
                                    </td>
                                    <td>
                                        <strong>@ordine.Quantita.ToString("N0")</strong>
                                        <br><small>@ordine.UnitaMisura</small>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = ordine.Stato?.CodiceStato switch
                                            {
                                                "EM" => "bg-secondary",
                                                "PR" => "bg-primary",
                                                "SO" => "bg-warning",
                                                "CH" => "bg-success",
                                                _ => "bg-light text-dark"
                                            };
                                        }
                                        <span class="badge @badgeClass">@ordine.Stato?.DescrizioneStato</span>
                                    </td>
                                    <td>@ordine.CentroLavoro?.DescrizioneCentro</td>
                                    <td>
                                        @ordine.DataInizioOP.ToString("dd/MM/yyyy")
                                        <br><small class="text-muted">@ordine.DataInizioOP.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        @if (ordine.DataFinePrevista.HasValue)
                                        {
                                            @ordine.DataFinePrevista.Value.ToString("dd/MM/yyyy")
                                            <br><small class="text-muted">@ordine.DataFinePrevista.Value.ToString("HH:mm")</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar" role="progressbar" style="width: @ordine.PercentualeCompletamento%">
                                                @ordine.PercentualeCompletamento.ToString("N1")%
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@ordine.IdListaOP" class="btn btn-sm btn-outline-info" title="Dettagli">
                                            <i class="bi bi-eye"></i> Dettagli
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h4 class="text-muted">Nessun ordine trovato</h4>
                    <p class="text-muted">Non ci sono ordini di produzione che corrispondono ai filtri selezionati.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Inizializza Select2 sul dropdown articoli
            $('#filtroArticolo').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Seleziona un articolo',
                allowClear: true,
                language: {
                    noResults: function() {
                        return "Nessun articolo trovato";
                    },
                    searching: function() {
                        return "Ricerca in corso...";
                    }
                }
            });

            // Auto-submit del form filtri quando cambiano i select (escluso articoli)
            $('select[name^="filtro"]:not(#filtroArticolo)').change(function() {
                $(this).closest('form').submit();
            });
            
            // Submit manuale per articoli (dopo la selezione)
            $('#filtroArticolo').on('select2:select select2:clear', function() {
                $(this).closest('form').submit();
            });
        });
    </script>
}